<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_tjk_city_dushanbe"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_tjk_city_dushanbe">
    <bpmn:participant id="Pool_tjk_city_dushanbe" name="Dushanbe (city:dus)" processRef="Process_tjk_city_dushanbe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tjk_city_dushanbe" name="Dushanbe — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_tjk_city_dushanbe" name="Policy trigger
received"><bpmn:outgoing>F_tjk_city_dushanbe_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_tjk_city_dushanbe_open" name="Parallel checks">
      <bpmn:incoming>F_tjk_city_dushanbe_01</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_02</bpmn:outgoing>
      <bpmn:outgoing>F_tjk_city_dushanbe_03</bpmn:outgoing>
      <bpmn:outgoing>F_tjk_city_dushanbe_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_tjk_city_dushanbe_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tjk.city:dushanbe.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tjk_city_dushanbe_02</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tjk_city_dushanbe_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tjk.city:dushanbe.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tjk_city_dushanbe_03</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tjk_city_dushanbe_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tjk.city:dushanbe.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tjk_city_dushanbe_04</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_tjk_city_dushanbe_join" name="Checks complete">
      <bpmn:incoming>F_tjk_city_dushanbe_05</bpmn:incoming>
      <bpmn:incoming>F_tjk_city_dushanbe_06</bpmn:incoming>
      <bpmn:incoming>F_tjk_city_dushanbe_07</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_tjk_city_dushanbe_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_tjk_city_dushanbe_08</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_tjk_city_dushanbe_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_tjk_city_dushanbe_09</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_10a</bpmn:outgoing>
      <bpmn:outgoing>F_tjk_city_dushanbe_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_tjk_city_dushanbe_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tjk.city:dushanbe.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tjk_city_dushanbe_10a</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tjk_city_dushanbe_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tjk.city:dushanbe.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tjk_city_dushanbe_10b</bpmn:incoming>
      <bpmn:outgoing>F_tjk_city_dushanbe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_tjk_city_dushanbe" name="Process complete">
      <bpmn:incoming>F_tjk_city_dushanbe_11</bpmn:incoming>
      <bpmn:incoming>F_tjk_city_dushanbe_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_01" sourceRef="Start_tjk_city_dushanbe" targetRef="GW_tjk_city_dushanbe_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_02" sourceRef="GW_tjk_city_dushanbe_open" targetRef="T_tjk_city_dushanbe_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_03" sourceRef="GW_tjk_city_dushanbe_open" targetRef="T_tjk_city_dushanbe_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_04" sourceRef="GW_tjk_city_dushanbe_open" targetRef="T_tjk_city_dushanbe_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_05" sourceRef="T_tjk_city_dushanbe_policy" targetRef="GW_tjk_city_dushanbe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_06" sourceRef="T_tjk_city_dushanbe_budget" targetRef="GW_tjk_city_dushanbe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_07" sourceRef="T_tjk_city_dushanbe_coord" targetRef="GW_tjk_city_dushanbe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_08" sourceRef="GW_tjk_city_dushanbe_join" targetRef="T_tjk_city_dushanbe_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_09" sourceRef="T_tjk_city_dushanbe_review" targetRef="GW_tjk_city_dushanbe_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_10a" sourceRef="GW_tjk_city_dushanbe_risk" targetRef="T_tjk_city_dushanbe_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_10b" sourceRef="GW_tjk_city_dushanbe_risk" targetRef="T_tjk_city_dushanbe_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_11" sourceRef="T_tjk_city_dushanbe_publish" targetRef="End_tjk_city_dushanbe">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tjk_city_dushanbe_11b" sourceRef="T_tjk_city_dushanbe_revise" targetRef="End_tjk_city_dushanbe">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_tjk_city_dushanbe">
    <bpmndi:BPMNPlane id="BPMNPlane_tjk_city_dushanbe" bpmnElement="Collaboration_tjk_city_dushanbe" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
