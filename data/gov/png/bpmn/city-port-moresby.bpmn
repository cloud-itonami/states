<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_png_city_port_moresby"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_png_city_port_moresby">
    <bpmn:participant id="Pool_png_city_port_moresby" name="Port Moresby (city:por)" processRef="Process_png_city_port_moresby" />
  </bpmn:collaboration>
  <bpmn:process id="Process_png_city_port_moresby" name="Port Moresby — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_png_city_port_moresby" name="Policy trigger
received"><bpmn:outgoing>F_png_city_port_moresby_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_png_city_port_moresby_open" name="Parallel checks">
      <bpmn:incoming>F_png_city_port_moresby_01</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_02</bpmn:outgoing>
      <bpmn:outgoing>F_png_city_port_moresby_03</bpmn:outgoing>
      <bpmn:outgoing>F_png_city_port_moresby_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_png_city_port_moresby_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.png.city:port-moresby.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_png_city_port_moresby_02</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_png_city_port_moresby_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.png.city:port-moresby.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_png_city_port_moresby_03</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_png_city_port_moresby_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.png.city:port-moresby.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_png_city_port_moresby_04</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_png_city_port_moresby_join" name="Checks complete">
      <bpmn:incoming>F_png_city_port_moresby_05</bpmn:incoming>
      <bpmn:incoming>F_png_city_port_moresby_06</bpmn:incoming>
      <bpmn:incoming>F_png_city_port_moresby_07</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_png_city_port_moresby_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_png_city_port_moresby_08</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_png_city_port_moresby_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_png_city_port_moresby_09</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_10a</bpmn:outgoing>
      <bpmn:outgoing>F_png_city_port_moresby_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_png_city_port_moresby_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.png.city:port-moresby.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_png_city_port_moresby_10a</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_png_city_port_moresby_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.png.city:port-moresby.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_png_city_port_moresby_10b</bpmn:incoming>
      <bpmn:outgoing>F_png_city_port_moresby_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_png_city_port_moresby" name="Process complete">
      <bpmn:incoming>F_png_city_port_moresby_11</bpmn:incoming>
      <bpmn:incoming>F_png_city_port_moresby_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_01" sourceRef="Start_png_city_port_moresby" targetRef="GW_png_city_port_moresby_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_02" sourceRef="GW_png_city_port_moresby_open" targetRef="T_png_city_port_moresby_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_03" sourceRef="GW_png_city_port_moresby_open" targetRef="T_png_city_port_moresby_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_04" sourceRef="GW_png_city_port_moresby_open" targetRef="T_png_city_port_moresby_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_05" sourceRef="T_png_city_port_moresby_policy" targetRef="GW_png_city_port_moresby_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_06" sourceRef="T_png_city_port_moresby_budget" targetRef="GW_png_city_port_moresby_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_07" sourceRef="T_png_city_port_moresby_coord" targetRef="GW_png_city_port_moresby_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_08" sourceRef="GW_png_city_port_moresby_join" targetRef="T_png_city_port_moresby_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_09" sourceRef="T_png_city_port_moresby_review" targetRef="GW_png_city_port_moresby_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_10a" sourceRef="GW_png_city_port_moresby_risk" targetRef="T_png_city_port_moresby_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_10b" sourceRef="GW_png_city_port_moresby_risk" targetRef="T_png_city_port_moresby_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_11" sourceRef="T_png_city_port_moresby_publish" targetRef="End_png_city_port_moresby">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_png_city_port_moresby_11b" sourceRef="T_png_city_port_moresby_revise" targetRef="End_png_city_port_moresby">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_png_city_port_moresby">
    <bpmndi:BPMNPlane id="BPMNPlane_png_city_port_moresby" bpmnElement="Collaboration_png_city_port_moresby" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
