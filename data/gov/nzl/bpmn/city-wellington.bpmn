<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_nzl_city_wellington"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_nzl_city_wellington">
    <bpmn:participant id="Pool_nzl_city_wellington" name="Wellington (city:wel)" processRef="Process_nzl_city_wellington" />
  </bpmn:collaboration>
  <bpmn:process id="Process_nzl_city_wellington" name="Wellington — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_nzl_city_wellington" name="Policy trigger
received"><bpmn:outgoing>F_nzl_city_wellington_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_nzl_city_wellington_open" name="Parallel checks">
      <bpmn:incoming>F_nzl_city_wellington_01</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_02</bpmn:outgoing>
      <bpmn:outgoing>F_nzl_city_wellington_03</bpmn:outgoing>
      <bpmn:outgoing>F_nzl_city_wellington_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_nzl_city_wellington_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nzl.city:wellington.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nzl_city_wellington_02</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nzl_city_wellington_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nzl.city:wellington.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nzl_city_wellington_03</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nzl_city_wellington_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nzl.city:wellington.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nzl_city_wellington_04</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_nzl_city_wellington_join" name="Checks complete">
      <bpmn:incoming>F_nzl_city_wellington_05</bpmn:incoming>
      <bpmn:incoming>F_nzl_city_wellington_06</bpmn:incoming>
      <bpmn:incoming>F_nzl_city_wellington_07</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_nzl_city_wellington_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_nzl_city_wellington_08</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_nzl_city_wellington_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_nzl_city_wellington_09</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_10a</bpmn:outgoing>
      <bpmn:outgoing>F_nzl_city_wellington_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_nzl_city_wellington_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nzl.city:wellington.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nzl_city_wellington_10a</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nzl_city_wellington_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nzl.city:wellington.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nzl_city_wellington_10b</bpmn:incoming>
      <bpmn:outgoing>F_nzl_city_wellington_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_nzl_city_wellington" name="Process complete">
      <bpmn:incoming>F_nzl_city_wellington_11</bpmn:incoming>
      <bpmn:incoming>F_nzl_city_wellington_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_01" sourceRef="Start_nzl_city_wellington" targetRef="GW_nzl_city_wellington_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_02" sourceRef="GW_nzl_city_wellington_open" targetRef="T_nzl_city_wellington_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_03" sourceRef="GW_nzl_city_wellington_open" targetRef="T_nzl_city_wellington_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_04" sourceRef="GW_nzl_city_wellington_open" targetRef="T_nzl_city_wellington_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_05" sourceRef="T_nzl_city_wellington_policy" targetRef="GW_nzl_city_wellington_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_06" sourceRef="T_nzl_city_wellington_budget" targetRef="GW_nzl_city_wellington_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_07" sourceRef="T_nzl_city_wellington_coord" targetRef="GW_nzl_city_wellington_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_08" sourceRef="GW_nzl_city_wellington_join" targetRef="T_nzl_city_wellington_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_09" sourceRef="T_nzl_city_wellington_review" targetRef="GW_nzl_city_wellington_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_10a" sourceRef="GW_nzl_city_wellington_risk" targetRef="T_nzl_city_wellington_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_10b" sourceRef="GW_nzl_city_wellington_risk" targetRef="T_nzl_city_wellington_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_11" sourceRef="T_nzl_city_wellington_publish" targetRef="End_nzl_city_wellington">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nzl_city_wellington_11b" sourceRef="T_nzl_city_wellington_revise" targetRef="End_nzl_city_wellington">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_nzl_city_wellington">
    <bpmndi:BPMNPlane id="BPMNPlane_nzl_city_wellington" bpmnElement="Collaboration_nzl_city_wellington" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
