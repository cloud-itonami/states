    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_civ_city_yamoussoukro">
    <bpmn:participant id="Pool_civ_city_yamoussoukro" name="Yamoussoukro (city:yam)" processRef="Process_civ_city_yamoussoukro" />
  </bpmn:collaboration>
  <bpmn:process id="Process_civ_city_yamoussoukro" name="Yamoussoukro — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_civ_city_yamoussoukro" name="Policy trigger
received"><bpmn:outgoing>F_civ_city_yamoussoukro_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_civ_city_yamoussoukro_open" name="Parallel checks">
      <bpmn:incoming>F_civ_city_yamoussoukro_01</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_02</bpmn:outgoing>
      <bpmn:outgoing>F_civ_city_yamoussoukro_03</bpmn:outgoing>
      <bpmn:outgoing>F_civ_city_yamoussoukro_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_civ_city_yamoussoukro_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:yamoussoukro.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_yamoussoukro_02</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_civ_city_yamoussoukro_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:yamoussoukro.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_yamoussoukro_03</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_civ_city_yamoussoukro_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:yamoussoukro.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_yamoussoukro_04</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_civ_city_yamoussoukro_join" name="Checks complete">
      <bpmn:incoming>F_civ_city_yamoussoukro_05</bpmn:incoming>
      <bpmn:incoming>F_civ_city_yamoussoukro_06</bpmn:incoming>
      <bpmn:incoming>F_civ_city_yamoussoukro_07</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_civ_city_yamoussoukro_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_yamoussoukro_08</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_civ_city_yamoussoukro_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_civ_city_yamoussoukro_09</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_10a</bpmn:outgoing>
      <bpmn:outgoing>F_civ_city_yamoussoukro_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_civ_city_yamoussoukro_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:yamoussoukro.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_yamoussoukro_10a</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_civ_city_yamoussoukro_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:yamoussoukro.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_yamoussoukro_10b</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_yamoussoukro_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_civ_city_yamoussoukro" name="Process complete">
      <bpmn:incoming>F_civ_city_yamoussoukro_11</bpmn:incoming>
      <bpmn:incoming>F_civ_city_yamoussoukro_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_01" sourceRef="Start_civ_city_yamoussoukro" targetRef="GW_civ_city_yamoussoukro_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_02" sourceRef="GW_civ_city_yamoussoukro_open" targetRef="T_civ_city_yamoussoukro_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_03" sourceRef="GW_civ_city_yamoussoukro_open" targetRef="T_civ_city_yamoussoukro_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_04" sourceRef="GW_civ_city_yamoussoukro_open" targetRef="T_civ_city_yamoussoukro_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_05" sourceRef="T_civ_city_yamoussoukro_policy" targetRef="GW_civ_city_yamoussoukro_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_06" sourceRef="T_civ_city_yamoussoukro_budget" targetRef="GW_civ_city_yamoussoukro_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_07" sourceRef="T_civ_city_yamoussoukro_coord" targetRef="GW_civ_city_yamoussoukro_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_08" sourceRef="GW_civ_city_yamoussoukro_join" targetRef="T_civ_city_yamoussoukro_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_09" sourceRef="T_civ_city_yamoussoukro_review" targetRef="GW_civ_city_yamoussoukro_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_10a" sourceRef="GW_civ_city_yamoussoukro_risk" targetRef="T_civ_city_yamoussoukro_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_10b" sourceRef="GW_civ_city_yamoussoukro_risk" targetRef="T_civ_city_yamoussoukro_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_11" sourceRef="T_civ_city_yamoussoukro_publish" targetRef="End_civ_city_yamoussoukro">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_yamoussoukro_11b" sourceRef="T_civ_city_yamoussoukro_revise" targetRef="End_civ_city_yamoussoukro">
    </bpmn:sequenceFlow>
  </bpmn:process>
