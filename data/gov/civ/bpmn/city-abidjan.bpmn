<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_civ_city_abidjan"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_civ_city_abidjan">
    <bpmn:participant id="Pool_civ_city_abidjan" name="Abidjan (city:abi)" processRef="Process_civ_city_abidjan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_civ_city_abidjan" name="Abidjan — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_civ_city_abidjan" name="Policy trigger
received"><bpmn:outgoing>F_civ_city_abidjan_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_civ_city_abidjan_open" name="Parallel checks">
      <bpmn:incoming>F_civ_city_abidjan_01</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_02</bpmn:outgoing>
      <bpmn:outgoing>F_civ_city_abidjan_03</bpmn:outgoing>
      <bpmn:outgoing>F_civ_city_abidjan_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_civ_city_abidjan_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:abidjan.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_abidjan_02</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_civ_city_abidjan_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:abidjan.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_abidjan_03</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_civ_city_abidjan_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:abidjan.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_abidjan_04</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_civ_city_abidjan_join" name="Checks complete">
      <bpmn:incoming>F_civ_city_abidjan_05</bpmn:incoming>
      <bpmn:incoming>F_civ_city_abidjan_06</bpmn:incoming>
      <bpmn:incoming>F_civ_city_abidjan_07</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_civ_city_abidjan_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_abidjan_08</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_civ_city_abidjan_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_civ_city_abidjan_09</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_10a</bpmn:outgoing>
      <bpmn:outgoing>F_civ_city_abidjan_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_civ_city_abidjan_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:abidjan.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_abidjan_10a</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_civ_city_abidjan_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.civ.city:abidjan.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_civ_city_abidjan_10b</bpmn:incoming>
      <bpmn:outgoing>F_civ_city_abidjan_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_civ_city_abidjan" name="Process complete">
      <bpmn:incoming>F_civ_city_abidjan_11</bpmn:incoming>
      <bpmn:incoming>F_civ_city_abidjan_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_01" sourceRef="Start_civ_city_abidjan" targetRef="GW_civ_city_abidjan_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_02" sourceRef="GW_civ_city_abidjan_open" targetRef="T_civ_city_abidjan_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_03" sourceRef="GW_civ_city_abidjan_open" targetRef="T_civ_city_abidjan_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_04" sourceRef="GW_civ_city_abidjan_open" targetRef="T_civ_city_abidjan_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_05" sourceRef="T_civ_city_abidjan_policy" targetRef="GW_civ_city_abidjan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_06" sourceRef="T_civ_city_abidjan_budget" targetRef="GW_civ_city_abidjan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_07" sourceRef="T_civ_city_abidjan_coord" targetRef="GW_civ_city_abidjan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_08" sourceRef="GW_civ_city_abidjan_join" targetRef="T_civ_city_abidjan_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_09" sourceRef="T_civ_city_abidjan_review" targetRef="GW_civ_city_abidjan_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_10a" sourceRef="GW_civ_city_abidjan_risk" targetRef="T_civ_city_abidjan_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_10b" sourceRef="GW_civ_city_abidjan_risk" targetRef="T_civ_city_abidjan_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_11" sourceRef="T_civ_city_abidjan_publish" targetRef="End_civ_city_abidjan">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_civ_city_abidjan_11b" sourceRef="T_civ_city_abidjan_revise" targetRef="End_civ_city_abidjan">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_civ_city_abidjan">
    <bpmndi:BPMNPlane id="BPMNPlane_civ_city_abidjan" bpmnElement="Collaboration_civ_city_abidjan" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
