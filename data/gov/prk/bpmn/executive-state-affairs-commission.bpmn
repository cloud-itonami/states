<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_prk_executive_state_affairs_commission"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_prk_executive_state_affairs_commission">
    <bpmn:participant id="Pool_prk_executive_state_affairs_commission" name="Executive State Affairs Commission (executiv)" processRef="Process_prk_executive_state_affairs_commission" />
  </bpmn:collaboration>
  <bpmn:process id="Process_prk_executive_state_affairs_commission" name="Executive State Affairs Commission — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_prk_executive_state_affairs_commission" name="Policy trigger
received"><bpmn:outgoing>F_prk_executive_state_affairs_commission_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_prk_executive_state_affairs_commission_open" name="Parallel checks">
      <bpmn:incoming>F_prk_executive_state_affairs_commission_01</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_02</bpmn:outgoing>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_03</bpmn:outgoing>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_prk_executive_state_affairs_commission_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.prk.executive-state-affairs-commission.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_02</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_prk_executive_state_affairs_commission_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.prk.executive-state-affairs-commission.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_03</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_prk_executive_state_affairs_commission_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.prk.executive-state-affairs-commission.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_04</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_prk_executive_state_affairs_commission_join" name="Checks complete">
      <bpmn:incoming>F_prk_executive_state_affairs_commission_05</bpmn:incoming>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_06</bpmn:incoming>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_07</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_prk_executive_state_affairs_commission_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_08</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_prk_executive_state_affairs_commission_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_prk_executive_state_affairs_commission_09</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_10a</bpmn:outgoing>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_prk_executive_state_affairs_commission_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.prk.executive-state-affairs-commission.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_10a</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_prk_executive_state_affairs_commission_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.prk.executive-state-affairs-commission.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_10b</bpmn:incoming>
      <bpmn:outgoing>F_prk_executive_state_affairs_commission_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_prk_executive_state_affairs_commission" name="Process complete">
      <bpmn:incoming>F_prk_executive_state_affairs_commission_11</bpmn:incoming>
      <bpmn:incoming>F_prk_executive_state_affairs_commission_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_01" sourceRef="Start_prk_executive_state_affairs_commission" targetRef="GW_prk_executive_state_affairs_commission_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_02" sourceRef="GW_prk_executive_state_affairs_commission_open" targetRef="T_prk_executive_state_affairs_commission_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_03" sourceRef="GW_prk_executive_state_affairs_commission_open" targetRef="T_prk_executive_state_affairs_commission_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_04" sourceRef="GW_prk_executive_state_affairs_commission_open" targetRef="T_prk_executive_state_affairs_commission_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_05" sourceRef="T_prk_executive_state_affairs_commission_policy" targetRef="GW_prk_executive_state_affairs_commission_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_06" sourceRef="T_prk_executive_state_affairs_commission_budget" targetRef="GW_prk_executive_state_affairs_commission_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_07" sourceRef="T_prk_executive_state_affairs_commission_coord" targetRef="GW_prk_executive_state_affairs_commission_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_08" sourceRef="GW_prk_executive_state_affairs_commission_join" targetRef="T_prk_executive_state_affairs_commission_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_09" sourceRef="T_prk_executive_state_affairs_commission_review" targetRef="GW_prk_executive_state_affairs_commission_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_10a" sourceRef="GW_prk_executive_state_affairs_commission_risk" targetRef="T_prk_executive_state_affairs_commission_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_10b" sourceRef="GW_prk_executive_state_affairs_commission_risk" targetRef="T_prk_executive_state_affairs_commission_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_11" sourceRef="T_prk_executive_state_affairs_commission_publish" targetRef="End_prk_executive_state_affairs_commission">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_prk_executive_state_affairs_commission_11b" sourceRef="T_prk_executive_state_affairs_commission_revise" targetRef="End_prk_executive_state_affairs_commission">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_prk_executive_state_affairs_commission">
    <bpmndi:BPMNPlane id="BPMNPlane_prk_executive_state_affairs_commission" bpmnElement="Collaboration_prk_executive_state_affairs_commission" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
