<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_caf_city_bangui"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_caf_city_bangui">
    <bpmn:participant id="Pool_caf_city_bangui" name="Bangui (city:ban)" processRef="Process_caf_city_bangui" />
  </bpmn:collaboration>
  <bpmn:process id="Process_caf_city_bangui" name="Bangui — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_caf_city_bangui" name="Policy trigger
received"><bpmn:outgoing>F_caf_city_bangui_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_caf_city_bangui_open" name="Parallel checks">
      <bpmn:incoming>F_caf_city_bangui_01</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_02</bpmn:outgoing>
      <bpmn:outgoing>F_caf_city_bangui_03</bpmn:outgoing>
      <bpmn:outgoing>F_caf_city_bangui_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_caf_city_bangui_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.caf.city:bangui.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_caf_city_bangui_02</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_caf_city_bangui_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.caf.city:bangui.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_caf_city_bangui_03</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_caf_city_bangui_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.caf.city:bangui.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_caf_city_bangui_04</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_caf_city_bangui_join" name="Checks complete">
      <bpmn:incoming>F_caf_city_bangui_05</bpmn:incoming>
      <bpmn:incoming>F_caf_city_bangui_06</bpmn:incoming>
      <bpmn:incoming>F_caf_city_bangui_07</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_caf_city_bangui_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_caf_city_bangui_08</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_caf_city_bangui_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_caf_city_bangui_09</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_10a</bpmn:outgoing>
      <bpmn:outgoing>F_caf_city_bangui_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_caf_city_bangui_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.caf.city:bangui.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_caf_city_bangui_10a</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_caf_city_bangui_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.caf.city:bangui.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_caf_city_bangui_10b</bpmn:incoming>
      <bpmn:outgoing>F_caf_city_bangui_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_caf_city_bangui" name="Process complete">
      <bpmn:incoming>F_caf_city_bangui_11</bpmn:incoming>
      <bpmn:incoming>F_caf_city_bangui_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_caf_city_bangui_01" sourceRef="Start_caf_city_bangui" targetRef="GW_caf_city_bangui_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_02" sourceRef="GW_caf_city_bangui_open" targetRef="T_caf_city_bangui_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_03" sourceRef="GW_caf_city_bangui_open" targetRef="T_caf_city_bangui_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_04" sourceRef="GW_caf_city_bangui_open" targetRef="T_caf_city_bangui_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_05" sourceRef="T_caf_city_bangui_policy" targetRef="GW_caf_city_bangui_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_06" sourceRef="T_caf_city_bangui_budget" targetRef="GW_caf_city_bangui_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_07" sourceRef="T_caf_city_bangui_coord" targetRef="GW_caf_city_bangui_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_08" sourceRef="GW_caf_city_bangui_join" targetRef="T_caf_city_bangui_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_09" sourceRef="T_caf_city_bangui_review" targetRef="GW_caf_city_bangui_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_10a" sourceRef="GW_caf_city_bangui_risk" targetRef="T_caf_city_bangui_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_10b" sourceRef="GW_caf_city_bangui_risk" targetRef="T_caf_city_bangui_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_11" sourceRef="T_caf_city_bangui_publish" targetRef="End_caf_city_bangui">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_caf_city_bangui_11b" sourceRef="T_caf_city_bangui_revise" targetRef="End_caf_city_bangui">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_caf_city_bangui">
    <bpmndi:BPMNPlane id="BPMNPlane_caf_city_bangui" bpmnElement="Collaboration_caf_city_bangui" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
