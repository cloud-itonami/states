<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mex_finance_hacienda"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mex_finance_hacienda">
    <bpmn:participant id="Pool_mex_finance_hacienda" name="Finance Hacienda (m5x8f1r9)" processRef="Process_mex_finance_hacienda" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mex_finance_hacienda" name="Finance Hacienda — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_mex_finance_hacienda" name="License / Permit
application received"><bpmn:outgoing>F_mex_finance_hacienda_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_mex_finance_hacienda_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.finance-hacienda.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_01</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_mex_finance_hacienda_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_mex_finance_hacienda_02</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_03a</bpmn:outgoing>
      <bpmn:outgoing>F_mex_finance_hacienda_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mex_finance_hacienda_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.finance-hacienda.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_03b</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mex_finance_hacienda_checks" name="Parallel review">
      <bpmn:incoming>F_mex_finance_hacienda_03a</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_04a</bpmn:outgoing>
      <bpmn:outgoing>F_mex_finance_hacienda_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mex_finance_hacienda_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.finance-hacienda.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_04a</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_finance_hacienda_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.finance-hacienda.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_04b</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mex_finance_hacienda_join" name="Reviews complete">
      <bpmn:incoming>F_mex_finance_hacienda_05</bpmn:incoming>
      <bpmn:incoming>F_mex_finance_hacienda_05b</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mex_finance_hacienda_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_06</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mex_finance_hacienda_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_mex_finance_hacienda_07</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_08a</bpmn:outgoing>
      <bpmn:outgoing>F_mex_finance_hacienda_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mex_finance_hacienda_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.finance-hacienda.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_08a</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_finance_hacienda_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.finance-hacienda.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_finance_hacienda_08b</bpmn:incoming>
      <bpmn:outgoing>F_mex_finance_hacienda_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mex_finance_hacienda" name="Application
processed">
      <bpmn:incoming>F_mex_finance_hacienda_end1</bpmn:incoming>
      <bpmn:incoming>F_mex_finance_hacienda_end1b</bpmn:incoming>
      <bpmn:incoming>F_mex_finance_hacienda_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_01" sourceRef="Start_mex_finance_hacienda" targetRef="T_mex_finance_hacienda_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_02" sourceRef="T_mex_finance_hacienda_screen" targetRef="GW_mex_finance_hacienda_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_03a" sourceRef="GW_mex_finance_hacienda_complete" targetRef="GW_mex_finance_hacienda_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_03b" sourceRef="GW_mex_finance_hacienda_complete" targetRef="T_mex_finance_hacienda_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_04a" sourceRef="GW_mex_finance_hacienda_checks" targetRef="T_mex_finance_hacienda_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_04b" sourceRef="GW_mex_finance_hacienda_checks" targetRef="T_mex_finance_hacienda_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_05" sourceRef="T_mex_finance_hacienda_legal" targetRef="GW_mex_finance_hacienda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_05b" sourceRef="T_mex_finance_hacienda_technical" targetRef="GW_mex_finance_hacienda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_06" sourceRef="GW_mex_finance_hacienda_join" targetRef="T_mex_finance_hacienda_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_07" sourceRef="T_mex_finance_hacienda_decision" targetRef="GW_mex_finance_hacienda_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_08a" sourceRef="GW_mex_finance_hacienda_approve" targetRef="T_mex_finance_hacienda_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_08b" sourceRef="GW_mex_finance_hacienda_approve" targetRef="T_mex_finance_hacienda_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_end1" sourceRef="T_mex_finance_hacienda_issue" targetRef="End_mex_finance_hacienda">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_end1b" sourceRef="T_mex_finance_hacienda_deny" targetRef="End_mex_finance_hacienda">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_finance_hacienda_end1c" sourceRef="T_mex_finance_hacienda_return" targetRef="End_mex_finance_hacienda">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mex_finance_hacienda">
    <bpmndi:BPMNPlane id="BPMNPlane_mex_finance_hacienda" bpmnElement="Collaboration_mex_finance_hacienda" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
