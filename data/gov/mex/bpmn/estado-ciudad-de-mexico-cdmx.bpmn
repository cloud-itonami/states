received"><bpmn:outgoing>F_mex_estado_ciudad_de_mexico_cdmx_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mex_estado_ciudad_de_mexico_cdmx_open" name="Parallel checks">
