    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_ciudad_de_mexico_cdmx_06" sourceRef="T_mex_estado_ciudad_de_mexico_cdmx_budget" targetRef="GW_mex_estado_ciudad_de_mexico_cdmx_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_ciudad_de_mexico_cdmx_07" sourceRef="T_mex_estado_ciudad_de_mexico_cdmx_coord" targetRef="GW_mex_estado_ciudad_de_mexico_cdmx_join">
