    <bpmn:sequenceFlow id="F_mex_estado_ciudad_de_mexico_cdmx_08" sourceRef="GW_mex_estado_ciudad_de_mexico_cdmx_join" targetRef="T_mex_estado_ciudad_de_mexico_cdmx_review">
    </bpmn:sequenceFlow>
