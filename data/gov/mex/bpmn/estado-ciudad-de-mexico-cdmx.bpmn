    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mex_estado_ciudad_de_mexico_cdmx_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.estado:ciudad-de-mexico:cdmx.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
