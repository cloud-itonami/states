<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mex_law_enforcement_guardia_nacional"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mex_law_enforcement_guardia_nacional">
    <bpmn:participant id="Pool_mex_law_enforcement_guardia_nacional" name="Law Enforcement Guardia Nacional (m1x2p3l4)" processRef="Process_mex_law_enforcement_guardia_nacional" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mex_law_enforcement_guardia_nacional" name="Law Enforcement Guardia Nacional — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_mex_law_enforcement_guardia_nacional" name="Incident
reported"><bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_mex_law_enforcement_guardia_nacional_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.law-enforcement-guardia-nacional.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_01</bpmn:incoming>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_mex_law_enforcement_guardia_nacional_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_02</bpmn:incoming>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_03a</bpmn:outgoing>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_03b</bpmn:outgoing>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mex_law_enforcement_guardia_nacional_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.law-enforcement-guardia-nacional.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_03a</bpmn:incoming>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_law_enforcement_guardia_nacional_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.law-enforcement-guardia-nacional.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_03b</bpmn:incoming>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_law_enforcement_guardia_nacional_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.law-enforcement-guardia-nacional.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_03c</bpmn:incoming>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_law_enforcement_guardia_nacional_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.law-enforcement-guardia-nacional.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_06</bpmn:incoming>
      <bpmn:outgoing>F_mex_law_enforcement_guardia_nacional_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mex_law_enforcement_guardia_nacional" name="Incident resolved">
      <bpmn:incoming>F_mex_law_enforcement_guardia_nacional_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_01" sourceRef="Start_mex_law_enforcement_guardia_nacional" targetRef="T_mex_law_enforcement_guardia_nacional_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_02" sourceRef="T_mex_law_enforcement_guardia_nacional_triage" targetRef="GW_mex_law_enforcement_guardia_nacional_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_03a" sourceRef="GW_mex_law_enforcement_guardia_nacional_sev" targetRef="T_mex_law_enforcement_guardia_nacional_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_03b" sourceRef="GW_mex_law_enforcement_guardia_nacional_sev" targetRef="T_mex_law_enforcement_guardia_nacional_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_03c" sourceRef="GW_mex_law_enforcement_guardia_nacional_sev" targetRef="T_mex_law_enforcement_guardia_nacional_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_06" sourceRef="T_mex_law_enforcement_guardia_nacional_emergency" targetRef="T_mex_law_enforcement_guardia_nacional_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_06b" sourceRef="T_mex_law_enforcement_guardia_nacional_investigate" targetRef="T_mex_law_enforcement_guardia_nacional_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_06c" sourceRef="T_mex_law_enforcement_guardia_nacional_log" targetRef="T_mex_law_enforcement_guardia_nacional_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_law_enforcement_guardia_nacional_07" sourceRef="T_mex_law_enforcement_guardia_nacional_report" targetRef="End_mex_law_enforcement_guardia_nacional">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mex_law_enforcement_guardia_nacional">
    <bpmndi:BPMNPlane id="BPMNPlane_mex_law_enforcement_guardia_nacional" bpmnElement="Collaboration_mex_law_enforcement_guardia_nacional" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
