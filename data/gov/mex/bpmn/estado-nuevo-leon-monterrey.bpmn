<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mex_estado_nuevo_leon_monterrey"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mex_estado_nuevo_leon_monterrey">
    <bpmn:participant id="Pool_mex_estado_nuevo_leon_monterrey" name="Monterrey (estado:n)" processRef="Process_mex_estado_nuevo_leon_monterrey" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mex_estado_nuevo_leon_monterrey" name="Monterrey — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mex_estado_nuevo_leon_monterrey" name="Policy trigger
received"><bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mex_estado_nuevo_leon_monterrey_open" name="Parallel checks">
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_01</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_02</bpmn:outgoing>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_03</bpmn:outgoing>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mex_estado_nuevo_leon_monterrey_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.estado:nuevo-leon:monterrey.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_02</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_estado_nuevo_leon_monterrey_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.estado:nuevo-leon:monterrey.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_03</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_estado_nuevo_leon_monterrey_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.estado:nuevo-leon:monterrey.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_04</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mex_estado_nuevo_leon_monterrey_join" name="Checks complete">
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_05</bpmn:incoming>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_06</bpmn:incoming>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_07</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mex_estado_nuevo_leon_monterrey_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_08</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mex_estado_nuevo_leon_monterrey_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_09</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mex_estado_nuevo_leon_monterrey_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.estado:nuevo-leon:monterrey.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_10a</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_estado_nuevo_leon_monterrey_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.estado:nuevo-leon:monterrey.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_10b</bpmn:incoming>
      <bpmn:outgoing>F_mex_estado_nuevo_leon_monterrey_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mex_estado_nuevo_leon_monterrey" name="Process complete">
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_11</bpmn:incoming>
      <bpmn:incoming>F_mex_estado_nuevo_leon_monterrey_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_01" sourceRef="Start_mex_estado_nuevo_leon_monterrey" targetRef="GW_mex_estado_nuevo_leon_monterrey_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_02" sourceRef="GW_mex_estado_nuevo_leon_monterrey_open" targetRef="T_mex_estado_nuevo_leon_monterrey_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_03" sourceRef="GW_mex_estado_nuevo_leon_monterrey_open" targetRef="T_mex_estado_nuevo_leon_monterrey_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_04" sourceRef="GW_mex_estado_nuevo_leon_monterrey_open" targetRef="T_mex_estado_nuevo_leon_monterrey_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_05" sourceRef="T_mex_estado_nuevo_leon_monterrey_policy" targetRef="GW_mex_estado_nuevo_leon_monterrey_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_06" sourceRef="T_mex_estado_nuevo_leon_monterrey_budget" targetRef="GW_mex_estado_nuevo_leon_monterrey_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_07" sourceRef="T_mex_estado_nuevo_leon_monterrey_coord" targetRef="GW_mex_estado_nuevo_leon_monterrey_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_08" sourceRef="GW_mex_estado_nuevo_leon_monterrey_join" targetRef="T_mex_estado_nuevo_leon_monterrey_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_09" sourceRef="T_mex_estado_nuevo_leon_monterrey_review" targetRef="GW_mex_estado_nuevo_leon_monterrey_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_10a" sourceRef="GW_mex_estado_nuevo_leon_monterrey_risk" targetRef="T_mex_estado_nuevo_leon_monterrey_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_10b" sourceRef="GW_mex_estado_nuevo_leon_monterrey_risk" targetRef="T_mex_estado_nuevo_leon_monterrey_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_11" sourceRef="T_mex_estado_nuevo_leon_monterrey_publish" targetRef="End_mex_estado_nuevo_leon_monterrey">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_estado_nuevo_leon_monterrey_11b" sourceRef="T_mex_estado_nuevo_leon_monterrey_revise" targetRef="End_mex_estado_nuevo_leon_monterrey">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mex_estado_nuevo_leon_monterrey">
    <bpmndi:BPMNPlane id="BPMNPlane_mex_estado_nuevo_leon_monterrey" bpmnElement="Collaboration_mex_estado_nuevo_leon_monterrey" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
