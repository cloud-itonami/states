<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mex_executive_presidencia"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mex_executive_presidencia">
    <bpmn:participant id="Pool_mex_executive_presidencia" name="Executive Presidencia (executiv)" processRef="Process_mex_executive_presidencia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mex_executive_presidencia" name="Executive Presidencia — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mex_executive_presidencia" name="Policy trigger
received"><bpmn:outgoing>F_mex_executive_presidencia_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mex_executive_presidencia_open" name="Parallel checks">
      <bpmn:incoming>F_mex_executive_presidencia_01</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_02</bpmn:outgoing>
      <bpmn:outgoing>F_mex_executive_presidencia_03</bpmn:outgoing>
      <bpmn:outgoing>F_mex_executive_presidencia_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mex_executive_presidencia_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.executive-presidencia.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_executive_presidencia_02</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_executive_presidencia_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.executive-presidencia.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_executive_presidencia_03</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_executive_presidencia_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.executive-presidencia.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_executive_presidencia_04</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mex_executive_presidencia_join" name="Checks complete">
      <bpmn:incoming>F_mex_executive_presidencia_05</bpmn:incoming>
      <bpmn:incoming>F_mex_executive_presidencia_06</bpmn:incoming>
      <bpmn:incoming>F_mex_executive_presidencia_07</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mex_executive_presidencia_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_executive_presidencia_08</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mex_executive_presidencia_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mex_executive_presidencia_09</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mex_executive_presidencia_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mex_executive_presidencia_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.executive-presidencia.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_executive_presidencia_10a</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mex_executive_presidencia_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mex.executive-presidencia.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mex_executive_presidencia_10b</bpmn:incoming>
      <bpmn:outgoing>F_mex_executive_presidencia_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mex_executive_presidencia" name="Process complete">
      <bpmn:incoming>F_mex_executive_presidencia_11</bpmn:incoming>
      <bpmn:incoming>F_mex_executive_presidencia_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_01" sourceRef="Start_mex_executive_presidencia" targetRef="GW_mex_executive_presidencia_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_02" sourceRef="GW_mex_executive_presidencia_open" targetRef="T_mex_executive_presidencia_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_03" sourceRef="GW_mex_executive_presidencia_open" targetRef="T_mex_executive_presidencia_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_04" sourceRef="GW_mex_executive_presidencia_open" targetRef="T_mex_executive_presidencia_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_05" sourceRef="T_mex_executive_presidencia_policy" targetRef="GW_mex_executive_presidencia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_06" sourceRef="T_mex_executive_presidencia_budget" targetRef="GW_mex_executive_presidencia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_07" sourceRef="T_mex_executive_presidencia_coord" targetRef="GW_mex_executive_presidencia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_08" sourceRef="GW_mex_executive_presidencia_join" targetRef="T_mex_executive_presidencia_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_09" sourceRef="T_mex_executive_presidencia_review" targetRef="GW_mex_executive_presidencia_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_10a" sourceRef="GW_mex_executive_presidencia_risk" targetRef="T_mex_executive_presidencia_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_10b" sourceRef="GW_mex_executive_presidencia_risk" targetRef="T_mex_executive_presidencia_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_11" sourceRef="T_mex_executive_presidencia_publish" targetRef="End_mex_executive_presidencia">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mex_executive_presidencia_11b" sourceRef="T_mex_executive_presidencia_revise" targetRef="End_mex_executive_presidencia">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mex_executive_presidencia">
    <bpmndi:BPMNPlane id="BPMNPlane_mex_executive_presidencia" bpmnElement="Collaboration_mex_executive_presidencia" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
