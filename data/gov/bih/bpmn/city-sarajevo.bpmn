<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bih_city_sarajevo"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bih_city_sarajevo">
    <bpmn:participant id="Pool_bih_city_sarajevo" name="Sarajevo (city:sar)" processRef="Process_bih_city_sarajevo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bih_city_sarajevo" name="Sarajevo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bih_city_sarajevo" name="Policy trigger
received"><bpmn:outgoing>F_bih_city_sarajevo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bih_city_sarajevo_open" name="Parallel checks">
      <bpmn:incoming>F_bih_city_sarajevo_01</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_02</bpmn:outgoing>
      <bpmn:outgoing>F_bih_city_sarajevo_03</bpmn:outgoing>
      <bpmn:outgoing>F_bih_city_sarajevo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bih_city_sarajevo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bih.city:sarajevo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bih_city_sarajevo_02</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bih_city_sarajevo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bih.city:sarajevo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bih_city_sarajevo_03</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bih_city_sarajevo_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bih.city:sarajevo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bih_city_sarajevo_04</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bih_city_sarajevo_join" name="Checks complete">
      <bpmn:incoming>F_bih_city_sarajevo_05</bpmn:incoming>
      <bpmn:incoming>F_bih_city_sarajevo_06</bpmn:incoming>
      <bpmn:incoming>F_bih_city_sarajevo_07</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bih_city_sarajevo_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bih_city_sarajevo_08</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bih_city_sarajevo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bih_city_sarajevo_09</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bih_city_sarajevo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bih_city_sarajevo_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bih.city:sarajevo.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bih_city_sarajevo_10a</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bih_city_sarajevo_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bih.city:sarajevo.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bih_city_sarajevo_10b</bpmn:incoming>
      <bpmn:outgoing>F_bih_city_sarajevo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bih_city_sarajevo" name="Process complete">
      <bpmn:incoming>F_bih_city_sarajevo_11</bpmn:incoming>
      <bpmn:incoming>F_bih_city_sarajevo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_01" sourceRef="Start_bih_city_sarajevo" targetRef="GW_bih_city_sarajevo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_02" sourceRef="GW_bih_city_sarajevo_open" targetRef="T_bih_city_sarajevo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_03" sourceRef="GW_bih_city_sarajevo_open" targetRef="T_bih_city_sarajevo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_04" sourceRef="GW_bih_city_sarajevo_open" targetRef="T_bih_city_sarajevo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_05" sourceRef="T_bih_city_sarajevo_policy" targetRef="GW_bih_city_sarajevo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_06" sourceRef="T_bih_city_sarajevo_budget" targetRef="GW_bih_city_sarajevo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_07" sourceRef="T_bih_city_sarajevo_coord" targetRef="GW_bih_city_sarajevo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_08" sourceRef="GW_bih_city_sarajevo_join" targetRef="T_bih_city_sarajevo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_09" sourceRef="T_bih_city_sarajevo_review" targetRef="GW_bih_city_sarajevo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_10a" sourceRef="GW_bih_city_sarajevo_risk" targetRef="T_bih_city_sarajevo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_10b" sourceRef="GW_bih_city_sarajevo_risk" targetRef="T_bih_city_sarajevo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_11" sourceRef="T_bih_city_sarajevo_publish" targetRef="End_bih_city_sarajevo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bih_city_sarajevo_11b" sourceRef="T_bih_city_sarajevo_revise" targetRef="End_bih_city_sarajevo">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bih_city_sarajevo">
    <bpmndi:BPMNPlane id="BPMNPlane_bih_city_sarajevo" bpmnElement="Collaboration_bih_city_sarajevo" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
