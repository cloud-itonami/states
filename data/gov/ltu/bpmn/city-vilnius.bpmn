<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ltu_city_vilnius"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ltu_city_vilnius">
    <bpmn:participant id="Pool_ltu_city_vilnius" name="Vilnius (city:vil)" processRef="Process_ltu_city_vilnius" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ltu_city_vilnius" name="Vilnius — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ltu_city_vilnius" name="Policy trigger
received"><bpmn:outgoing>F_ltu_city_vilnius_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ltu_city_vilnius_open" name="Parallel checks">
      <bpmn:incoming>F_ltu_city_vilnius_01</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_02</bpmn:outgoing>
      <bpmn:outgoing>F_ltu_city_vilnius_03</bpmn:outgoing>
      <bpmn:outgoing>F_ltu_city_vilnius_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ltu_city_vilnius_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ltu.city:vilnius.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ltu_city_vilnius_02</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ltu_city_vilnius_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ltu.city:vilnius.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ltu_city_vilnius_03</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ltu_city_vilnius_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ltu.city:vilnius.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ltu_city_vilnius_04</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ltu_city_vilnius_join" name="Checks complete">
      <bpmn:incoming>F_ltu_city_vilnius_05</bpmn:incoming>
      <bpmn:incoming>F_ltu_city_vilnius_06</bpmn:incoming>
      <bpmn:incoming>F_ltu_city_vilnius_07</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ltu_city_vilnius_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ltu_city_vilnius_08</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ltu_city_vilnius_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ltu_city_vilnius_09</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ltu_city_vilnius_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ltu_city_vilnius_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ltu.city:vilnius.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ltu_city_vilnius_10a</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ltu_city_vilnius_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ltu.city:vilnius.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ltu_city_vilnius_10b</bpmn:incoming>
      <bpmn:outgoing>F_ltu_city_vilnius_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ltu_city_vilnius" name="Process complete">
      <bpmn:incoming>F_ltu_city_vilnius_11</bpmn:incoming>
      <bpmn:incoming>F_ltu_city_vilnius_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_01" sourceRef="Start_ltu_city_vilnius" targetRef="GW_ltu_city_vilnius_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_02" sourceRef="GW_ltu_city_vilnius_open" targetRef="T_ltu_city_vilnius_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_03" sourceRef="GW_ltu_city_vilnius_open" targetRef="T_ltu_city_vilnius_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_04" sourceRef="GW_ltu_city_vilnius_open" targetRef="T_ltu_city_vilnius_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_05" sourceRef="T_ltu_city_vilnius_policy" targetRef="GW_ltu_city_vilnius_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_06" sourceRef="T_ltu_city_vilnius_budget" targetRef="GW_ltu_city_vilnius_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_07" sourceRef="T_ltu_city_vilnius_coord" targetRef="GW_ltu_city_vilnius_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_08" sourceRef="GW_ltu_city_vilnius_join" targetRef="T_ltu_city_vilnius_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_09" sourceRef="T_ltu_city_vilnius_review" targetRef="GW_ltu_city_vilnius_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_10a" sourceRef="GW_ltu_city_vilnius_risk" targetRef="T_ltu_city_vilnius_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_10b" sourceRef="GW_ltu_city_vilnius_risk" targetRef="T_ltu_city_vilnius_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_11" sourceRef="T_ltu_city_vilnius_publish" targetRef="End_ltu_city_vilnius">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ltu_city_vilnius_11b" sourceRef="T_ltu_city_vilnius_revise" targetRef="End_ltu_city_vilnius">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ltu_city_vilnius">
    <bpmndi:BPMNPlane id="BPMNPlane_ltu_city_vilnius" bpmnElement="Collaboration_ltu_city_vilnius" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
