<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bel_interior"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bel_interior">
    <bpmn:participant id="Pool_bel_interior" name="Interior (b1l2i3n4)" processRef="Process_bel_interior" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bel_interior" name="Interior — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bel_interior" name="Policy trigger
received"><bpmn:outgoing>F_bel_interior_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bel_interior_open" name="Parallel checks">
      <bpmn:incoming>F_bel_interior_01</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_02</bpmn:outgoing>
      <bpmn:outgoing>F_bel_interior_03</bpmn:outgoing>
      <bpmn:outgoing>F_bel_interior_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bel_interior_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bel.interior.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bel_interior_02</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bel_interior_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bel.interior.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bel_interior_03</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bel_interior_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bel.interior.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bel_interior_04</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bel_interior_join" name="Checks complete">
      <bpmn:incoming>F_bel_interior_05</bpmn:incoming>
      <bpmn:incoming>F_bel_interior_06</bpmn:incoming>
      <bpmn:incoming>F_bel_interior_07</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bel_interior_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bel_interior_08</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bel_interior_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bel_interior_09</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bel_interior_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bel_interior_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bel.interior.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bel_interior_10a</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bel_interior_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bel.interior.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bel_interior_10b</bpmn:incoming>
      <bpmn:outgoing>F_bel_interior_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bel_interior" name="Process complete">
      <bpmn:incoming>F_bel_interior_11</bpmn:incoming>
      <bpmn:incoming>F_bel_interior_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bel_interior_01" sourceRef="Start_bel_interior" targetRef="GW_bel_interior_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_02" sourceRef="GW_bel_interior_open" targetRef="T_bel_interior_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_03" sourceRef="GW_bel_interior_open" targetRef="T_bel_interior_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_04" sourceRef="GW_bel_interior_open" targetRef="T_bel_interior_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_05" sourceRef="T_bel_interior_policy" targetRef="GW_bel_interior_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_06" sourceRef="T_bel_interior_budget" targetRef="GW_bel_interior_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_07" sourceRef="T_bel_interior_coord" targetRef="GW_bel_interior_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_08" sourceRef="GW_bel_interior_join" targetRef="T_bel_interior_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_09" sourceRef="T_bel_interior_review" targetRef="GW_bel_interior_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_10a" sourceRef="GW_bel_interior_risk" targetRef="T_bel_interior_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_10b" sourceRef="GW_bel_interior_risk" targetRef="T_bel_interior_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_11" sourceRef="T_bel_interior_publish" targetRef="End_bel_interior">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bel_interior_11b" sourceRef="T_bel_interior_revise" targetRef="End_bel_interior">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bel_interior">
    <bpmndi:BPMNPlane id="BPMNPlane_bel_interior" bpmnElement="Collaboration_bel_interior" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
