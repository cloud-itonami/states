<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ecu_city_quito"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ecu_city_quito">
    <bpmn:participant id="Pool_ecu_city_quito" name="Quito (city:qui)" processRef="Process_ecu_city_quito" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ecu_city_quito" name="Quito — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ecu_city_quito" name="Policy trigger
received"><bpmn:outgoing>F_ecu_city_quito_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ecu_city_quito_open" name="Parallel checks">
      <bpmn:incoming>F_ecu_city_quito_01</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_02</bpmn:outgoing>
      <bpmn:outgoing>F_ecu_city_quito_03</bpmn:outgoing>
      <bpmn:outgoing>F_ecu_city_quito_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ecu_city_quito_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ecu.city:quito.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ecu_city_quito_02</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ecu_city_quito_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ecu.city:quito.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ecu_city_quito_03</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ecu_city_quito_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ecu.city:quito.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ecu_city_quito_04</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ecu_city_quito_join" name="Checks complete">
      <bpmn:incoming>F_ecu_city_quito_05</bpmn:incoming>
      <bpmn:incoming>F_ecu_city_quito_06</bpmn:incoming>
      <bpmn:incoming>F_ecu_city_quito_07</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ecu_city_quito_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ecu_city_quito_08</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ecu_city_quito_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ecu_city_quito_09</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ecu_city_quito_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ecu_city_quito_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ecu.city:quito.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ecu_city_quito_10a</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ecu_city_quito_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ecu.city:quito.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ecu_city_quito_10b</bpmn:incoming>
      <bpmn:outgoing>F_ecu_city_quito_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ecu_city_quito" name="Process complete">
      <bpmn:incoming>F_ecu_city_quito_11</bpmn:incoming>
      <bpmn:incoming>F_ecu_city_quito_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ecu_city_quito_01" sourceRef="Start_ecu_city_quito" targetRef="GW_ecu_city_quito_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_02" sourceRef="GW_ecu_city_quito_open" targetRef="T_ecu_city_quito_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_03" sourceRef="GW_ecu_city_quito_open" targetRef="T_ecu_city_quito_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_04" sourceRef="GW_ecu_city_quito_open" targetRef="T_ecu_city_quito_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_05" sourceRef="T_ecu_city_quito_policy" targetRef="GW_ecu_city_quito_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_06" sourceRef="T_ecu_city_quito_budget" targetRef="GW_ecu_city_quito_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_07" sourceRef="T_ecu_city_quito_coord" targetRef="GW_ecu_city_quito_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_08" sourceRef="GW_ecu_city_quito_join" targetRef="T_ecu_city_quito_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_09" sourceRef="T_ecu_city_quito_review" targetRef="GW_ecu_city_quito_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_10a" sourceRef="GW_ecu_city_quito_risk" targetRef="T_ecu_city_quito_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_10b" sourceRef="GW_ecu_city_quito_risk" targetRef="T_ecu_city_quito_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_11" sourceRef="T_ecu_city_quito_publish" targetRef="End_ecu_city_quito">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ecu_city_quito_11b" sourceRef="T_ecu_city_quito_revise" targetRef="End_ecu_city_quito">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ecu_city_quito">
    <bpmndi:BPMNPlane id="BPMNPlane_ecu_city_quito" bpmnElement="Collaboration_ecu_city_quito" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
