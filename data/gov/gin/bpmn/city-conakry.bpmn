<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_gin_city_conakry"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_gin_city_conakry">
    <bpmn:participant id="Pool_gin_city_conakry" name="Conakry (city:con)" processRef="Process_gin_city_conakry" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gin_city_conakry" name="Conakry — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_gin_city_conakry" name="Policy trigger
received"><bpmn:outgoing>F_gin_city_conakry_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_gin_city_conakry_open" name="Parallel checks">
      <bpmn:incoming>F_gin_city_conakry_01</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_02</bpmn:outgoing>
      <bpmn:outgoing>F_gin_city_conakry_03</bpmn:outgoing>
      <bpmn:outgoing>F_gin_city_conakry_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_gin_city_conakry_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gin.city:conakry.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gin_city_conakry_02</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gin_city_conakry_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gin.city:conakry.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gin_city_conakry_03</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gin_city_conakry_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gin.city:conakry.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gin_city_conakry_04</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_gin_city_conakry_join" name="Checks complete">
      <bpmn:incoming>F_gin_city_conakry_05</bpmn:incoming>
      <bpmn:incoming>F_gin_city_conakry_06</bpmn:incoming>
      <bpmn:incoming>F_gin_city_conakry_07</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_gin_city_conakry_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_gin_city_conakry_08</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_gin_city_conakry_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_gin_city_conakry_09</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_10a</bpmn:outgoing>
      <bpmn:outgoing>F_gin_city_conakry_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_gin_city_conakry_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gin.city:conakry.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gin_city_conakry_10a</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gin_city_conakry_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gin.city:conakry.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gin_city_conakry_10b</bpmn:incoming>
      <bpmn:outgoing>F_gin_city_conakry_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_gin_city_conakry" name="Process complete">
      <bpmn:incoming>F_gin_city_conakry_11</bpmn:incoming>
      <bpmn:incoming>F_gin_city_conakry_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_gin_city_conakry_01" sourceRef="Start_gin_city_conakry" targetRef="GW_gin_city_conakry_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_02" sourceRef="GW_gin_city_conakry_open" targetRef="T_gin_city_conakry_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_03" sourceRef="GW_gin_city_conakry_open" targetRef="T_gin_city_conakry_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_04" sourceRef="GW_gin_city_conakry_open" targetRef="T_gin_city_conakry_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_05" sourceRef="T_gin_city_conakry_policy" targetRef="GW_gin_city_conakry_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_06" sourceRef="T_gin_city_conakry_budget" targetRef="GW_gin_city_conakry_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_07" sourceRef="T_gin_city_conakry_coord" targetRef="GW_gin_city_conakry_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_08" sourceRef="GW_gin_city_conakry_join" targetRef="T_gin_city_conakry_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_09" sourceRef="T_gin_city_conakry_review" targetRef="GW_gin_city_conakry_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_10a" sourceRef="GW_gin_city_conakry_risk" targetRef="T_gin_city_conakry_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_10b" sourceRef="GW_gin_city_conakry_risk" targetRef="T_gin_city_conakry_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_11" sourceRef="T_gin_city_conakry_publish" targetRef="End_gin_city_conakry">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gin_city_conakry_11b" sourceRef="T_gin_city_conakry_revise" targetRef="End_gin_city_conakry">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_gin_city_conakry">
    <bpmndi:BPMNPlane id="BPMNPlane_gin_city_conakry" bpmnElement="Collaboration_gin_city_conakry" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
