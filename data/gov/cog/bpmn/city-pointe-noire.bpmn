<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_cog_city_pointe_noire"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_cog_city_pointe_noire">
    <bpmn:participant id="Pool_cog_city_pointe_noire" name="Pointe-Noire (city:poi)" processRef="Process_cog_city_pointe_noire" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cog_city_pointe_noire" name="Pointe-Noire — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_cog_city_pointe_noire" name="Policy trigger
received"><bpmn:outgoing>F_cog_city_pointe_noire_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_cog_city_pointe_noire_open" name="Parallel checks">
      <bpmn:incoming>F_cog_city_pointe_noire_01</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_02</bpmn:outgoing>
      <bpmn:outgoing>F_cog_city_pointe_noire_03</bpmn:outgoing>
      <bpmn:outgoing>F_cog_city_pointe_noire_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_cog_city_pointe_noire_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cog.city:pointe-noire.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cog_city_pointe_noire_02</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cog_city_pointe_noire_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cog.city:pointe-noire.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cog_city_pointe_noire_03</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cog_city_pointe_noire_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cog.city:pointe-noire.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cog_city_pointe_noire_04</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_cog_city_pointe_noire_join" name="Checks complete">
      <bpmn:incoming>F_cog_city_pointe_noire_05</bpmn:incoming>
      <bpmn:incoming>F_cog_city_pointe_noire_06</bpmn:incoming>
      <bpmn:incoming>F_cog_city_pointe_noire_07</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_cog_city_pointe_noire_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_cog_city_pointe_noire_08</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_cog_city_pointe_noire_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_cog_city_pointe_noire_09</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_10a</bpmn:outgoing>
      <bpmn:outgoing>F_cog_city_pointe_noire_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_cog_city_pointe_noire_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cog.city:pointe-noire.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cog_city_pointe_noire_10a</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cog_city_pointe_noire_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cog.city:pointe-noire.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cog_city_pointe_noire_10b</bpmn:incoming>
      <bpmn:outgoing>F_cog_city_pointe_noire_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_cog_city_pointe_noire" name="Process complete">
      <bpmn:incoming>F_cog_city_pointe_noire_11</bpmn:incoming>
      <bpmn:incoming>F_cog_city_pointe_noire_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_01" sourceRef="Start_cog_city_pointe_noire" targetRef="GW_cog_city_pointe_noire_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_02" sourceRef="GW_cog_city_pointe_noire_open" targetRef="T_cog_city_pointe_noire_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_03" sourceRef="GW_cog_city_pointe_noire_open" targetRef="T_cog_city_pointe_noire_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_04" sourceRef="GW_cog_city_pointe_noire_open" targetRef="T_cog_city_pointe_noire_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_05" sourceRef="T_cog_city_pointe_noire_policy" targetRef="GW_cog_city_pointe_noire_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_06" sourceRef="T_cog_city_pointe_noire_budget" targetRef="GW_cog_city_pointe_noire_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_07" sourceRef="T_cog_city_pointe_noire_coord" targetRef="GW_cog_city_pointe_noire_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_08" sourceRef="GW_cog_city_pointe_noire_join" targetRef="T_cog_city_pointe_noire_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_09" sourceRef="T_cog_city_pointe_noire_review" targetRef="GW_cog_city_pointe_noire_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_10a" sourceRef="GW_cog_city_pointe_noire_risk" targetRef="T_cog_city_pointe_noire_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_10b" sourceRef="GW_cog_city_pointe_noire_risk" targetRef="T_cog_city_pointe_noire_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_11" sourceRef="T_cog_city_pointe_noire_publish" targetRef="End_cog_city_pointe_noire">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cog_city_pointe_noire_11b" sourceRef="T_cog_city_pointe_noire_revise" targetRef="End_cog_city_pointe_noire">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cog_city_pointe_noire">
    <bpmndi:BPMNPlane id="BPMNPlane_cog_city_pointe_noire" bpmnElement="Collaboration_cog_city_pointe_noire" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
