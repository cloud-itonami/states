<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_can_supreme_court"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_can_supreme_court">
    <bpmn:participant id="Pool_can_supreme_court" name="Supreme Court (c1a2s3c4)" processRef="Process_can_supreme_court" />
  </bpmn:collaboration>
  <bpmn:process id="Process_can_supreme_court" name="Supreme Court — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_can_supreme_court" name="Incident
reported"><bpmn:outgoing>F_can_supreme_court_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_can_supreme_court_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.supreme-court.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_supreme_court_01</bpmn:incoming>
      <bpmn:outgoing>F_can_supreme_court_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_can_supreme_court_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_can_supreme_court_02</bpmn:incoming>
      <bpmn:outgoing>F_can_supreme_court_03a</bpmn:outgoing>
      <bpmn:outgoing>F_can_supreme_court_03b</bpmn:outgoing>
      <bpmn:outgoing>F_can_supreme_court_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_can_supreme_court_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.supreme-court.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_supreme_court_03a</bpmn:incoming>
      <bpmn:outgoing>F_can_supreme_court_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_supreme_court_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.supreme-court.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_supreme_court_03b</bpmn:incoming>
      <bpmn:outgoing>F_can_supreme_court_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_supreme_court_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.supreme-court.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_supreme_court_03c</bpmn:incoming>
      <bpmn:outgoing>F_can_supreme_court_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_supreme_court_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.supreme-court.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_supreme_court_06</bpmn:incoming>
      <bpmn:outgoing>F_can_supreme_court_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_can_supreme_court" name="Incident resolved">
      <bpmn:incoming>F_can_supreme_court_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_can_supreme_court_01" sourceRef="Start_can_supreme_court" targetRef="T_can_supreme_court_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_02" sourceRef="T_can_supreme_court_triage" targetRef="GW_can_supreme_court_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_03a" sourceRef="GW_can_supreme_court_sev" targetRef="T_can_supreme_court_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_03b" sourceRef="GW_can_supreme_court_sev" targetRef="T_can_supreme_court_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_03c" sourceRef="GW_can_supreme_court_sev" targetRef="T_can_supreme_court_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_06" sourceRef="T_can_supreme_court_emergency" targetRef="T_can_supreme_court_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_06b" sourceRef="T_can_supreme_court_investigate" targetRef="T_can_supreme_court_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_06c" sourceRef="T_can_supreme_court_log" targetRef="T_can_supreme_court_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_supreme_court_07" sourceRef="T_can_supreme_court_report" targetRef="End_can_supreme_court">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_can_supreme_court">
    <bpmndi:BPMNPlane id="BPMNPlane_can_supreme_court" bpmnElement="Collaboration_can_supreme_court" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
