<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_can_province_newfoundland_and_labrador_st_johns"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_can_province_newfoundland_and_labrador_st_johns">
    <bpmn:participant id="Pool_can_province_newfoundland_and_labrador_st_johns" name="St. John's (province)" processRef="Process_can_province_newfoundland_and_labrador_st_johns" />
  </bpmn:collaboration>
  <bpmn:process id="Process_can_province_newfoundland_and_labrador_st_johns" name="St. John's — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_can_province_newfoundland_and_labrador_st_johns" name="Policy trigger
received"><bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_can_province_newfoundland_and_labrador_st_johns_open" name="Parallel checks">
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_01</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_02</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_03</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_can_province_newfoundland_and_labrador_st_johns_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:newfoundland-and-labrador:st-johns.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_02</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_newfoundland_and_labrador_st_johns_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:newfoundland-and-labrador:st-johns.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_03</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_newfoundland_and_labrador_st_johns_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:newfoundland-and-labrador:st-johns.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_04</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_can_province_newfoundland_and_labrador_st_johns_join" name="Checks complete">
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_05</bpmn:incoming>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_06</bpmn:incoming>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_07</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_can_province_newfoundland_and_labrador_st_johns_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_08</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_can_province_newfoundland_and_labrador_st_johns_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_09</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_10a</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_can_province_newfoundland_and_labrador_st_johns_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:newfoundland-and-labrador:st-johns.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_10a</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_newfoundland_and_labrador_st_johns_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:newfoundland-and-labrador:st-johns.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_10b</bpmn:incoming>
      <bpmn:outgoing>F_can_province_newfoundland_and_labrador_st_johns_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_can_province_newfoundland_and_labrador_st_johns" name="Process complete">
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_11</bpmn:incoming>
      <bpmn:incoming>F_can_province_newfoundland_and_labrador_st_johns_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_01" sourceRef="Start_can_province_newfoundland_and_labrador_st_johns" targetRef="GW_can_province_newfoundland_and_labrador_st_johns_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_02" sourceRef="GW_can_province_newfoundland_and_labrador_st_johns_open" targetRef="T_can_province_newfoundland_and_labrador_st_johns_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_03" sourceRef="GW_can_province_newfoundland_and_labrador_st_johns_open" targetRef="T_can_province_newfoundland_and_labrador_st_johns_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_04" sourceRef="GW_can_province_newfoundland_and_labrador_st_johns_open" targetRef="T_can_province_newfoundland_and_labrador_st_johns_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_05" sourceRef="T_can_province_newfoundland_and_labrador_st_johns_policy" targetRef="GW_can_province_newfoundland_and_labrador_st_johns_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_06" sourceRef="T_can_province_newfoundland_and_labrador_st_johns_budget" targetRef="GW_can_province_newfoundland_and_labrador_st_johns_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_07" sourceRef="T_can_province_newfoundland_and_labrador_st_johns_coord" targetRef="GW_can_province_newfoundland_and_labrador_st_johns_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_08" sourceRef="GW_can_province_newfoundland_and_labrador_st_johns_join" targetRef="T_can_province_newfoundland_and_labrador_st_johns_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_09" sourceRef="T_can_province_newfoundland_and_labrador_st_johns_review" targetRef="GW_can_province_newfoundland_and_labrador_st_johns_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_10a" sourceRef="GW_can_province_newfoundland_and_labrador_st_johns_risk" targetRef="T_can_province_newfoundland_and_labrador_st_johns_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_10b" sourceRef="GW_can_province_newfoundland_and_labrador_st_johns_risk" targetRef="T_can_province_newfoundland_and_labrador_st_johns_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_11" sourceRef="T_can_province_newfoundland_and_labrador_st_johns_publish" targetRef="End_can_province_newfoundland_and_labrador_st_johns">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_newfoundland_and_labrador_st_johns_11b" sourceRef="T_can_province_newfoundland_and_labrador_st_johns_revise" targetRef="End_can_province_newfoundland_and_labrador_st_johns">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_can_province_newfoundland_and_labrador_st_johns">
    <bpmndi:BPMNPlane id="BPMNPlane_can_province_newfoundland_and_labrador_st_johns" bpmnElement="Collaboration_can_province_newfoundland_and_labrador_st_johns" />
