<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_can_territory_northwest_territories_yellowknife"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_can_territory_northwest_territories_yellowknife">
    <bpmn:participant id="Pool_can_territory_northwest_territories_yellowknife" name="Yellowknife (territor)" processRef="Process_can_territory_northwest_territories_yellowknife" />
  </bpmn:collaboration>
  <bpmn:process id="Process_can_territory_northwest_territories_yellowknife" name="Yellowknife — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_can_territory_northwest_territories_yellowknife" name="Policy trigger
received"><bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_can_territory_northwest_territories_yellowknife_open" name="Parallel checks">
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_01</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_02</bpmn:outgoing>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_03</bpmn:outgoing>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_can_territory_northwest_territories_yellowknife_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.territory:northwest-territories:yellowknife.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_02</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_territory_northwest_territories_yellowknife_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.territory:northwest-territories:yellowknife.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_03</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_territory_northwest_territories_yellowknife_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.territory:northwest-territories:yellowknife.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_04</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_can_territory_northwest_territories_yellowknife_join" name="Checks complete">
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_05</bpmn:incoming>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_06</bpmn:incoming>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_07</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_can_territory_northwest_territories_yellowknife_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_08</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_can_territory_northwest_territories_yellowknife_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_09</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_10a</bpmn:outgoing>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_can_territory_northwest_territories_yellowknife_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.territory:northwest-territories:yellowknife.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_10a</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_territory_northwest_territories_yellowknife_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.territory:northwest-territories:yellowknife.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_10b</bpmn:incoming>
      <bpmn:outgoing>F_can_territory_northwest_territories_yellowknife_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_can_territory_northwest_territories_yellowknife" name="Process complete">
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_11</bpmn:incoming>
      <bpmn:incoming>F_can_territory_northwest_territories_yellowknife_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_01" sourceRef="Start_can_territory_northwest_territories_yellowknife" targetRef="GW_can_territory_northwest_territories_yellowknife_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_02" sourceRef="GW_can_territory_northwest_territories_yellowknife_open" targetRef="T_can_territory_northwest_territories_yellowknife_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_03" sourceRef="GW_can_territory_northwest_territories_yellowknife_open" targetRef="T_can_territory_northwest_territories_yellowknife_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_04" sourceRef="GW_can_territory_northwest_territories_yellowknife_open" targetRef="T_can_territory_northwest_territories_yellowknife_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_05" sourceRef="T_can_territory_northwest_territories_yellowknife_policy" targetRef="GW_can_territory_northwest_territories_yellowknife_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_06" sourceRef="T_can_territory_northwest_territories_yellowknife_budget" targetRef="GW_can_territory_northwest_territories_yellowknife_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_07" sourceRef="T_can_territory_northwest_territories_yellowknife_coord" targetRef="GW_can_territory_northwest_territories_yellowknife_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_08" sourceRef="GW_can_territory_northwest_territories_yellowknife_join" targetRef="T_can_territory_northwest_territories_yellowknife_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_09" sourceRef="T_can_territory_northwest_territories_yellowknife_review" targetRef="GW_can_territory_northwest_territories_yellowknife_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_10a" sourceRef="GW_can_territory_northwest_territories_yellowknife_risk" targetRef="T_can_territory_northwest_territories_yellowknife_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_10b" sourceRef="GW_can_territory_northwest_territories_yellowknife_risk" targetRef="T_can_territory_northwest_territories_yellowknife_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_11" sourceRef="T_can_territory_northwest_territories_yellowknife_publish" targetRef="End_can_territory_northwest_territories_yellowknife">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_territory_northwest_territories_yellowknife_11b" sourceRef="T_can_territory_northwest_territories_yellowknife_revise" targetRef="End_can_territory_northwest_territories_yellowknife">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_can_territory_northwest_territories_yellowknife">
    <bpmndi:BPMNPlane id="BPMNPlane_can_territory_northwest_territories_yellowknife" bpmnElement="Collaboration_can_territory_northwest_territories_yellowknife" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
