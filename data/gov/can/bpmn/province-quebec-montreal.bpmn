<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_can_province_quebec_montreal"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_can_province_quebec_montreal">
    <bpmn:participant id="Pool_can_province_quebec_montreal" name="Montreal (province)" processRef="Process_can_province_quebec_montreal" />
  </bpmn:collaboration>
  <bpmn:process id="Process_can_province_quebec_montreal" name="Montreal — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_can_province_quebec_montreal" name="Policy trigger
received"><bpmn:outgoing>F_can_province_quebec_montreal_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_can_province_quebec_montreal_open" name="Parallel checks">
      <bpmn:incoming>F_can_province_quebec_montreal_01</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_02</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_quebec_montreal_03</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_quebec_montreal_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_can_province_quebec_montreal_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:quebec:montreal.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_quebec_montreal_02</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_quebec_montreal_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:quebec:montreal.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_quebec_montreal_03</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_quebec_montreal_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:quebec:montreal.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_quebec_montreal_04</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_can_province_quebec_montreal_join" name="Checks complete">
      <bpmn:incoming>F_can_province_quebec_montreal_05</bpmn:incoming>
      <bpmn:incoming>F_can_province_quebec_montreal_06</bpmn:incoming>
      <bpmn:incoming>F_can_province_quebec_montreal_07</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_can_province_quebec_montreal_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_quebec_montreal_08</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_can_province_quebec_montreal_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_can_province_quebec_montreal_09</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_10a</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_quebec_montreal_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_can_province_quebec_montreal_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:quebec:montreal.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_quebec_montreal_10a</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_quebec_montreal_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:quebec:montreal.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_quebec_montreal_10b</bpmn:incoming>
      <bpmn:outgoing>F_can_province_quebec_montreal_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_can_province_quebec_montreal" name="Process complete">
      <bpmn:incoming>F_can_province_quebec_montreal_11</bpmn:incoming>
      <bpmn:incoming>F_can_province_quebec_montreal_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_01" sourceRef="Start_can_province_quebec_montreal" targetRef="GW_can_province_quebec_montreal_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_02" sourceRef="GW_can_province_quebec_montreal_open" targetRef="T_can_province_quebec_montreal_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_03" sourceRef="GW_can_province_quebec_montreal_open" targetRef="T_can_province_quebec_montreal_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_04" sourceRef="GW_can_province_quebec_montreal_open" targetRef="T_can_province_quebec_montreal_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_05" sourceRef="T_can_province_quebec_montreal_policy" targetRef="GW_can_province_quebec_montreal_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_06" sourceRef="T_can_province_quebec_montreal_budget" targetRef="GW_can_province_quebec_montreal_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_07" sourceRef="T_can_province_quebec_montreal_coord" targetRef="GW_can_province_quebec_montreal_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_08" sourceRef="GW_can_province_quebec_montreal_join" targetRef="T_can_province_quebec_montreal_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_09" sourceRef="T_can_province_quebec_montreal_review" targetRef="GW_can_province_quebec_montreal_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_10a" sourceRef="GW_can_province_quebec_montreal_risk" targetRef="T_can_province_quebec_montreal_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_10b" sourceRef="GW_can_province_quebec_montreal_risk" targetRef="T_can_province_quebec_montreal_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_11" sourceRef="T_can_province_quebec_montreal_publish" targetRef="End_can_province_quebec_montreal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_quebec_montreal_11b" sourceRef="T_can_province_quebec_montreal_revise" targetRef="End_can_province_quebec_montreal">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_can_province_quebec_montreal">
    <bpmndi:BPMNPlane id="BPMNPlane_can_province_quebec_montreal" bpmnElement="Collaboration_can_province_quebec_montreal" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
