    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_10a" sourceRef="GW_can_province_alberta_edmonton_risk" targetRef="T_can_province_alberta_edmonton_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
