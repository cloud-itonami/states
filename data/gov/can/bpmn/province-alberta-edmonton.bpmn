      <bpmn:incoming>F_can_province_alberta_edmonton_06</bpmn:incoming>
      <bpmn:incoming>F_can_province_alberta_edmonton_07</bpmn:incoming>
      <bpmn:outgoing>F_can_province_alberta_edmonton_08</bpmn:outgoing>
