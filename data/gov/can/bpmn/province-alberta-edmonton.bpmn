    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_10b" sourceRef="GW_can_province_alberta_edmonton_risk" targetRef="T_can_province_alberta_edmonton_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_11" sourceRef="T_can_province_alberta_edmonton_publish" targetRef="End_can_province_alberta_edmonton">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_11b" sourceRef="T_can_province_alberta_edmonton_revise" targetRef="End_can_province_alberta_edmonton">
