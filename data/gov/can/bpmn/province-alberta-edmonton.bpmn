    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_can_province_alberta_edmonton">
    <bpmn:participant id="Pool_can_province_alberta_edmonton" name="Edmonton (province)" processRef="Process_can_province_alberta_edmonton" />
  </bpmn:collaboration>
  <bpmn:process id="Process_can_province_alberta_edmonton" name="Edmonton — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_can_province_alberta_edmonton" name="Policy trigger
received"><bpmn:outgoing>F_can_province_alberta_edmonton_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_can_province_alberta_edmonton_open" name="Parallel checks">
