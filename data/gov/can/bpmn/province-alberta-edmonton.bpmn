    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_02" sourceRef="GW_can_province_alberta_edmonton_open" targetRef="T_can_province_alberta_edmonton_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_03" sourceRef="GW_can_province_alberta_edmonton_open" targetRef="T_can_province_alberta_edmonton_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_04" sourceRef="GW_can_province_alberta_edmonton_open" targetRef="T_can_province_alberta_edmonton_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_05" sourceRef="T_can_province_alberta_edmonton_policy" targetRef="GW_can_province_alberta_edmonton_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_06" sourceRef="T_can_province_alberta_edmonton_budget" targetRef="GW_can_province_alberta_edmonton_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_07" sourceRef="T_can_province_alberta_edmonton_coord" targetRef="GW_can_province_alberta_edmonton_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_08" sourceRef="GW_can_province_alberta_edmonton_join" targetRef="T_can_province_alberta_edmonton_review">
    </bpmn:sequenceFlow>
