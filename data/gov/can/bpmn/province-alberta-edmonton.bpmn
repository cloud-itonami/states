      <bpmn:outgoing>F_can_province_alberta_edmonton_03</bpmn:outgoing>
      <bpmn:outgoing>F_can_province_alberta_edmonton_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_can_province_alberta_edmonton_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:alberta:edmonton.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_alberta_edmonton_02</bpmn:incoming>
      <bpmn:outgoing>F_can_province_alberta_edmonton_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_alberta_edmonton_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.can.province:alberta:edmonton.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_alberta_edmonton_03</bpmn:incoming>
      <bpmn:outgoing>F_can_province_alberta_edmonton_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_can_province_alberta_edmonton_coord" name="Inter-Agency
