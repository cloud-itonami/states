      <bpmn:incoming>F_can_province_alberta_edmonton_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_can_province_alberta_edmonton_01" sourceRef="Start_can_province_alberta_edmonton" targetRef="GW_can_province_alberta_edmonton_open">
