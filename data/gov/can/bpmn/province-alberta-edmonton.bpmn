        <zeebe:taskDefinition type="gov.can.province:alberta:edmonton.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_can_province_alberta_edmonton_04</bpmn:incoming>
