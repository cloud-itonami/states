<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mmr_city_naypyidaw"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mmr_city_naypyidaw">
    <bpmn:participant id="Pool_mmr_city_naypyidaw" name="Naypyidaw (city:nay)" processRef="Process_mmr_city_naypyidaw" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mmr_city_naypyidaw" name="Naypyidaw — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mmr_city_naypyidaw" name="Policy trigger
received"><bpmn:outgoing>F_mmr_city_naypyidaw_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mmr_city_naypyidaw_open" name="Parallel checks">
      <bpmn:incoming>F_mmr_city_naypyidaw_01</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_02</bpmn:outgoing>
      <bpmn:outgoing>F_mmr_city_naypyidaw_03</bpmn:outgoing>
      <bpmn:outgoing>F_mmr_city_naypyidaw_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mmr_city_naypyidaw_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mmr.city:naypyidaw.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mmr_city_naypyidaw_02</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mmr_city_naypyidaw_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mmr.city:naypyidaw.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mmr_city_naypyidaw_03</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mmr_city_naypyidaw_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mmr.city:naypyidaw.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mmr_city_naypyidaw_04</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mmr_city_naypyidaw_join" name="Checks complete">
      <bpmn:incoming>F_mmr_city_naypyidaw_05</bpmn:incoming>
      <bpmn:incoming>F_mmr_city_naypyidaw_06</bpmn:incoming>
      <bpmn:incoming>F_mmr_city_naypyidaw_07</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mmr_city_naypyidaw_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mmr_city_naypyidaw_08</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mmr_city_naypyidaw_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mmr_city_naypyidaw_09</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mmr_city_naypyidaw_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mmr_city_naypyidaw_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mmr.city:naypyidaw.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mmr_city_naypyidaw_10a</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mmr_city_naypyidaw_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mmr.city:naypyidaw.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mmr_city_naypyidaw_10b</bpmn:incoming>
      <bpmn:outgoing>F_mmr_city_naypyidaw_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mmr_city_naypyidaw" name="Process complete">
      <bpmn:incoming>F_mmr_city_naypyidaw_11</bpmn:incoming>
      <bpmn:incoming>F_mmr_city_naypyidaw_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_01" sourceRef="Start_mmr_city_naypyidaw" targetRef="GW_mmr_city_naypyidaw_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_02" sourceRef="GW_mmr_city_naypyidaw_open" targetRef="T_mmr_city_naypyidaw_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_03" sourceRef="GW_mmr_city_naypyidaw_open" targetRef="T_mmr_city_naypyidaw_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_04" sourceRef="GW_mmr_city_naypyidaw_open" targetRef="T_mmr_city_naypyidaw_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_05" sourceRef="T_mmr_city_naypyidaw_policy" targetRef="GW_mmr_city_naypyidaw_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_06" sourceRef="T_mmr_city_naypyidaw_budget" targetRef="GW_mmr_city_naypyidaw_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_07" sourceRef="T_mmr_city_naypyidaw_coord" targetRef="GW_mmr_city_naypyidaw_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_08" sourceRef="GW_mmr_city_naypyidaw_join" targetRef="T_mmr_city_naypyidaw_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_09" sourceRef="T_mmr_city_naypyidaw_review" targetRef="GW_mmr_city_naypyidaw_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_10a" sourceRef="GW_mmr_city_naypyidaw_risk" targetRef="T_mmr_city_naypyidaw_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_10b" sourceRef="GW_mmr_city_naypyidaw_risk" targetRef="T_mmr_city_naypyidaw_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_11" sourceRef="T_mmr_city_naypyidaw_publish" targetRef="End_mmr_city_naypyidaw">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mmr_city_naypyidaw_11b" sourceRef="T_mmr_city_naypyidaw_revise" targetRef="End_mmr_city_naypyidaw">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mmr_city_naypyidaw">
    <bpmndi:BPMNPlane id="BPMNPlane_mmr_city_naypyidaw" bpmnElement="Collaboration_mmr_city_naypyidaw" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
