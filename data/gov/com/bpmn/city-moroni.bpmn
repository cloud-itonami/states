<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_com_city_moroni"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_com_city_moroni">
    <bpmn:participant id="Pool_com_city_moroni" name="Moroni (city:mor)" processRef="Process_com_city_moroni" />
  </bpmn:collaboration>
  <bpmn:process id="Process_com_city_moroni" name="Moroni — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_com_city_moroni" name="Policy trigger
received"><bpmn:outgoing>F_com_city_moroni_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_com_city_moroni_open" name="Parallel checks">
      <bpmn:incoming>F_com_city_moroni_01</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_02</bpmn:outgoing>
      <bpmn:outgoing>F_com_city_moroni_03</bpmn:outgoing>
      <bpmn:outgoing>F_com_city_moroni_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_com_city_moroni_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.com.city:moroni.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_com_city_moroni_02</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_com_city_moroni_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.com.city:moroni.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_com_city_moroni_03</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_com_city_moroni_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.com.city:moroni.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_com_city_moroni_04</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_com_city_moroni_join" name="Checks complete">
      <bpmn:incoming>F_com_city_moroni_05</bpmn:incoming>
      <bpmn:incoming>F_com_city_moroni_06</bpmn:incoming>
      <bpmn:incoming>F_com_city_moroni_07</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_com_city_moroni_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_com_city_moroni_08</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_com_city_moroni_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_com_city_moroni_09</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_10a</bpmn:outgoing>
      <bpmn:outgoing>F_com_city_moroni_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_com_city_moroni_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.com.city:moroni.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_com_city_moroni_10a</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_com_city_moroni_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.com.city:moroni.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_com_city_moroni_10b</bpmn:incoming>
      <bpmn:outgoing>F_com_city_moroni_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_com_city_moroni" name="Process complete">
      <bpmn:incoming>F_com_city_moroni_11</bpmn:incoming>
      <bpmn:incoming>F_com_city_moroni_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_com_city_moroni_01" sourceRef="Start_com_city_moroni" targetRef="GW_com_city_moroni_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_02" sourceRef="GW_com_city_moroni_open" targetRef="T_com_city_moroni_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_03" sourceRef="GW_com_city_moroni_open" targetRef="T_com_city_moroni_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_04" sourceRef="GW_com_city_moroni_open" targetRef="T_com_city_moroni_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_05" sourceRef="T_com_city_moroni_policy" targetRef="GW_com_city_moroni_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_06" sourceRef="T_com_city_moroni_budget" targetRef="GW_com_city_moroni_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_07" sourceRef="T_com_city_moroni_coord" targetRef="GW_com_city_moroni_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_08" sourceRef="GW_com_city_moroni_join" targetRef="T_com_city_moroni_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_09" sourceRef="T_com_city_moroni_review" targetRef="GW_com_city_moroni_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_10a" sourceRef="GW_com_city_moroni_risk" targetRef="T_com_city_moroni_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_10b" sourceRef="GW_com_city_moroni_risk" targetRef="T_com_city_moroni_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_11" sourceRef="T_com_city_moroni_publish" targetRef="End_com_city_moroni">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_com_city_moroni_11b" sourceRef="T_com_city_moroni_revise" targetRef="End_com_city_moroni">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_com_city_moroni">
    <bpmndi:BPMNPlane id="BPMNPlane_com_city_moroni" bpmnElement="Collaboration_com_city_moroni" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
