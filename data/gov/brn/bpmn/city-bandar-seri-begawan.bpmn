    id="Definitions_brn_city_bandar_seri_begawan"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_brn_city_bandar_seri_begawan">
    <bpmn:participant id="Pool_brn_city_bandar_seri_begawan" name="Bandar Seri Begawan (city:ban)" processRef="Process_brn_city_bandar_seri_begawan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_brn_city_bandar_seri_begawan" name="Bandar Seri Begawan — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_brn_city_bandar_seri_begawan" name="Policy trigger
received"><bpmn:outgoing>F_brn_city_bandar_seri_begawan_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_brn_city_bandar_seri_begawan_open" name="Parallel checks">
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_01</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_02</bpmn:outgoing>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_03</bpmn:outgoing>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_brn_city_bandar_seri_begawan_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.brn.city:bandar-seri-begawan.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_02</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_brn_city_bandar_seri_begawan_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.brn.city:bandar-seri-begawan.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_03</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_brn_city_bandar_seri_begawan_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.brn.city:bandar-seri-begawan.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_04</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_brn_city_bandar_seri_begawan_join" name="Checks complete">
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_05</bpmn:incoming>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_06</bpmn:incoming>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_07</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_brn_city_bandar_seri_begawan_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_08</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_brn_city_bandar_seri_begawan_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_09</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_10a</bpmn:outgoing>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_brn_city_bandar_seri_begawan_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.brn.city:bandar-seri-begawan.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_10a</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_brn_city_bandar_seri_begawan_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.brn.city:bandar-seri-begawan.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_10b</bpmn:incoming>
      <bpmn:outgoing>F_brn_city_bandar_seri_begawan_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_brn_city_bandar_seri_begawan" name="Process complete">
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_11</bpmn:incoming>
      <bpmn:incoming>F_brn_city_bandar_seri_begawan_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_01" sourceRef="Start_brn_city_bandar_seri_begawan" targetRef="GW_brn_city_bandar_seri_begawan_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_02" sourceRef="GW_brn_city_bandar_seri_begawan_open" targetRef="T_brn_city_bandar_seri_begawan_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_03" sourceRef="GW_brn_city_bandar_seri_begawan_open" targetRef="T_brn_city_bandar_seri_begawan_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_04" sourceRef="GW_brn_city_bandar_seri_begawan_open" targetRef="T_brn_city_bandar_seri_begawan_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_05" sourceRef="T_brn_city_bandar_seri_begawan_policy" targetRef="GW_brn_city_bandar_seri_begawan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_06" sourceRef="T_brn_city_bandar_seri_begawan_budget" targetRef="GW_brn_city_bandar_seri_begawan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_07" sourceRef="T_brn_city_bandar_seri_begawan_coord" targetRef="GW_brn_city_bandar_seri_begawan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_08" sourceRef="GW_brn_city_bandar_seri_begawan_join" targetRef="T_brn_city_bandar_seri_begawan_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_09" sourceRef="T_brn_city_bandar_seri_begawan_review" targetRef="GW_brn_city_bandar_seri_begawan_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_10a" sourceRef="GW_brn_city_bandar_seri_begawan_risk" targetRef="T_brn_city_bandar_seri_begawan_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_10b" sourceRef="GW_brn_city_bandar_seri_begawan_risk" targetRef="T_brn_city_bandar_seri_begawan_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_11" sourceRef="T_brn_city_bandar_seri_begawan_publish" targetRef="End_brn_city_bandar_seri_begawan">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_brn_city_bandar_seri_begawan_11b" sourceRef="T_brn_city_bandar_seri_begawan_revise" targetRef="End_brn_city_bandar_seri_begawan">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_brn_city_bandar_seri_begawan">
    <bpmndi:BPMNPlane id="BPMNPlane_brn_city_bandar_seri_begawan" bpmnElement="Collaboration_brn_city_bandar_seri_begawan" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
