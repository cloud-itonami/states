<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_eri_city_asmara"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_eri_city_asmara">
    <bpmn:participant id="Pool_eri_city_asmara" name="Asmara (city:asm)" processRef="Process_eri_city_asmara" />
  </bpmn:collaboration>
  <bpmn:process id="Process_eri_city_asmara" name="Asmara — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_eri_city_asmara" name="Policy trigger
received"><bpmn:outgoing>F_eri_city_asmara_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_eri_city_asmara_open" name="Parallel checks">
      <bpmn:incoming>F_eri_city_asmara_01</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_02</bpmn:outgoing>
      <bpmn:outgoing>F_eri_city_asmara_03</bpmn:outgoing>
      <bpmn:outgoing>F_eri_city_asmara_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_eri_city_asmara_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eri.city:asmara.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eri_city_asmara_02</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eri_city_asmara_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eri.city:asmara.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eri_city_asmara_03</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eri_city_asmara_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eri.city:asmara.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eri_city_asmara_04</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_eri_city_asmara_join" name="Checks complete">
      <bpmn:incoming>F_eri_city_asmara_05</bpmn:incoming>
      <bpmn:incoming>F_eri_city_asmara_06</bpmn:incoming>
      <bpmn:incoming>F_eri_city_asmara_07</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_eri_city_asmara_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_eri_city_asmara_08</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_eri_city_asmara_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_eri_city_asmara_09</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_10a</bpmn:outgoing>
      <bpmn:outgoing>F_eri_city_asmara_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_eri_city_asmara_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eri.city:asmara.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eri_city_asmara_10a</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eri_city_asmara_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eri.city:asmara.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eri_city_asmara_10b</bpmn:incoming>
      <bpmn:outgoing>F_eri_city_asmara_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_eri_city_asmara" name="Process complete">
      <bpmn:incoming>F_eri_city_asmara_11</bpmn:incoming>
      <bpmn:incoming>F_eri_city_asmara_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_eri_city_asmara_01" sourceRef="Start_eri_city_asmara" targetRef="GW_eri_city_asmara_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_02" sourceRef="GW_eri_city_asmara_open" targetRef="T_eri_city_asmara_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_03" sourceRef="GW_eri_city_asmara_open" targetRef="T_eri_city_asmara_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_04" sourceRef="GW_eri_city_asmara_open" targetRef="T_eri_city_asmara_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_05" sourceRef="T_eri_city_asmara_policy" targetRef="GW_eri_city_asmara_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_06" sourceRef="T_eri_city_asmara_budget" targetRef="GW_eri_city_asmara_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_07" sourceRef="T_eri_city_asmara_coord" targetRef="GW_eri_city_asmara_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_08" sourceRef="GW_eri_city_asmara_join" targetRef="T_eri_city_asmara_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_09" sourceRef="T_eri_city_asmara_review" targetRef="GW_eri_city_asmara_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_10a" sourceRef="GW_eri_city_asmara_risk" targetRef="T_eri_city_asmara_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_10b" sourceRef="GW_eri_city_asmara_risk" targetRef="T_eri_city_asmara_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_11" sourceRef="T_eri_city_asmara_publish" targetRef="End_eri_city_asmara">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eri_city_asmara_11b" sourceRef="T_eri_city_asmara_revise" targetRef="End_eri_city_asmara">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_eri_city_asmara">
    <bpmndi:BPMNPlane id="BPMNPlane_eri_city_asmara" bpmnElement="Collaboration_eri_city_asmara" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
