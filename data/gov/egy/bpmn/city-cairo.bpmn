<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_egy_city_cairo"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_egy_city_cairo">
    <bpmn:participant id="Pool_egy_city_cairo" name="Cairo (city:cai)" processRef="Process_egy_city_cairo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_egy_city_cairo" name="Cairo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_egy_city_cairo" name="Policy trigger
received"><bpmn:outgoing>F_egy_city_cairo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_egy_city_cairo_open" name="Parallel checks">
      <bpmn:incoming>F_egy_city_cairo_01</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_02</bpmn:outgoing>
      <bpmn:outgoing>F_egy_city_cairo_03</bpmn:outgoing>
      <bpmn:outgoing>F_egy_city_cairo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_egy_city_cairo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.egy.city:cairo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_egy_city_cairo_02</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_egy_city_cairo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.egy.city:cairo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_egy_city_cairo_03</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_egy_city_cairo_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.egy.city:cairo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_egy_city_cairo_04</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_egy_city_cairo_join" name="Checks complete">
      <bpmn:incoming>F_egy_city_cairo_05</bpmn:incoming>
      <bpmn:incoming>F_egy_city_cairo_06</bpmn:incoming>
      <bpmn:incoming>F_egy_city_cairo_07</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_egy_city_cairo_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_egy_city_cairo_08</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_egy_city_cairo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_egy_city_cairo_09</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_egy_city_cairo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_egy_city_cairo_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.egy.city:cairo.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_egy_city_cairo_10a</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_egy_city_cairo_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.egy.city:cairo.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_egy_city_cairo_10b</bpmn:incoming>
      <bpmn:outgoing>F_egy_city_cairo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_egy_city_cairo" name="Process complete">
      <bpmn:incoming>F_egy_city_cairo_11</bpmn:incoming>
      <bpmn:incoming>F_egy_city_cairo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_egy_city_cairo_01" sourceRef="Start_egy_city_cairo" targetRef="GW_egy_city_cairo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_02" sourceRef="GW_egy_city_cairo_open" targetRef="T_egy_city_cairo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_03" sourceRef="GW_egy_city_cairo_open" targetRef="T_egy_city_cairo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_04" sourceRef="GW_egy_city_cairo_open" targetRef="T_egy_city_cairo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_05" sourceRef="T_egy_city_cairo_policy" targetRef="GW_egy_city_cairo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_06" sourceRef="T_egy_city_cairo_budget" targetRef="GW_egy_city_cairo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_07" sourceRef="T_egy_city_cairo_coord" targetRef="GW_egy_city_cairo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_08" sourceRef="GW_egy_city_cairo_join" targetRef="T_egy_city_cairo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_09" sourceRef="T_egy_city_cairo_review" targetRef="GW_egy_city_cairo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_10a" sourceRef="GW_egy_city_cairo_risk" targetRef="T_egy_city_cairo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_10b" sourceRef="GW_egy_city_cairo_risk" targetRef="T_egy_city_cairo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_11" sourceRef="T_egy_city_cairo_publish" targetRef="End_egy_city_cairo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_egy_city_cairo_11b" sourceRef="T_egy_city_cairo_revise" targetRef="End_egy_city_cairo">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_egy_city_cairo">
    <bpmndi:BPMNPlane id="BPMNPlane_egy_city_cairo" bpmnElement="Collaboration_egy_city_cairo" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
