<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_tha_city_chiang_mai"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_tha_city_chiang_mai">
    <bpmn:participant id="Pool_tha_city_chiang_mai" name="Chiang Mai (city:chi)" processRef="Process_tha_city_chiang_mai" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tha_city_chiang_mai" name="Chiang Mai — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_tha_city_chiang_mai" name="Policy trigger
received"><bpmn:outgoing>F_tha_city_chiang_mai_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_tha_city_chiang_mai_open" name="Parallel checks">
      <bpmn:incoming>F_tha_city_chiang_mai_01</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_02</bpmn:outgoing>
      <bpmn:outgoing>F_tha_city_chiang_mai_03</bpmn:outgoing>
      <bpmn:outgoing>F_tha_city_chiang_mai_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_tha_city_chiang_mai_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tha.city:chiang-mai.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tha_city_chiang_mai_02</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tha_city_chiang_mai_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tha.city:chiang-mai.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tha_city_chiang_mai_03</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tha_city_chiang_mai_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tha.city:chiang-mai.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tha_city_chiang_mai_04</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_tha_city_chiang_mai_join" name="Checks complete">
      <bpmn:incoming>F_tha_city_chiang_mai_05</bpmn:incoming>
      <bpmn:incoming>F_tha_city_chiang_mai_06</bpmn:incoming>
      <bpmn:incoming>F_tha_city_chiang_mai_07</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_tha_city_chiang_mai_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_tha_city_chiang_mai_08</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_tha_city_chiang_mai_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_tha_city_chiang_mai_09</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_10a</bpmn:outgoing>
      <bpmn:outgoing>F_tha_city_chiang_mai_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_tha_city_chiang_mai_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tha.city:chiang-mai.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tha_city_chiang_mai_10a</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tha_city_chiang_mai_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tha.city:chiang-mai.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tha_city_chiang_mai_10b</bpmn:incoming>
      <bpmn:outgoing>F_tha_city_chiang_mai_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_tha_city_chiang_mai" name="Process complete">
      <bpmn:incoming>F_tha_city_chiang_mai_11</bpmn:incoming>
      <bpmn:incoming>F_tha_city_chiang_mai_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_01" sourceRef="Start_tha_city_chiang_mai" targetRef="GW_tha_city_chiang_mai_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_02" sourceRef="GW_tha_city_chiang_mai_open" targetRef="T_tha_city_chiang_mai_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_03" sourceRef="GW_tha_city_chiang_mai_open" targetRef="T_tha_city_chiang_mai_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_04" sourceRef="GW_tha_city_chiang_mai_open" targetRef="T_tha_city_chiang_mai_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_05" sourceRef="T_tha_city_chiang_mai_policy" targetRef="GW_tha_city_chiang_mai_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_06" sourceRef="T_tha_city_chiang_mai_budget" targetRef="GW_tha_city_chiang_mai_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_07" sourceRef="T_tha_city_chiang_mai_coord" targetRef="GW_tha_city_chiang_mai_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_08" sourceRef="GW_tha_city_chiang_mai_join" targetRef="T_tha_city_chiang_mai_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_09" sourceRef="T_tha_city_chiang_mai_review" targetRef="GW_tha_city_chiang_mai_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_10a" sourceRef="GW_tha_city_chiang_mai_risk" targetRef="T_tha_city_chiang_mai_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_10b" sourceRef="GW_tha_city_chiang_mai_risk" targetRef="T_tha_city_chiang_mai_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_11" sourceRef="T_tha_city_chiang_mai_publish" targetRef="End_tha_city_chiang_mai">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tha_city_chiang_mai_11b" sourceRef="T_tha_city_chiang_mai_revise" targetRef="End_tha_city_chiang_mai">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_tha_city_chiang_mai">
    <bpmndi:BPMNPlane id="BPMNPlane_tha_city_chiang_mai" bpmnElement="Collaboration_tha_city_chiang_mai" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
