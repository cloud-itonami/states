<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_lca_city_castries"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_lca_city_castries">
    <bpmn:participant id="Pool_lca_city_castries" name="Castries (city:cas)" processRef="Process_lca_city_castries" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lca_city_castries" name="Castries — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_lca_city_castries" name="Policy trigger
received"><bpmn:outgoing>F_lca_city_castries_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_lca_city_castries_open" name="Parallel checks">
      <bpmn:incoming>F_lca_city_castries_01</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_02</bpmn:outgoing>
      <bpmn:outgoing>F_lca_city_castries_03</bpmn:outgoing>
      <bpmn:outgoing>F_lca_city_castries_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_lca_city_castries_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lca.city:castries.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lca_city_castries_02</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lca_city_castries_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lca.city:castries.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lca_city_castries_03</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lca_city_castries_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lca.city:castries.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lca_city_castries_04</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_lca_city_castries_join" name="Checks complete">
      <bpmn:incoming>F_lca_city_castries_05</bpmn:incoming>
      <bpmn:incoming>F_lca_city_castries_06</bpmn:incoming>
      <bpmn:incoming>F_lca_city_castries_07</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_lca_city_castries_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_lca_city_castries_08</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_lca_city_castries_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_lca_city_castries_09</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_10a</bpmn:outgoing>
      <bpmn:outgoing>F_lca_city_castries_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_lca_city_castries_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lca.city:castries.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lca_city_castries_10a</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lca_city_castries_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lca.city:castries.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lca_city_castries_10b</bpmn:incoming>
      <bpmn:outgoing>F_lca_city_castries_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_lca_city_castries" name="Process complete">
      <bpmn:incoming>F_lca_city_castries_11</bpmn:incoming>
      <bpmn:incoming>F_lca_city_castries_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_lca_city_castries_01" sourceRef="Start_lca_city_castries" targetRef="GW_lca_city_castries_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_02" sourceRef="GW_lca_city_castries_open" targetRef="T_lca_city_castries_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_03" sourceRef="GW_lca_city_castries_open" targetRef="T_lca_city_castries_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_04" sourceRef="GW_lca_city_castries_open" targetRef="T_lca_city_castries_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_05" sourceRef="T_lca_city_castries_policy" targetRef="GW_lca_city_castries_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_06" sourceRef="T_lca_city_castries_budget" targetRef="GW_lca_city_castries_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_07" sourceRef="T_lca_city_castries_coord" targetRef="GW_lca_city_castries_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_08" sourceRef="GW_lca_city_castries_join" targetRef="T_lca_city_castries_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_09" sourceRef="T_lca_city_castries_review" targetRef="GW_lca_city_castries_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_10a" sourceRef="GW_lca_city_castries_risk" targetRef="T_lca_city_castries_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_10b" sourceRef="GW_lca_city_castries_risk" targetRef="T_lca_city_castries_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_11" sourceRef="T_lca_city_castries_publish" targetRef="End_lca_city_castries">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lca_city_castries_11b" sourceRef="T_lca_city_castries_revise" targetRef="End_lca_city_castries">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_lca_city_castries">
    <bpmndi:BPMNPlane id="BPMNPlane_lca_city_castries" bpmnElement="Collaboration_lca_city_castries" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
