<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_kor_military_ministry_of_national"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_kor_military_ministry_of_national">
    <bpmn:participant id="Pool_kor_military_ministry_of_national" name="Military Ministry Of National (military)" processRef="Process_kor_military_ministry_of_national" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kor_military_ministry_of_national" name="Military Ministry Of National — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_kor_military_ministry_of_national" name="Readiness
assessment triggered"><bpmn:outgoing>F_kor_military_ministry_of_national_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_kor_military_ministry_of_national_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.military-ministry-of-national.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_military_ministry_of_national_01</bpmn:incoming>
      <bpmn:outgoing>F_kor_military_ministry_of_national_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_kor_military_ministry_of_national_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_kor_military_ministry_of_national_02</bpmn:incoming>
      <bpmn:outgoing>F_kor_military_ministry_of_national_03a</bpmn:outgoing>
      <bpmn:outgoing>F_kor_military_ministry_of_national_03b</bpmn:outgoing>
      <bpmn:outgoing>F_kor_military_ministry_of_national_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_kor_military_ministry_of_national_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.military-ministry-of-national.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_military_ministry_of_national_03a</bpmn:incoming>
      <bpmn:outgoing>F_kor_military_ministry_of_national_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_military_ministry_of_national_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.military-ministry-of-national.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_military_ministry_of_national_03b</bpmn:incoming>
      <bpmn:outgoing>F_kor_military_ministry_of_national_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_military_ministry_of_national_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.military-ministry-of-national.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_military_ministry_of_national_03c</bpmn:incoming>
      <bpmn:outgoing>F_kor_military_ministry_of_national_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_military_ministry_of_national_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.military-ministry-of-national.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_military_ministry_of_national_04</bpmn:incoming>
      <bpmn:outgoing>F_kor_military_ministry_of_national_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_kor_military_ministry_of_national" name="Assessment complete">
      <bpmn:incoming>F_kor_military_ministry_of_national_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_01" sourceRef="Start_kor_military_ministry_of_national" targetRef="T_kor_military_ministry_of_national_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_02" sourceRef="T_kor_military_ministry_of_national_assess" targetRef="GW_kor_military_ministry_of_national_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_03a" sourceRef="GW_kor_military_ministry_of_national_ready" targetRef="T_kor_military_ministry_of_national_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_03b" sourceRef="GW_kor_military_ministry_of_national_ready" targetRef="T_kor_military_ministry_of_national_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_03c" sourceRef="GW_kor_military_ministry_of_national_ready" targetRef="T_kor_military_ministry_of_national_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_04" sourceRef="T_kor_military_ministry_of_national_ops" targetRef="T_kor_military_ministry_of_national_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_04b" sourceRef="T_kor_military_ministry_of_national_proc" targetRef="T_kor_military_ministry_of_national_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_04c" sourceRef="T_kor_military_ministry_of_national_alert" targetRef="T_kor_military_ministry_of_national_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_military_ministry_of_national_05" sourceRef="T_kor_military_ministry_of_national_report" targetRef="End_kor_military_ministry_of_national">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_kor_military_ministry_of_national">
    <bpmndi:BPMNPlane id="BPMNPlane_kor_military_ministry_of_national" bpmnElement="Collaboration_kor_military_ministry_of_national" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
