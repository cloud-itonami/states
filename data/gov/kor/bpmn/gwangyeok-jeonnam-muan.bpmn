      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_jeonnam_muan_04</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_kor_gwangyeok_jeonnam_muan_join" name="Checks complete">
      <bpmn:incoming>F_kor_gwangyeok_jeonnam_muan_05</bpmn:incoming>
      <bpmn:incoming>F_kor_gwangyeok_jeonnam_muan_06</bpmn:incoming>
      <bpmn:incoming>F_kor_gwangyeok_jeonnam_muan_07</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_08</bpmn:outgoing>
