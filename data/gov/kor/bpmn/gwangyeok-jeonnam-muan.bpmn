    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_01" sourceRef="Start_kor_gwangyeok_jeonnam_muan" targetRef="GW_kor_gwangyeok_jeonnam_muan_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_02" sourceRef="GW_kor_gwangyeok_jeonnam_muan_open" targetRef="T_kor_gwangyeok_jeonnam_muan_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_03" sourceRef="GW_kor_gwangyeok_jeonnam_muan_open" targetRef="T_kor_gwangyeok_jeonnam_muan_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_04" sourceRef="GW_kor_gwangyeok_jeonnam_muan_open" targetRef="T_kor_gwangyeok_jeonnam_muan_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_05" sourceRef="T_kor_gwangyeok_jeonnam_muan_policy" targetRef="GW_kor_gwangyeok_jeonnam_muan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_06" sourceRef="T_kor_gwangyeok_jeonnam_muan_budget" targetRef="GW_kor_gwangyeok_jeonnam_muan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_07" sourceRef="T_kor_gwangyeok_jeonnam_muan_coord" targetRef="GW_kor_gwangyeok_jeonnam_muan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_08" sourceRef="GW_kor_gwangyeok_jeonnam_muan_join" targetRef="T_kor_gwangyeok_jeonnam_muan_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_09" sourceRef="T_kor_gwangyeok_jeonnam_muan_review" targetRef="GW_kor_gwangyeok_jeonnam_muan_risk">
