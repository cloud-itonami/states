  <bpmn:collaboration id="Collaboration_kor_gwangyeok_jeonnam_muan">
    <bpmn:participant id="Pool_kor_gwangyeok_jeonnam_muan" name="Muan (gwangyeo)" processRef="Process_kor_gwangyeok_jeonnam_muan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kor_gwangyeok_jeonnam_muan" name="Muan — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_kor_gwangyeok_jeonnam_muan" name="Policy trigger
received"><bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_kor_gwangyeok_jeonnam_muan_open" name="Parallel checks">
