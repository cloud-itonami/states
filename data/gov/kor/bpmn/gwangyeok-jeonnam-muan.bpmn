    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_10a" sourceRef="GW_kor_gwangyeok_jeonnam_muan_risk" targetRef="T_kor_gwangyeok_jeonnam_muan_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
