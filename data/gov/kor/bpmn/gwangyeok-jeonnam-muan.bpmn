      <bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_03</bpmn:outgoing>
      <bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_kor_gwangyeok_jeonnam_muan_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:jeonnam:muan.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_jeonnam_muan_02</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_gwangyeok_jeonnam_muan_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:jeonnam:muan.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_jeonnam_muan_03</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_jeonnam_muan_06</bpmn:outgoing>
