    <bpmn:sequenceFlow id="F_kor_gwangyeok_jeonnam_muan_10b" sourceRef="GW_kor_gwangyeok_jeonnam_muan_risk" targetRef="T_kor_gwangyeok_jeonnam_muan_revise" name="Rejected">
