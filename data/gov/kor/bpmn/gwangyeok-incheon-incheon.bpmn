    id="Definitions_kor_gwangyeok_incheon_incheon"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_kor_gwangyeok_incheon_incheon">
    <bpmn:participant id="Pool_kor_gwangyeok_incheon_incheon" name="Incheon (gwangyeo)" processRef="Process_kor_gwangyeok_incheon_incheon" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kor_gwangyeok_incheon_incheon" name="Incheon — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_kor_gwangyeok_incheon_incheon" name="Policy trigger
received"><bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_kor_gwangyeok_incheon_incheon_open" name="Parallel checks">
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_01</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_02</bpmn:outgoing>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_03</bpmn:outgoing>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_kor_gwangyeok_incheon_incheon_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:incheon:incheon.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_02</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_gwangyeok_incheon_incheon_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:incheon:incheon.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_03</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_gwangyeok_incheon_incheon_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:incheon:incheon.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_04</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_kor_gwangyeok_incheon_incheon_join" name="Checks complete">
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_05</bpmn:incoming>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_06</bpmn:incoming>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_07</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_kor_gwangyeok_incheon_incheon_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_08</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_kor_gwangyeok_incheon_incheon_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_09</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_10a</bpmn:outgoing>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_kor_gwangyeok_incheon_incheon_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:incheon:incheon.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_10a</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_gwangyeok_incheon_incheon_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.gwangyeok:incheon:incheon.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_10b</bpmn:incoming>
      <bpmn:outgoing>F_kor_gwangyeok_incheon_incheon_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_kor_gwangyeok_incheon_incheon" name="Process complete">
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_11</bpmn:incoming>
      <bpmn:incoming>F_kor_gwangyeok_incheon_incheon_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_01" sourceRef="Start_kor_gwangyeok_incheon_incheon" targetRef="GW_kor_gwangyeok_incheon_incheon_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_02" sourceRef="GW_kor_gwangyeok_incheon_incheon_open" targetRef="T_kor_gwangyeok_incheon_incheon_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_03" sourceRef="GW_kor_gwangyeok_incheon_incheon_open" targetRef="T_kor_gwangyeok_incheon_incheon_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_04" sourceRef="GW_kor_gwangyeok_incheon_incheon_open" targetRef="T_kor_gwangyeok_incheon_incheon_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_05" sourceRef="T_kor_gwangyeok_incheon_incheon_policy" targetRef="GW_kor_gwangyeok_incheon_incheon_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_06" sourceRef="T_kor_gwangyeok_incheon_incheon_budget" targetRef="GW_kor_gwangyeok_incheon_incheon_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_07" sourceRef="T_kor_gwangyeok_incheon_incheon_coord" targetRef="GW_kor_gwangyeok_incheon_incheon_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_08" sourceRef="GW_kor_gwangyeok_incheon_incheon_join" targetRef="T_kor_gwangyeok_incheon_incheon_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_09" sourceRef="T_kor_gwangyeok_incheon_incheon_review" targetRef="GW_kor_gwangyeok_incheon_incheon_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_10a" sourceRef="GW_kor_gwangyeok_incheon_incheon_risk" targetRef="T_kor_gwangyeok_incheon_incheon_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_10b" sourceRef="GW_kor_gwangyeok_incheon_incheon_risk" targetRef="T_kor_gwangyeok_incheon_incheon_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_11" sourceRef="T_kor_gwangyeok_incheon_incheon_publish" targetRef="End_kor_gwangyeok_incheon_incheon">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_gwangyeok_incheon_incheon_11b" sourceRef="T_kor_gwangyeok_incheon_incheon_revise" targetRef="End_kor_gwangyeok_incheon_incheon">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_kor_gwangyeok_incheon_incheon">
    <bpmndi:BPMNPlane id="BPMNPlane_kor_gwangyeok_incheon_incheon" bpmnElement="Collaboration_kor_gwangyeok_incheon_incheon" />
  </bpmndi:BPMNDiagram>
