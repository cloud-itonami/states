<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_kor_executive_blue_house"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_kor_executive_blue_house">
    <bpmn:participant id="Pool_kor_executive_blue_house" name="Executive Blue House (ykzyyygs)" processRef="Process_kor_executive_blue_house" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kor_executive_blue_house" name="Executive Blue House — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_kor_executive_blue_house" name="Policy trigger
received"><bpmn:outgoing>F_kor_executive_blue_house_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_kor_executive_blue_house_open" name="Parallel checks">
      <bpmn:incoming>F_kor_executive_blue_house_01</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_02</bpmn:outgoing>
      <bpmn:outgoing>F_kor_executive_blue_house_03</bpmn:outgoing>
      <bpmn:outgoing>F_kor_executive_blue_house_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_kor_executive_blue_house_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.executive-blue-house.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_executive_blue_house_02</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_executive_blue_house_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.executive-blue-house.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_executive_blue_house_03</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_executive_blue_house_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.executive-blue-house.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_executive_blue_house_04</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_kor_executive_blue_house_join" name="Checks complete">
      <bpmn:incoming>F_kor_executive_blue_house_05</bpmn:incoming>
      <bpmn:incoming>F_kor_executive_blue_house_06</bpmn:incoming>
      <bpmn:incoming>F_kor_executive_blue_house_07</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_kor_executive_blue_house_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_executive_blue_house_08</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_kor_executive_blue_house_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_kor_executive_blue_house_09</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_10a</bpmn:outgoing>
      <bpmn:outgoing>F_kor_executive_blue_house_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_kor_executive_blue_house_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.executive-blue-house.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_executive_blue_house_10a</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kor_executive_blue_house_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kor.executive-blue-house.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kor_executive_blue_house_10b</bpmn:incoming>
      <bpmn:outgoing>F_kor_executive_blue_house_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_kor_executive_blue_house" name="Process complete">
      <bpmn:incoming>F_kor_executive_blue_house_11</bpmn:incoming>
      <bpmn:incoming>F_kor_executive_blue_house_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_01" sourceRef="Start_kor_executive_blue_house" targetRef="GW_kor_executive_blue_house_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_02" sourceRef="GW_kor_executive_blue_house_open" targetRef="T_kor_executive_blue_house_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_03" sourceRef="GW_kor_executive_blue_house_open" targetRef="T_kor_executive_blue_house_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_04" sourceRef="GW_kor_executive_blue_house_open" targetRef="T_kor_executive_blue_house_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_05" sourceRef="T_kor_executive_blue_house_policy" targetRef="GW_kor_executive_blue_house_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_06" sourceRef="T_kor_executive_blue_house_budget" targetRef="GW_kor_executive_blue_house_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_07" sourceRef="T_kor_executive_blue_house_coord" targetRef="GW_kor_executive_blue_house_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_08" sourceRef="GW_kor_executive_blue_house_join" targetRef="T_kor_executive_blue_house_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_09" sourceRef="T_kor_executive_blue_house_review" targetRef="GW_kor_executive_blue_house_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_10a" sourceRef="GW_kor_executive_blue_house_risk" targetRef="T_kor_executive_blue_house_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_10b" sourceRef="GW_kor_executive_blue_house_risk" targetRef="T_kor_executive_blue_house_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_11" sourceRef="T_kor_executive_blue_house_publish" targetRef="End_kor_executive_blue_house">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kor_executive_blue_house_11b" sourceRef="T_kor_executive_blue_house_revise" targetRef="End_kor_executive_blue_house">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_kor_executive_blue_house">
    <bpmndi:BPMNPlane id="BPMNPlane_kor_executive_blue_house" bpmnElement="Collaboration_kor_executive_blue_house" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
