<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ind_state_uttarakhand_dehradun"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_state_uttarakhand_dehradun">
    <bpmn:participant id="Pool_ind_state_uttarakhand_dehradun" name="Dehradun (state:ut)" processRef="Process_ind_state_uttarakhand_dehradun" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_state_uttarakhand_dehradun" name="Dehradun — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_state_uttarakhand_dehradun" name="Policy trigger
received"><bpmn:outgoing>F_ind_state_uttarakhand_dehradun_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_state_uttarakhand_dehradun_open" name="Parallel checks">
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_state_uttarakhand_dehradun_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:uttarakhand:dehradun.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_uttarakhand_dehradun_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:uttarakhand:dehradun.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_uttarakhand_dehradun_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:uttarakhand:dehradun.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_state_uttarakhand_dehradun_join" name="Checks complete">
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_05</bpmn:incoming>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_06</bpmn:incoming>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_state_uttarakhand_dehradun_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_state_uttarakhand_dehradun_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_state_uttarakhand_dehradun_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:uttarakhand:dehradun.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_uttarakhand_dehradun_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:uttarakhand:dehradun.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_uttarakhand_dehradun_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_state_uttarakhand_dehradun" name="Process complete">
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_11</bpmn:incoming>
      <bpmn:incoming>F_ind_state_uttarakhand_dehradun_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_01" sourceRef="Start_ind_state_uttarakhand_dehradun" targetRef="GW_ind_state_uttarakhand_dehradun_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_02" sourceRef="GW_ind_state_uttarakhand_dehradun_open" targetRef="T_ind_state_uttarakhand_dehradun_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_03" sourceRef="GW_ind_state_uttarakhand_dehradun_open" targetRef="T_ind_state_uttarakhand_dehradun_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_04" sourceRef="GW_ind_state_uttarakhand_dehradun_open" targetRef="T_ind_state_uttarakhand_dehradun_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_05" sourceRef="T_ind_state_uttarakhand_dehradun_policy" targetRef="GW_ind_state_uttarakhand_dehradun_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_06" sourceRef="T_ind_state_uttarakhand_dehradun_budget" targetRef="GW_ind_state_uttarakhand_dehradun_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_07" sourceRef="T_ind_state_uttarakhand_dehradun_coord" targetRef="GW_ind_state_uttarakhand_dehradun_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_08" sourceRef="GW_ind_state_uttarakhand_dehradun_join" targetRef="T_ind_state_uttarakhand_dehradun_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_09" sourceRef="T_ind_state_uttarakhand_dehradun_review" targetRef="GW_ind_state_uttarakhand_dehradun_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_10a" sourceRef="GW_ind_state_uttarakhand_dehradun_risk" targetRef="T_ind_state_uttarakhand_dehradun_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_10b" sourceRef="GW_ind_state_uttarakhand_dehradun_risk" targetRef="T_ind_state_uttarakhand_dehradun_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_11" sourceRef="T_ind_state_uttarakhand_dehradun_publish" targetRef="End_ind_state_uttarakhand_dehradun">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_uttarakhand_dehradun_11b" sourceRef="T_ind_state_uttarakhand_dehradun_revise" targetRef="End_ind_state_uttarakhand_dehradun">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_state_uttarakhand_dehradun">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_state_uttarakhand_dehradun" bpmnElement="Collaboration_ind_state_uttarakhand_dehradun" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
