    <bpmn:sequenceFlow id="F_ind_district_up_dst_156_kanpur_dehat_01" sourceRef="Start_ind_district_up_dst_156_kanpur_dehat" targetRef="GW_ind_district_up_dst_156_kanpur_dehat_open">
