  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_up_dst_156_kanpur_dehat" name="Up Dst 156 Kanpur Dehat — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_up_dst_156_kanpur_dehat" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_up_dst_156_kanpur_dehat_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_up_dst_156_kanpur_dehat_open" name="Parallel checks">
