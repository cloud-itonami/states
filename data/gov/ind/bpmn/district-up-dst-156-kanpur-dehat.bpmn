      <bpmn:outgoing>F_ind_district_up_dst_156_kanpur_dehat_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_up_dst_156_kanpur_dehat_policy" name="Draft Policy
