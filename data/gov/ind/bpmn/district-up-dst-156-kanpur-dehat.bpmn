    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_156_kanpur_dehat_04" sourceRef="GW_ind_district_up_dst_156_kanpur_dehat_open" targetRef="T_ind_district_up_dst_156_kanpur_dehat_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_156_kanpur_dehat_05" sourceRef="T_ind_district_up_dst_156_kanpur_dehat_policy" targetRef="GW_ind_district_up_dst_156_kanpur_dehat_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_156_kanpur_dehat_06" sourceRef="T_ind_district_up_dst_156_kanpur_dehat_budget" targetRef="GW_ind_district_up_dst_156_kanpur_dehat_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_156_kanpur_dehat_07" sourceRef="T_ind_district_up_dst_156_kanpur_dehat_coord" targetRef="GW_ind_district_up_dst_156_kanpur_dehat_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_156_kanpur_dehat_08" sourceRef="GW_ind_district_up_dst_156_kanpur_dehat_join" targetRef="T_ind_district_up_dst_156_kanpur_dehat_review">
