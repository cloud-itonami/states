      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:up-dst-156-kanpur-dehat.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
