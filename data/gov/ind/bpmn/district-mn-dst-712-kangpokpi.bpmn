  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_mn_dst_712_kangpokpi" name="Mn Dst 712 Kangpokpi — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_mn_dst_712_kangpokpi" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_mn_dst_712_kangpokpi_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_mn_dst_712_kangpokpi_open" name="Parallel checks">
