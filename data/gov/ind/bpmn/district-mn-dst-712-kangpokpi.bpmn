        <zeebe:taskDefinition type="gov.ind.district:mn-dst-712-kangpokpi.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mn_dst_712_kangpokpi_03</bpmn:incoming>
