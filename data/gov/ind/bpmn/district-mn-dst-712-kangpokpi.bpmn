    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_01" sourceRef="Start_ind_district_mn_dst_712_kangpokpi" targetRef="GW_ind_district_mn_dst_712_kangpokpi_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_02" sourceRef="GW_ind_district_mn_dst_712_kangpokpi_open" targetRef="T_ind_district_mn_dst_712_kangpokpi_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_03" sourceRef="GW_ind_district_mn_dst_712_kangpokpi_open" targetRef="T_ind_district_mn_dst_712_kangpokpi_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_04" sourceRef="GW_ind_district_mn_dst_712_kangpokpi_open" targetRef="T_ind_district_mn_dst_712_kangpokpi_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_05" sourceRef="T_ind_district_mn_dst_712_kangpokpi_policy" targetRef="GW_ind_district_mn_dst_712_kangpokpi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_06" sourceRef="T_ind_district_mn_dst_712_kangpokpi_budget" targetRef="GW_ind_district_mn_dst_712_kangpokpi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_07" sourceRef="T_ind_district_mn_dst_712_kangpokpi_coord" targetRef="GW_ind_district_mn_dst_712_kangpokpi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_08" sourceRef="GW_ind_district_mn_dst_712_kangpokpi_join" targetRef="T_ind_district_mn_dst_712_kangpokpi_review">
