    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_10b" sourceRef="GW_ind_district_mn_dst_712_kangpokpi_risk" targetRef="T_ind_district_mn_dst_712_kangpokpi_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
