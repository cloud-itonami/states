      <bpmn:outgoing>F_ind_district_mn_dst_712_kangpokpi_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_mn_dst_712_kangpokpi_policy" name="Draft Policy
