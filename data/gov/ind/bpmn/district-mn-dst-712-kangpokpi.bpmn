    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_11b" sourceRef="T_ind_district_mn_dst_712_kangpokpi_revise" targetRef="End_ind_district_mn_dst_712_kangpokpi">
