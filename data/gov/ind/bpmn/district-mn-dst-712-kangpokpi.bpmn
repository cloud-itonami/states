    <bpmn:sequenceFlow id="F_ind_district_mn_dst_712_kangpokpi_10a" sourceRef="GW_ind_district_mn_dst_712_kangpokpi_risk" targetRef="T_ind_district_mn_dst_712_kangpokpi_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
