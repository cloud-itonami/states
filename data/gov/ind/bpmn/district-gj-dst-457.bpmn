    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_district_gj_dst_457">
    <bpmn:participant id="Pool_ind_district_gj_dst_457" name="Gj Dst 457 (district)" processRef="Process_ind_district_gj_dst_457" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_gj_dst_457" name="Gj Dst 457 — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_gj_dst_457" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_gj_dst_457_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_gj_dst_457_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_gj_dst_457_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_gj_dst_457_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_gj_dst_457_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_gj_dst_457_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:gj-dst-457.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_gj_dst_457_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_gj_dst_457_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:gj-dst-457.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_gj_dst_457_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_gj_dst_457_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:gj-dst-457.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_gj_dst_457_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_district_gj_dst_457_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_gj_dst_457_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_gj_dst_457_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_gj_dst_457_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_district_gj_dst_457_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_gj_dst_457_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_district_gj_dst_457_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_district_gj_dst_457_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_gj_dst_457_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_district_gj_dst_457_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:gj-dst-457.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_gj_dst_457_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_gj_dst_457_revise" name="Return for
