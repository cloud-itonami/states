      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:gj-dst-457.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_gj_dst_457_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_gj_dst_457_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_district_gj_dst_457" name="Process complete">
      <bpmn:incoming>F_ind_district_gj_dst_457_11</bpmn:incoming>
      <bpmn:incoming>F_ind_district_gj_dst_457_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_01" sourceRef="Start_ind_district_gj_dst_457" targetRef="GW_ind_district_gj_dst_457_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_02" sourceRef="GW_ind_district_gj_dst_457_open" targetRef="T_ind_district_gj_dst_457_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_03" sourceRef="GW_ind_district_gj_dst_457_open" targetRef="T_ind_district_gj_dst_457_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_04" sourceRef="GW_ind_district_gj_dst_457_open" targetRef="T_ind_district_gj_dst_457_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_05" sourceRef="T_ind_district_gj_dst_457_policy" targetRef="GW_ind_district_gj_dst_457_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_06" sourceRef="T_ind_district_gj_dst_457_budget" targetRef="GW_ind_district_gj_dst_457_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_07" sourceRef="T_ind_district_gj_dst_457_coord" targetRef="GW_ind_district_gj_dst_457_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_08" sourceRef="GW_ind_district_gj_dst_457_join" targetRef="T_ind_district_gj_dst_457_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_09" sourceRef="T_ind_district_gj_dst_457_review" targetRef="GW_ind_district_gj_dst_457_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_10a" sourceRef="GW_ind_district_gj_dst_457_risk" targetRef="T_ind_district_gj_dst_457_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_10b" sourceRef="GW_ind_district_gj_dst_457_risk" targetRef="T_ind_district_gj_dst_457_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_11" sourceRef="T_ind_district_gj_dst_457_publish" targetRef="End_ind_district_gj_dst_457">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_gj_dst_457_11b" sourceRef="T_ind_district_gj_dst_457_revise" targetRef="End_ind_district_gj_dst_457">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_district_gj_dst_457">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_district_gj_dst_457" bpmnElement="Collaboration_ind_district_gj_dst_457" />
  </bpmndi:BPMNDiagram>
