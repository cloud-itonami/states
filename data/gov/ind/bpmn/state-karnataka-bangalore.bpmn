    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_state_karnataka_bangalore">
    <bpmn:participant id="Pool_ind_state_karnataka_bangalore" name="Bangalore (state:ka)" processRef="Process_ind_state_karnataka_bangalore" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_state_karnataka_bangalore" name="Bangalore — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_state_karnataka_bangalore" name="Policy trigger
received"><bpmn:outgoing>F_ind_state_karnataka_bangalore_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_state_karnataka_bangalore_open" name="Parallel checks">
      <bpmn:incoming>F_ind_state_karnataka_bangalore_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_state_karnataka_bangalore_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:karnataka:bangalore.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_karnataka_bangalore_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:karnataka:bangalore.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_karnataka_bangalore_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:karnataka:bangalore.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_state_karnataka_bangalore_join" name="Checks complete">
      <bpmn:incoming>F_ind_state_karnataka_bangalore_05</bpmn:incoming>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_06</bpmn:incoming>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_state_karnataka_bangalore_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_state_karnataka_bangalore_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_state_karnataka_bangalore_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_state_karnataka_bangalore_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
