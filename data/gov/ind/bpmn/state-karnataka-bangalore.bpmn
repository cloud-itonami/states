      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state:karnataka:bangalore.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_state_karnataka_bangalore" name="Process complete">
