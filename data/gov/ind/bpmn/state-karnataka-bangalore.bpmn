        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_karnataka_bangalore_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_karnataka_bangalore_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_karnataka_bangalore_revise" name="Return for
