      <bpmn:incoming>F_ind_state_karnataka_bangalore_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_01" sourceRef="Start_ind_state_karnataka_bangalore" targetRef="GW_ind_state_karnataka_bangalore_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_02" sourceRef="GW_ind_state_karnataka_bangalore_open" targetRef="T_ind_state_karnataka_bangalore_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_03" sourceRef="GW_ind_state_karnataka_bangalore_open" targetRef="T_ind_state_karnataka_bangalore_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_04" sourceRef="GW_ind_state_karnataka_bangalore_open" targetRef="T_ind_state_karnataka_bangalore_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_05" sourceRef="T_ind_state_karnataka_bangalore_policy" targetRef="GW_ind_state_karnataka_bangalore_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_06" sourceRef="T_ind_state_karnataka_bangalore_budget" targetRef="GW_ind_state_karnataka_bangalore_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_07" sourceRef="T_ind_state_karnataka_bangalore_coord" targetRef="GW_ind_state_karnataka_bangalore_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_08" sourceRef="GW_ind_state_karnataka_bangalore_join" targetRef="T_ind_state_karnataka_bangalore_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_09" sourceRef="T_ind_state_karnataka_bangalore_review" targetRef="GW_ind_state_karnataka_bangalore_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_10a" sourceRef="GW_ind_state_karnataka_bangalore_risk" targetRef="T_ind_state_karnataka_bangalore_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_10b" sourceRef="GW_ind_state_karnataka_bangalore_risk" targetRef="T_ind_state_karnataka_bangalore_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_11" sourceRef="T_ind_state_karnataka_bangalore_publish" targetRef="End_ind_state_karnataka_bangalore">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_karnataka_bangalore_11b" sourceRef="T_ind_state_karnataka_bangalore_revise" targetRef="End_ind_state_karnataka_bangalore">
    </bpmn:sequenceFlow>
