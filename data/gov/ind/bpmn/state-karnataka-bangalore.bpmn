  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_state_karnataka_bangalore">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_state_karnataka_bangalore" bpmnElement="Collaboration_ind_state_karnataka_bangalore" />
  </bpmndi:BPMNDiagram>
