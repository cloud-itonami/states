    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_district_tg_dst_681">
    <bpmn:participant id="Pool_ind_district_tg_dst_681" name="Tg Dst 681 (jagitial)" processRef="Process_ind_district_tg_dst_681" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_tg_dst_681" name="Tg Dst 681 — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_tg_dst_681" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_tg_dst_681_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_tg_dst_681_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_tg_dst_681_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_tg_dst_681_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_tg_dst_681_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_tg_dst_681_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:tg-dst-681.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_tg_dst_681_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_tg_dst_681_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:tg-dst-681.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_tg_dst_681_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_tg_dst_681_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:tg-dst-681.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_tg_dst_681_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_district_tg_dst_681_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_tg_dst_681_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_tg_dst_681_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_tg_dst_681_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_district_tg_dst_681_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_tg_dst_681_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_district_tg_dst_681_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_district_tg_dst_681_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_tg_dst_681_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_district_tg_dst_681_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:tg-dst-681.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_tg_dst_681_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_tg_dst_681_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:tg-dst-681.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_tg_dst_681_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_tg_dst_681_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_district_tg_dst_681" name="Process complete">
      <bpmn:incoming>F_ind_district_tg_dst_681_11</bpmn:incoming>
      <bpmn:incoming>F_ind_district_tg_dst_681_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_01" sourceRef="Start_ind_district_tg_dst_681" targetRef="GW_ind_district_tg_dst_681_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_02" sourceRef="GW_ind_district_tg_dst_681_open" targetRef="T_ind_district_tg_dst_681_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_03" sourceRef="GW_ind_district_tg_dst_681_open" targetRef="T_ind_district_tg_dst_681_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_04" sourceRef="GW_ind_district_tg_dst_681_open" targetRef="T_ind_district_tg_dst_681_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_05" sourceRef="T_ind_district_tg_dst_681_policy" targetRef="GW_ind_district_tg_dst_681_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_06" sourceRef="T_ind_district_tg_dst_681_budget" targetRef="GW_ind_district_tg_dst_681_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_07" sourceRef="T_ind_district_tg_dst_681_coord" targetRef="GW_ind_district_tg_dst_681_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_08" sourceRef="GW_ind_district_tg_dst_681_join" targetRef="T_ind_district_tg_dst_681_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_09" sourceRef="T_ind_district_tg_dst_681_review" targetRef="GW_ind_district_tg_dst_681_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_10a" sourceRef="GW_ind_district_tg_dst_681_risk" targetRef="T_ind_district_tg_dst_681_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_10b" sourceRef="GW_ind_district_tg_dst_681_risk" targetRef="T_ind_district_tg_dst_681_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_11" sourceRef="T_ind_district_tg_dst_681_publish" targetRef="End_ind_district_tg_dst_681">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_tg_dst_681_11b" sourceRef="T_ind_district_tg_dst_681_revise" targetRef="End_ind_district_tg_dst_681">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_district_tg_dst_681">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_district_tg_dst_681" bpmnElement="Collaboration_ind_district_tg_dst_681" />
  </bpmndi:BPMNDiagram>
