      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_01" sourceRef="Start_ind_district_or_dst_361_kendujhar" targetRef="GW_ind_district_or_dst_361_kendujhar_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_02" sourceRef="GW_ind_district_or_dst_361_kendujhar_open" targetRef="T_ind_district_or_dst_361_kendujhar_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_03" sourceRef="GW_ind_district_or_dst_361_kendujhar_open" targetRef="T_ind_district_or_dst_361_kendujhar_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_04" sourceRef="GW_ind_district_or_dst_361_kendujhar_open" targetRef="T_ind_district_or_dst_361_kendujhar_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_05" sourceRef="T_ind_district_or_dst_361_kendujhar_policy" targetRef="GW_ind_district_or_dst_361_kendujhar_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_06" sourceRef="T_ind_district_or_dst_361_kendujhar_budget" targetRef="GW_ind_district_or_dst_361_kendujhar_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_07" sourceRef="T_ind_district_or_dst_361_kendujhar_coord" targetRef="GW_ind_district_or_dst_361_kendujhar_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_08" sourceRef="GW_ind_district_or_dst_361_kendujhar_join" targetRef="T_ind_district_or_dst_361_kendujhar_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_09" sourceRef="T_ind_district_or_dst_361_kendujhar_review" targetRef="GW_ind_district_or_dst_361_kendujhar_risk">
