    <bpmn:exclusiveGateway id="GW_ind_district_or_dst_361_kendujhar_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_10b</bpmn:outgoing>
