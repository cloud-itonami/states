      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_district_or_dst_361_kendujhar_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_08</bpmn:outgoing>
