  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_or_dst_361_kendujhar" name="Or Dst 361 Kendujhar — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_or_dst_361_kendujhar" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_or_dst_361_kendujhar_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_01</bpmn:incoming>
