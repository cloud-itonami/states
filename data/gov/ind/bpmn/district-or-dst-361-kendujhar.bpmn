    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_10a" sourceRef="GW_ind_district_or_dst_361_kendujhar_risk" targetRef="T_ind_district_or_dst_361_kendujhar_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_or_dst_361_kendujhar_10b" sourceRef="GW_ind_district_or_dst_361_kendujhar_risk" targetRef="T_ind_district_or_dst_361_kendujhar_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
