      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_or_dst_361_kendujhar_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:or-dst-361-kendujhar.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_or_dst_361_kendujhar_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:or-dst-361-kendujhar.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_or_dst_361_kendujhar_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_or_dst_361_kendujhar_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_or_dst_361_kendujhar_coord" name="Inter-Agency
