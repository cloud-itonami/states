<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ind_district_br_dst_192_bhagalpur"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_district_br_dst_192_bhagalpur">
    <bpmn:participant id="Pool_ind_district_br_dst_192_bhagalpur" name="Br Dst 192 Bhagalpur (district)" processRef="Process_ind_district_br_dst_192_bhagalpur" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_br_dst_192_bhagalpur" name="Br Dst 192 Bhagalpur — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_br_dst_192_bhagalpur" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_br_dst_192_bhagalpur_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_br_dst_192_bhagalpur_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-192-bhagalpur.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_br_dst_192_bhagalpur_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-192-bhagalpur.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_br_dst_192_bhagalpur_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-192-bhagalpur.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_district_br_dst_192_bhagalpur_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_district_br_dst_192_bhagalpur_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_district_br_dst_192_bhagalpur_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_district_br_dst_192_bhagalpur_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-192-bhagalpur.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_br_dst_192_bhagalpur_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-192-bhagalpur.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_192_bhagalpur_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_district_br_dst_192_bhagalpur" name="Process complete">
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_11</bpmn:incoming>
      <bpmn:incoming>F_ind_district_br_dst_192_bhagalpur_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_01" sourceRef="Start_ind_district_br_dst_192_bhagalpur" targetRef="GW_ind_district_br_dst_192_bhagalpur_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_02" sourceRef="GW_ind_district_br_dst_192_bhagalpur_open" targetRef="T_ind_district_br_dst_192_bhagalpur_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_03" sourceRef="GW_ind_district_br_dst_192_bhagalpur_open" targetRef="T_ind_district_br_dst_192_bhagalpur_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_04" sourceRef="GW_ind_district_br_dst_192_bhagalpur_open" targetRef="T_ind_district_br_dst_192_bhagalpur_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_05" sourceRef="T_ind_district_br_dst_192_bhagalpur_policy" targetRef="GW_ind_district_br_dst_192_bhagalpur_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_06" sourceRef="T_ind_district_br_dst_192_bhagalpur_budget" targetRef="GW_ind_district_br_dst_192_bhagalpur_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_07" sourceRef="T_ind_district_br_dst_192_bhagalpur_coord" targetRef="GW_ind_district_br_dst_192_bhagalpur_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_08" sourceRef="GW_ind_district_br_dst_192_bhagalpur_join" targetRef="T_ind_district_br_dst_192_bhagalpur_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_09" sourceRef="T_ind_district_br_dst_192_bhagalpur_review" targetRef="GW_ind_district_br_dst_192_bhagalpur_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_10a" sourceRef="GW_ind_district_br_dst_192_bhagalpur_risk" targetRef="T_ind_district_br_dst_192_bhagalpur_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_10b" sourceRef="GW_ind_district_br_dst_192_bhagalpur_risk" targetRef="T_ind_district_br_dst_192_bhagalpur_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_11" sourceRef="T_ind_district_br_dst_192_bhagalpur_publish" targetRef="End_ind_district_br_dst_192_bhagalpur">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_192_bhagalpur_11b" sourceRef="T_ind_district_br_dst_192_bhagalpur_revise" targetRef="End_ind_district_br_dst_192_bhagalpur">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_district_br_dst_192_bhagalpur">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_district_br_dst_192_bhagalpur" bpmnElement="Collaboration_ind_district_br_dst_192_bhagalpur" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
