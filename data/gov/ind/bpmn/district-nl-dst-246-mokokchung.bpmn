    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_nl_dst_246_mokokchung_07" sourceRef="T_ind_district_nl_dst_246_mokokchung_coord" targetRef="GW_ind_district_nl_dst_246_mokokchung_join">
