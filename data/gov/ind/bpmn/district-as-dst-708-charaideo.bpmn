        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_11</bpmn:outgoing>
