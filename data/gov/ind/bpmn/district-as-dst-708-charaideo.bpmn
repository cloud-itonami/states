      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:as-dst-708-charaideo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_district_as_dst_708_charaideo_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_08</bpmn:outgoing>
