    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_district_as_dst_708_charaideo">
    <bpmn:participant id="Pool_ind_district_as_dst_708_charaideo" name="As Dst 708 Charaideo (district)" processRef="Process_ind_district_as_dst_708_charaideo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_as_dst_708_charaideo" name="As Dst 708 Charaideo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_as_dst_708_charaideo" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_as_dst_708_charaideo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_as_dst_708_charaideo_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_as_dst_708_charaideo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:as-dst-708-charaideo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_as_dst_708_charaideo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:as-dst-708-charaideo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_as_dst_708_charaideo_coord" name="Inter-Agency
