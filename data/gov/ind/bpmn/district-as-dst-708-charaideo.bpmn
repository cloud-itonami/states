  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_district_as_dst_708_charaideo">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_district_as_dst_708_charaideo" bpmnElement="Collaboration_ind_district_as_dst_708_charaideo" />
  </bpmndi:BPMNDiagram>
