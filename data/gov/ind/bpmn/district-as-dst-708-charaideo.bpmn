      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_01" sourceRef="Start_ind_district_as_dst_708_charaideo" targetRef="GW_ind_district_as_dst_708_charaideo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_02" sourceRef="GW_ind_district_as_dst_708_charaideo_open" targetRef="T_ind_district_as_dst_708_charaideo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_03" sourceRef="GW_ind_district_as_dst_708_charaideo_open" targetRef="T_ind_district_as_dst_708_charaideo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_04" sourceRef="GW_ind_district_as_dst_708_charaideo_open" targetRef="T_ind_district_as_dst_708_charaideo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_05" sourceRef="T_ind_district_as_dst_708_charaideo_policy" targetRef="GW_ind_district_as_dst_708_charaideo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_06" sourceRef="T_ind_district_as_dst_708_charaideo_budget" targetRef="GW_ind_district_as_dst_708_charaideo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_07" sourceRef="T_ind_district_as_dst_708_charaideo_coord" targetRef="GW_ind_district_as_dst_708_charaideo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_08" sourceRef="GW_ind_district_as_dst_708_charaideo_join" targetRef="T_ind_district_as_dst_708_charaideo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_09" sourceRef="T_ind_district_as_dst_708_charaideo_review" targetRef="GW_ind_district_as_dst_708_charaideo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_10a" sourceRef="GW_ind_district_as_dst_708_charaideo_risk" targetRef="T_ind_district_as_dst_708_charaideo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_10b" sourceRef="GW_ind_district_as_dst_708_charaideo_risk" targetRef="T_ind_district_as_dst_708_charaideo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_11" sourceRef="T_ind_district_as_dst_708_charaideo_publish" targetRef="End_ind_district_as_dst_708_charaideo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_as_dst_708_charaideo_11b" sourceRef="T_ind_district_as_dst_708_charaideo_revise" targetRef="End_ind_district_as_dst_708_charaideo">
    </bpmn:sequenceFlow>
