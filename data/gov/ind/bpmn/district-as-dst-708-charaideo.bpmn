      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_district_as_dst_708_charaideo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_district_as_dst_708_charaideo_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_as_dst_708_charaideo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_district_as_dst_708_charaideo_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
