    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_hp_dst_025_solan_06" sourceRef="T_ind_district_hp_dst_025_solan_budget" targetRef="GW_ind_district_hp_dst_025_solan_join">
