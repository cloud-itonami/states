<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ind_state_government"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_state_government">
    <bpmn:participant id="Pool_ind_state_government" name="State Government (state-go)" processRef="Process_ind_state_government" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_state_government" name="State Government — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_state_government" name="Policy trigger
received"><bpmn:outgoing>F_ind_state_government_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_state_government_open" name="Parallel checks">
      <bpmn:incoming>F_ind_state_government_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_government_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_government_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_state_government_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state-government.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_government_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_government_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state-government.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_government_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_government_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state-government.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_government_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_state_government_join" name="Checks complete">
      <bpmn:incoming>F_ind_state_government_05</bpmn:incoming>
      <bpmn:incoming>F_ind_state_government_06</bpmn:incoming>
      <bpmn:incoming>F_ind_state_government_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_state_government_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_government_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_state_government_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_state_government_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_state_government_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_state_government_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state-government.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_government_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_state_government_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.state-government.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_state_government_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_state_government_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_state_government" name="Process complete">
      <bpmn:incoming>F_ind_state_government_11</bpmn:incoming>
      <bpmn:incoming>F_ind_state_government_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_state_government_01" sourceRef="Start_ind_state_government" targetRef="GW_ind_state_government_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_02" sourceRef="GW_ind_state_government_open" targetRef="T_ind_state_government_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_03" sourceRef="GW_ind_state_government_open" targetRef="T_ind_state_government_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_04" sourceRef="GW_ind_state_government_open" targetRef="T_ind_state_government_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_05" sourceRef="T_ind_state_government_policy" targetRef="GW_ind_state_government_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_06" sourceRef="T_ind_state_government_budget" targetRef="GW_ind_state_government_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_07" sourceRef="T_ind_state_government_coord" targetRef="GW_ind_state_government_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_08" sourceRef="GW_ind_state_government_join" targetRef="T_ind_state_government_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_09" sourceRef="T_ind_state_government_review" targetRef="GW_ind_state_government_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_10a" sourceRef="GW_ind_state_government_risk" targetRef="T_ind_state_government_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_10b" sourceRef="GW_ind_state_government_risk" targetRef="T_ind_state_government_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_11" sourceRef="T_ind_state_government_publish" targetRef="End_ind_state_government">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_state_government_11b" sourceRef="T_ind_state_government_revise" targetRef="End_ind_state_government">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_state_government">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_state_government" bpmnElement="Collaboration_ind_state_government" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
