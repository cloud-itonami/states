    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_ap_dst_515_spsr_05" sourceRef="T_ind_district_ap_dst_515_spsr_policy" targetRef="GW_ind_district_ap_dst_515_spsr_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_ap_dst_515_spsr_06" sourceRef="T_ind_district_ap_dst_515_spsr_budget" targetRef="GW_ind_district_ap_dst_515_spsr_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_ap_dst_515_spsr_07" sourceRef="T_ind_district_ap_dst_515_spsr_coord" targetRef="GW_ind_district_ap_dst_515_spsr_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_ap_dst_515_spsr_08" sourceRef="GW_ind_district_ap_dst_515_spsr_join" targetRef="T_ind_district_ap_dst_515_spsr_review">
