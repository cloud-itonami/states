    <bpmn:sequenceFlow id="F_ind_district_ap_dst_515_spsr_03" sourceRef="GW_ind_district_ap_dst_515_spsr_open" targetRef="T_ind_district_ap_dst_515_spsr_budget">
    </bpmn:sequenceFlow>
