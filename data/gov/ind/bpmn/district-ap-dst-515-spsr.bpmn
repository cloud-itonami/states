    <bpmn:sequenceFlow id="F_ind_district_ap_dst_515_spsr_10b" sourceRef="GW_ind_district_ap_dst_515_spsr_risk" targetRef="T_ind_district_ap_dst_515_spsr_revise" name="Rejected">
