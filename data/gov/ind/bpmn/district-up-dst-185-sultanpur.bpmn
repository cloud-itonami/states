  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_up_dst_185_sultanpur" name="Up Dst 185 Sultanpur — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_up_dst_185_sultanpur" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_up_dst_185_sultanpur_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_up_dst_185_sultanpur_open" name="Parallel checks">
