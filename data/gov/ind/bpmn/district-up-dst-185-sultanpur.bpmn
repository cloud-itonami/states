      <bpmn:outgoing>F_ind_district_up_dst_185_sultanpur_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_up_dst_185_sultanpur_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_up_dst_185_sultanpur_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:up-dst-185-sultanpur.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_up_dst_185_sultanpur_02</bpmn:incoming>
