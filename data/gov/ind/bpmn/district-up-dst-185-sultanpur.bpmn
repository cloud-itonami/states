    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_01" sourceRef="Start_ind_district_up_dst_185_sultanpur" targetRef="GW_ind_district_up_dst_185_sultanpur_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_02" sourceRef="GW_ind_district_up_dst_185_sultanpur_open" targetRef="T_ind_district_up_dst_185_sultanpur_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_03" sourceRef="GW_ind_district_up_dst_185_sultanpur_open" targetRef="T_ind_district_up_dst_185_sultanpur_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_04" sourceRef="GW_ind_district_up_dst_185_sultanpur_open" targetRef="T_ind_district_up_dst_185_sultanpur_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_05" sourceRef="T_ind_district_up_dst_185_sultanpur_policy" targetRef="GW_ind_district_up_dst_185_sultanpur_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_06" sourceRef="T_ind_district_up_dst_185_sultanpur_budget" targetRef="GW_ind_district_up_dst_185_sultanpur_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_07" sourceRef="T_ind_district_up_dst_185_sultanpur_coord" targetRef="GW_ind_district_up_dst_185_sultanpur_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_08" sourceRef="GW_ind_district_up_dst_185_sultanpur_join" targetRef="T_ind_district_up_dst_185_sultanpur_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_09" sourceRef="T_ind_district_up_dst_185_sultanpur_review" targetRef="GW_ind_district_up_dst_185_sultanpur_risk">
    </bpmn:sequenceFlow>
