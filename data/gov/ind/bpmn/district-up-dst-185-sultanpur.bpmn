    <bpmn:sequenceFlow id="F_ind_district_up_dst_185_sultanpur_10b" sourceRef="GW_ind_district_up_dst_185_sultanpur_risk" targetRef="T_ind_district_up_dst_185_sultanpur_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
