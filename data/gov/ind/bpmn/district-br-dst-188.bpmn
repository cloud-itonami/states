<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ind_district_br_dst_188"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_district_br_dst_188">
    <bpmn:participant id="Pool_ind_district_br_dst_188" name="Br Dst 188 (district)" processRef="Process_ind_district_br_dst_188" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_br_dst_188" name="Br Dst 188 — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_br_dst_188" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_br_dst_188_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_br_dst_188_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_br_dst_188_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_br_dst_188_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_br_dst_188_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_br_dst_188_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-188.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_188_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_br_dst_188_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-188.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_188_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_br_dst_188_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-188.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_188_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ind_district_br_dst_188_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_br_dst_188_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_br_dst_188_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_br_dst_188_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_district_br_dst_188_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_188_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_district_br_dst_188_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ind_district_br_dst_188_09</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_br_dst_188_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_district_br_dst_188_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-188.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_188_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_br_dst_188_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:br-dst-188.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_br_dst_188_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_br_dst_188_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_district_br_dst_188" name="Process complete">
      <bpmn:incoming>F_ind_district_br_dst_188_11</bpmn:incoming>
      <bpmn:incoming>F_ind_district_br_dst_188_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_01" sourceRef="Start_ind_district_br_dst_188" targetRef="GW_ind_district_br_dst_188_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_02" sourceRef="GW_ind_district_br_dst_188_open" targetRef="T_ind_district_br_dst_188_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_03" sourceRef="GW_ind_district_br_dst_188_open" targetRef="T_ind_district_br_dst_188_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_04" sourceRef="GW_ind_district_br_dst_188_open" targetRef="T_ind_district_br_dst_188_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_05" sourceRef="T_ind_district_br_dst_188_policy" targetRef="GW_ind_district_br_dst_188_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_06" sourceRef="T_ind_district_br_dst_188_budget" targetRef="GW_ind_district_br_dst_188_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_07" sourceRef="T_ind_district_br_dst_188_coord" targetRef="GW_ind_district_br_dst_188_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_08" sourceRef="GW_ind_district_br_dst_188_join" targetRef="T_ind_district_br_dst_188_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_09" sourceRef="T_ind_district_br_dst_188_review" targetRef="GW_ind_district_br_dst_188_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_10a" sourceRef="GW_ind_district_br_dst_188_risk" targetRef="T_ind_district_br_dst_188_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_10b" sourceRef="GW_ind_district_br_dst_188_risk" targetRef="T_ind_district_br_dst_188_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_11" sourceRef="T_ind_district_br_dst_188_publish" targetRef="End_ind_district_br_dst_188">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_br_dst_188_11b" sourceRef="T_ind_district_br_dst_188_revise" targetRef="End_ind_district_br_dst_188">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_district_br_dst_188">
    <bpmndi:BPMNPlane id="BPMNPlane_ind_district_br_dst_188" bpmnElement="Collaboration_ind_district_br_dst_188" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
