    <bpmn:parallelGateway id="GW_ind_district_mz_dst_263_join" name="Checks complete">
      <bpmn:incoming>F_ind_district_mz_dst_263_05</bpmn:incoming>
      <bpmn:incoming>F_ind_district_mz_dst_263_06</bpmn:incoming>
      <bpmn:incoming>F_ind_district_mz_dst_263_07</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ind_district_mz_dst_263_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mz_dst_263_08</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ind_district_mz_dst_263_risk" name="Approved?" isMarkerVisible="true">
