      <bpmn:outgoing>F_ind_district_mz_dst_263_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_mz_dst_263_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ind_district_mz_dst_263_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:mz-dst-263.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mz_dst_263_10a</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_11</bpmn:outgoing>
