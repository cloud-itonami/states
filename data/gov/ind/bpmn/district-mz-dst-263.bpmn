      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:mz-dst-263.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mz_dst_263_10b</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ind_district_mz_dst_263" name="Process complete">
      <bpmn:incoming>F_ind_district_mz_dst_263_11</bpmn:incoming>
      <bpmn:incoming>F_ind_district_mz_dst_263_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_01" sourceRef="Start_ind_district_mz_dst_263" targetRef="GW_ind_district_mz_dst_263_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_02" sourceRef="GW_ind_district_mz_dst_263_open" targetRef="T_ind_district_mz_dst_263_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_03" sourceRef="GW_ind_district_mz_dst_263_open" targetRef="T_ind_district_mz_dst_263_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_04" sourceRef="GW_ind_district_mz_dst_263_open" targetRef="T_ind_district_mz_dst_263_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_05" sourceRef="T_ind_district_mz_dst_263_policy" targetRef="GW_ind_district_mz_dst_263_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_06" sourceRef="T_ind_district_mz_dst_263_budget" targetRef="GW_ind_district_mz_dst_263_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_07" sourceRef="T_ind_district_mz_dst_263_coord" targetRef="GW_ind_district_mz_dst_263_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_08" sourceRef="GW_ind_district_mz_dst_263_join" targetRef="T_ind_district_mz_dst_263_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_09" sourceRef="T_ind_district_mz_dst_263_review" targetRef="GW_ind_district_mz_dst_263_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_10a" sourceRef="GW_ind_district_mz_dst_263_risk" targetRef="T_ind_district_mz_dst_263_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_10b" sourceRef="GW_ind_district_mz_dst_263_risk" targetRef="T_ind_district_mz_dst_263_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_11" sourceRef="T_ind_district_mz_dst_263_publish" targetRef="End_ind_district_mz_dst_263">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ind_district_mz_dst_263_11b" sourceRef="T_ind_district_mz_dst_263_revise" targetRef="End_ind_district_mz_dst_263">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ind_district_mz_dst_263">
