    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ind_district_mz_dst_263">
    <bpmn:participant id="Pool_ind_district_mz_dst_263" name="Mz Dst 263 (district)" processRef="Process_ind_district_mz_dst_263" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ind_district_mz_dst_263" name="Mz Dst 263 — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ind_district_mz_dst_263" name="Policy trigger
received"><bpmn:outgoing>F_ind_district_mz_dst_263_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ind_district_mz_dst_263_open" name="Parallel checks">
      <bpmn:incoming>F_ind_district_mz_dst_263_01</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_02</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_mz_dst_263_03</bpmn:outgoing>
      <bpmn:outgoing>F_ind_district_mz_dst_263_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ind_district_mz_dst_263_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:mz-dst-263.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mz_dst_263_02</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_mz_dst_263_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:mz-dst-263.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mz_dst_263_03</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ind_district_mz_dst_263_coord" name="Inter-Agency
