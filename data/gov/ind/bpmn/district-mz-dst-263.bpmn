      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ind.district:mz-dst-263.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ind_district_mz_dst_263_04</bpmn:incoming>
      <bpmn:outgoing>F_ind_district_mz_dst_263_07</bpmn:outgoing>
