<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_persontypes"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_persontypes">
    <bpmn:participant id="Pool_usa_persontypes" name="Persontypes (c236fwkr)" processRef="Process_usa_persontypes" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_persontypes" name="Persontypes — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_usa_persontypes" name="Policy trigger
received"><bpmn:outgoing>F_usa_persontypes_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_usa_persontypes_open" name="Parallel checks">
      <bpmn:incoming>F_usa_persontypes_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_02</bpmn:outgoing>
      <bpmn:outgoing>F_usa_persontypes_03</bpmn:outgoing>
      <bpmn:outgoing>F_usa_persontypes_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_persontypes_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.persontypes.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_persontypes_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_persontypes_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.persontypes.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_persontypes_03</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_persontypes_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.persontypes.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_persontypes_04</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_persontypes_join" name="Checks complete">
      <bpmn:incoming>F_usa_persontypes_05</bpmn:incoming>
      <bpmn:incoming>F_usa_persontypes_06</bpmn:incoming>
      <bpmn:incoming>F_usa_persontypes_07</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_usa_persontypes_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_persontypes_08</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_usa_persontypes_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_persontypes_09</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_10a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_persontypes_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_persontypes_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.persontypes.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_persontypes_10a</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_persontypes_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.persontypes.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_persontypes_10b</bpmn:incoming>
      <bpmn:outgoing>F_usa_persontypes_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_persontypes" name="Process complete">
      <bpmn:incoming>F_usa_persontypes_11</bpmn:incoming>
      <bpmn:incoming>F_usa_persontypes_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_persontypes_01" sourceRef="Start_usa_persontypes" targetRef="GW_usa_persontypes_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_02" sourceRef="GW_usa_persontypes_open" targetRef="T_usa_persontypes_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_03" sourceRef="GW_usa_persontypes_open" targetRef="T_usa_persontypes_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_04" sourceRef="GW_usa_persontypes_open" targetRef="T_usa_persontypes_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_05" sourceRef="T_usa_persontypes_policy" targetRef="GW_usa_persontypes_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_06" sourceRef="T_usa_persontypes_budget" targetRef="GW_usa_persontypes_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_07" sourceRef="T_usa_persontypes_coord" targetRef="GW_usa_persontypes_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_08" sourceRef="GW_usa_persontypes_join" targetRef="T_usa_persontypes_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_09" sourceRef="T_usa_persontypes_review" targetRef="GW_usa_persontypes_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_10a" sourceRef="GW_usa_persontypes_risk" targetRef="T_usa_persontypes_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_10b" sourceRef="GW_usa_persontypes_risk" targetRef="T_usa_persontypes_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_11" sourceRef="T_usa_persontypes_publish" targetRef="End_usa_persontypes">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_persontypes_11b" sourceRef="T_usa_persontypes_revise" targetRef="End_usa_persontypes">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_persontypes">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_persontypes" bpmnElement="Collaboration_usa_persontypes" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
