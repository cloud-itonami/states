    <bpmn:sequenceFlow id="F_usa_state_kentucky_frankfort_03" sourceRef="GW_usa_state_kentucky_frankfort_open" targetRef="T_usa_state_kentucky_frankfort_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_kentucky_frankfort_04" sourceRef="GW_usa_state_kentucky_frankfort_open" targetRef="T_usa_state_kentucky_frankfort_coord">
    </bpmn:sequenceFlow>
