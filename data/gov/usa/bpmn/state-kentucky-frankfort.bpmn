    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_kentucky_frankfort_06" sourceRef="T_usa_state_kentucky_frankfort_budget" targetRef="GW_usa_state_kentucky_frankfort_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_kentucky_frankfort_07" sourceRef="T_usa_state_kentucky_frankfort_coord" targetRef="GW_usa_state_kentucky_frankfort_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_kentucky_frankfort_08" sourceRef="GW_usa_state_kentucky_frankfort_join" targetRef="T_usa_state_kentucky_frankfort_review">
