<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_house_of_representatives"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_house_of_representatives">
    <bpmn:participant id="Pool_usa_house_of_representatives" name="House Of Representatives (52qm8tdc)" processRef="Process_usa_house_of_representatives" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_house_of_representatives" name="House Of Representatives — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_usa_house_of_representatives" name="Policy trigger
received"><bpmn:outgoing>F_usa_house_of_representatives_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_usa_house_of_representatives_open" name="Parallel checks">
      <bpmn:incoming>F_usa_house_of_representatives_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_02</bpmn:outgoing>
      <bpmn:outgoing>F_usa_house_of_representatives_03</bpmn:outgoing>
      <bpmn:outgoing>F_usa_house_of_representatives_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_house_of_representatives_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.house-of-representatives.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_house_of_representatives_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_house_of_representatives_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.house-of-representatives.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_house_of_representatives_03</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_house_of_representatives_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.house-of-representatives.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_house_of_representatives_04</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_house_of_representatives_join" name="Checks complete">
      <bpmn:incoming>F_usa_house_of_representatives_05</bpmn:incoming>
      <bpmn:incoming>F_usa_house_of_representatives_06</bpmn:incoming>
      <bpmn:incoming>F_usa_house_of_representatives_07</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_usa_house_of_representatives_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_house_of_representatives_08</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_usa_house_of_representatives_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_house_of_representatives_09</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_10a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_house_of_representatives_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_house_of_representatives_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.house-of-representatives.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_house_of_representatives_10a</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_house_of_representatives_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.house-of-representatives.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_house_of_representatives_10b</bpmn:incoming>
      <bpmn:outgoing>F_usa_house_of_representatives_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_house_of_representatives" name="Process complete">
      <bpmn:incoming>F_usa_house_of_representatives_11</bpmn:incoming>
      <bpmn:incoming>F_usa_house_of_representatives_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_01" sourceRef="Start_usa_house_of_representatives" targetRef="GW_usa_house_of_representatives_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_02" sourceRef="GW_usa_house_of_representatives_open" targetRef="T_usa_house_of_representatives_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_03" sourceRef="GW_usa_house_of_representatives_open" targetRef="T_usa_house_of_representatives_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_04" sourceRef="GW_usa_house_of_representatives_open" targetRef="T_usa_house_of_representatives_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_05" sourceRef="T_usa_house_of_representatives_policy" targetRef="GW_usa_house_of_representatives_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_06" sourceRef="T_usa_house_of_representatives_budget" targetRef="GW_usa_house_of_representatives_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_07" sourceRef="T_usa_house_of_representatives_coord" targetRef="GW_usa_house_of_representatives_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_08" sourceRef="GW_usa_house_of_representatives_join" targetRef="T_usa_house_of_representatives_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_09" sourceRef="T_usa_house_of_representatives_review" targetRef="GW_usa_house_of_representatives_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_10a" sourceRef="GW_usa_house_of_representatives_risk" targetRef="T_usa_house_of_representatives_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_10b" sourceRef="GW_usa_house_of_representatives_risk" targetRef="T_usa_house_of_representatives_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_11" sourceRef="T_usa_house_of_representatives_publish" targetRef="End_usa_house_of_representatives">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_house_of_representatives_11b" sourceRef="T_usa_house_of_representatives_revise" targetRef="End_usa_house_of_representatives">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_house_of_representatives">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_house_of_representatives" bpmnElement="Collaboration_usa_house_of_representatives" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
