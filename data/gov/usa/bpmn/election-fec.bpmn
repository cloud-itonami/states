<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_election_fec"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_election_fec">
    <bpmn:participant id="Pool_usa_election_fec" name="Election Fec (u1s2e3c4)" processRef="Process_usa_election_fec" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_election_fec" name="Election Fec — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_usa_election_fec" name="Policy trigger
received"><bpmn:outgoing>F_usa_election_fec_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_usa_election_fec_open" name="Parallel checks">
      <bpmn:incoming>F_usa_election_fec_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_02</bpmn:outgoing>
      <bpmn:outgoing>F_usa_election_fec_03</bpmn:outgoing>
      <bpmn:outgoing>F_usa_election_fec_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_election_fec_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.election-fec.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_election_fec_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_election_fec_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.election-fec.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_election_fec_03</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_election_fec_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.election-fec.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_election_fec_04</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_election_fec_join" name="Checks complete">
      <bpmn:incoming>F_usa_election_fec_05</bpmn:incoming>
      <bpmn:incoming>F_usa_election_fec_06</bpmn:incoming>
      <bpmn:incoming>F_usa_election_fec_07</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_usa_election_fec_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_election_fec_08</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_usa_election_fec_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_election_fec_09</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_10a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_election_fec_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_election_fec_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.election-fec.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_election_fec_10a</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_election_fec_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.election-fec.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_election_fec_10b</bpmn:incoming>
      <bpmn:outgoing>F_usa_election_fec_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_election_fec" name="Process complete">
      <bpmn:incoming>F_usa_election_fec_11</bpmn:incoming>
      <bpmn:incoming>F_usa_election_fec_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_election_fec_01" sourceRef="Start_usa_election_fec" targetRef="GW_usa_election_fec_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_02" sourceRef="GW_usa_election_fec_open" targetRef="T_usa_election_fec_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_03" sourceRef="GW_usa_election_fec_open" targetRef="T_usa_election_fec_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_04" sourceRef="GW_usa_election_fec_open" targetRef="T_usa_election_fec_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_05" sourceRef="T_usa_election_fec_policy" targetRef="GW_usa_election_fec_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_06" sourceRef="T_usa_election_fec_budget" targetRef="GW_usa_election_fec_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_07" sourceRef="T_usa_election_fec_coord" targetRef="GW_usa_election_fec_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_08" sourceRef="GW_usa_election_fec_join" targetRef="T_usa_election_fec_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_09" sourceRef="T_usa_election_fec_review" targetRef="GW_usa_election_fec_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_10a" sourceRef="GW_usa_election_fec_risk" targetRef="T_usa_election_fec_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_10b" sourceRef="GW_usa_election_fec_risk" targetRef="T_usa_election_fec_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_11" sourceRef="T_usa_election_fec_publish" targetRef="End_usa_election_fec">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_election_fec_11b" sourceRef="T_usa_election_fec_revise" targetRef="End_usa_election_fec">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_election_fec">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_election_fec" bpmnElement="Collaboration_usa_election_fec" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
