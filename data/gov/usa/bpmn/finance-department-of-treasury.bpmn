<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_finance_department_of_treasury"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_finance_department_of_treasury">
    <bpmn:participant id="Pool_usa_finance_department_of_treasury" name="Finance Department Of Treasury (u5s8t1r9)" processRef="Process_usa_finance_department_of_treasury" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_finance_department_of_treasury" name="Finance Department Of Treasury — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_usa_finance_department_of_treasury" name="License / Permit
application received"><bpmn:outgoing>F_usa_finance_department_of_treasury_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_usa_finance_department_of_treasury_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.finance-department-of-treasury.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_usa_finance_department_of_treasury_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_finance_department_of_treasury_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_03a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_finance_department_of_treasury_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.finance-department-of-treasury.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_03b</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_finance_department_of_treasury_checks" name="Parallel review">
      <bpmn:incoming>F_usa_finance_department_of_treasury_03a</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_04a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_finance_department_of_treasury_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.finance-department-of-treasury.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_04a</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_finance_department_of_treasury_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.finance-department-of-treasury.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_04b</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_finance_department_of_treasury_join" name="Reviews complete">
      <bpmn:incoming>F_usa_finance_department_of_treasury_05</bpmn:incoming>
      <bpmn:incoming>F_usa_finance_department_of_treasury_05b</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_usa_finance_department_of_treasury_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_06</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_usa_finance_department_of_treasury_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_finance_department_of_treasury_07</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_08a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_finance_department_of_treasury_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.finance-department-of-treasury.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_08a</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_finance_department_of_treasury_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.finance-department-of-treasury.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_finance_department_of_treasury_08b</bpmn:incoming>
      <bpmn:outgoing>F_usa_finance_department_of_treasury_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_finance_department_of_treasury" name="Application
processed">
      <bpmn:incoming>F_usa_finance_department_of_treasury_end1</bpmn:incoming>
      <bpmn:incoming>F_usa_finance_department_of_treasury_end1b</bpmn:incoming>
      <bpmn:incoming>F_usa_finance_department_of_treasury_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_01" sourceRef="Start_usa_finance_department_of_treasury" targetRef="T_usa_finance_department_of_treasury_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_02" sourceRef="T_usa_finance_department_of_treasury_screen" targetRef="GW_usa_finance_department_of_treasury_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_03a" sourceRef="GW_usa_finance_department_of_treasury_complete" targetRef="GW_usa_finance_department_of_treasury_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_03b" sourceRef="GW_usa_finance_department_of_treasury_complete" targetRef="T_usa_finance_department_of_treasury_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_04a" sourceRef="GW_usa_finance_department_of_treasury_checks" targetRef="T_usa_finance_department_of_treasury_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_04b" sourceRef="GW_usa_finance_department_of_treasury_checks" targetRef="T_usa_finance_department_of_treasury_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_05" sourceRef="T_usa_finance_department_of_treasury_legal" targetRef="GW_usa_finance_department_of_treasury_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_05b" sourceRef="T_usa_finance_department_of_treasury_technical" targetRef="GW_usa_finance_department_of_treasury_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_06" sourceRef="GW_usa_finance_department_of_treasury_join" targetRef="T_usa_finance_department_of_treasury_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_07" sourceRef="T_usa_finance_department_of_treasury_decision" targetRef="GW_usa_finance_department_of_treasury_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_08a" sourceRef="GW_usa_finance_department_of_treasury_approve" targetRef="T_usa_finance_department_of_treasury_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_08b" sourceRef="GW_usa_finance_department_of_treasury_approve" targetRef="T_usa_finance_department_of_treasury_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_end1" sourceRef="T_usa_finance_department_of_treasury_issue" targetRef="End_usa_finance_department_of_treasury">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_end1b" sourceRef="T_usa_finance_department_of_treasury_deny" targetRef="End_usa_finance_department_of_treasury">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_finance_department_of_treasury_end1c" sourceRef="T_usa_finance_department_of_treasury_return" targetRef="End_usa_finance_department_of_treasury">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_finance_department_of_treasury">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_finance_department_of_treasury" bpmnElement="Collaboration_usa_finance_department_of_treasury" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
