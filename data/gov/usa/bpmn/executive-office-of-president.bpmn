<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_executive_office_of_president"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_executive_office_of_president">
    <bpmn:participant id="Pool_usa_executive_office_of_president" name="Executive Office Of President (6b3zamrc)" processRef="Process_usa_executive_office_of_president" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_executive_office_of_president" name="Executive Office Of President — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_usa_executive_office_of_president" name="Policy trigger
received"><bpmn:outgoing>F_usa_executive_office_of_president_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_usa_executive_office_of_president_open" name="Parallel checks">
      <bpmn:incoming>F_usa_executive_office_of_president_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_02</bpmn:outgoing>
      <bpmn:outgoing>F_usa_executive_office_of_president_03</bpmn:outgoing>
      <bpmn:outgoing>F_usa_executive_office_of_president_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_executive_office_of_president_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.executive-office-of-president.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_executive_office_of_president_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_executive_office_of_president_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.executive-office-of-president.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_executive_office_of_president_03</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_executive_office_of_president_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.executive-office-of-president.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_executive_office_of_president_04</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_executive_office_of_president_join" name="Checks complete">
      <bpmn:incoming>F_usa_executive_office_of_president_05</bpmn:incoming>
      <bpmn:incoming>F_usa_executive_office_of_president_06</bpmn:incoming>
      <bpmn:incoming>F_usa_executive_office_of_president_07</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_usa_executive_office_of_president_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_executive_office_of_president_08</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_usa_executive_office_of_president_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_executive_office_of_president_09</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_10a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_executive_office_of_president_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_executive_office_of_president_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.executive-office-of-president.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_executive_office_of_president_10a</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_executive_office_of_president_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.executive-office-of-president.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_executive_office_of_president_10b</bpmn:incoming>
      <bpmn:outgoing>F_usa_executive_office_of_president_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_executive_office_of_president" name="Process complete">
      <bpmn:incoming>F_usa_executive_office_of_president_11</bpmn:incoming>
      <bpmn:incoming>F_usa_executive_office_of_president_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_01" sourceRef="Start_usa_executive_office_of_president" targetRef="GW_usa_executive_office_of_president_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_02" sourceRef="GW_usa_executive_office_of_president_open" targetRef="T_usa_executive_office_of_president_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_03" sourceRef="GW_usa_executive_office_of_president_open" targetRef="T_usa_executive_office_of_president_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_04" sourceRef="GW_usa_executive_office_of_president_open" targetRef="T_usa_executive_office_of_president_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_05" sourceRef="T_usa_executive_office_of_president_policy" targetRef="GW_usa_executive_office_of_president_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_06" sourceRef="T_usa_executive_office_of_president_budget" targetRef="GW_usa_executive_office_of_president_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_07" sourceRef="T_usa_executive_office_of_president_coord" targetRef="GW_usa_executive_office_of_president_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_08" sourceRef="GW_usa_executive_office_of_president_join" targetRef="T_usa_executive_office_of_president_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_09" sourceRef="T_usa_executive_office_of_president_review" targetRef="GW_usa_executive_office_of_president_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_10a" sourceRef="GW_usa_executive_office_of_president_risk" targetRef="T_usa_executive_office_of_president_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_10b" sourceRef="GW_usa_executive_office_of_president_risk" targetRef="T_usa_executive_office_of_president_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_11" sourceRef="T_usa_executive_office_of_president_publish" targetRef="End_usa_executive_office_of_president">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_executive_office_of_president_11b" sourceRef="T_usa_executive_office_of_president_revise" targetRef="End_usa_executive_office_of_president">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_executive_office_of_president">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_executive_office_of_president" bpmnElement="Collaboration_usa_executive_office_of_president" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
