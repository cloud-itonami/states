    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_10b" sourceRef="GW_usa_state_west_virginia_charleston_risk" targetRef="T_usa_state_west_virginia_charleston_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
