    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_03" sourceRef="GW_usa_state_west_virginia_charleston_open" targetRef="T_usa_state_west_virginia_charleston_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_04" sourceRef="GW_usa_state_west_virginia_charleston_open" targetRef="T_usa_state_west_virginia_charleston_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_05" sourceRef="T_usa_state_west_virginia_charleston_policy" targetRef="GW_usa_state_west_virginia_charleston_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_06" sourceRef="T_usa_state_west_virginia_charleston_budget" targetRef="GW_usa_state_west_virginia_charleston_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_07" sourceRef="T_usa_state_west_virginia_charleston_coord" targetRef="GW_usa_state_west_virginia_charleston_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_west_virginia_charleston_08" sourceRef="GW_usa_state_west_virginia_charleston_join" targetRef="T_usa_state_west_virginia_charleston_review">
    </bpmn:sequenceFlow>
