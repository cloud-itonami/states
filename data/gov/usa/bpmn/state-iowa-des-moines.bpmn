  </bpmn:collaboration>
  <bpmn:process id="Process_usa_state_iowa_des_moines" name="Des Moines — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_usa_state_iowa_des_moines" name="Policy trigger
received"><bpmn:outgoing>F_usa_state_iowa_des_moines_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_usa_state_iowa_des_moines_open" name="Parallel checks">
