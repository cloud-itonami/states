    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_iowa_des_moines_06" sourceRef="T_usa_state_iowa_des_moines_budget" targetRef="GW_usa_state_iowa_des_moines_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_iowa_des_moines_07" sourceRef="T_usa_state_iowa_des_moines_coord" targetRef="GW_usa_state_iowa_des_moines_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_iowa_des_moines_08" sourceRef="GW_usa_state_iowa_des_moines_join" targetRef="T_usa_state_iowa_des_moines_review">
    </bpmn:sequenceFlow>
