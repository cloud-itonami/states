      <bpmn:outgoing>F_usa_state_iowa_des_moines_03</bpmn:outgoing>
      <bpmn:outgoing>F_usa_state_iowa_des_moines_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_state_iowa_des_moines_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.state:iowa:des-moines.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_iowa_des_moines_02</bpmn:incoming>
