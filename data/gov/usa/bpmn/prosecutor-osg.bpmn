<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_prosecutor_osg"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_prosecutor_osg">
    <bpmn:participant id="Pool_usa_prosecutor_osg" name="Prosecutor Osg (u1s2p3g4)" processRef="Process_usa_prosecutor_osg" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_prosecutor_osg" name="Prosecutor Osg — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_usa_prosecutor_osg" name="Incident
reported"><bpmn:outgoing>F_usa_prosecutor_osg_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_usa_prosecutor_osg_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.prosecutor-osg.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_prosecutor_osg_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_prosecutor_osg_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_usa_prosecutor_osg_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_prosecutor_osg_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_prosecutor_osg_03a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_prosecutor_osg_03b</bpmn:outgoing>
      <bpmn:outgoing>F_usa_prosecutor_osg_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_prosecutor_osg_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.prosecutor-osg.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_prosecutor_osg_03a</bpmn:incoming>
      <bpmn:outgoing>F_usa_prosecutor_osg_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_prosecutor_osg_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.prosecutor-osg.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_prosecutor_osg_03b</bpmn:incoming>
      <bpmn:outgoing>F_usa_prosecutor_osg_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_prosecutor_osg_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.prosecutor-osg.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_prosecutor_osg_03c</bpmn:incoming>
      <bpmn:outgoing>F_usa_prosecutor_osg_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_prosecutor_osg_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.prosecutor-osg.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_prosecutor_osg_06</bpmn:incoming>
      <bpmn:outgoing>F_usa_prosecutor_osg_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_prosecutor_osg" name="Incident resolved">
      <bpmn:incoming>F_usa_prosecutor_osg_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_01" sourceRef="Start_usa_prosecutor_osg" targetRef="T_usa_prosecutor_osg_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_02" sourceRef="T_usa_prosecutor_osg_triage" targetRef="GW_usa_prosecutor_osg_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_03a" sourceRef="GW_usa_prosecutor_osg_sev" targetRef="T_usa_prosecutor_osg_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_03b" sourceRef="GW_usa_prosecutor_osg_sev" targetRef="T_usa_prosecutor_osg_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_03c" sourceRef="GW_usa_prosecutor_osg_sev" targetRef="T_usa_prosecutor_osg_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_06" sourceRef="T_usa_prosecutor_osg_emergency" targetRef="T_usa_prosecutor_osg_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_06b" sourceRef="T_usa_prosecutor_osg_investigate" targetRef="T_usa_prosecutor_osg_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_06c" sourceRef="T_usa_prosecutor_osg_log" targetRef="T_usa_prosecutor_osg_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_prosecutor_osg_07" sourceRef="T_usa_prosecutor_osg_report" targetRef="End_usa_prosecutor_osg">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_prosecutor_osg">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_prosecutor_osg" bpmnElement="Collaboration_usa_prosecutor_osg" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
