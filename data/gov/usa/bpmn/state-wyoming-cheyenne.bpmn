<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_usa_state_wyoming_cheyenne"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_usa_state_wyoming_cheyenne">
    <bpmn:participant id="Pool_usa_state_wyoming_cheyenne" name="Cheyenne (state:wy)" processRef="Process_usa_state_wyoming_cheyenne" />
  </bpmn:collaboration>
  <bpmn:process id="Process_usa_state_wyoming_cheyenne" name="Cheyenne — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_usa_state_wyoming_cheyenne" name="Policy trigger
received"><bpmn:outgoing>F_usa_state_wyoming_cheyenne_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_usa_state_wyoming_cheyenne_open" name="Parallel checks">
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_01</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_02</bpmn:outgoing>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_03</bpmn:outgoing>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_usa_state_wyoming_cheyenne_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.state:wyoming:cheyenne.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_02</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_state_wyoming_cheyenne_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.state:wyoming:cheyenne.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_03</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_state_wyoming_cheyenne_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.state:wyoming:cheyenne.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_04</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_usa_state_wyoming_cheyenne_join" name="Checks complete">
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_05</bpmn:incoming>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_06</bpmn:incoming>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_07</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_usa_state_wyoming_cheyenne_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_08</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_usa_state_wyoming_cheyenne_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_09</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_10a</bpmn:outgoing>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_usa_state_wyoming_cheyenne_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.state:wyoming:cheyenne.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_10a</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_usa_state_wyoming_cheyenne_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.usa.state:wyoming:cheyenne.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_10b</bpmn:incoming>
      <bpmn:outgoing>F_usa_state_wyoming_cheyenne_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_usa_state_wyoming_cheyenne" name="Process complete">
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_11</bpmn:incoming>
      <bpmn:incoming>F_usa_state_wyoming_cheyenne_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_01" sourceRef="Start_usa_state_wyoming_cheyenne" targetRef="GW_usa_state_wyoming_cheyenne_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_02" sourceRef="GW_usa_state_wyoming_cheyenne_open" targetRef="T_usa_state_wyoming_cheyenne_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_03" sourceRef="GW_usa_state_wyoming_cheyenne_open" targetRef="T_usa_state_wyoming_cheyenne_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_04" sourceRef="GW_usa_state_wyoming_cheyenne_open" targetRef="T_usa_state_wyoming_cheyenne_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_05" sourceRef="T_usa_state_wyoming_cheyenne_policy" targetRef="GW_usa_state_wyoming_cheyenne_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_06" sourceRef="T_usa_state_wyoming_cheyenne_budget" targetRef="GW_usa_state_wyoming_cheyenne_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_07" sourceRef="T_usa_state_wyoming_cheyenne_coord" targetRef="GW_usa_state_wyoming_cheyenne_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_08" sourceRef="GW_usa_state_wyoming_cheyenne_join" targetRef="T_usa_state_wyoming_cheyenne_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_09" sourceRef="T_usa_state_wyoming_cheyenne_review" targetRef="GW_usa_state_wyoming_cheyenne_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_10a" sourceRef="GW_usa_state_wyoming_cheyenne_risk" targetRef="T_usa_state_wyoming_cheyenne_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_10b" sourceRef="GW_usa_state_wyoming_cheyenne_risk" targetRef="T_usa_state_wyoming_cheyenne_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_11" sourceRef="T_usa_state_wyoming_cheyenne_publish" targetRef="End_usa_state_wyoming_cheyenne">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_usa_state_wyoming_cheyenne_11b" sourceRef="T_usa_state_wyoming_cheyenne_revise" targetRef="End_usa_state_wyoming_cheyenne">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_usa_state_wyoming_cheyenne">
    <bpmndi:BPMNPlane id="BPMNPlane_usa_state_wyoming_cheyenne" bpmnElement="Collaboration_usa_state_wyoming_cheyenne" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
