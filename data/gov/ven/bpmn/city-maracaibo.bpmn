<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ven_city_maracaibo"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ven_city_maracaibo">
    <bpmn:participant id="Pool_ven_city_maracaibo" name="Maracaibo (city:mar)" processRef="Process_ven_city_maracaibo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ven_city_maracaibo" name="Maracaibo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ven_city_maracaibo" name="Policy trigger
received"><bpmn:outgoing>F_ven_city_maracaibo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ven_city_maracaibo_open" name="Parallel checks">
      <bpmn:incoming>F_ven_city_maracaibo_01</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_02</bpmn:outgoing>
      <bpmn:outgoing>F_ven_city_maracaibo_03</bpmn:outgoing>
      <bpmn:outgoing>F_ven_city_maracaibo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ven_city_maracaibo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:maracaibo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_maracaibo_02</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ven_city_maracaibo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:maracaibo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_maracaibo_03</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ven_city_maracaibo_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:maracaibo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_maracaibo_04</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ven_city_maracaibo_join" name="Checks complete">
      <bpmn:incoming>F_ven_city_maracaibo_05</bpmn:incoming>
      <bpmn:incoming>F_ven_city_maracaibo_06</bpmn:incoming>
      <bpmn:incoming>F_ven_city_maracaibo_07</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ven_city_maracaibo_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_maracaibo_08</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ven_city_maracaibo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ven_city_maracaibo_09</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ven_city_maracaibo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ven_city_maracaibo_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:maracaibo.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_maracaibo_10a</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ven_city_maracaibo_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:maracaibo.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_maracaibo_10b</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_maracaibo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ven_city_maracaibo" name="Process complete">
      <bpmn:incoming>F_ven_city_maracaibo_11</bpmn:incoming>
      <bpmn:incoming>F_ven_city_maracaibo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_01" sourceRef="Start_ven_city_maracaibo" targetRef="GW_ven_city_maracaibo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_02" sourceRef="GW_ven_city_maracaibo_open" targetRef="T_ven_city_maracaibo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_03" sourceRef="GW_ven_city_maracaibo_open" targetRef="T_ven_city_maracaibo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_04" sourceRef="GW_ven_city_maracaibo_open" targetRef="T_ven_city_maracaibo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_05" sourceRef="T_ven_city_maracaibo_policy" targetRef="GW_ven_city_maracaibo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_06" sourceRef="T_ven_city_maracaibo_budget" targetRef="GW_ven_city_maracaibo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_07" sourceRef="T_ven_city_maracaibo_coord" targetRef="GW_ven_city_maracaibo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_08" sourceRef="GW_ven_city_maracaibo_join" targetRef="T_ven_city_maracaibo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_09" sourceRef="T_ven_city_maracaibo_review" targetRef="GW_ven_city_maracaibo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_10a" sourceRef="GW_ven_city_maracaibo_risk" targetRef="T_ven_city_maracaibo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_10b" sourceRef="GW_ven_city_maracaibo_risk" targetRef="T_ven_city_maracaibo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_11" sourceRef="T_ven_city_maracaibo_publish" targetRef="End_ven_city_maracaibo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_maracaibo_11b" sourceRef="T_ven_city_maracaibo_revise" targetRef="End_ven_city_maracaibo">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ven_city_maracaibo">
    <bpmndi:BPMNPlane id="BPMNPlane_ven_city_maracaibo" bpmnElement="Collaboration_ven_city_maracaibo" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
