<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ven_city_caracas"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ven_city_caracas">
    <bpmn:participant id="Pool_ven_city_caracas" name="Caracas (city:car)" processRef="Process_ven_city_caracas" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ven_city_caracas" name="Caracas — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ven_city_caracas" name="Policy trigger
received"><bpmn:outgoing>F_ven_city_caracas_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ven_city_caracas_open" name="Parallel checks">
      <bpmn:incoming>F_ven_city_caracas_01</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_02</bpmn:outgoing>
      <bpmn:outgoing>F_ven_city_caracas_03</bpmn:outgoing>
      <bpmn:outgoing>F_ven_city_caracas_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ven_city_caracas_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:caracas.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_caracas_02</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ven_city_caracas_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:caracas.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_caracas_03</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ven_city_caracas_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:caracas.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_caracas_04</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ven_city_caracas_join" name="Checks complete">
      <bpmn:incoming>F_ven_city_caracas_05</bpmn:incoming>
      <bpmn:incoming>F_ven_city_caracas_06</bpmn:incoming>
      <bpmn:incoming>F_ven_city_caracas_07</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ven_city_caracas_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_caracas_08</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ven_city_caracas_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ven_city_caracas_09</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ven_city_caracas_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ven_city_caracas_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:caracas.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_caracas_10a</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ven_city_caracas_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ven.city:caracas.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ven_city_caracas_10b</bpmn:incoming>
      <bpmn:outgoing>F_ven_city_caracas_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ven_city_caracas" name="Process complete">
      <bpmn:incoming>F_ven_city_caracas_11</bpmn:incoming>
      <bpmn:incoming>F_ven_city_caracas_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ven_city_caracas_01" sourceRef="Start_ven_city_caracas" targetRef="GW_ven_city_caracas_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_02" sourceRef="GW_ven_city_caracas_open" targetRef="T_ven_city_caracas_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_03" sourceRef="GW_ven_city_caracas_open" targetRef="T_ven_city_caracas_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_04" sourceRef="GW_ven_city_caracas_open" targetRef="T_ven_city_caracas_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_05" sourceRef="T_ven_city_caracas_policy" targetRef="GW_ven_city_caracas_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_06" sourceRef="T_ven_city_caracas_budget" targetRef="GW_ven_city_caracas_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_07" sourceRef="T_ven_city_caracas_coord" targetRef="GW_ven_city_caracas_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_08" sourceRef="GW_ven_city_caracas_join" targetRef="T_ven_city_caracas_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_09" sourceRef="T_ven_city_caracas_review" targetRef="GW_ven_city_caracas_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_10a" sourceRef="GW_ven_city_caracas_risk" targetRef="T_ven_city_caracas_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_10b" sourceRef="GW_ven_city_caracas_risk" targetRef="T_ven_city_caracas_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_11" sourceRef="T_ven_city_caracas_publish" targetRef="End_ven_city_caracas">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ven_city_caracas_11b" sourceRef="T_ven_city_caracas_revise" targetRef="End_ven_city_caracas">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ven_city_caracas">
    <bpmndi:BPMNPlane id="BPMNPlane_ven_city_caracas" bpmnElement="Collaboration_ven_city_caracas" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
