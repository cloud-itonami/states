<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_cod_city_kinshasa"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_cod_city_kinshasa">
    <bpmn:participant id="Pool_cod_city_kinshasa" name="Kinshasa (city:kin)" processRef="Process_cod_city_kinshasa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cod_city_kinshasa" name="Kinshasa — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_cod_city_kinshasa" name="Policy trigger
received"><bpmn:outgoing>F_cod_city_kinshasa_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_cod_city_kinshasa_open" name="Parallel checks">
      <bpmn:incoming>F_cod_city_kinshasa_01</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_02</bpmn:outgoing>
      <bpmn:outgoing>F_cod_city_kinshasa_03</bpmn:outgoing>
      <bpmn:outgoing>F_cod_city_kinshasa_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_cod_city_kinshasa_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cod.city:kinshasa.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cod_city_kinshasa_02</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cod_city_kinshasa_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cod.city:kinshasa.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cod_city_kinshasa_03</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cod_city_kinshasa_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cod.city:kinshasa.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cod_city_kinshasa_04</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_cod_city_kinshasa_join" name="Checks complete">
      <bpmn:incoming>F_cod_city_kinshasa_05</bpmn:incoming>
      <bpmn:incoming>F_cod_city_kinshasa_06</bpmn:incoming>
      <bpmn:incoming>F_cod_city_kinshasa_07</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_cod_city_kinshasa_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_cod_city_kinshasa_08</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_cod_city_kinshasa_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_cod_city_kinshasa_09</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_10a</bpmn:outgoing>
      <bpmn:outgoing>F_cod_city_kinshasa_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_cod_city_kinshasa_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cod.city:kinshasa.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cod_city_kinshasa_10a</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cod_city_kinshasa_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cod.city:kinshasa.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cod_city_kinshasa_10b</bpmn:incoming>
      <bpmn:outgoing>F_cod_city_kinshasa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_cod_city_kinshasa" name="Process complete">
      <bpmn:incoming>F_cod_city_kinshasa_11</bpmn:incoming>
      <bpmn:incoming>F_cod_city_kinshasa_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_01" sourceRef="Start_cod_city_kinshasa" targetRef="GW_cod_city_kinshasa_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_02" sourceRef="GW_cod_city_kinshasa_open" targetRef="T_cod_city_kinshasa_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_03" sourceRef="GW_cod_city_kinshasa_open" targetRef="T_cod_city_kinshasa_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_04" sourceRef="GW_cod_city_kinshasa_open" targetRef="T_cod_city_kinshasa_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_05" sourceRef="T_cod_city_kinshasa_policy" targetRef="GW_cod_city_kinshasa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_06" sourceRef="T_cod_city_kinshasa_budget" targetRef="GW_cod_city_kinshasa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_07" sourceRef="T_cod_city_kinshasa_coord" targetRef="GW_cod_city_kinshasa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_08" sourceRef="GW_cod_city_kinshasa_join" targetRef="T_cod_city_kinshasa_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_09" sourceRef="T_cod_city_kinshasa_review" targetRef="GW_cod_city_kinshasa_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_10a" sourceRef="GW_cod_city_kinshasa_risk" targetRef="T_cod_city_kinshasa_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_10b" sourceRef="GW_cod_city_kinshasa_risk" targetRef="T_cod_city_kinshasa_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_11" sourceRef="T_cod_city_kinshasa_publish" targetRef="End_cod_city_kinshasa">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cod_city_kinshasa_11b" sourceRef="T_cod_city_kinshasa_revise" targetRef="End_cod_city_kinshasa">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cod_city_kinshasa">
    <bpmndi:BPMNPlane id="BPMNPlane_cod_city_kinshasa" bpmnElement="Collaboration_cod_city_kinshasa" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
