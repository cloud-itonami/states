<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_fra_region_ile_de_france_paris"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_fra_region_ile_de_france_paris">
    <bpmn:participant id="Pool_fra_region_ile_de_france_paris" name="Paris (region:i)" processRef="Process_fra_region_ile_de_france_paris" />
  </bpmn:collaboration>
  <bpmn:process id="Process_fra_region_ile_de_france_paris" name="Paris — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_fra_region_ile_de_france_paris" name="Policy trigger
received"><bpmn:outgoing>F_fra_region_ile_de_france_paris_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_fra_region_ile_de_france_paris_open" name="Parallel checks">
      <bpmn:incoming>F_fra_region_ile_de_france_paris_01</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_02</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_03</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_fra_region_ile_de_france_paris_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:ile-de-france:paris.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_02</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_ile_de_france_paris_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:ile-de-france:paris.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_03</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_ile_de_france_paris_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:ile-de-france:paris.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_04</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_fra_region_ile_de_france_paris_join" name="Checks complete">
      <bpmn:incoming>F_fra_region_ile_de_france_paris_05</bpmn:incoming>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_06</bpmn:incoming>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_07</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_fra_region_ile_de_france_paris_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_08</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_fra_region_ile_de_france_paris_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_fra_region_ile_de_france_paris_09</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_10a</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_fra_region_ile_de_france_paris_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:ile-de-france:paris.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_10a</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_ile_de_france_paris_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:ile-de-france:paris.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_10b</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_ile_de_france_paris_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_fra_region_ile_de_france_paris" name="Process complete">
      <bpmn:incoming>F_fra_region_ile_de_france_paris_11</bpmn:incoming>
      <bpmn:incoming>F_fra_region_ile_de_france_paris_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_01" sourceRef="Start_fra_region_ile_de_france_paris" targetRef="GW_fra_region_ile_de_france_paris_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_02" sourceRef="GW_fra_region_ile_de_france_paris_open" targetRef="T_fra_region_ile_de_france_paris_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_03" sourceRef="GW_fra_region_ile_de_france_paris_open" targetRef="T_fra_region_ile_de_france_paris_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_04" sourceRef="GW_fra_region_ile_de_france_paris_open" targetRef="T_fra_region_ile_de_france_paris_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_05" sourceRef="T_fra_region_ile_de_france_paris_policy" targetRef="GW_fra_region_ile_de_france_paris_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_06" sourceRef="T_fra_region_ile_de_france_paris_budget" targetRef="GW_fra_region_ile_de_france_paris_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_07" sourceRef="T_fra_region_ile_de_france_paris_coord" targetRef="GW_fra_region_ile_de_france_paris_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_08" sourceRef="GW_fra_region_ile_de_france_paris_join" targetRef="T_fra_region_ile_de_france_paris_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_09" sourceRef="T_fra_region_ile_de_france_paris_review" targetRef="GW_fra_region_ile_de_france_paris_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_10a" sourceRef="GW_fra_region_ile_de_france_paris_risk" targetRef="T_fra_region_ile_de_france_paris_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_10b" sourceRef="GW_fra_region_ile_de_france_paris_risk" targetRef="T_fra_region_ile_de_france_paris_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_11" sourceRef="T_fra_region_ile_de_france_paris_publish" targetRef="End_fra_region_ile_de_france_paris">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_ile_de_france_paris_11b" sourceRef="T_fra_region_ile_de_france_paris_revise" targetRef="End_fra_region_ile_de_france_paris">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_fra_region_ile_de_france_paris">
    <bpmndi:BPMNPlane id="BPMNPlane_fra_region_ile_de_france_paris" bpmnElement="Collaboration_fra_region_ile_de_france_paris" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
