<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_fra_region_normandie_rouen"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_fra_region_normandie_rouen">
    <bpmn:participant id="Pool_fra_region_normandie_rouen" name="Rouen (region:n)" processRef="Process_fra_region_normandie_rouen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_fra_region_normandie_rouen" name="Rouen — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_fra_region_normandie_rouen" name="Policy trigger
received"><bpmn:outgoing>F_fra_region_normandie_rouen_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_fra_region_normandie_rouen_open" name="Parallel checks">
      <bpmn:incoming>F_fra_region_normandie_rouen_01</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_02</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_normandie_rouen_03</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_normandie_rouen_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_fra_region_normandie_rouen_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:normandie:rouen.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_normandie_rouen_02</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_normandie_rouen_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:normandie:rouen.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_normandie_rouen_03</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_normandie_rouen_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:normandie:rouen.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_normandie_rouen_04</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_fra_region_normandie_rouen_join" name="Checks complete">
      <bpmn:incoming>F_fra_region_normandie_rouen_05</bpmn:incoming>
      <bpmn:incoming>F_fra_region_normandie_rouen_06</bpmn:incoming>
      <bpmn:incoming>F_fra_region_normandie_rouen_07</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_fra_region_normandie_rouen_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_normandie_rouen_08</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_fra_region_normandie_rouen_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_fra_region_normandie_rouen_09</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_10a</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_normandie_rouen_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_fra_region_normandie_rouen_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:normandie:rouen.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_normandie_rouen_10a</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_normandie_rouen_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:normandie:rouen.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_normandie_rouen_10b</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_normandie_rouen_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_fra_region_normandie_rouen" name="Process complete">
      <bpmn:incoming>F_fra_region_normandie_rouen_11</bpmn:incoming>
      <bpmn:incoming>F_fra_region_normandie_rouen_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_01" sourceRef="Start_fra_region_normandie_rouen" targetRef="GW_fra_region_normandie_rouen_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_02" sourceRef="GW_fra_region_normandie_rouen_open" targetRef="T_fra_region_normandie_rouen_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_03" sourceRef="GW_fra_region_normandie_rouen_open" targetRef="T_fra_region_normandie_rouen_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_04" sourceRef="GW_fra_region_normandie_rouen_open" targetRef="T_fra_region_normandie_rouen_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_05" sourceRef="T_fra_region_normandie_rouen_policy" targetRef="GW_fra_region_normandie_rouen_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_06" sourceRef="T_fra_region_normandie_rouen_budget" targetRef="GW_fra_region_normandie_rouen_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_07" sourceRef="T_fra_region_normandie_rouen_coord" targetRef="GW_fra_region_normandie_rouen_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_08" sourceRef="GW_fra_region_normandie_rouen_join" targetRef="T_fra_region_normandie_rouen_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_09" sourceRef="T_fra_region_normandie_rouen_review" targetRef="GW_fra_region_normandie_rouen_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_10a" sourceRef="GW_fra_region_normandie_rouen_risk" targetRef="T_fra_region_normandie_rouen_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_10b" sourceRef="GW_fra_region_normandie_rouen_risk" targetRef="T_fra_region_normandie_rouen_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_11" sourceRef="T_fra_region_normandie_rouen_publish" targetRef="End_fra_region_normandie_rouen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_normandie_rouen_11b" sourceRef="T_fra_region_normandie_rouen_revise" targetRef="End_fra_region_normandie_rouen">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_fra_region_normandie_rouen">
    <bpmndi:BPMNPlane id="BPMNPlane_fra_region_normandie_rouen" bpmnElement="Collaboration_fra_region_normandie_rouen" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
