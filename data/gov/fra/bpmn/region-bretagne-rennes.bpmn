    id="Definitions_fra_region_bretagne_rennes"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_fra_region_bretagne_rennes">
    <bpmn:participant id="Pool_fra_region_bretagne_rennes" name="Rennes (region:b)" processRef="Process_fra_region_bretagne_rennes" />
  </bpmn:collaboration>
  <bpmn:process id="Process_fra_region_bretagne_rennes" name="Rennes — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_fra_region_bretagne_rennes" name="Policy trigger
received"><bpmn:outgoing>F_fra_region_bretagne_rennes_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_fra_region_bretagne_rennes_open" name="Parallel checks">
      <bpmn:incoming>F_fra_region_bretagne_rennes_01</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_02</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_03</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_fra_region_bretagne_rennes_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:bretagne:rennes.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_bretagne_rennes_02</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_bretagne_rennes_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:bretagne:rennes.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_bretagne_rennes_03</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_bretagne_rennes_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:bretagne:rennes.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_bretagne_rennes_04</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_fra_region_bretagne_rennes_join" name="Checks complete">
      <bpmn:incoming>F_fra_region_bretagne_rennes_05</bpmn:incoming>
      <bpmn:incoming>F_fra_region_bretagne_rennes_06</bpmn:incoming>
      <bpmn:incoming>F_fra_region_bretagne_rennes_07</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_fra_region_bretagne_rennes_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_bretagne_rennes_08</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_fra_region_bretagne_rennes_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_fra_region_bretagne_rennes_09</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_10a</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_fra_region_bretagne_rennes_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:bretagne:rennes.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_bretagne_rennes_10a</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_11</bpmn:outgoing>
