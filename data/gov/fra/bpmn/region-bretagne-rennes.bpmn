      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:bretagne:rennes.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_bretagne_rennes_10b</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_bretagne_rennes_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_fra_region_bretagne_rennes" name="Process complete">
      <bpmn:incoming>F_fra_region_bretagne_rennes_11</bpmn:incoming>
      <bpmn:incoming>F_fra_region_bretagne_rennes_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_01" sourceRef="Start_fra_region_bretagne_rennes" targetRef="GW_fra_region_bretagne_rennes_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_02" sourceRef="GW_fra_region_bretagne_rennes_open" targetRef="T_fra_region_bretagne_rennes_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_03" sourceRef="GW_fra_region_bretagne_rennes_open" targetRef="T_fra_region_bretagne_rennes_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_04" sourceRef="GW_fra_region_bretagne_rennes_open" targetRef="T_fra_region_bretagne_rennes_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_05" sourceRef="T_fra_region_bretagne_rennes_policy" targetRef="GW_fra_region_bretagne_rennes_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_06" sourceRef="T_fra_region_bretagne_rennes_budget" targetRef="GW_fra_region_bretagne_rennes_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_07" sourceRef="T_fra_region_bretagne_rennes_coord" targetRef="GW_fra_region_bretagne_rennes_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_08" sourceRef="GW_fra_region_bretagne_rennes_join" targetRef="T_fra_region_bretagne_rennes_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_09" sourceRef="T_fra_region_bretagne_rennes_review" targetRef="GW_fra_region_bretagne_rennes_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_10a" sourceRef="GW_fra_region_bretagne_rennes_risk" targetRef="T_fra_region_bretagne_rennes_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_10b" sourceRef="GW_fra_region_bretagne_rennes_risk" targetRef="T_fra_region_bretagne_rennes_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_11" sourceRef="T_fra_region_bretagne_rennes_publish" targetRef="End_fra_region_bretagne_rennes">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_bretagne_rennes_11b" sourceRef="T_fra_region_bretagne_rennes_revise" targetRef="End_fra_region_bretagne_rennes">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_fra_region_bretagne_rennes">
    <bpmndi:BPMNPlane id="BPMNPlane_fra_region_bretagne_rennes" bpmnElement="Collaboration_fra_region_bretagne_rennes" />
  </bpmndi:BPMNDiagram>
