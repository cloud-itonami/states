      <bpmn:outgoing>F_fra_region_occitanie_toulouse_03</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_occitanie_toulouse_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_fra_region_occitanie_toulouse_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:occitanie:toulouse.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_occitanie_toulouse_02</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_occitanie_toulouse_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_occitanie_toulouse_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:occitanie:toulouse.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_occitanie_toulouse_03</bpmn:incoming>
