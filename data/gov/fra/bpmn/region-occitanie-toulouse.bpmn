  </bpmn:collaboration>
  <bpmn:process id="Process_fra_region_occitanie_toulouse" name="Toulouse — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_fra_region_occitanie_toulouse" name="Policy trigger
received"><bpmn:outgoing>F_fra_region_occitanie_toulouse_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_fra_region_occitanie_toulouse_open" name="Parallel checks">
