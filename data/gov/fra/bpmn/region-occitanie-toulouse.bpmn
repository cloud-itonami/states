    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_occitanie_toulouse_10a" sourceRef="GW_fra_region_occitanie_toulouse_risk" targetRef="T_fra_region_occitanie_toulouse_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
