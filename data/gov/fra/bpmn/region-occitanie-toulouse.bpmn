    <bpmn:sequenceFlow id="F_fra_region_occitanie_toulouse_03" sourceRef="GW_fra_region_occitanie_toulouse_open" targetRef="T_fra_region_occitanie_toulouse_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_occitanie_toulouse_04" sourceRef="GW_fra_region_occitanie_toulouse_open" targetRef="T_fra_region_occitanie_toulouse_coord">
    </bpmn:sequenceFlow>
