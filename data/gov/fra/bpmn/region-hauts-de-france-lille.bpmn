      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:hauts-de-france:lille.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_10b</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_fra_region_hauts_de_france_lille" name="Process complete">
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_11</bpmn:incoming>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_01" sourceRef="Start_fra_region_hauts_de_france_lille" targetRef="GW_fra_region_hauts_de_france_lille_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_02" sourceRef="GW_fra_region_hauts_de_france_lille_open" targetRef="T_fra_region_hauts_de_france_lille_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_03" sourceRef="GW_fra_region_hauts_de_france_lille_open" targetRef="T_fra_region_hauts_de_france_lille_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_04" sourceRef="GW_fra_region_hauts_de_france_lille_open" targetRef="T_fra_region_hauts_de_france_lille_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_05" sourceRef="T_fra_region_hauts_de_france_lille_policy" targetRef="GW_fra_region_hauts_de_france_lille_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_06" sourceRef="T_fra_region_hauts_de_france_lille_budget" targetRef="GW_fra_region_hauts_de_france_lille_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_07" sourceRef="T_fra_region_hauts_de_france_lille_coord" targetRef="GW_fra_region_hauts_de_france_lille_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_08" sourceRef="GW_fra_region_hauts_de_france_lille_join" targetRef="T_fra_region_hauts_de_france_lille_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_09" sourceRef="T_fra_region_hauts_de_france_lille_review" targetRef="GW_fra_region_hauts_de_france_lille_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_10a" sourceRef="GW_fra_region_hauts_de_france_lille_risk" targetRef="T_fra_region_hauts_de_france_lille_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_10b" sourceRef="GW_fra_region_hauts_de_france_lille_risk" targetRef="T_fra_region_hauts_de_france_lille_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_11" sourceRef="T_fra_region_hauts_de_france_lille_publish" targetRef="End_fra_region_hauts_de_france_lille">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_hauts_de_france_lille_11b" sourceRef="T_fra_region_hauts_de_france_lille_revise" targetRef="End_fra_region_hauts_de_france_lille">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_fra_region_hauts_de_france_lille">
    <bpmndi:BPMNPlane id="BPMNPlane_fra_region_hauts_de_france_lille" bpmnElement="Collaboration_fra_region_hauts_de_france_lille" />
  </bpmndi:BPMNDiagram>
