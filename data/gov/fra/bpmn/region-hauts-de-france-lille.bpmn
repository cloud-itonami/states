    <bpmn:serviceTask id="T_fra_region_hauts_de_france_lille_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:hauts-de-france:lille.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_10a</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_hauts_de_france_lille_revise" name="Return for
