      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:hauts-de-france:lille.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_04</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_fra_region_hauts_de_france_lille_join" name="Checks complete">
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_05</bpmn:incoming>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_06</bpmn:incoming>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_07</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_08</bpmn:outgoing>
