    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_fra_region_hauts_de_france_lille">
    <bpmn:participant id="Pool_fra_region_hauts_de_france_lille" name="Lille (region:h)" processRef="Process_fra_region_hauts_de_france_lille" />
  </bpmn:collaboration>
  <bpmn:process id="Process_fra_region_hauts_de_france_lille" name="Lille — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_fra_region_hauts_de_france_lille" name="Policy trigger
received"><bpmn:outgoing>F_fra_region_hauts_de_france_lille_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_fra_region_hauts_de_france_lille_open" name="Parallel checks">
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_01</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_02</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_03</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_fra_region_hauts_de_france_lille_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:hauts-de-france:lille.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_02</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_hauts_de_france_lille_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:hauts-de-france:lille.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_03</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_hauts_de_france_lille_coord" name="Inter-Agency
