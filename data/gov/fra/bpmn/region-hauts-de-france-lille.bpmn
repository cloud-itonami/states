      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_fra_region_hauts_de_france_lille_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_fra_region_hauts_de_france_lille_09</bpmn:incoming>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_10a</bpmn:outgoing>
      <bpmn:outgoing>F_fra_region_hauts_de_france_lille_10b</bpmn:outgoing>
