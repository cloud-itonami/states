    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_grand_est_strasbourg_04" sourceRef="GW_fra_region_grand_est_strasbourg_open" targetRef="T_fra_region_grand_est_strasbourg_coord">
