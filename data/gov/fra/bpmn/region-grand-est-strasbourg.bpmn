    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_grand_est_strasbourg_06" sourceRef="T_fra_region_grand_est_strasbourg_budget" targetRef="GW_fra_region_grand_est_strasbourg_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fra_region_grand_est_strasbourg_07" sourceRef="T_fra_region_grand_est_strasbourg_coord" targetRef="GW_fra_region_grand_est_strasbourg_join">
    </bpmn:sequenceFlow>
