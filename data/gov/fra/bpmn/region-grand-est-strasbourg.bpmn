      <bpmn:outgoing>F_fra_region_grand_est_strasbourg_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fra_region_grand_est_strasbourg_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fra.region:grand-est:strasbourg.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
