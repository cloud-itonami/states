<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_hrv_city_zagreb"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_hrv_city_zagreb">
    <bpmn:participant id="Pool_hrv_city_zagreb" name="Zagreb (city:zag)" processRef="Process_hrv_city_zagreb" />
  </bpmn:collaboration>
  <bpmn:process id="Process_hrv_city_zagreb" name="Zagreb — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_hrv_city_zagreb" name="Policy trigger
received"><bpmn:outgoing>F_hrv_city_zagreb_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_hrv_city_zagreb_open" name="Parallel checks">
      <bpmn:incoming>F_hrv_city_zagreb_01</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_02</bpmn:outgoing>
      <bpmn:outgoing>F_hrv_city_zagreb_03</bpmn:outgoing>
      <bpmn:outgoing>F_hrv_city_zagreb_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_hrv_city_zagreb_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hrv.city:zagreb.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hrv_city_zagreb_02</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hrv_city_zagreb_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hrv.city:zagreb.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hrv_city_zagreb_03</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hrv_city_zagreb_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hrv.city:zagreb.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hrv_city_zagreb_04</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_hrv_city_zagreb_join" name="Checks complete">
      <bpmn:incoming>F_hrv_city_zagreb_05</bpmn:incoming>
      <bpmn:incoming>F_hrv_city_zagreb_06</bpmn:incoming>
      <bpmn:incoming>F_hrv_city_zagreb_07</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_hrv_city_zagreb_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_hrv_city_zagreb_08</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_hrv_city_zagreb_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_hrv_city_zagreb_09</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_10a</bpmn:outgoing>
      <bpmn:outgoing>F_hrv_city_zagreb_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_hrv_city_zagreb_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hrv.city:zagreb.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hrv_city_zagreb_10a</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hrv_city_zagreb_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hrv.city:zagreb.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hrv_city_zagreb_10b</bpmn:incoming>
      <bpmn:outgoing>F_hrv_city_zagreb_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hrv_city_zagreb" name="Process complete">
      <bpmn:incoming>F_hrv_city_zagreb_11</bpmn:incoming>
      <bpmn:incoming>F_hrv_city_zagreb_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_01" sourceRef="Start_hrv_city_zagreb" targetRef="GW_hrv_city_zagreb_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_02" sourceRef="GW_hrv_city_zagreb_open" targetRef="T_hrv_city_zagreb_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_03" sourceRef="GW_hrv_city_zagreb_open" targetRef="T_hrv_city_zagreb_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_04" sourceRef="GW_hrv_city_zagreb_open" targetRef="T_hrv_city_zagreb_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_05" sourceRef="T_hrv_city_zagreb_policy" targetRef="GW_hrv_city_zagreb_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_06" sourceRef="T_hrv_city_zagreb_budget" targetRef="GW_hrv_city_zagreb_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_07" sourceRef="T_hrv_city_zagreb_coord" targetRef="GW_hrv_city_zagreb_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_08" sourceRef="GW_hrv_city_zagreb_join" targetRef="T_hrv_city_zagreb_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_09" sourceRef="T_hrv_city_zagreb_review" targetRef="GW_hrv_city_zagreb_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_10a" sourceRef="GW_hrv_city_zagreb_risk" targetRef="T_hrv_city_zagreb_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_10b" sourceRef="GW_hrv_city_zagreb_risk" targetRef="T_hrv_city_zagreb_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_11" sourceRef="T_hrv_city_zagreb_publish" targetRef="End_hrv_city_zagreb">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hrv_city_zagreb_11b" sourceRef="T_hrv_city_zagreb_revise" targetRef="End_hrv_city_zagreb">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hrv_city_zagreb">
    <bpmndi:BPMNPlane id="BPMNPlane_hrv_city_zagreb" bpmnElement="Collaboration_hrv_city_zagreb" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
