<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_nic_city_managua"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_nic_city_managua">
    <bpmn:participant id="Pool_nic_city_managua" name="Managua (city:man)" processRef="Process_nic_city_managua" />
  </bpmn:collaboration>
  <bpmn:process id="Process_nic_city_managua" name="Managua — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_nic_city_managua" name="Policy trigger
received"><bpmn:outgoing>F_nic_city_managua_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_nic_city_managua_open" name="Parallel checks">
      <bpmn:incoming>F_nic_city_managua_01</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_02</bpmn:outgoing>
      <bpmn:outgoing>F_nic_city_managua_03</bpmn:outgoing>
      <bpmn:outgoing>F_nic_city_managua_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_nic_city_managua_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nic.city:managua.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nic_city_managua_02</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nic_city_managua_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nic.city:managua.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nic_city_managua_03</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nic_city_managua_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nic.city:managua.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nic_city_managua_04</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_nic_city_managua_join" name="Checks complete">
      <bpmn:incoming>F_nic_city_managua_05</bpmn:incoming>
      <bpmn:incoming>F_nic_city_managua_06</bpmn:incoming>
      <bpmn:incoming>F_nic_city_managua_07</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_nic_city_managua_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_nic_city_managua_08</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_nic_city_managua_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_nic_city_managua_09</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_10a</bpmn:outgoing>
      <bpmn:outgoing>F_nic_city_managua_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_nic_city_managua_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nic.city:managua.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nic_city_managua_10a</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nic_city_managua_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nic.city:managua.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nic_city_managua_10b</bpmn:incoming>
      <bpmn:outgoing>F_nic_city_managua_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_nic_city_managua" name="Process complete">
      <bpmn:incoming>F_nic_city_managua_11</bpmn:incoming>
      <bpmn:incoming>F_nic_city_managua_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_nic_city_managua_01" sourceRef="Start_nic_city_managua" targetRef="GW_nic_city_managua_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_02" sourceRef="GW_nic_city_managua_open" targetRef="T_nic_city_managua_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_03" sourceRef="GW_nic_city_managua_open" targetRef="T_nic_city_managua_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_04" sourceRef="GW_nic_city_managua_open" targetRef="T_nic_city_managua_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_05" sourceRef="T_nic_city_managua_policy" targetRef="GW_nic_city_managua_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_06" sourceRef="T_nic_city_managua_budget" targetRef="GW_nic_city_managua_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_07" sourceRef="T_nic_city_managua_coord" targetRef="GW_nic_city_managua_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_08" sourceRef="GW_nic_city_managua_join" targetRef="T_nic_city_managua_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_09" sourceRef="T_nic_city_managua_review" targetRef="GW_nic_city_managua_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_10a" sourceRef="GW_nic_city_managua_risk" targetRef="T_nic_city_managua_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_10b" sourceRef="GW_nic_city_managua_risk" targetRef="T_nic_city_managua_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_11" sourceRef="T_nic_city_managua_publish" targetRef="End_nic_city_managua">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nic_city_managua_11b" sourceRef="T_nic_city_managua_revise" targetRef="End_nic_city_managua">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_nic_city_managua">
    <bpmndi:BPMNPlane id="BPMNPlane_nic_city_managua" bpmnElement="Collaboration_nic_city_managua" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
