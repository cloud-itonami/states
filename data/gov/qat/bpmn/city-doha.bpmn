<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_qat_city_doha"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_qat_city_doha">
    <bpmn:participant id="Pool_qat_city_doha" name="Doha (city:doh)" processRef="Process_qat_city_doha" />
  </bpmn:collaboration>
  <bpmn:process id="Process_qat_city_doha" name="Doha — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_qat_city_doha" name="Policy trigger
received"><bpmn:outgoing>F_qat_city_doha_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_qat_city_doha_open" name="Parallel checks">
      <bpmn:incoming>F_qat_city_doha_01</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_02</bpmn:outgoing>
      <bpmn:outgoing>F_qat_city_doha_03</bpmn:outgoing>
      <bpmn:outgoing>F_qat_city_doha_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_qat_city_doha_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.qat.city:doha.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_qat_city_doha_02</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_qat_city_doha_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.qat.city:doha.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_qat_city_doha_03</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_qat_city_doha_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.qat.city:doha.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_qat_city_doha_04</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_qat_city_doha_join" name="Checks complete">
      <bpmn:incoming>F_qat_city_doha_05</bpmn:incoming>
      <bpmn:incoming>F_qat_city_doha_06</bpmn:incoming>
      <bpmn:incoming>F_qat_city_doha_07</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_qat_city_doha_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_qat_city_doha_08</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_qat_city_doha_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_qat_city_doha_09</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_10a</bpmn:outgoing>
      <bpmn:outgoing>F_qat_city_doha_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_qat_city_doha_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.qat.city:doha.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_qat_city_doha_10a</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_qat_city_doha_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.qat.city:doha.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_qat_city_doha_10b</bpmn:incoming>
      <bpmn:outgoing>F_qat_city_doha_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_qat_city_doha" name="Process complete">
      <bpmn:incoming>F_qat_city_doha_11</bpmn:incoming>
      <bpmn:incoming>F_qat_city_doha_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_qat_city_doha_01" sourceRef="Start_qat_city_doha" targetRef="GW_qat_city_doha_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_02" sourceRef="GW_qat_city_doha_open" targetRef="T_qat_city_doha_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_03" sourceRef="GW_qat_city_doha_open" targetRef="T_qat_city_doha_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_04" sourceRef="GW_qat_city_doha_open" targetRef="T_qat_city_doha_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_05" sourceRef="T_qat_city_doha_policy" targetRef="GW_qat_city_doha_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_06" sourceRef="T_qat_city_doha_budget" targetRef="GW_qat_city_doha_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_07" sourceRef="T_qat_city_doha_coord" targetRef="GW_qat_city_doha_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_08" sourceRef="GW_qat_city_doha_join" targetRef="T_qat_city_doha_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_09" sourceRef="T_qat_city_doha_review" targetRef="GW_qat_city_doha_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_10a" sourceRef="GW_qat_city_doha_risk" targetRef="T_qat_city_doha_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_10b" sourceRef="GW_qat_city_doha_risk" targetRef="T_qat_city_doha_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_11" sourceRef="T_qat_city_doha_publish" targetRef="End_qat_city_doha">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_qat_city_doha_11b" sourceRef="T_qat_city_doha_revise" targetRef="End_qat_city_doha">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_qat_city_doha">
    <bpmndi:BPMNPlane id="BPMNPlane_qat_city_doha" bpmnElement="Collaboration_qat_city_doha" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
