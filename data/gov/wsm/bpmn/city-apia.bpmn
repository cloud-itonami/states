<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_wsm_city_apia"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_wsm_city_apia">
    <bpmn:participant id="Pool_wsm_city_apia" name="Apia (city:api)" processRef="Process_wsm_city_apia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_wsm_city_apia" name="Apia — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_wsm_city_apia" name="Policy trigger
received"><bpmn:outgoing>F_wsm_city_apia_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_wsm_city_apia_open" name="Parallel checks">
      <bpmn:incoming>F_wsm_city_apia_01</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_02</bpmn:outgoing>
      <bpmn:outgoing>F_wsm_city_apia_03</bpmn:outgoing>
      <bpmn:outgoing>F_wsm_city_apia_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_wsm_city_apia_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.wsm.city:apia.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_wsm_city_apia_02</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_wsm_city_apia_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.wsm.city:apia.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_wsm_city_apia_03</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_wsm_city_apia_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.wsm.city:apia.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_wsm_city_apia_04</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_wsm_city_apia_join" name="Checks complete">
      <bpmn:incoming>F_wsm_city_apia_05</bpmn:incoming>
      <bpmn:incoming>F_wsm_city_apia_06</bpmn:incoming>
      <bpmn:incoming>F_wsm_city_apia_07</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_wsm_city_apia_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_wsm_city_apia_08</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_wsm_city_apia_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_wsm_city_apia_09</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_10a</bpmn:outgoing>
      <bpmn:outgoing>F_wsm_city_apia_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_wsm_city_apia_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.wsm.city:apia.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_wsm_city_apia_10a</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_wsm_city_apia_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.wsm.city:apia.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_wsm_city_apia_10b</bpmn:incoming>
      <bpmn:outgoing>F_wsm_city_apia_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_wsm_city_apia" name="Process complete">
      <bpmn:incoming>F_wsm_city_apia_11</bpmn:incoming>
      <bpmn:incoming>F_wsm_city_apia_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_wsm_city_apia_01" sourceRef="Start_wsm_city_apia" targetRef="GW_wsm_city_apia_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_02" sourceRef="GW_wsm_city_apia_open" targetRef="T_wsm_city_apia_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_03" sourceRef="GW_wsm_city_apia_open" targetRef="T_wsm_city_apia_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_04" sourceRef="GW_wsm_city_apia_open" targetRef="T_wsm_city_apia_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_05" sourceRef="T_wsm_city_apia_policy" targetRef="GW_wsm_city_apia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_06" sourceRef="T_wsm_city_apia_budget" targetRef="GW_wsm_city_apia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_07" sourceRef="T_wsm_city_apia_coord" targetRef="GW_wsm_city_apia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_08" sourceRef="GW_wsm_city_apia_join" targetRef="T_wsm_city_apia_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_09" sourceRef="T_wsm_city_apia_review" targetRef="GW_wsm_city_apia_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_10a" sourceRef="GW_wsm_city_apia_risk" targetRef="T_wsm_city_apia_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_10b" sourceRef="GW_wsm_city_apia_risk" targetRef="T_wsm_city_apia_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_11" sourceRef="T_wsm_city_apia_publish" targetRef="End_wsm_city_apia">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_wsm_city_apia_11b" sourceRef="T_wsm_city_apia_revise" targetRef="End_wsm_city_apia">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_wsm_city_apia">
    <bpmndi:BPMNPlane id="BPMNPlane_wsm_city_apia" bpmnElement="Collaboration_wsm_city_apia" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
