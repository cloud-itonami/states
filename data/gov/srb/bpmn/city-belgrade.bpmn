<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_srb_city_belgrade"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_srb_city_belgrade">
    <bpmn:participant id="Pool_srb_city_belgrade" name="Belgrade (city:bel)" processRef="Process_srb_city_belgrade" />
  </bpmn:collaboration>
  <bpmn:process id="Process_srb_city_belgrade" name="Belgrade — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_srb_city_belgrade" name="Policy trigger
received"><bpmn:outgoing>F_srb_city_belgrade_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_srb_city_belgrade_open" name="Parallel checks">
      <bpmn:incoming>F_srb_city_belgrade_01</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_02</bpmn:outgoing>
      <bpmn:outgoing>F_srb_city_belgrade_03</bpmn:outgoing>
      <bpmn:outgoing>F_srb_city_belgrade_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_srb_city_belgrade_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.srb.city:belgrade.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_srb_city_belgrade_02</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_srb_city_belgrade_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.srb.city:belgrade.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_srb_city_belgrade_03</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_srb_city_belgrade_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.srb.city:belgrade.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_srb_city_belgrade_04</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_srb_city_belgrade_join" name="Checks complete">
      <bpmn:incoming>F_srb_city_belgrade_05</bpmn:incoming>
      <bpmn:incoming>F_srb_city_belgrade_06</bpmn:incoming>
      <bpmn:incoming>F_srb_city_belgrade_07</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_srb_city_belgrade_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_srb_city_belgrade_08</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_srb_city_belgrade_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_srb_city_belgrade_09</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_10a</bpmn:outgoing>
      <bpmn:outgoing>F_srb_city_belgrade_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_srb_city_belgrade_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.srb.city:belgrade.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_srb_city_belgrade_10a</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_srb_city_belgrade_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.srb.city:belgrade.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_srb_city_belgrade_10b</bpmn:incoming>
      <bpmn:outgoing>F_srb_city_belgrade_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_srb_city_belgrade" name="Process complete">
      <bpmn:incoming>F_srb_city_belgrade_11</bpmn:incoming>
      <bpmn:incoming>F_srb_city_belgrade_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_01" sourceRef="Start_srb_city_belgrade" targetRef="GW_srb_city_belgrade_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_02" sourceRef="GW_srb_city_belgrade_open" targetRef="T_srb_city_belgrade_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_03" sourceRef="GW_srb_city_belgrade_open" targetRef="T_srb_city_belgrade_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_04" sourceRef="GW_srb_city_belgrade_open" targetRef="T_srb_city_belgrade_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_05" sourceRef="T_srb_city_belgrade_policy" targetRef="GW_srb_city_belgrade_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_06" sourceRef="T_srb_city_belgrade_budget" targetRef="GW_srb_city_belgrade_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_07" sourceRef="T_srb_city_belgrade_coord" targetRef="GW_srb_city_belgrade_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_08" sourceRef="GW_srb_city_belgrade_join" targetRef="T_srb_city_belgrade_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_09" sourceRef="T_srb_city_belgrade_review" targetRef="GW_srb_city_belgrade_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_10a" sourceRef="GW_srb_city_belgrade_risk" targetRef="T_srb_city_belgrade_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_10b" sourceRef="GW_srb_city_belgrade_risk" targetRef="T_srb_city_belgrade_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_11" sourceRef="T_srb_city_belgrade_publish" targetRef="End_srb_city_belgrade">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_srb_city_belgrade_11b" sourceRef="T_srb_city_belgrade_revise" targetRef="End_srb_city_belgrade">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_srb_city_belgrade">
    <bpmndi:BPMNPlane id="BPMNPlane_srb_city_belgrade" bpmnElement="Collaboration_srb_city_belgrade" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
