      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zaf.province:gauteng:johannesburg.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_10b</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_zaf_province_gauteng_johannesburg" name="Process complete">
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_11</bpmn:incoming>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_01" sourceRef="Start_zaf_province_gauteng_johannesburg" targetRef="GW_zaf_province_gauteng_johannesburg_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_02" sourceRef="GW_zaf_province_gauteng_johannesburg_open" targetRef="T_zaf_province_gauteng_johannesburg_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_03" sourceRef="GW_zaf_province_gauteng_johannesburg_open" targetRef="T_zaf_province_gauteng_johannesburg_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_04" sourceRef="GW_zaf_province_gauteng_johannesburg_open" targetRef="T_zaf_province_gauteng_johannesburg_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_05" sourceRef="T_zaf_province_gauteng_johannesburg_policy" targetRef="GW_zaf_province_gauteng_johannesburg_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_06" sourceRef="T_zaf_province_gauteng_johannesburg_budget" targetRef="GW_zaf_province_gauteng_johannesburg_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_07" sourceRef="T_zaf_province_gauteng_johannesburg_coord" targetRef="GW_zaf_province_gauteng_johannesburg_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_08" sourceRef="GW_zaf_province_gauteng_johannesburg_join" targetRef="T_zaf_province_gauteng_johannesburg_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_09" sourceRef="T_zaf_province_gauteng_johannesburg_review" targetRef="GW_zaf_province_gauteng_johannesburg_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_10a" sourceRef="GW_zaf_province_gauteng_johannesburg_risk" targetRef="T_zaf_province_gauteng_johannesburg_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_10b" sourceRef="GW_zaf_province_gauteng_johannesburg_risk" targetRef="T_zaf_province_gauteng_johannesburg_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_11" sourceRef="T_zaf_province_gauteng_johannesburg_publish" targetRef="End_zaf_province_gauteng_johannesburg">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zaf_province_gauteng_johannesburg_11b" sourceRef="T_zaf_province_gauteng_johannesburg_revise" targetRef="End_zaf_province_gauteng_johannesburg">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_zaf_province_gauteng_johannesburg">
    <bpmndi:BPMNPlane id="BPMNPlane_zaf_province_gauteng_johannesburg" bpmnElement="Collaboration_zaf_province_gauteng_johannesburg" />
