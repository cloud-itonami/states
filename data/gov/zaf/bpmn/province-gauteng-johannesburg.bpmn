    id="Definitions_zaf_province_gauteng_johannesburg"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_zaf_province_gauteng_johannesburg">
    <bpmn:participant id="Pool_zaf_province_gauteng_johannesburg" name="Johannesburg (province)" processRef="Process_zaf_province_gauteng_johannesburg" />
  </bpmn:collaboration>
  <bpmn:process id="Process_zaf_province_gauteng_johannesburg" name="Johannesburg — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_zaf_province_gauteng_johannesburg" name="Policy trigger
received"><bpmn:outgoing>F_zaf_province_gauteng_johannesburg_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_zaf_province_gauteng_johannesburg_open" name="Parallel checks">
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_01</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_02</bpmn:outgoing>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_03</bpmn:outgoing>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_zaf_province_gauteng_johannesburg_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zaf.province:gauteng:johannesburg.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_02</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zaf_province_gauteng_johannesburg_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zaf.province:gauteng:johannesburg.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_03</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zaf_province_gauteng_johannesburg_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zaf.province:gauteng:johannesburg.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_04</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_zaf_province_gauteng_johannesburg_join" name="Checks complete">
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_05</bpmn:incoming>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_06</bpmn:incoming>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_07</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_zaf_province_gauteng_johannesburg_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_08</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_zaf_province_gauteng_johannesburg_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_09</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_10a</bpmn:outgoing>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_zaf_province_gauteng_johannesburg_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zaf.province:gauteng:johannesburg.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zaf_province_gauteng_johannesburg_10a</bpmn:incoming>
      <bpmn:outgoing>F_zaf_province_gauteng_johannesburg_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zaf_province_gauteng_johannesburg_revise" name="Return for
