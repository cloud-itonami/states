<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bwa_city_gaborone"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bwa_city_gaborone">
    <bpmn:participant id="Pool_bwa_city_gaborone" name="Gaborone (city:gab)" processRef="Process_bwa_city_gaborone" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bwa_city_gaborone" name="Gaborone — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bwa_city_gaborone" name="Policy trigger
received"><bpmn:outgoing>F_bwa_city_gaborone_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bwa_city_gaborone_open" name="Parallel checks">
      <bpmn:incoming>F_bwa_city_gaborone_01</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_02</bpmn:outgoing>
      <bpmn:outgoing>F_bwa_city_gaborone_03</bpmn:outgoing>
      <bpmn:outgoing>F_bwa_city_gaborone_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bwa_city_gaborone_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bwa.city:gaborone.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bwa_city_gaborone_02</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bwa_city_gaborone_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bwa.city:gaborone.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bwa_city_gaborone_03</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bwa_city_gaborone_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bwa.city:gaborone.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bwa_city_gaborone_04</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bwa_city_gaborone_join" name="Checks complete">
      <bpmn:incoming>F_bwa_city_gaborone_05</bpmn:incoming>
      <bpmn:incoming>F_bwa_city_gaborone_06</bpmn:incoming>
      <bpmn:incoming>F_bwa_city_gaborone_07</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bwa_city_gaborone_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bwa_city_gaborone_08</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bwa_city_gaborone_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bwa_city_gaborone_09</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bwa_city_gaborone_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bwa_city_gaborone_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bwa.city:gaborone.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bwa_city_gaborone_10a</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bwa_city_gaborone_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bwa.city:gaborone.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bwa_city_gaborone_10b</bpmn:incoming>
      <bpmn:outgoing>F_bwa_city_gaborone_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bwa_city_gaborone" name="Process complete">
      <bpmn:incoming>F_bwa_city_gaborone_11</bpmn:incoming>
      <bpmn:incoming>F_bwa_city_gaborone_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_01" sourceRef="Start_bwa_city_gaborone" targetRef="GW_bwa_city_gaborone_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_02" sourceRef="GW_bwa_city_gaborone_open" targetRef="T_bwa_city_gaborone_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_03" sourceRef="GW_bwa_city_gaborone_open" targetRef="T_bwa_city_gaborone_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_04" sourceRef="GW_bwa_city_gaborone_open" targetRef="T_bwa_city_gaborone_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_05" sourceRef="T_bwa_city_gaborone_policy" targetRef="GW_bwa_city_gaborone_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_06" sourceRef="T_bwa_city_gaborone_budget" targetRef="GW_bwa_city_gaborone_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_07" sourceRef="T_bwa_city_gaborone_coord" targetRef="GW_bwa_city_gaborone_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_08" sourceRef="GW_bwa_city_gaborone_join" targetRef="T_bwa_city_gaborone_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_09" sourceRef="T_bwa_city_gaborone_review" targetRef="GW_bwa_city_gaborone_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_10a" sourceRef="GW_bwa_city_gaborone_risk" targetRef="T_bwa_city_gaborone_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_10b" sourceRef="GW_bwa_city_gaborone_risk" targetRef="T_bwa_city_gaborone_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_11" sourceRef="T_bwa_city_gaborone_publish" targetRef="End_bwa_city_gaborone">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bwa_city_gaborone_11b" sourceRef="T_bwa_city_gaborone_revise" targetRef="End_bwa_city_gaborone">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bwa_city_gaborone">
    <bpmndi:BPMNPlane id="BPMNPlane_bwa_city_gaborone" bpmnElement="Collaboration_bwa_city_gaborone" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
