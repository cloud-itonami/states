<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_0_ministry_of_people"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_0_ministry_of_people">
    <bpmn:participant id="Pool_0_ministry_of_people" name="Ministry Of People (security)" processRef="Process_0_ministry_of_people" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0_ministry_of_people" name="Ministry Of People — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_0_ministry_of_people" name="Policy trigger
received"><bpmn:outgoing>F_0_ministry_of_people_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_0_ministry_of_people_open" name="Parallel checks">
      <bpmn:incoming>F_0_ministry_of_people_01</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_02</bpmn:outgoing>
      <bpmn:outgoing>F_0_ministry_of_people_03</bpmn:outgoing>
      <bpmn:outgoing>F_0_ministry_of_people_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_0_ministry_of_people_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.0.ministry-of-people.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_0_ministry_of_people_02</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_0_ministry_of_people_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.0.ministry-of-people.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_0_ministry_of_people_03</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_0_ministry_of_people_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.0.ministry-of-people.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_0_ministry_of_people_04</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_0_ministry_of_people_join" name="Checks complete">
      <bpmn:incoming>F_0_ministry_of_people_05</bpmn:incoming>
      <bpmn:incoming>F_0_ministry_of_people_06</bpmn:incoming>
      <bpmn:incoming>F_0_ministry_of_people_07</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_0_ministry_of_people_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_0_ministry_of_people_08</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_0_ministry_of_people_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_0_ministry_of_people_09</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_10a</bpmn:outgoing>
      <bpmn:outgoing>F_0_ministry_of_people_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_0_ministry_of_people_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.0.ministry-of-people.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_0_ministry_of_people_10a</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_0_ministry_of_people_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.0.ministry-of-people.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_0_ministry_of_people_10b</bpmn:incoming>
      <bpmn:outgoing>F_0_ministry_of_people_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_0_ministry_of_people" name="Process complete">
      <bpmn:incoming>F_0_ministry_of_people_11</bpmn:incoming>
      <bpmn:incoming>F_0_ministry_of_people_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_01" sourceRef="Start_0_ministry_of_people" targetRef="GW_0_ministry_of_people_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_02" sourceRef="GW_0_ministry_of_people_open" targetRef="T_0_ministry_of_people_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_03" sourceRef="GW_0_ministry_of_people_open" targetRef="T_0_ministry_of_people_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_04" sourceRef="GW_0_ministry_of_people_open" targetRef="T_0_ministry_of_people_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_05" sourceRef="T_0_ministry_of_people_policy" targetRef="GW_0_ministry_of_people_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_06" sourceRef="T_0_ministry_of_people_budget" targetRef="GW_0_ministry_of_people_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_07" sourceRef="T_0_ministry_of_people_coord" targetRef="GW_0_ministry_of_people_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_08" sourceRef="GW_0_ministry_of_people_join" targetRef="T_0_ministry_of_people_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_09" sourceRef="T_0_ministry_of_people_review" targetRef="GW_0_ministry_of_people_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_10a" sourceRef="GW_0_ministry_of_people_risk" targetRef="T_0_ministry_of_people_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_10b" sourceRef="GW_0_ministry_of_people_risk" targetRef="T_0_ministry_of_people_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_11" sourceRef="T_0_ministry_of_people_publish" targetRef="End_0_ministry_of_people">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_0_ministry_of_people_11b" sourceRef="T_0_ministry_of_people_revise" targetRef="End_0_ministry_of_people">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_0_ministry_of_people">
    <bpmndi:BPMNPlane id="BPMNPlane_0_ministry_of_people" bpmnElement="Collaboration_0_ministry_of_people" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
