<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_dza_city_algiers"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_dza_city_algiers">
    <bpmn:participant id="Pool_dza_city_algiers" name="Algiers (city:alg)" processRef="Process_dza_city_algiers" />
  </bpmn:collaboration>
  <bpmn:process id="Process_dza_city_algiers" name="Algiers — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_dza_city_algiers" name="Policy trigger
received"><bpmn:outgoing>F_dza_city_algiers_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_dza_city_algiers_open" name="Parallel checks">
      <bpmn:incoming>F_dza_city_algiers_01</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_02</bpmn:outgoing>
      <bpmn:outgoing>F_dza_city_algiers_03</bpmn:outgoing>
      <bpmn:outgoing>F_dza_city_algiers_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_dza_city_algiers_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dza.city:algiers.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dza_city_algiers_02</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dza_city_algiers_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dza.city:algiers.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dza_city_algiers_03</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dza_city_algiers_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dza.city:algiers.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dza_city_algiers_04</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_dza_city_algiers_join" name="Checks complete">
      <bpmn:incoming>F_dza_city_algiers_05</bpmn:incoming>
      <bpmn:incoming>F_dza_city_algiers_06</bpmn:incoming>
      <bpmn:incoming>F_dza_city_algiers_07</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_dza_city_algiers_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_dza_city_algiers_08</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_dza_city_algiers_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_dza_city_algiers_09</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_10a</bpmn:outgoing>
      <bpmn:outgoing>F_dza_city_algiers_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_dza_city_algiers_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dza.city:algiers.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dza_city_algiers_10a</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dza_city_algiers_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dza.city:algiers.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dza_city_algiers_10b</bpmn:incoming>
      <bpmn:outgoing>F_dza_city_algiers_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_dza_city_algiers" name="Process complete">
      <bpmn:incoming>F_dza_city_algiers_11</bpmn:incoming>
      <bpmn:incoming>F_dza_city_algiers_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_dza_city_algiers_01" sourceRef="Start_dza_city_algiers" targetRef="GW_dza_city_algiers_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_02" sourceRef="GW_dza_city_algiers_open" targetRef="T_dza_city_algiers_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_03" sourceRef="GW_dza_city_algiers_open" targetRef="T_dza_city_algiers_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_04" sourceRef="GW_dza_city_algiers_open" targetRef="T_dza_city_algiers_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_05" sourceRef="T_dza_city_algiers_policy" targetRef="GW_dza_city_algiers_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_06" sourceRef="T_dza_city_algiers_budget" targetRef="GW_dza_city_algiers_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_07" sourceRef="T_dza_city_algiers_coord" targetRef="GW_dza_city_algiers_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_08" sourceRef="GW_dza_city_algiers_join" targetRef="T_dza_city_algiers_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_09" sourceRef="T_dza_city_algiers_review" targetRef="GW_dza_city_algiers_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_10a" sourceRef="GW_dza_city_algiers_risk" targetRef="T_dza_city_algiers_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_10b" sourceRef="GW_dza_city_algiers_risk" targetRef="T_dza_city_algiers_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_11" sourceRef="T_dza_city_algiers_publish" targetRef="End_dza_city_algiers">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dza_city_algiers_11b" sourceRef="T_dza_city_algiers_revise" targetRef="End_dza_city_algiers">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_dza_city_algiers">
    <bpmndi:BPMNPlane id="BPMNPlane_dza_city_algiers" bpmnElement="Collaboration_dza_city_algiers" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
