<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_cri_city_san_jose"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_cri_city_san_jose">
    <bpmn:participant id="Pool_cri_city_san_jose" name="San Jose (city:san)" processRef="Process_cri_city_san_jose" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cri_city_san_jose" name="San Jose — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_cri_city_san_jose" name="Policy trigger
received"><bpmn:outgoing>F_cri_city_san_jose_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_cri_city_san_jose_open" name="Parallel checks">
      <bpmn:incoming>F_cri_city_san_jose_01</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_02</bpmn:outgoing>
      <bpmn:outgoing>F_cri_city_san_jose_03</bpmn:outgoing>
      <bpmn:outgoing>F_cri_city_san_jose_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_cri_city_san_jose_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cri.city:san-jose.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cri_city_san_jose_02</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cri_city_san_jose_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cri.city:san-jose.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cri_city_san_jose_03</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cri_city_san_jose_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cri.city:san-jose.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cri_city_san_jose_04</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_cri_city_san_jose_join" name="Checks complete">
      <bpmn:incoming>F_cri_city_san_jose_05</bpmn:incoming>
      <bpmn:incoming>F_cri_city_san_jose_06</bpmn:incoming>
      <bpmn:incoming>F_cri_city_san_jose_07</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_cri_city_san_jose_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_cri_city_san_jose_08</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_cri_city_san_jose_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_cri_city_san_jose_09</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_10a</bpmn:outgoing>
      <bpmn:outgoing>F_cri_city_san_jose_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_cri_city_san_jose_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cri.city:san-jose.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cri_city_san_jose_10a</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cri_city_san_jose_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cri.city:san-jose.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cri_city_san_jose_10b</bpmn:incoming>
      <bpmn:outgoing>F_cri_city_san_jose_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_cri_city_san_jose" name="Process complete">
      <bpmn:incoming>F_cri_city_san_jose_11</bpmn:incoming>
      <bpmn:incoming>F_cri_city_san_jose_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_01" sourceRef="Start_cri_city_san_jose" targetRef="GW_cri_city_san_jose_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_02" sourceRef="GW_cri_city_san_jose_open" targetRef="T_cri_city_san_jose_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_03" sourceRef="GW_cri_city_san_jose_open" targetRef="T_cri_city_san_jose_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_04" sourceRef="GW_cri_city_san_jose_open" targetRef="T_cri_city_san_jose_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_05" sourceRef="T_cri_city_san_jose_policy" targetRef="GW_cri_city_san_jose_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_06" sourceRef="T_cri_city_san_jose_budget" targetRef="GW_cri_city_san_jose_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_07" sourceRef="T_cri_city_san_jose_coord" targetRef="GW_cri_city_san_jose_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_08" sourceRef="GW_cri_city_san_jose_join" targetRef="T_cri_city_san_jose_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_09" sourceRef="T_cri_city_san_jose_review" targetRef="GW_cri_city_san_jose_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_10a" sourceRef="GW_cri_city_san_jose_risk" targetRef="T_cri_city_san_jose_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_10b" sourceRef="GW_cri_city_san_jose_risk" targetRef="T_cri_city_san_jose_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_11" sourceRef="T_cri_city_san_jose_publish" targetRef="End_cri_city_san_jose">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cri_city_san_jose_11b" sourceRef="T_cri_city_san_jose_revise" targetRef="End_cri_city_san_jose">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cri_city_san_jose">
    <bpmndi:BPMNPlane id="BPMNPlane_cri_city_san_jose" bpmnElement="Collaboration_cri_city_san_jose" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
