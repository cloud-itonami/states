<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ben_city_porto_novo"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ben_city_porto_novo">
    <bpmn:participant id="Pool_ben_city_porto_novo" name="Porto-Novo (city:por)" processRef="Process_ben_city_porto_novo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ben_city_porto_novo" name="Porto-Novo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ben_city_porto_novo" name="Policy trigger
received"><bpmn:outgoing>F_ben_city_porto_novo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ben_city_porto_novo_open" name="Parallel checks">
      <bpmn:incoming>F_ben_city_porto_novo_01</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_02</bpmn:outgoing>
      <bpmn:outgoing>F_ben_city_porto_novo_03</bpmn:outgoing>
      <bpmn:outgoing>F_ben_city_porto_novo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ben_city_porto_novo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:porto-novo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_porto_novo_02</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ben_city_porto_novo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:porto-novo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_porto_novo_03</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ben_city_porto_novo_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:porto-novo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_porto_novo_04</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ben_city_porto_novo_join" name="Checks complete">
      <bpmn:incoming>F_ben_city_porto_novo_05</bpmn:incoming>
      <bpmn:incoming>F_ben_city_porto_novo_06</bpmn:incoming>
      <bpmn:incoming>F_ben_city_porto_novo_07</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ben_city_porto_novo_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_porto_novo_08</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ben_city_porto_novo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ben_city_porto_novo_09</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ben_city_porto_novo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ben_city_porto_novo_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:porto-novo.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_porto_novo_10a</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ben_city_porto_novo_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:porto-novo.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_porto_novo_10b</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_porto_novo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ben_city_porto_novo" name="Process complete">
      <bpmn:incoming>F_ben_city_porto_novo_11</bpmn:incoming>
      <bpmn:incoming>F_ben_city_porto_novo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_01" sourceRef="Start_ben_city_porto_novo" targetRef="GW_ben_city_porto_novo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_02" sourceRef="GW_ben_city_porto_novo_open" targetRef="T_ben_city_porto_novo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_03" sourceRef="GW_ben_city_porto_novo_open" targetRef="T_ben_city_porto_novo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_04" sourceRef="GW_ben_city_porto_novo_open" targetRef="T_ben_city_porto_novo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_05" sourceRef="T_ben_city_porto_novo_policy" targetRef="GW_ben_city_porto_novo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_06" sourceRef="T_ben_city_porto_novo_budget" targetRef="GW_ben_city_porto_novo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_07" sourceRef="T_ben_city_porto_novo_coord" targetRef="GW_ben_city_porto_novo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_08" sourceRef="GW_ben_city_porto_novo_join" targetRef="T_ben_city_porto_novo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_09" sourceRef="T_ben_city_porto_novo_review" targetRef="GW_ben_city_porto_novo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_10a" sourceRef="GW_ben_city_porto_novo_risk" targetRef="T_ben_city_porto_novo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_10b" sourceRef="GW_ben_city_porto_novo_risk" targetRef="T_ben_city_porto_novo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_11" sourceRef="T_ben_city_porto_novo_publish" targetRef="End_ben_city_porto_novo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_porto_novo_11b" sourceRef="T_ben_city_porto_novo_revise" targetRef="End_ben_city_porto_novo">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ben_city_porto_novo">
    <bpmndi:BPMNPlane id="BPMNPlane_ben_city_porto_novo" bpmnElement="Collaboration_ben_city_porto_novo" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
