<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ben_city_cotonou"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ben_city_cotonou">
    <bpmn:participant id="Pool_ben_city_cotonou" name="Cotonou (city:cot)" processRef="Process_ben_city_cotonou" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ben_city_cotonou" name="Cotonou — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ben_city_cotonou" name="Policy trigger
received"><bpmn:outgoing>F_ben_city_cotonou_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ben_city_cotonou_open" name="Parallel checks">
      <bpmn:incoming>F_ben_city_cotonou_01</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_02</bpmn:outgoing>
      <bpmn:outgoing>F_ben_city_cotonou_03</bpmn:outgoing>
      <bpmn:outgoing>F_ben_city_cotonou_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ben_city_cotonou_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:cotonou.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_cotonou_02</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ben_city_cotonou_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:cotonou.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_cotonou_03</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ben_city_cotonou_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:cotonou.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_cotonou_04</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ben_city_cotonou_join" name="Checks complete">
      <bpmn:incoming>F_ben_city_cotonou_05</bpmn:incoming>
      <bpmn:incoming>F_ben_city_cotonou_06</bpmn:incoming>
      <bpmn:incoming>F_ben_city_cotonou_07</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ben_city_cotonou_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_cotonou_08</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ben_city_cotonou_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ben_city_cotonou_09</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ben_city_cotonou_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ben_city_cotonou_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:cotonou.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_cotonou_10a</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ben_city_cotonou_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ben.city:cotonou.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ben_city_cotonou_10b</bpmn:incoming>
      <bpmn:outgoing>F_ben_city_cotonou_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ben_city_cotonou" name="Process complete">
      <bpmn:incoming>F_ben_city_cotonou_11</bpmn:incoming>
      <bpmn:incoming>F_ben_city_cotonou_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_01" sourceRef="Start_ben_city_cotonou" targetRef="GW_ben_city_cotonou_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_02" sourceRef="GW_ben_city_cotonou_open" targetRef="T_ben_city_cotonou_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_03" sourceRef="GW_ben_city_cotonou_open" targetRef="T_ben_city_cotonou_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_04" sourceRef="GW_ben_city_cotonou_open" targetRef="T_ben_city_cotonou_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_05" sourceRef="T_ben_city_cotonou_policy" targetRef="GW_ben_city_cotonou_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_06" sourceRef="T_ben_city_cotonou_budget" targetRef="GW_ben_city_cotonou_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_07" sourceRef="T_ben_city_cotonou_coord" targetRef="GW_ben_city_cotonou_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_08" sourceRef="GW_ben_city_cotonou_join" targetRef="T_ben_city_cotonou_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_09" sourceRef="T_ben_city_cotonou_review" targetRef="GW_ben_city_cotonou_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_10a" sourceRef="GW_ben_city_cotonou_risk" targetRef="T_ben_city_cotonou_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_10b" sourceRef="GW_ben_city_cotonou_risk" targetRef="T_ben_city_cotonou_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_11" sourceRef="T_ben_city_cotonou_publish" targetRef="End_ben_city_cotonou">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ben_city_cotonou_11b" sourceRef="T_ben_city_cotonou_revise" targetRef="End_ben_city_cotonou">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ben_city_cotonou">
    <bpmndi:BPMNPlane id="BPMNPlane_ben_city_cotonou" bpmnElement="Collaboration_ben_city_cotonou" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
