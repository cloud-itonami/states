<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_swe_city_stockholm"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_swe_city_stockholm">
    <bpmn:participant id="Pool_swe_city_stockholm" name="Stockholm (city:sto)" processRef="Process_swe_city_stockholm" />
  </bpmn:collaboration>
  <bpmn:process id="Process_swe_city_stockholm" name="Stockholm — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_swe_city_stockholm" name="Policy trigger
received"><bpmn:outgoing>F_swe_city_stockholm_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_swe_city_stockholm_open" name="Parallel checks">
      <bpmn:incoming>F_swe_city_stockholm_01</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_02</bpmn:outgoing>
      <bpmn:outgoing>F_swe_city_stockholm_03</bpmn:outgoing>
      <bpmn:outgoing>F_swe_city_stockholm_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_swe_city_stockholm_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swe.city:stockholm.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swe_city_stockholm_02</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_swe_city_stockholm_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swe.city:stockholm.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swe_city_stockholm_03</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_swe_city_stockholm_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swe.city:stockholm.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swe_city_stockholm_04</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_swe_city_stockholm_join" name="Checks complete">
      <bpmn:incoming>F_swe_city_stockholm_05</bpmn:incoming>
      <bpmn:incoming>F_swe_city_stockholm_06</bpmn:incoming>
      <bpmn:incoming>F_swe_city_stockholm_07</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_swe_city_stockholm_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_swe_city_stockholm_08</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_swe_city_stockholm_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_swe_city_stockholm_09</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_10a</bpmn:outgoing>
      <bpmn:outgoing>F_swe_city_stockholm_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_swe_city_stockholm_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swe.city:stockholm.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swe_city_stockholm_10a</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_swe_city_stockholm_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swe.city:stockholm.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swe_city_stockholm_10b</bpmn:incoming>
      <bpmn:outgoing>F_swe_city_stockholm_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_swe_city_stockholm" name="Process complete">
      <bpmn:incoming>F_swe_city_stockholm_11</bpmn:incoming>
      <bpmn:incoming>F_swe_city_stockholm_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_01" sourceRef="Start_swe_city_stockholm" targetRef="GW_swe_city_stockholm_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_02" sourceRef="GW_swe_city_stockholm_open" targetRef="T_swe_city_stockholm_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_03" sourceRef="GW_swe_city_stockholm_open" targetRef="T_swe_city_stockholm_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_04" sourceRef="GW_swe_city_stockholm_open" targetRef="T_swe_city_stockholm_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_05" sourceRef="T_swe_city_stockholm_policy" targetRef="GW_swe_city_stockholm_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_06" sourceRef="T_swe_city_stockholm_budget" targetRef="GW_swe_city_stockholm_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_07" sourceRef="T_swe_city_stockholm_coord" targetRef="GW_swe_city_stockholm_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_08" sourceRef="GW_swe_city_stockholm_join" targetRef="T_swe_city_stockholm_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_09" sourceRef="T_swe_city_stockholm_review" targetRef="GW_swe_city_stockholm_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_10a" sourceRef="GW_swe_city_stockholm_risk" targetRef="T_swe_city_stockholm_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_10b" sourceRef="GW_swe_city_stockholm_risk" targetRef="T_swe_city_stockholm_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_11" sourceRef="T_swe_city_stockholm_publish" targetRef="End_swe_city_stockholm">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swe_city_stockholm_11b" sourceRef="T_swe_city_stockholm_revise" targetRef="End_swe_city_stockholm">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_swe_city_stockholm">
    <bpmndi:BPMNPlane id="BPMNPlane_swe_city_stockholm" bpmnElement="Collaboration_swe_city_stockholm" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
