<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_tza_city_dodoma"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_tza_city_dodoma">
    <bpmn:participant id="Pool_tza_city_dodoma" name="Dodoma (city:dod)" processRef="Process_tza_city_dodoma" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tza_city_dodoma" name="Dodoma — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_tza_city_dodoma" name="Policy trigger
received"><bpmn:outgoing>F_tza_city_dodoma_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_tza_city_dodoma_open" name="Parallel checks">
      <bpmn:incoming>F_tza_city_dodoma_01</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_02</bpmn:outgoing>
      <bpmn:outgoing>F_tza_city_dodoma_03</bpmn:outgoing>
      <bpmn:outgoing>F_tza_city_dodoma_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_tza_city_dodoma_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tza.city:dodoma.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tza_city_dodoma_02</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tza_city_dodoma_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tza.city:dodoma.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tza_city_dodoma_03</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tza_city_dodoma_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tza.city:dodoma.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tza_city_dodoma_04</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_tza_city_dodoma_join" name="Checks complete">
      <bpmn:incoming>F_tza_city_dodoma_05</bpmn:incoming>
      <bpmn:incoming>F_tza_city_dodoma_06</bpmn:incoming>
      <bpmn:incoming>F_tza_city_dodoma_07</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_tza_city_dodoma_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_tza_city_dodoma_08</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_tza_city_dodoma_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_tza_city_dodoma_09</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_10a</bpmn:outgoing>
      <bpmn:outgoing>F_tza_city_dodoma_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_tza_city_dodoma_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tza.city:dodoma.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tza_city_dodoma_10a</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tza_city_dodoma_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tza.city:dodoma.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tza_city_dodoma_10b</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dodoma_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_tza_city_dodoma" name="Process complete">
      <bpmn:incoming>F_tza_city_dodoma_11</bpmn:incoming>
      <bpmn:incoming>F_tza_city_dodoma_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_01" sourceRef="Start_tza_city_dodoma" targetRef="GW_tza_city_dodoma_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_02" sourceRef="GW_tza_city_dodoma_open" targetRef="T_tza_city_dodoma_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_03" sourceRef="GW_tza_city_dodoma_open" targetRef="T_tza_city_dodoma_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_04" sourceRef="GW_tza_city_dodoma_open" targetRef="T_tza_city_dodoma_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_05" sourceRef="T_tza_city_dodoma_policy" targetRef="GW_tza_city_dodoma_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_06" sourceRef="T_tza_city_dodoma_budget" targetRef="GW_tza_city_dodoma_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_07" sourceRef="T_tza_city_dodoma_coord" targetRef="GW_tza_city_dodoma_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_08" sourceRef="GW_tza_city_dodoma_join" targetRef="T_tza_city_dodoma_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_09" sourceRef="T_tza_city_dodoma_review" targetRef="GW_tza_city_dodoma_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_10a" sourceRef="GW_tza_city_dodoma_risk" targetRef="T_tza_city_dodoma_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_10b" sourceRef="GW_tza_city_dodoma_risk" targetRef="T_tza_city_dodoma_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_11" sourceRef="T_tza_city_dodoma_publish" targetRef="End_tza_city_dodoma">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dodoma_11b" sourceRef="T_tza_city_dodoma_revise" targetRef="End_tza_city_dodoma">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_tza_city_dodoma">
    <bpmndi:BPMNPlane id="BPMNPlane_tza_city_dodoma" bpmnElement="Collaboration_tza_city_dodoma" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
