    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_02" sourceRef="GW_tza_city_dar_es_salaam_open" targetRef="T_tza_city_dar_es_salaam_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_03" sourceRef="GW_tza_city_dar_es_salaam_open" targetRef="T_tza_city_dar_es_salaam_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_04" sourceRef="GW_tza_city_dar_es_salaam_open" targetRef="T_tza_city_dar_es_salaam_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_05" sourceRef="T_tza_city_dar_es_salaam_policy" targetRef="GW_tza_city_dar_es_salaam_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_06" sourceRef="T_tza_city_dar_es_salaam_budget" targetRef="GW_tza_city_dar_es_salaam_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_07" sourceRef="T_tza_city_dar_es_salaam_coord" targetRef="GW_tza_city_dar_es_salaam_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_08" sourceRef="GW_tza_city_dar_es_salaam_join" targetRef="T_tza_city_dar_es_salaam_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tza_city_dar_es_salaam_09" sourceRef="T_tza_city_dar_es_salaam_review" targetRef="GW_tza_city_dar_es_salaam_risk">
