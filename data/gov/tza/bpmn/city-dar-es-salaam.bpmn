      <bpmn:outgoing>F_tza_city_dar_es_salaam_03</bpmn:outgoing>
      <bpmn:outgoing>F_tza_city_dar_es_salaam_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_tza_city_dar_es_salaam_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tza.city:dar-es-salaam.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
