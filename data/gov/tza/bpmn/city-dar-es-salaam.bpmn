      <bpmn:incoming>F_tza_city_dar_es_salaam_06</bpmn:incoming>
      <bpmn:incoming>F_tza_city_dar_es_salaam_07</bpmn:incoming>
      <bpmn:outgoing>F_tza_city_dar_es_salaam_08</bpmn:outgoing>
