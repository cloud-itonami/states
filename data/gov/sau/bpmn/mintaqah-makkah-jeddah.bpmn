<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_sau_mintaqah_makkah_jeddah"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_sau_mintaqah_makkah_jeddah">
    <bpmn:participant id="Pool_sau_mintaqah_makkah_jeddah" name="Jeddah (mintaqah)" processRef="Process_sau_mintaqah_makkah_jeddah" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sau_mintaqah_makkah_jeddah" name="Jeddah — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_sau_mintaqah_makkah_jeddah" name="Policy trigger
received"><bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_sau_mintaqah_makkah_jeddah_open" name="Parallel checks">
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_01</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_02</bpmn:outgoing>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_03</bpmn:outgoing>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_sau_mintaqah_makkah_jeddah_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sau.mintaqah:makkah:jeddah.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_02</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sau_mintaqah_makkah_jeddah_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sau.mintaqah:makkah:jeddah.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_03</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sau_mintaqah_makkah_jeddah_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sau.mintaqah:makkah:jeddah.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_04</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_sau_mintaqah_makkah_jeddah_join" name="Checks complete">
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_05</bpmn:incoming>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_06</bpmn:incoming>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_07</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_sau_mintaqah_makkah_jeddah_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_08</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_sau_mintaqah_makkah_jeddah_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_09</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_10a</bpmn:outgoing>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_sau_mintaqah_makkah_jeddah_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sau.mintaqah:makkah:jeddah.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_10a</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sau_mintaqah_makkah_jeddah_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sau.mintaqah:makkah:jeddah.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_10b</bpmn:incoming>
      <bpmn:outgoing>F_sau_mintaqah_makkah_jeddah_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sau_mintaqah_makkah_jeddah" name="Process complete">
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_11</bpmn:incoming>
      <bpmn:incoming>F_sau_mintaqah_makkah_jeddah_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_01" sourceRef="Start_sau_mintaqah_makkah_jeddah" targetRef="GW_sau_mintaqah_makkah_jeddah_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_02" sourceRef="GW_sau_mintaqah_makkah_jeddah_open" targetRef="T_sau_mintaqah_makkah_jeddah_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_03" sourceRef="GW_sau_mintaqah_makkah_jeddah_open" targetRef="T_sau_mintaqah_makkah_jeddah_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_04" sourceRef="GW_sau_mintaqah_makkah_jeddah_open" targetRef="T_sau_mintaqah_makkah_jeddah_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_05" sourceRef="T_sau_mintaqah_makkah_jeddah_policy" targetRef="GW_sau_mintaqah_makkah_jeddah_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_06" sourceRef="T_sau_mintaqah_makkah_jeddah_budget" targetRef="GW_sau_mintaqah_makkah_jeddah_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_07" sourceRef="T_sau_mintaqah_makkah_jeddah_coord" targetRef="GW_sau_mintaqah_makkah_jeddah_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_08" sourceRef="GW_sau_mintaqah_makkah_jeddah_join" targetRef="T_sau_mintaqah_makkah_jeddah_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_09" sourceRef="T_sau_mintaqah_makkah_jeddah_review" targetRef="GW_sau_mintaqah_makkah_jeddah_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_10a" sourceRef="GW_sau_mintaqah_makkah_jeddah_risk" targetRef="T_sau_mintaqah_makkah_jeddah_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_10b" sourceRef="GW_sau_mintaqah_makkah_jeddah_risk" targetRef="T_sau_mintaqah_makkah_jeddah_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_11" sourceRef="T_sau_mintaqah_makkah_jeddah_publish" targetRef="End_sau_mintaqah_makkah_jeddah">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sau_mintaqah_makkah_jeddah_11b" sourceRef="T_sau_mintaqah_makkah_jeddah_revise" targetRef="End_sau_mintaqah_makkah_jeddah">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sau_mintaqah_makkah_jeddah">
    <bpmndi:BPMNPlane id="BPMNPlane_sau_mintaqah_makkah_jeddah" bpmnElement="Collaboration_sau_mintaqah_makkah_jeddah" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
