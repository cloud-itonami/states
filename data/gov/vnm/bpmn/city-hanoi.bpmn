<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_vnm_city_hanoi"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_vnm_city_hanoi">
    <bpmn:participant id="Pool_vnm_city_hanoi" name="Hanoi (city:han)" processRef="Process_vnm_city_hanoi" />
  </bpmn:collaboration>
  <bpmn:process id="Process_vnm_city_hanoi" name="Hanoi — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_vnm_city_hanoi" name="Policy trigger
received"><bpmn:outgoing>F_vnm_city_hanoi_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_vnm_city_hanoi_open" name="Parallel checks">
      <bpmn:incoming>F_vnm_city_hanoi_01</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_02</bpmn:outgoing>
      <bpmn:outgoing>F_vnm_city_hanoi_03</bpmn:outgoing>
      <bpmn:outgoing>F_vnm_city_hanoi_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_vnm_city_hanoi_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.vnm.city:hanoi.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_vnm_city_hanoi_02</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_vnm_city_hanoi_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.vnm.city:hanoi.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_vnm_city_hanoi_03</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_vnm_city_hanoi_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.vnm.city:hanoi.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_vnm_city_hanoi_04</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_vnm_city_hanoi_join" name="Checks complete">
      <bpmn:incoming>F_vnm_city_hanoi_05</bpmn:incoming>
      <bpmn:incoming>F_vnm_city_hanoi_06</bpmn:incoming>
      <bpmn:incoming>F_vnm_city_hanoi_07</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_vnm_city_hanoi_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_vnm_city_hanoi_08</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_vnm_city_hanoi_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_vnm_city_hanoi_09</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_10a</bpmn:outgoing>
      <bpmn:outgoing>F_vnm_city_hanoi_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_vnm_city_hanoi_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.vnm.city:hanoi.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_vnm_city_hanoi_10a</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_vnm_city_hanoi_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.vnm.city:hanoi.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_vnm_city_hanoi_10b</bpmn:incoming>
      <bpmn:outgoing>F_vnm_city_hanoi_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_vnm_city_hanoi" name="Process complete">
      <bpmn:incoming>F_vnm_city_hanoi_11</bpmn:incoming>
      <bpmn:incoming>F_vnm_city_hanoi_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_01" sourceRef="Start_vnm_city_hanoi" targetRef="GW_vnm_city_hanoi_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_02" sourceRef="GW_vnm_city_hanoi_open" targetRef="T_vnm_city_hanoi_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_03" sourceRef="GW_vnm_city_hanoi_open" targetRef="T_vnm_city_hanoi_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_04" sourceRef="GW_vnm_city_hanoi_open" targetRef="T_vnm_city_hanoi_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_05" sourceRef="T_vnm_city_hanoi_policy" targetRef="GW_vnm_city_hanoi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_06" sourceRef="T_vnm_city_hanoi_budget" targetRef="GW_vnm_city_hanoi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_07" sourceRef="T_vnm_city_hanoi_coord" targetRef="GW_vnm_city_hanoi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_08" sourceRef="GW_vnm_city_hanoi_join" targetRef="T_vnm_city_hanoi_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_09" sourceRef="T_vnm_city_hanoi_review" targetRef="GW_vnm_city_hanoi_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_10a" sourceRef="GW_vnm_city_hanoi_risk" targetRef="T_vnm_city_hanoi_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_10b" sourceRef="GW_vnm_city_hanoi_risk" targetRef="T_vnm_city_hanoi_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_11" sourceRef="T_vnm_city_hanoi_publish" targetRef="End_vnm_city_hanoi">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_vnm_city_hanoi_11b" sourceRef="T_vnm_city_hanoi_revise" targetRef="End_vnm_city_hanoi">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_vnm_city_hanoi">
    <bpmndi:BPMNPlane id="BPMNPlane_vnm_city_hanoi" bpmnElement="Collaboration_vnm_city_hanoi" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
