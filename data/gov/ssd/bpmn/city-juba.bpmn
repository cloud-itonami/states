<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ssd_city_juba"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ssd_city_juba">
    <bpmn:participant id="Pool_ssd_city_juba" name="Juba (city:jub)" processRef="Process_ssd_city_juba" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ssd_city_juba" name="Juba — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ssd_city_juba" name="Policy trigger
received"><bpmn:outgoing>F_ssd_city_juba_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ssd_city_juba_open" name="Parallel checks">
      <bpmn:incoming>F_ssd_city_juba_01</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_02</bpmn:outgoing>
      <bpmn:outgoing>F_ssd_city_juba_03</bpmn:outgoing>
      <bpmn:outgoing>F_ssd_city_juba_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ssd_city_juba_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ssd.city:juba.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ssd_city_juba_02</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ssd_city_juba_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ssd.city:juba.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ssd_city_juba_03</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ssd_city_juba_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ssd.city:juba.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ssd_city_juba_04</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ssd_city_juba_join" name="Checks complete">
      <bpmn:incoming>F_ssd_city_juba_05</bpmn:incoming>
      <bpmn:incoming>F_ssd_city_juba_06</bpmn:incoming>
      <bpmn:incoming>F_ssd_city_juba_07</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ssd_city_juba_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ssd_city_juba_08</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ssd_city_juba_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ssd_city_juba_09</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ssd_city_juba_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ssd_city_juba_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ssd.city:juba.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ssd_city_juba_10a</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ssd_city_juba_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ssd.city:juba.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ssd_city_juba_10b</bpmn:incoming>
      <bpmn:outgoing>F_ssd_city_juba_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ssd_city_juba" name="Process complete">
      <bpmn:incoming>F_ssd_city_juba_11</bpmn:incoming>
      <bpmn:incoming>F_ssd_city_juba_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ssd_city_juba_01" sourceRef="Start_ssd_city_juba" targetRef="GW_ssd_city_juba_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_02" sourceRef="GW_ssd_city_juba_open" targetRef="T_ssd_city_juba_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_03" sourceRef="GW_ssd_city_juba_open" targetRef="T_ssd_city_juba_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_04" sourceRef="GW_ssd_city_juba_open" targetRef="T_ssd_city_juba_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_05" sourceRef="T_ssd_city_juba_policy" targetRef="GW_ssd_city_juba_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_06" sourceRef="T_ssd_city_juba_budget" targetRef="GW_ssd_city_juba_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_07" sourceRef="T_ssd_city_juba_coord" targetRef="GW_ssd_city_juba_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_08" sourceRef="GW_ssd_city_juba_join" targetRef="T_ssd_city_juba_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_09" sourceRef="T_ssd_city_juba_review" targetRef="GW_ssd_city_juba_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_10a" sourceRef="GW_ssd_city_juba_risk" targetRef="T_ssd_city_juba_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_10b" sourceRef="GW_ssd_city_juba_risk" targetRef="T_ssd_city_juba_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_11" sourceRef="T_ssd_city_juba_publish" targetRef="End_ssd_city_juba">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ssd_city_juba_11b" sourceRef="T_ssd_city_juba_revise" targetRef="End_ssd_city_juba">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ssd_city_juba">
    <bpmndi:BPMNPlane id="BPMNPlane_ssd_city_juba" bpmnElement="Collaboration_ssd_city_juba" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
