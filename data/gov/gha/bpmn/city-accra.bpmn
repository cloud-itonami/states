<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_gha_city_accra"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_gha_city_accra">
    <bpmn:participant id="Pool_gha_city_accra" name="Accra (city:acc)" processRef="Process_gha_city_accra" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gha_city_accra" name="Accra — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_gha_city_accra" name="Policy trigger
received"><bpmn:outgoing>F_gha_city_accra_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_gha_city_accra_open" name="Parallel checks">
      <bpmn:incoming>F_gha_city_accra_01</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_02</bpmn:outgoing>
      <bpmn:outgoing>F_gha_city_accra_03</bpmn:outgoing>
      <bpmn:outgoing>F_gha_city_accra_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_gha_city_accra_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gha.city:accra.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gha_city_accra_02</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gha_city_accra_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gha.city:accra.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gha_city_accra_03</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gha_city_accra_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gha.city:accra.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gha_city_accra_04</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_gha_city_accra_join" name="Checks complete">
      <bpmn:incoming>F_gha_city_accra_05</bpmn:incoming>
      <bpmn:incoming>F_gha_city_accra_06</bpmn:incoming>
      <bpmn:incoming>F_gha_city_accra_07</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_gha_city_accra_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_gha_city_accra_08</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_gha_city_accra_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_gha_city_accra_09</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_10a</bpmn:outgoing>
      <bpmn:outgoing>F_gha_city_accra_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_gha_city_accra_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gha.city:accra.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gha_city_accra_10a</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gha_city_accra_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gha.city:accra.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gha_city_accra_10b</bpmn:incoming>
      <bpmn:outgoing>F_gha_city_accra_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_gha_city_accra" name="Process complete">
      <bpmn:incoming>F_gha_city_accra_11</bpmn:incoming>
      <bpmn:incoming>F_gha_city_accra_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_gha_city_accra_01" sourceRef="Start_gha_city_accra" targetRef="GW_gha_city_accra_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_02" sourceRef="GW_gha_city_accra_open" targetRef="T_gha_city_accra_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_03" sourceRef="GW_gha_city_accra_open" targetRef="T_gha_city_accra_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_04" sourceRef="GW_gha_city_accra_open" targetRef="T_gha_city_accra_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_05" sourceRef="T_gha_city_accra_policy" targetRef="GW_gha_city_accra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_06" sourceRef="T_gha_city_accra_budget" targetRef="GW_gha_city_accra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_07" sourceRef="T_gha_city_accra_coord" targetRef="GW_gha_city_accra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_08" sourceRef="GW_gha_city_accra_join" targetRef="T_gha_city_accra_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_09" sourceRef="T_gha_city_accra_review" targetRef="GW_gha_city_accra_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_10a" sourceRef="GW_gha_city_accra_risk" targetRef="T_gha_city_accra_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_10b" sourceRef="GW_gha_city_accra_risk" targetRef="T_gha_city_accra_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_11" sourceRef="T_gha_city_accra_publish" targetRef="End_gha_city_accra">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gha_city_accra_11b" sourceRef="T_gha_city_accra_revise" targetRef="End_gha_city_accra">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_gha_city_accra">
    <bpmndi:BPMNPlane id="BPMNPlane_gha_city_accra" bpmnElement="Collaboration_gha_city_accra" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
