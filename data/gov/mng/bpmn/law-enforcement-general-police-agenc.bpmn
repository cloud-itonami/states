<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mng_law_enforcement_general_police_agenc"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mng_law_enforcement_general_police_agenc">
    <bpmn:participant id="Pool_mng_law_enforcement_general_police_agenc" name="Law Enforcement General Police Agenc (law-enfo)" processRef="Process_mng_law_enforcement_general_police_agenc" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mng_law_enforcement_general_police_agenc" name="Law Enforcement General Police Agenc — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_mng_law_enforcement_general_police_agenc" name="Incident
reported"><bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_mng_law_enforcement_general_police_agenc_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.law-enforcement-general-police-agenc.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_01</bpmn:incoming>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_mng_law_enforcement_general_police_agenc_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_02</bpmn:incoming>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_03a</bpmn:outgoing>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_03b</bpmn:outgoing>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mng_law_enforcement_general_police_agenc_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.law-enforcement-general-police-agenc.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_03a</bpmn:incoming>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_law_enforcement_general_police_agenc_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.law-enforcement-general-police-agenc.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_03b</bpmn:incoming>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_law_enforcement_general_police_agenc_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.law-enforcement-general-police-agenc.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_03c</bpmn:incoming>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_law_enforcement_general_police_agenc_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.law-enforcement-general-police-agenc.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_06</bpmn:incoming>
      <bpmn:outgoing>F_mng_law_enforcement_general_police_agenc_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mng_law_enforcement_general_police_agenc" name="Incident resolved">
      <bpmn:incoming>F_mng_law_enforcement_general_police_agenc_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_01" sourceRef="Start_mng_law_enforcement_general_police_agenc" targetRef="T_mng_law_enforcement_general_police_agenc_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_02" sourceRef="T_mng_law_enforcement_general_police_agenc_triage" targetRef="GW_mng_law_enforcement_general_police_agenc_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_03a" sourceRef="GW_mng_law_enforcement_general_police_agenc_sev" targetRef="T_mng_law_enforcement_general_police_agenc_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_03b" sourceRef="GW_mng_law_enforcement_general_police_agenc_sev" targetRef="T_mng_law_enforcement_general_police_agenc_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_03c" sourceRef="GW_mng_law_enforcement_general_police_agenc_sev" targetRef="T_mng_law_enforcement_general_police_agenc_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_06" sourceRef="T_mng_law_enforcement_general_police_agenc_emergency" targetRef="T_mng_law_enforcement_general_police_agenc_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_06b" sourceRef="T_mng_law_enforcement_general_police_agenc_investigate" targetRef="T_mng_law_enforcement_general_police_agenc_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_06c" sourceRef="T_mng_law_enforcement_general_police_agenc_log" targetRef="T_mng_law_enforcement_general_police_agenc_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_law_enforcement_general_police_agenc_07" sourceRef="T_mng_law_enforcement_general_police_agenc_report" targetRef="End_mng_law_enforcement_general_police_agenc">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mng_law_enforcement_general_police_agenc">
    <bpmndi:BPMNPlane id="BPMNPlane_mng_law_enforcement_general_police_agenc" bpmnElement="Collaboration_mng_law_enforcement_general_police_agenc" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
