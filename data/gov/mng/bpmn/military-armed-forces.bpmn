<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mng_military_armed_forces"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mng_military_armed_forces">
    <bpmn:participant id="Pool_mng_military_armed_forces" name="Military Armed Forces (22yh343c)" processRef="Process_mng_military_armed_forces" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mng_military_armed_forces" name="Military Armed Forces — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_mng_military_armed_forces" name="Readiness
assessment triggered"><bpmn:outgoing>F_mng_military_armed_forces_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_mng_military_armed_forces_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.military-armed-forces.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_military_armed_forces_01</bpmn:incoming>
      <bpmn:outgoing>F_mng_military_armed_forces_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_mng_military_armed_forces_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_mng_military_armed_forces_02</bpmn:incoming>
      <bpmn:outgoing>F_mng_military_armed_forces_03a</bpmn:outgoing>
      <bpmn:outgoing>F_mng_military_armed_forces_03b</bpmn:outgoing>
      <bpmn:outgoing>F_mng_military_armed_forces_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mng_military_armed_forces_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.military-armed-forces.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_military_armed_forces_03a</bpmn:incoming>
      <bpmn:outgoing>F_mng_military_armed_forces_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_military_armed_forces_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.military-armed-forces.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_military_armed_forces_03b</bpmn:incoming>
      <bpmn:outgoing>F_mng_military_armed_forces_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_military_armed_forces_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.military-armed-forces.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_military_armed_forces_03c</bpmn:incoming>
      <bpmn:outgoing>F_mng_military_armed_forces_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_military_armed_forces_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.military-armed-forces.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_military_armed_forces_04</bpmn:incoming>
      <bpmn:outgoing>F_mng_military_armed_forces_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mng_military_armed_forces" name="Assessment complete">
      <bpmn:incoming>F_mng_military_armed_forces_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_01" sourceRef="Start_mng_military_armed_forces" targetRef="T_mng_military_armed_forces_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_02" sourceRef="T_mng_military_armed_forces_assess" targetRef="GW_mng_military_armed_forces_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_03a" sourceRef="GW_mng_military_armed_forces_ready" targetRef="T_mng_military_armed_forces_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_03b" sourceRef="GW_mng_military_armed_forces_ready" targetRef="T_mng_military_armed_forces_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_03c" sourceRef="GW_mng_military_armed_forces_ready" targetRef="T_mng_military_armed_forces_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_04" sourceRef="T_mng_military_armed_forces_ops" targetRef="T_mng_military_armed_forces_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_04b" sourceRef="T_mng_military_armed_forces_proc" targetRef="T_mng_military_armed_forces_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_04c" sourceRef="T_mng_military_armed_forces_alert" targetRef="T_mng_military_armed_forces_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_military_armed_forces_05" sourceRef="T_mng_military_armed_forces_report" targetRef="End_mng_military_armed_forces">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mng_military_armed_forces">
    <bpmndi:BPMNPlane id="BPMNPlane_mng_military_armed_forces" bpmnElement="Collaboration_mng_military_armed_forces" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
