<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mng_legislative_state_great"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mng_legislative_state_great">
    <bpmn:participant id="Pool_mng_legislative_state_great" name="Legislative State Great (legislat)" processRef="Process_mng_legislative_state_great" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mng_legislative_state_great" name="Legislative State Great — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mng_legislative_state_great" name="Policy trigger
received"><bpmn:outgoing>F_mng_legislative_state_great_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mng_legislative_state_great_open" name="Parallel checks">
      <bpmn:incoming>F_mng_legislative_state_great_01</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_02</bpmn:outgoing>
      <bpmn:outgoing>F_mng_legislative_state_great_03</bpmn:outgoing>
      <bpmn:outgoing>F_mng_legislative_state_great_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mng_legislative_state_great_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.legislative-state-great.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_legislative_state_great_02</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_legislative_state_great_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.legislative-state-great.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_legislative_state_great_03</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_legislative_state_great_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.legislative-state-great.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_legislative_state_great_04</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mng_legislative_state_great_join" name="Checks complete">
      <bpmn:incoming>F_mng_legislative_state_great_05</bpmn:incoming>
      <bpmn:incoming>F_mng_legislative_state_great_06</bpmn:incoming>
      <bpmn:incoming>F_mng_legislative_state_great_07</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mng_legislative_state_great_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_legislative_state_great_08</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mng_legislative_state_great_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mng_legislative_state_great_09</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mng_legislative_state_great_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mng_legislative_state_great_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.legislative-state-great.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_legislative_state_great_10a</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mng_legislative_state_great_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mng.legislative-state-great.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mng_legislative_state_great_10b</bpmn:incoming>
      <bpmn:outgoing>F_mng_legislative_state_great_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mng_legislative_state_great" name="Process complete">
      <bpmn:incoming>F_mng_legislative_state_great_11</bpmn:incoming>
      <bpmn:incoming>F_mng_legislative_state_great_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_01" sourceRef="Start_mng_legislative_state_great" targetRef="GW_mng_legislative_state_great_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_02" sourceRef="GW_mng_legislative_state_great_open" targetRef="T_mng_legislative_state_great_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_03" sourceRef="GW_mng_legislative_state_great_open" targetRef="T_mng_legislative_state_great_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_04" sourceRef="GW_mng_legislative_state_great_open" targetRef="T_mng_legislative_state_great_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_05" sourceRef="T_mng_legislative_state_great_policy" targetRef="GW_mng_legislative_state_great_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_06" sourceRef="T_mng_legislative_state_great_budget" targetRef="GW_mng_legislative_state_great_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_07" sourceRef="T_mng_legislative_state_great_coord" targetRef="GW_mng_legislative_state_great_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_08" sourceRef="GW_mng_legislative_state_great_join" targetRef="T_mng_legislative_state_great_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_09" sourceRef="T_mng_legislative_state_great_review" targetRef="GW_mng_legislative_state_great_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_10a" sourceRef="GW_mng_legislative_state_great_risk" targetRef="T_mng_legislative_state_great_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_10b" sourceRef="GW_mng_legislative_state_great_risk" targetRef="T_mng_legislative_state_great_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_11" sourceRef="T_mng_legislative_state_great_publish" targetRef="End_mng_legislative_state_great">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mng_legislative_state_great_11b" sourceRef="T_mng_legislative_state_great_revise" targetRef="End_mng_legislative_state_great">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mng_legislative_state_great">
    <bpmndi:BPMNPlane id="BPMNPlane_mng_legislative_state_great" bpmnElement="Collaboration_mng_legislative_state_great" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
