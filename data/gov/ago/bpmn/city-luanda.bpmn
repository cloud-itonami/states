<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ago_city_luanda"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ago_city_luanda">
    <bpmn:participant id="Pool_ago_city_luanda" name="Luanda (city:lua)" processRef="Process_ago_city_luanda" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ago_city_luanda" name="Luanda — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ago_city_luanda" name="Policy trigger
received"><bpmn:outgoing>F_ago_city_luanda_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ago_city_luanda_open" name="Parallel checks">
      <bpmn:incoming>F_ago_city_luanda_01</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_02</bpmn:outgoing>
      <bpmn:outgoing>F_ago_city_luanda_03</bpmn:outgoing>
      <bpmn:outgoing>F_ago_city_luanda_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ago_city_luanda_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ago.city:luanda.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ago_city_luanda_02</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ago_city_luanda_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ago.city:luanda.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ago_city_luanda_03</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ago_city_luanda_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ago.city:luanda.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ago_city_luanda_04</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ago_city_luanda_join" name="Checks complete">
      <bpmn:incoming>F_ago_city_luanda_05</bpmn:incoming>
      <bpmn:incoming>F_ago_city_luanda_06</bpmn:incoming>
      <bpmn:incoming>F_ago_city_luanda_07</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ago_city_luanda_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ago_city_luanda_08</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ago_city_luanda_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ago_city_luanda_09</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ago_city_luanda_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ago_city_luanda_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ago.city:luanda.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ago_city_luanda_10a</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ago_city_luanda_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ago.city:luanda.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ago_city_luanda_10b</bpmn:incoming>
      <bpmn:outgoing>F_ago_city_luanda_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ago_city_luanda" name="Process complete">
      <bpmn:incoming>F_ago_city_luanda_11</bpmn:incoming>
      <bpmn:incoming>F_ago_city_luanda_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ago_city_luanda_01" sourceRef="Start_ago_city_luanda" targetRef="GW_ago_city_luanda_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_02" sourceRef="GW_ago_city_luanda_open" targetRef="T_ago_city_luanda_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_03" sourceRef="GW_ago_city_luanda_open" targetRef="T_ago_city_luanda_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_04" sourceRef="GW_ago_city_luanda_open" targetRef="T_ago_city_luanda_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_05" sourceRef="T_ago_city_luanda_policy" targetRef="GW_ago_city_luanda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_06" sourceRef="T_ago_city_luanda_budget" targetRef="GW_ago_city_luanda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_07" sourceRef="T_ago_city_luanda_coord" targetRef="GW_ago_city_luanda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_08" sourceRef="GW_ago_city_luanda_join" targetRef="T_ago_city_luanda_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_09" sourceRef="T_ago_city_luanda_review" targetRef="GW_ago_city_luanda_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_10a" sourceRef="GW_ago_city_luanda_risk" targetRef="T_ago_city_luanda_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_10b" sourceRef="GW_ago_city_luanda_risk" targetRef="T_ago_city_luanda_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_11" sourceRef="T_ago_city_luanda_publish" targetRef="End_ago_city_luanda">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ago_city_luanda_11b" sourceRef="T_ago_city_luanda_revise" targetRef="End_ago_city_luanda">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ago_city_luanda">
    <bpmndi:BPMNPlane id="BPMNPlane_ago_city_luanda" bpmnElement="Collaboration_ago_city_luanda" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
