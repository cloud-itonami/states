<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_hun_city_budapest"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_hun_city_budapest">
    <bpmn:participant id="Pool_hun_city_budapest" name="Budapest (city:bud)" processRef="Process_hun_city_budapest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_hun_city_budapest" name="Budapest — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_hun_city_budapest" name="Policy trigger
received"><bpmn:outgoing>F_hun_city_budapest_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_hun_city_budapest_open" name="Parallel checks">
      <bpmn:incoming>F_hun_city_budapest_01</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_02</bpmn:outgoing>
      <bpmn:outgoing>F_hun_city_budapest_03</bpmn:outgoing>
      <bpmn:outgoing>F_hun_city_budapest_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_hun_city_budapest_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hun.city:budapest.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hun_city_budapest_02</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hun_city_budapest_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hun.city:budapest.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hun_city_budapest_03</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hun_city_budapest_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hun.city:budapest.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hun_city_budapest_04</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_hun_city_budapest_join" name="Checks complete">
      <bpmn:incoming>F_hun_city_budapest_05</bpmn:incoming>
      <bpmn:incoming>F_hun_city_budapest_06</bpmn:incoming>
      <bpmn:incoming>F_hun_city_budapest_07</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_hun_city_budapest_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_hun_city_budapest_08</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_hun_city_budapest_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_hun_city_budapest_09</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_10a</bpmn:outgoing>
      <bpmn:outgoing>F_hun_city_budapest_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_hun_city_budapest_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hun.city:budapest.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hun_city_budapest_10a</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hun_city_budapest_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hun.city:budapest.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hun_city_budapest_10b</bpmn:incoming>
      <bpmn:outgoing>F_hun_city_budapest_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hun_city_budapest" name="Process complete">
      <bpmn:incoming>F_hun_city_budapest_11</bpmn:incoming>
      <bpmn:incoming>F_hun_city_budapest_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hun_city_budapest_01" sourceRef="Start_hun_city_budapest" targetRef="GW_hun_city_budapest_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_02" sourceRef="GW_hun_city_budapest_open" targetRef="T_hun_city_budapest_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_03" sourceRef="GW_hun_city_budapest_open" targetRef="T_hun_city_budapest_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_04" sourceRef="GW_hun_city_budapest_open" targetRef="T_hun_city_budapest_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_05" sourceRef="T_hun_city_budapest_policy" targetRef="GW_hun_city_budapest_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_06" sourceRef="T_hun_city_budapest_budget" targetRef="GW_hun_city_budapest_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_07" sourceRef="T_hun_city_budapest_coord" targetRef="GW_hun_city_budapest_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_08" sourceRef="GW_hun_city_budapest_join" targetRef="T_hun_city_budapest_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_09" sourceRef="T_hun_city_budapest_review" targetRef="GW_hun_city_budapest_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_10a" sourceRef="GW_hun_city_budapest_risk" targetRef="T_hun_city_budapest_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_10b" sourceRef="GW_hun_city_budapest_risk" targetRef="T_hun_city_budapest_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_11" sourceRef="T_hun_city_budapest_publish" targetRef="End_hun_city_budapest">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hun_city_budapest_11b" sourceRef="T_hun_city_budapest_revise" targetRef="End_hun_city_budapest">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hun_city_budapest">
    <bpmndi:BPMNPlane id="BPMNPlane_hun_city_budapest" bpmnElement="Collaboration_hun_city_budapest" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
