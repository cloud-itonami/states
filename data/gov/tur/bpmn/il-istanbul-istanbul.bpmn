<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_tur_il_istanbul_istanbul"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_tur_il_istanbul_istanbul">
    <bpmn:participant id="Pool_tur_il_istanbul_istanbul" name="Istanbul (il:istan)" processRef="Process_tur_il_istanbul_istanbul" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tur_il_istanbul_istanbul" name="Istanbul — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_tur_il_istanbul_istanbul" name="Policy trigger
received"><bpmn:outgoing>F_tur_il_istanbul_istanbul_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_tur_il_istanbul_istanbul_open" name="Parallel checks">
      <bpmn:incoming>F_tur_il_istanbul_istanbul_01</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_02</bpmn:outgoing>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_03</bpmn:outgoing>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_tur_il_istanbul_istanbul_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tur.il:istanbul:istanbul.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_02</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tur_il_istanbul_istanbul_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tur.il:istanbul:istanbul.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_03</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tur_il_istanbul_istanbul_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tur.il:istanbul:istanbul.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_04</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_tur_il_istanbul_istanbul_join" name="Checks complete">
      <bpmn:incoming>F_tur_il_istanbul_istanbul_05</bpmn:incoming>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_06</bpmn:incoming>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_07</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_tur_il_istanbul_istanbul_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_08</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_tur_il_istanbul_istanbul_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_tur_il_istanbul_istanbul_09</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_10a</bpmn:outgoing>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_tur_il_istanbul_istanbul_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tur.il:istanbul:istanbul.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_10a</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tur_il_istanbul_istanbul_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tur.il:istanbul:istanbul.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_10b</bpmn:incoming>
      <bpmn:outgoing>F_tur_il_istanbul_istanbul_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_tur_il_istanbul_istanbul" name="Process complete">
      <bpmn:incoming>F_tur_il_istanbul_istanbul_11</bpmn:incoming>
      <bpmn:incoming>F_tur_il_istanbul_istanbul_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_01" sourceRef="Start_tur_il_istanbul_istanbul" targetRef="GW_tur_il_istanbul_istanbul_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_02" sourceRef="GW_tur_il_istanbul_istanbul_open" targetRef="T_tur_il_istanbul_istanbul_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_03" sourceRef="GW_tur_il_istanbul_istanbul_open" targetRef="T_tur_il_istanbul_istanbul_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_04" sourceRef="GW_tur_il_istanbul_istanbul_open" targetRef="T_tur_il_istanbul_istanbul_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_05" sourceRef="T_tur_il_istanbul_istanbul_policy" targetRef="GW_tur_il_istanbul_istanbul_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_06" sourceRef="T_tur_il_istanbul_istanbul_budget" targetRef="GW_tur_il_istanbul_istanbul_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_07" sourceRef="T_tur_il_istanbul_istanbul_coord" targetRef="GW_tur_il_istanbul_istanbul_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_08" sourceRef="GW_tur_il_istanbul_istanbul_join" targetRef="T_tur_il_istanbul_istanbul_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_09" sourceRef="T_tur_il_istanbul_istanbul_review" targetRef="GW_tur_il_istanbul_istanbul_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_10a" sourceRef="GW_tur_il_istanbul_istanbul_risk" targetRef="T_tur_il_istanbul_istanbul_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_10b" sourceRef="GW_tur_il_istanbul_istanbul_risk" targetRef="T_tur_il_istanbul_istanbul_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_11" sourceRef="T_tur_il_istanbul_istanbul_publish" targetRef="End_tur_il_istanbul_istanbul">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tur_il_istanbul_istanbul_11b" sourceRef="T_tur_il_istanbul_istanbul_revise" targetRef="End_tur_il_istanbul_istanbul">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_tur_il_istanbul_istanbul">
    <bpmndi:BPMNPlane id="BPMNPlane_tur_il_istanbul_istanbul" bpmnElement="Collaboration_tur_il_istanbul_istanbul" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
