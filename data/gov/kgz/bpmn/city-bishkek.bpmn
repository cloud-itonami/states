<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_kgz_city_bishkek"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_kgz_city_bishkek">
    <bpmn:participant id="Pool_kgz_city_bishkek" name="Bishkek (city:bis)" processRef="Process_kgz_city_bishkek" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kgz_city_bishkek" name="Bishkek — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_kgz_city_bishkek" name="Policy trigger
received"><bpmn:outgoing>F_kgz_city_bishkek_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_kgz_city_bishkek_open" name="Parallel checks">
      <bpmn:incoming>F_kgz_city_bishkek_01</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_02</bpmn:outgoing>
      <bpmn:outgoing>F_kgz_city_bishkek_03</bpmn:outgoing>
      <bpmn:outgoing>F_kgz_city_bishkek_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_kgz_city_bishkek_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kgz.city:bishkek.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kgz_city_bishkek_02</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kgz_city_bishkek_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kgz.city:bishkek.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kgz_city_bishkek_03</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kgz_city_bishkek_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kgz.city:bishkek.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kgz_city_bishkek_04</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_kgz_city_bishkek_join" name="Checks complete">
      <bpmn:incoming>F_kgz_city_bishkek_05</bpmn:incoming>
      <bpmn:incoming>F_kgz_city_bishkek_06</bpmn:incoming>
      <bpmn:incoming>F_kgz_city_bishkek_07</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_kgz_city_bishkek_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_kgz_city_bishkek_08</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_kgz_city_bishkek_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_kgz_city_bishkek_09</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_10a</bpmn:outgoing>
      <bpmn:outgoing>F_kgz_city_bishkek_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_kgz_city_bishkek_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kgz.city:bishkek.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kgz_city_bishkek_10a</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kgz_city_bishkek_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kgz.city:bishkek.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kgz_city_bishkek_10b</bpmn:incoming>
      <bpmn:outgoing>F_kgz_city_bishkek_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_kgz_city_bishkek" name="Process complete">
      <bpmn:incoming>F_kgz_city_bishkek_11</bpmn:incoming>
      <bpmn:incoming>F_kgz_city_bishkek_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_01" sourceRef="Start_kgz_city_bishkek" targetRef="GW_kgz_city_bishkek_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_02" sourceRef="GW_kgz_city_bishkek_open" targetRef="T_kgz_city_bishkek_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_03" sourceRef="GW_kgz_city_bishkek_open" targetRef="T_kgz_city_bishkek_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_04" sourceRef="GW_kgz_city_bishkek_open" targetRef="T_kgz_city_bishkek_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_05" sourceRef="T_kgz_city_bishkek_policy" targetRef="GW_kgz_city_bishkek_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_06" sourceRef="T_kgz_city_bishkek_budget" targetRef="GW_kgz_city_bishkek_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_07" sourceRef="T_kgz_city_bishkek_coord" targetRef="GW_kgz_city_bishkek_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_08" sourceRef="GW_kgz_city_bishkek_join" targetRef="T_kgz_city_bishkek_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_09" sourceRef="T_kgz_city_bishkek_review" targetRef="GW_kgz_city_bishkek_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_10a" sourceRef="GW_kgz_city_bishkek_risk" targetRef="T_kgz_city_bishkek_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_10b" sourceRef="GW_kgz_city_bishkek_risk" targetRef="T_kgz_city_bishkek_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_11" sourceRef="T_kgz_city_bishkek_publish" targetRef="End_kgz_city_bishkek">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kgz_city_bishkek_11b" sourceRef="T_kgz_city_bishkek_revise" targetRef="End_kgz_city_bishkek">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_kgz_city_bishkek">
    <bpmndi:BPMNPlane id="BPMNPlane_kgz_city_bishkek" bpmnElement="Collaboration_kgz_city_bishkek" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
