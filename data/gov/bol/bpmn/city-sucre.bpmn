<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bol_city_sucre"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bol_city_sucre">
    <bpmn:participant id="Pool_bol_city_sucre" name="Sucre (city:suc)" processRef="Process_bol_city_sucre" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bol_city_sucre" name="Sucre — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bol_city_sucre" name="Policy trigger
received"><bpmn:outgoing>F_bol_city_sucre_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bol_city_sucre_open" name="Parallel checks">
      <bpmn:incoming>F_bol_city_sucre_01</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_02</bpmn:outgoing>
      <bpmn:outgoing>F_bol_city_sucre_03</bpmn:outgoing>
      <bpmn:outgoing>F_bol_city_sucre_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bol_city_sucre_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:sucre.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_sucre_02</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bol_city_sucre_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:sucre.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_sucre_03</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bol_city_sucre_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:sucre.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_sucre_04</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bol_city_sucre_join" name="Checks complete">
      <bpmn:incoming>F_bol_city_sucre_05</bpmn:incoming>
      <bpmn:incoming>F_bol_city_sucre_06</bpmn:incoming>
      <bpmn:incoming>F_bol_city_sucre_07</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bol_city_sucre_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_sucre_08</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bol_city_sucre_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bol_city_sucre_09</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bol_city_sucre_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bol_city_sucre_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:sucre.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_sucre_10a</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bol_city_sucre_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:sucre.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_sucre_10b</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_sucre_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bol_city_sucre" name="Process complete">
      <bpmn:incoming>F_bol_city_sucre_11</bpmn:incoming>
      <bpmn:incoming>F_bol_city_sucre_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bol_city_sucre_01" sourceRef="Start_bol_city_sucre" targetRef="GW_bol_city_sucre_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_02" sourceRef="GW_bol_city_sucre_open" targetRef="T_bol_city_sucre_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_03" sourceRef="GW_bol_city_sucre_open" targetRef="T_bol_city_sucre_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_04" sourceRef="GW_bol_city_sucre_open" targetRef="T_bol_city_sucre_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_05" sourceRef="T_bol_city_sucre_policy" targetRef="GW_bol_city_sucre_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_06" sourceRef="T_bol_city_sucre_budget" targetRef="GW_bol_city_sucre_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_07" sourceRef="T_bol_city_sucre_coord" targetRef="GW_bol_city_sucre_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_08" sourceRef="GW_bol_city_sucre_join" targetRef="T_bol_city_sucre_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_09" sourceRef="T_bol_city_sucre_review" targetRef="GW_bol_city_sucre_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_10a" sourceRef="GW_bol_city_sucre_risk" targetRef="T_bol_city_sucre_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_10b" sourceRef="GW_bol_city_sucre_risk" targetRef="T_bol_city_sucre_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_11" sourceRef="T_bol_city_sucre_publish" targetRef="End_bol_city_sucre">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_sucre_11b" sourceRef="T_bol_city_sucre_revise" targetRef="End_bol_city_sucre">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bol_city_sucre">
    <bpmndi:BPMNPlane id="BPMNPlane_bol_city_sucre" bpmnElement="Collaboration_bol_city_sucre" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
