<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bol_city_santa_cruz"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bol_city_santa_cruz">
    <bpmn:participant id="Pool_bol_city_santa_cruz" name="Santa Cruz de la Sierra (city:san)" processRef="Process_bol_city_santa_cruz" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bol_city_santa_cruz" name="Santa Cruz de la Sierra — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bol_city_santa_cruz" name="Policy trigger
received"><bpmn:outgoing>F_bol_city_santa_cruz_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bol_city_santa_cruz_open" name="Parallel checks">
      <bpmn:incoming>F_bol_city_santa_cruz_01</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_02</bpmn:outgoing>
      <bpmn:outgoing>F_bol_city_santa_cruz_03</bpmn:outgoing>
      <bpmn:outgoing>F_bol_city_santa_cruz_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bol_city_santa_cruz_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:santa-cruz.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_santa_cruz_02</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bol_city_santa_cruz_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:santa-cruz.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_santa_cruz_03</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bol_city_santa_cruz_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:santa-cruz.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_santa_cruz_04</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bol_city_santa_cruz_join" name="Checks complete">
      <bpmn:incoming>F_bol_city_santa_cruz_05</bpmn:incoming>
      <bpmn:incoming>F_bol_city_santa_cruz_06</bpmn:incoming>
      <bpmn:incoming>F_bol_city_santa_cruz_07</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bol_city_santa_cruz_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_santa_cruz_08</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bol_city_santa_cruz_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bol_city_santa_cruz_09</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bol_city_santa_cruz_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bol_city_santa_cruz_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:santa-cruz.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_santa_cruz_10a</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bol_city_santa_cruz_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bol.city:santa-cruz.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bol_city_santa_cruz_10b</bpmn:incoming>
      <bpmn:outgoing>F_bol_city_santa_cruz_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bol_city_santa_cruz" name="Process complete">
      <bpmn:incoming>F_bol_city_santa_cruz_11</bpmn:incoming>
      <bpmn:incoming>F_bol_city_santa_cruz_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_01" sourceRef="Start_bol_city_santa_cruz" targetRef="GW_bol_city_santa_cruz_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_02" sourceRef="GW_bol_city_santa_cruz_open" targetRef="T_bol_city_santa_cruz_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_03" sourceRef="GW_bol_city_santa_cruz_open" targetRef="T_bol_city_santa_cruz_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_04" sourceRef="GW_bol_city_santa_cruz_open" targetRef="T_bol_city_santa_cruz_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_05" sourceRef="T_bol_city_santa_cruz_policy" targetRef="GW_bol_city_santa_cruz_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_06" sourceRef="T_bol_city_santa_cruz_budget" targetRef="GW_bol_city_santa_cruz_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_07" sourceRef="T_bol_city_santa_cruz_coord" targetRef="GW_bol_city_santa_cruz_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_08" sourceRef="GW_bol_city_santa_cruz_join" targetRef="T_bol_city_santa_cruz_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_09" sourceRef="T_bol_city_santa_cruz_review" targetRef="GW_bol_city_santa_cruz_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_10a" sourceRef="GW_bol_city_santa_cruz_risk" targetRef="T_bol_city_santa_cruz_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_10b" sourceRef="GW_bol_city_santa_cruz_risk" targetRef="T_bol_city_santa_cruz_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_11" sourceRef="T_bol_city_santa_cruz_publish" targetRef="End_bol_city_santa_cruz">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bol_city_santa_cruz_11b" sourceRef="T_bol_city_santa_cruz_revise" targetRef="End_bol_city_santa_cruz">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bol_city_santa_cruz">
    <bpmndi:BPMNPlane id="BPMNPlane_bol_city_santa_cruz" bpmnElement="Collaboration_bol_city_santa_cruz" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
