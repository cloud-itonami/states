<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_deu_land_berlin_berlin"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_deu_land_berlin_berlin">
    <bpmn:participant id="Pool_deu_land_berlin_berlin" name="Berlin (land:ber)" processRef="Process_deu_land_berlin_berlin" />
  </bpmn:collaboration>
  <bpmn:process id="Process_deu_land_berlin_berlin" name="Berlin — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_deu_land_berlin_berlin" name="Policy trigger
received"><bpmn:outgoing>F_deu_land_berlin_berlin_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_deu_land_berlin_berlin_open" name="Parallel checks">
      <bpmn:incoming>F_deu_land_berlin_berlin_01</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_02</bpmn:outgoing>
      <bpmn:outgoing>F_deu_land_berlin_berlin_03</bpmn:outgoing>
      <bpmn:outgoing>F_deu_land_berlin_berlin_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_deu_land_berlin_berlin_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.deu.land:berlin:berlin.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_deu_land_berlin_berlin_02</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_deu_land_berlin_berlin_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.deu.land:berlin:berlin.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_deu_land_berlin_berlin_03</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_deu_land_berlin_berlin_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.deu.land:berlin:berlin.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_deu_land_berlin_berlin_04</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_deu_land_berlin_berlin_join" name="Checks complete">
      <bpmn:incoming>F_deu_land_berlin_berlin_05</bpmn:incoming>
      <bpmn:incoming>F_deu_land_berlin_berlin_06</bpmn:incoming>
      <bpmn:incoming>F_deu_land_berlin_berlin_07</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_deu_land_berlin_berlin_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_deu_land_berlin_berlin_08</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_deu_land_berlin_berlin_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_deu_land_berlin_berlin_09</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_10a</bpmn:outgoing>
      <bpmn:outgoing>F_deu_land_berlin_berlin_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_deu_land_berlin_berlin_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.deu.land:berlin:berlin.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_deu_land_berlin_berlin_10a</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_deu_land_berlin_berlin_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.deu.land:berlin:berlin.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_deu_land_berlin_berlin_10b</bpmn:incoming>
      <bpmn:outgoing>F_deu_land_berlin_berlin_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_deu_land_berlin_berlin" name="Process complete">
      <bpmn:incoming>F_deu_land_berlin_berlin_11</bpmn:incoming>
      <bpmn:incoming>F_deu_land_berlin_berlin_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_01" sourceRef="Start_deu_land_berlin_berlin" targetRef="GW_deu_land_berlin_berlin_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_02" sourceRef="GW_deu_land_berlin_berlin_open" targetRef="T_deu_land_berlin_berlin_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_03" sourceRef="GW_deu_land_berlin_berlin_open" targetRef="T_deu_land_berlin_berlin_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_04" sourceRef="GW_deu_land_berlin_berlin_open" targetRef="T_deu_land_berlin_berlin_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_05" sourceRef="T_deu_land_berlin_berlin_policy" targetRef="GW_deu_land_berlin_berlin_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_06" sourceRef="T_deu_land_berlin_berlin_budget" targetRef="GW_deu_land_berlin_berlin_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_07" sourceRef="T_deu_land_berlin_berlin_coord" targetRef="GW_deu_land_berlin_berlin_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_08" sourceRef="GW_deu_land_berlin_berlin_join" targetRef="T_deu_land_berlin_berlin_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_09" sourceRef="T_deu_land_berlin_berlin_review" targetRef="GW_deu_land_berlin_berlin_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_10a" sourceRef="GW_deu_land_berlin_berlin_risk" targetRef="T_deu_land_berlin_berlin_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_10b" sourceRef="GW_deu_land_berlin_berlin_risk" targetRef="T_deu_land_berlin_berlin_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_11" sourceRef="T_deu_land_berlin_berlin_publish" targetRef="End_deu_land_berlin_berlin">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_berlin_berlin_11b" sourceRef="T_deu_land_berlin_berlin_revise" targetRef="End_deu_land_berlin_berlin">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_deu_land_berlin_berlin">
    <bpmndi:BPMNPlane id="BPMNPlane_deu_land_berlin_berlin" bpmnElement="Collaboration_deu_land_berlin_berlin" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
