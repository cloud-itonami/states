    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_niedersachsen_hannover_06" sourceRef="T_deu_land_niedersachsen_hannover_budget" targetRef="GW_deu_land_niedersachsen_hannover_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_deu_land_niedersachsen_hannover_07" sourceRef="T_deu_land_niedersachsen_hannover_coord" targetRef="GW_deu_land_niedersachsen_hannover_join">
