<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_rus_executive_presidential_admin"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_rus_executive_presidential_admin">
    <bpmn:participant id="Pool_rus_executive_presidential_admin" name="Executive Presidential Admin (executiv)" processRef="Process_rus_executive_presidential_admin" />
  </bpmn:collaboration>
  <bpmn:process id="Process_rus_executive_presidential_admin" name="Executive Presidential Admin — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_rus_executive_presidential_admin" name="Policy trigger
received"><bpmn:outgoing>F_rus_executive_presidential_admin_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_rus_executive_presidential_admin_open" name="Parallel checks">
      <bpmn:incoming>F_rus_executive_presidential_admin_01</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_02</bpmn:outgoing>
      <bpmn:outgoing>F_rus_executive_presidential_admin_03</bpmn:outgoing>
      <bpmn:outgoing>F_rus_executive_presidential_admin_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_rus_executive_presidential_admin_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.executive-presidential-admin.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_executive_presidential_admin_02</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rus_executive_presidential_admin_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.executive-presidential-admin.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_executive_presidential_admin_03</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rus_executive_presidential_admin_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.executive-presidential-admin.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_executive_presidential_admin_04</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_rus_executive_presidential_admin_join" name="Checks complete">
      <bpmn:incoming>F_rus_executive_presidential_admin_05</bpmn:incoming>
      <bpmn:incoming>F_rus_executive_presidential_admin_06</bpmn:incoming>
      <bpmn:incoming>F_rus_executive_presidential_admin_07</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_rus_executive_presidential_admin_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_executive_presidential_admin_08</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_rus_executive_presidential_admin_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_rus_executive_presidential_admin_09</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_10a</bpmn:outgoing>
      <bpmn:outgoing>F_rus_executive_presidential_admin_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_rus_executive_presidential_admin_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.executive-presidential-admin.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_executive_presidential_admin_10a</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rus_executive_presidential_admin_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.executive-presidential-admin.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_executive_presidential_admin_10b</bpmn:incoming>
      <bpmn:outgoing>F_rus_executive_presidential_admin_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_rus_executive_presidential_admin" name="Process complete">
      <bpmn:incoming>F_rus_executive_presidential_admin_11</bpmn:incoming>
      <bpmn:incoming>F_rus_executive_presidential_admin_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_01" sourceRef="Start_rus_executive_presidential_admin" targetRef="GW_rus_executive_presidential_admin_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_02" sourceRef="GW_rus_executive_presidential_admin_open" targetRef="T_rus_executive_presidential_admin_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_03" sourceRef="GW_rus_executive_presidential_admin_open" targetRef="T_rus_executive_presidential_admin_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_04" sourceRef="GW_rus_executive_presidential_admin_open" targetRef="T_rus_executive_presidential_admin_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_05" sourceRef="T_rus_executive_presidential_admin_policy" targetRef="GW_rus_executive_presidential_admin_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_06" sourceRef="T_rus_executive_presidential_admin_budget" targetRef="GW_rus_executive_presidential_admin_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_07" sourceRef="T_rus_executive_presidential_admin_coord" targetRef="GW_rus_executive_presidential_admin_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_08" sourceRef="GW_rus_executive_presidential_admin_join" targetRef="T_rus_executive_presidential_admin_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_09" sourceRef="T_rus_executive_presidential_admin_review" targetRef="GW_rus_executive_presidential_admin_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_10a" sourceRef="GW_rus_executive_presidential_admin_risk" targetRef="T_rus_executive_presidential_admin_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_10b" sourceRef="GW_rus_executive_presidential_admin_risk" targetRef="T_rus_executive_presidential_admin_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_11" sourceRef="T_rus_executive_presidential_admin_publish" targetRef="End_rus_executive_presidential_admin">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_executive_presidential_admin_11b" sourceRef="T_rus_executive_presidential_admin_revise" targetRef="End_rus_executive_presidential_admin">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_rus_executive_presidential_admin">
    <bpmndi:BPMNPlane id="BPMNPlane_rus_executive_presidential_admin" bpmnElement="Collaboration_rus_executive_presidential_admin" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
