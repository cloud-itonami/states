<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_rus_military_ministry_of_defence"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_rus_military_ministry_of_defence">
    <bpmn:participant id="Pool_rus_military_ministry_of_defence" name="Military Ministry Of Defence (e5mpqu6h)" processRef="Process_rus_military_ministry_of_defence" />
  </bpmn:collaboration>
  <bpmn:process id="Process_rus_military_ministry_of_defence" name="Military Ministry Of Defence — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_rus_military_ministry_of_defence" name="Readiness
assessment triggered"><bpmn:outgoing>F_rus_military_ministry_of_defence_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_rus_military_ministry_of_defence_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.military-ministry-of-defence.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_military_ministry_of_defence_01</bpmn:incoming>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_rus_military_ministry_of_defence_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_rus_military_ministry_of_defence_02</bpmn:incoming>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_03a</bpmn:outgoing>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_03b</bpmn:outgoing>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_rus_military_ministry_of_defence_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.military-ministry-of-defence.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_military_ministry_of_defence_03a</bpmn:incoming>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rus_military_ministry_of_defence_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.military-ministry-of-defence.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_military_ministry_of_defence_03b</bpmn:incoming>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rus_military_ministry_of_defence_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.military-ministry-of-defence.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_military_ministry_of_defence_03c</bpmn:incoming>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rus_military_ministry_of_defence_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rus.military-ministry-of-defence.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_rus_military_ministry_of_defence_04</bpmn:incoming>
      <bpmn:outgoing>F_rus_military_ministry_of_defence_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_rus_military_ministry_of_defence" name="Assessment complete">
      <bpmn:incoming>F_rus_military_ministry_of_defence_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_01" sourceRef="Start_rus_military_ministry_of_defence" targetRef="T_rus_military_ministry_of_defence_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_02" sourceRef="T_rus_military_ministry_of_defence_assess" targetRef="GW_rus_military_ministry_of_defence_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_03a" sourceRef="GW_rus_military_ministry_of_defence_ready" targetRef="T_rus_military_ministry_of_defence_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_03b" sourceRef="GW_rus_military_ministry_of_defence_ready" targetRef="T_rus_military_ministry_of_defence_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_03c" sourceRef="GW_rus_military_ministry_of_defence_ready" targetRef="T_rus_military_ministry_of_defence_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_04" sourceRef="T_rus_military_ministry_of_defence_ops" targetRef="T_rus_military_ministry_of_defence_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_04b" sourceRef="T_rus_military_ministry_of_defence_proc" targetRef="T_rus_military_ministry_of_defence_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_04c" sourceRef="T_rus_military_ministry_of_defence_alert" targetRef="T_rus_military_ministry_of_defence_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rus_military_ministry_of_defence_05" sourceRef="T_rus_military_ministry_of_defence_report" targetRef="End_rus_military_ministry_of_defence">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_rus_military_ministry_of_defence">
    <bpmndi:BPMNPlane id="BPMNPlane_rus_military_ministry_of_defence" bpmnElement="Collaboration_rus_military_ministry_of_defence" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
