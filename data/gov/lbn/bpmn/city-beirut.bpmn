<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_lbn_city_beirut"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_lbn_city_beirut">
    <bpmn:participant id="Pool_lbn_city_beirut" name="Beirut (city:bei)" processRef="Process_lbn_city_beirut" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lbn_city_beirut" name="Beirut — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_lbn_city_beirut" name="Policy trigger
received"><bpmn:outgoing>F_lbn_city_beirut_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_lbn_city_beirut_open" name="Parallel checks">
      <bpmn:incoming>F_lbn_city_beirut_01</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_02</bpmn:outgoing>
      <bpmn:outgoing>F_lbn_city_beirut_03</bpmn:outgoing>
      <bpmn:outgoing>F_lbn_city_beirut_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_lbn_city_beirut_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lbn.city:beirut.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lbn_city_beirut_02</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lbn_city_beirut_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lbn.city:beirut.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lbn_city_beirut_03</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lbn_city_beirut_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lbn.city:beirut.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lbn_city_beirut_04</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_lbn_city_beirut_join" name="Checks complete">
      <bpmn:incoming>F_lbn_city_beirut_05</bpmn:incoming>
      <bpmn:incoming>F_lbn_city_beirut_06</bpmn:incoming>
      <bpmn:incoming>F_lbn_city_beirut_07</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_lbn_city_beirut_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_lbn_city_beirut_08</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_lbn_city_beirut_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_lbn_city_beirut_09</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_10a</bpmn:outgoing>
      <bpmn:outgoing>F_lbn_city_beirut_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_lbn_city_beirut_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lbn.city:beirut.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lbn_city_beirut_10a</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lbn_city_beirut_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lbn.city:beirut.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lbn_city_beirut_10b</bpmn:incoming>
      <bpmn:outgoing>F_lbn_city_beirut_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_lbn_city_beirut" name="Process complete">
      <bpmn:incoming>F_lbn_city_beirut_11</bpmn:incoming>
      <bpmn:incoming>F_lbn_city_beirut_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_01" sourceRef="Start_lbn_city_beirut" targetRef="GW_lbn_city_beirut_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_02" sourceRef="GW_lbn_city_beirut_open" targetRef="T_lbn_city_beirut_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_03" sourceRef="GW_lbn_city_beirut_open" targetRef="T_lbn_city_beirut_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_04" sourceRef="GW_lbn_city_beirut_open" targetRef="T_lbn_city_beirut_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_05" sourceRef="T_lbn_city_beirut_policy" targetRef="GW_lbn_city_beirut_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_06" sourceRef="T_lbn_city_beirut_budget" targetRef="GW_lbn_city_beirut_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_07" sourceRef="T_lbn_city_beirut_coord" targetRef="GW_lbn_city_beirut_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_08" sourceRef="GW_lbn_city_beirut_join" targetRef="T_lbn_city_beirut_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_09" sourceRef="T_lbn_city_beirut_review" targetRef="GW_lbn_city_beirut_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_10a" sourceRef="GW_lbn_city_beirut_risk" targetRef="T_lbn_city_beirut_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_10b" sourceRef="GW_lbn_city_beirut_risk" targetRef="T_lbn_city_beirut_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_11" sourceRef="T_lbn_city_beirut_publish" targetRef="End_lbn_city_beirut">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lbn_city_beirut_11b" sourceRef="T_lbn_city_beirut_revise" targetRef="End_lbn_city_beirut">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_lbn_city_beirut">
    <bpmndi:BPMNPlane id="BPMNPlane_lbn_city_beirut" bpmnElement="Collaboration_lbn_city_beirut" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
