<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ukr_city_kharkiv"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ukr_city_kharkiv">
    <bpmn:participant id="Pool_ukr_city_kharkiv" name="Kharkiv (city:kha)" processRef="Process_ukr_city_kharkiv" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ukr_city_kharkiv" name="Kharkiv — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ukr_city_kharkiv" name="Policy trigger
received"><bpmn:outgoing>F_ukr_city_kharkiv_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ukr_city_kharkiv_open" name="Parallel checks">
      <bpmn:incoming>F_ukr_city_kharkiv_01</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_02</bpmn:outgoing>
      <bpmn:outgoing>F_ukr_city_kharkiv_03</bpmn:outgoing>
      <bpmn:outgoing>F_ukr_city_kharkiv_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ukr_city_kharkiv_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kharkiv.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kharkiv_02</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ukr_city_kharkiv_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kharkiv.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kharkiv_03</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ukr_city_kharkiv_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kharkiv.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kharkiv_04</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ukr_city_kharkiv_join" name="Checks complete">
      <bpmn:incoming>F_ukr_city_kharkiv_05</bpmn:incoming>
      <bpmn:incoming>F_ukr_city_kharkiv_06</bpmn:incoming>
      <bpmn:incoming>F_ukr_city_kharkiv_07</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ukr_city_kharkiv_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kharkiv_08</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ukr_city_kharkiv_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ukr_city_kharkiv_09</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ukr_city_kharkiv_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ukr_city_kharkiv_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kharkiv.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kharkiv_10a</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ukr_city_kharkiv_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kharkiv.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kharkiv_10b</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kharkiv_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ukr_city_kharkiv" name="Process complete">
      <bpmn:incoming>F_ukr_city_kharkiv_11</bpmn:incoming>
      <bpmn:incoming>F_ukr_city_kharkiv_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_01" sourceRef="Start_ukr_city_kharkiv" targetRef="GW_ukr_city_kharkiv_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_02" sourceRef="GW_ukr_city_kharkiv_open" targetRef="T_ukr_city_kharkiv_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_03" sourceRef="GW_ukr_city_kharkiv_open" targetRef="T_ukr_city_kharkiv_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_04" sourceRef="GW_ukr_city_kharkiv_open" targetRef="T_ukr_city_kharkiv_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_05" sourceRef="T_ukr_city_kharkiv_policy" targetRef="GW_ukr_city_kharkiv_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_06" sourceRef="T_ukr_city_kharkiv_budget" targetRef="GW_ukr_city_kharkiv_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_07" sourceRef="T_ukr_city_kharkiv_coord" targetRef="GW_ukr_city_kharkiv_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_08" sourceRef="GW_ukr_city_kharkiv_join" targetRef="T_ukr_city_kharkiv_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_09" sourceRef="T_ukr_city_kharkiv_review" targetRef="GW_ukr_city_kharkiv_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_10a" sourceRef="GW_ukr_city_kharkiv_risk" targetRef="T_ukr_city_kharkiv_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_10b" sourceRef="GW_ukr_city_kharkiv_risk" targetRef="T_ukr_city_kharkiv_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_11" sourceRef="T_ukr_city_kharkiv_publish" targetRef="End_ukr_city_kharkiv">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kharkiv_11b" sourceRef="T_ukr_city_kharkiv_revise" targetRef="End_ukr_city_kharkiv">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ukr_city_kharkiv">
    <bpmndi:BPMNPlane id="BPMNPlane_ukr_city_kharkiv" bpmnElement="Collaboration_ukr_city_kharkiv" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
