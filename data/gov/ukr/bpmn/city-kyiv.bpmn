<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ukr_city_kyiv"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ukr_city_kyiv">
    <bpmn:participant id="Pool_ukr_city_kyiv" name="Kyiv (city:kyi)" processRef="Process_ukr_city_kyiv" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ukr_city_kyiv" name="Kyiv — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ukr_city_kyiv" name="Policy trigger
received"><bpmn:outgoing>F_ukr_city_kyiv_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ukr_city_kyiv_open" name="Parallel checks">
      <bpmn:incoming>F_ukr_city_kyiv_01</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_02</bpmn:outgoing>
      <bpmn:outgoing>F_ukr_city_kyiv_03</bpmn:outgoing>
      <bpmn:outgoing>F_ukr_city_kyiv_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ukr_city_kyiv_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kyiv.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kyiv_02</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ukr_city_kyiv_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kyiv.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kyiv_03</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ukr_city_kyiv_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kyiv.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kyiv_04</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ukr_city_kyiv_join" name="Checks complete">
      <bpmn:incoming>F_ukr_city_kyiv_05</bpmn:incoming>
      <bpmn:incoming>F_ukr_city_kyiv_06</bpmn:incoming>
      <bpmn:incoming>F_ukr_city_kyiv_07</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ukr_city_kyiv_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kyiv_08</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ukr_city_kyiv_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ukr_city_kyiv_09</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ukr_city_kyiv_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ukr_city_kyiv_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kyiv.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kyiv_10a</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ukr_city_kyiv_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ukr.city:kyiv.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ukr_city_kyiv_10b</bpmn:incoming>
      <bpmn:outgoing>F_ukr_city_kyiv_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ukr_city_kyiv" name="Process complete">
      <bpmn:incoming>F_ukr_city_kyiv_11</bpmn:incoming>
      <bpmn:incoming>F_ukr_city_kyiv_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_01" sourceRef="Start_ukr_city_kyiv" targetRef="GW_ukr_city_kyiv_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_02" sourceRef="GW_ukr_city_kyiv_open" targetRef="T_ukr_city_kyiv_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_03" sourceRef="GW_ukr_city_kyiv_open" targetRef="T_ukr_city_kyiv_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_04" sourceRef="GW_ukr_city_kyiv_open" targetRef="T_ukr_city_kyiv_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_05" sourceRef="T_ukr_city_kyiv_policy" targetRef="GW_ukr_city_kyiv_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_06" sourceRef="T_ukr_city_kyiv_budget" targetRef="GW_ukr_city_kyiv_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_07" sourceRef="T_ukr_city_kyiv_coord" targetRef="GW_ukr_city_kyiv_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_08" sourceRef="GW_ukr_city_kyiv_join" targetRef="T_ukr_city_kyiv_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_09" sourceRef="T_ukr_city_kyiv_review" targetRef="GW_ukr_city_kyiv_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_10a" sourceRef="GW_ukr_city_kyiv_risk" targetRef="T_ukr_city_kyiv_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_10b" sourceRef="GW_ukr_city_kyiv_risk" targetRef="T_ukr_city_kyiv_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_11" sourceRef="T_ukr_city_kyiv_publish" targetRef="End_ukr_city_kyiv">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ukr_city_kyiv_11b" sourceRef="T_ukr_city_kyiv_revise" targetRef="End_ukr_city_kyiv">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ukr_city_kyiv">
    <bpmndi:BPMNPlane id="BPMNPlane_ukr_city_kyiv" bpmnElement="Collaboration_ukr_city_kyiv" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
