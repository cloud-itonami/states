<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mys_city_george_town"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mys_city_george_town">
    <bpmn:participant id="Pool_mys_city_george_town" name="George Town (city:geo)" processRef="Process_mys_city_george_town" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mys_city_george_town" name="George Town — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mys_city_george_town" name="Policy trigger
received"><bpmn:outgoing>F_mys_city_george_town_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mys_city_george_town_open" name="Parallel checks">
      <bpmn:incoming>F_mys_city_george_town_01</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_02</bpmn:outgoing>
      <bpmn:outgoing>F_mys_city_george_town_03</bpmn:outgoing>
      <bpmn:outgoing>F_mys_city_george_town_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mys_city_george_town_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mys.city:george-town.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mys_city_george_town_02</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mys_city_george_town_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mys.city:george-town.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mys_city_george_town_03</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mys_city_george_town_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mys.city:george-town.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mys_city_george_town_04</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mys_city_george_town_join" name="Checks complete">
      <bpmn:incoming>F_mys_city_george_town_05</bpmn:incoming>
      <bpmn:incoming>F_mys_city_george_town_06</bpmn:incoming>
      <bpmn:incoming>F_mys_city_george_town_07</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mys_city_george_town_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mys_city_george_town_08</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mys_city_george_town_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mys_city_george_town_09</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mys_city_george_town_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mys_city_george_town_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mys.city:george-town.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mys_city_george_town_10a</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mys_city_george_town_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mys.city:george-town.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mys_city_george_town_10b</bpmn:incoming>
      <bpmn:outgoing>F_mys_city_george_town_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mys_city_george_town" name="Process complete">
      <bpmn:incoming>F_mys_city_george_town_11</bpmn:incoming>
      <bpmn:incoming>F_mys_city_george_town_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mys_city_george_town_01" sourceRef="Start_mys_city_george_town" targetRef="GW_mys_city_george_town_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_02" sourceRef="GW_mys_city_george_town_open" targetRef="T_mys_city_george_town_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_03" sourceRef="GW_mys_city_george_town_open" targetRef="T_mys_city_george_town_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_04" sourceRef="GW_mys_city_george_town_open" targetRef="T_mys_city_george_town_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_05" sourceRef="T_mys_city_george_town_policy" targetRef="GW_mys_city_george_town_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_06" sourceRef="T_mys_city_george_town_budget" targetRef="GW_mys_city_george_town_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_07" sourceRef="T_mys_city_george_town_coord" targetRef="GW_mys_city_george_town_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_08" sourceRef="GW_mys_city_george_town_join" targetRef="T_mys_city_george_town_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_09" sourceRef="T_mys_city_george_town_review" targetRef="GW_mys_city_george_town_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_10a" sourceRef="GW_mys_city_george_town_risk" targetRef="T_mys_city_george_town_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_10b" sourceRef="GW_mys_city_george_town_risk" targetRef="T_mys_city_george_town_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_11" sourceRef="T_mys_city_george_town_publish" targetRef="End_mys_city_george_town">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mys_city_george_town_11b" sourceRef="T_mys_city_george_town_revise" targetRef="End_mys_city_george_town">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mys_city_george_town">
    <bpmndi:BPMNPlane id="BPMNPlane_mys_city_george_town" bpmnElement="Collaboration_mys_city_george_town" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
