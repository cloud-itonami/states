<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_yem_city_aden"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_yem_city_aden">
    <bpmn:participant id="Pool_yem_city_aden" name="Aden (city:ade)" processRef="Process_yem_city_aden" />
  </bpmn:collaboration>
  <bpmn:process id="Process_yem_city_aden" name="Aden — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_yem_city_aden" name="Policy trigger
received"><bpmn:outgoing>F_yem_city_aden_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_yem_city_aden_open" name="Parallel checks">
      <bpmn:incoming>F_yem_city_aden_01</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_02</bpmn:outgoing>
      <bpmn:outgoing>F_yem_city_aden_03</bpmn:outgoing>
      <bpmn:outgoing>F_yem_city_aden_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_yem_city_aden_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.yem.city:aden.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_yem_city_aden_02</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_yem_city_aden_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.yem.city:aden.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_yem_city_aden_03</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_yem_city_aden_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.yem.city:aden.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_yem_city_aden_04</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_yem_city_aden_join" name="Checks complete">
      <bpmn:incoming>F_yem_city_aden_05</bpmn:incoming>
      <bpmn:incoming>F_yem_city_aden_06</bpmn:incoming>
      <bpmn:incoming>F_yem_city_aden_07</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_yem_city_aden_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_yem_city_aden_08</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_yem_city_aden_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_yem_city_aden_09</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_10a</bpmn:outgoing>
      <bpmn:outgoing>F_yem_city_aden_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_yem_city_aden_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.yem.city:aden.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_yem_city_aden_10a</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_yem_city_aden_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.yem.city:aden.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_yem_city_aden_10b</bpmn:incoming>
      <bpmn:outgoing>F_yem_city_aden_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_yem_city_aden" name="Process complete">
      <bpmn:incoming>F_yem_city_aden_11</bpmn:incoming>
      <bpmn:incoming>F_yem_city_aden_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_yem_city_aden_01" sourceRef="Start_yem_city_aden" targetRef="GW_yem_city_aden_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_02" sourceRef="GW_yem_city_aden_open" targetRef="T_yem_city_aden_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_03" sourceRef="GW_yem_city_aden_open" targetRef="T_yem_city_aden_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_04" sourceRef="GW_yem_city_aden_open" targetRef="T_yem_city_aden_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_05" sourceRef="T_yem_city_aden_policy" targetRef="GW_yem_city_aden_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_06" sourceRef="T_yem_city_aden_budget" targetRef="GW_yem_city_aden_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_07" sourceRef="T_yem_city_aden_coord" targetRef="GW_yem_city_aden_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_08" sourceRef="GW_yem_city_aden_join" targetRef="T_yem_city_aden_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_09" sourceRef="T_yem_city_aden_review" targetRef="GW_yem_city_aden_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_10a" sourceRef="GW_yem_city_aden_risk" targetRef="T_yem_city_aden_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_10b" sourceRef="GW_yem_city_aden_risk" targetRef="T_yem_city_aden_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_11" sourceRef="T_yem_city_aden_publish" targetRef="End_yem_city_aden">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_yem_city_aden_11b" sourceRef="T_yem_city_aden_revise" targetRef="End_yem_city_aden">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_yem_city_aden">
    <bpmndi:BPMNPlane id="BPMNPlane_yem_city_aden" bpmnElement="Collaboration_yem_city_aden" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
