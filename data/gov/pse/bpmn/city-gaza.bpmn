<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pse_city_gaza"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pse_city_gaza">
    <bpmn:participant id="Pool_pse_city_gaza" name="Gaza City (city:gaz)" processRef="Process_pse_city_gaza" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pse_city_gaza" name="Gaza City — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_pse_city_gaza" name="Policy trigger
received"><bpmn:outgoing>F_pse_city_gaza_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_pse_city_gaza_open" name="Parallel checks">
      <bpmn:incoming>F_pse_city_gaza_01</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_02</bpmn:outgoing>
      <bpmn:outgoing>F_pse_city_gaza_03</bpmn:outgoing>
      <bpmn:outgoing>F_pse_city_gaza_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_pse_city_gaza_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pse.city:gaza.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pse_city_gaza_02</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pse_city_gaza_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pse.city:gaza.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pse_city_gaza_03</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pse_city_gaza_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pse.city:gaza.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pse_city_gaza_04</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pse_city_gaza_join" name="Checks complete">
      <bpmn:incoming>F_pse_city_gaza_05</bpmn:incoming>
      <bpmn:incoming>F_pse_city_gaza_06</bpmn:incoming>
      <bpmn:incoming>F_pse_city_gaza_07</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_pse_city_gaza_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pse_city_gaza_08</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_pse_city_gaza_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_pse_city_gaza_09</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_10a</bpmn:outgoing>
      <bpmn:outgoing>F_pse_city_gaza_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pse_city_gaza_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pse.city:gaza.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pse_city_gaza_10a</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pse_city_gaza_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pse.city:gaza.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pse_city_gaza_10b</bpmn:incoming>
      <bpmn:outgoing>F_pse_city_gaza_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pse_city_gaza" name="Process complete">
      <bpmn:incoming>F_pse_city_gaza_11</bpmn:incoming>
      <bpmn:incoming>F_pse_city_gaza_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pse_city_gaza_01" sourceRef="Start_pse_city_gaza" targetRef="GW_pse_city_gaza_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_02" sourceRef="GW_pse_city_gaza_open" targetRef="T_pse_city_gaza_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_03" sourceRef="GW_pse_city_gaza_open" targetRef="T_pse_city_gaza_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_04" sourceRef="GW_pse_city_gaza_open" targetRef="T_pse_city_gaza_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_05" sourceRef="T_pse_city_gaza_policy" targetRef="GW_pse_city_gaza_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_06" sourceRef="T_pse_city_gaza_budget" targetRef="GW_pse_city_gaza_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_07" sourceRef="T_pse_city_gaza_coord" targetRef="GW_pse_city_gaza_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_08" sourceRef="GW_pse_city_gaza_join" targetRef="T_pse_city_gaza_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_09" sourceRef="T_pse_city_gaza_review" targetRef="GW_pse_city_gaza_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_10a" sourceRef="GW_pse_city_gaza_risk" targetRef="T_pse_city_gaza_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_10b" sourceRef="GW_pse_city_gaza_risk" targetRef="T_pse_city_gaza_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_11" sourceRef="T_pse_city_gaza_publish" targetRef="End_pse_city_gaza">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pse_city_gaza_11b" sourceRef="T_pse_city_gaza_revise" targetRef="End_pse_city_gaza">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pse_city_gaza">
    <bpmndi:BPMNPlane id="BPMNPlane_pse_city_gaza" bpmnElement="Collaboration_pse_city_gaza" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
