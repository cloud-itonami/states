<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bgd_election_bec"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bgd_election_bec">
    <bpmn:participant id="Pool_bgd_election_bec" name="Election Bec (b1g2e3c4)" processRef="Process_bgd_election_bec" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bgd_election_bec" name="Election Bec — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bgd_election_bec" name="Policy trigger
received"><bpmn:outgoing>F_bgd_election_bec_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bgd_election_bec_open" name="Parallel checks">
      <bpmn:incoming>F_bgd_election_bec_01</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_02</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_election_bec_03</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_election_bec_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bgd_election_bec_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.election-bec.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_election_bec_02</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_election_bec_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.election-bec.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_election_bec_03</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_election_bec_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.election-bec.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_election_bec_04</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bgd_election_bec_join" name="Checks complete">
      <bpmn:incoming>F_bgd_election_bec_05</bpmn:incoming>
      <bpmn:incoming>F_bgd_election_bec_06</bpmn:incoming>
      <bpmn:incoming>F_bgd_election_bec_07</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bgd_election_bec_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_election_bec_08</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bgd_election_bec_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bgd_election_bec_09</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_election_bec_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bgd_election_bec_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.election-bec.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_election_bec_10a</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_election_bec_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.election-bec.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_election_bec_10b</bpmn:incoming>
      <bpmn:outgoing>F_bgd_election_bec_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bgd_election_bec" name="Process complete">
      <bpmn:incoming>F_bgd_election_bec_11</bpmn:incoming>
      <bpmn:incoming>F_bgd_election_bec_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bgd_election_bec_01" sourceRef="Start_bgd_election_bec" targetRef="GW_bgd_election_bec_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_02" sourceRef="GW_bgd_election_bec_open" targetRef="T_bgd_election_bec_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_03" sourceRef="GW_bgd_election_bec_open" targetRef="T_bgd_election_bec_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_04" sourceRef="GW_bgd_election_bec_open" targetRef="T_bgd_election_bec_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_05" sourceRef="T_bgd_election_bec_policy" targetRef="GW_bgd_election_bec_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_06" sourceRef="T_bgd_election_bec_budget" targetRef="GW_bgd_election_bec_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_07" sourceRef="T_bgd_election_bec_coord" targetRef="GW_bgd_election_bec_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_08" sourceRef="GW_bgd_election_bec_join" targetRef="T_bgd_election_bec_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_09" sourceRef="T_bgd_election_bec_review" targetRef="GW_bgd_election_bec_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_10a" sourceRef="GW_bgd_election_bec_risk" targetRef="T_bgd_election_bec_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_10b" sourceRef="GW_bgd_election_bec_risk" targetRef="T_bgd_election_bec_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_11" sourceRef="T_bgd_election_bec_publish" targetRef="End_bgd_election_bec">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_election_bec_11b" sourceRef="T_bgd_election_bec_revise" targetRef="End_bgd_election_bec">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bgd_election_bec">
    <bpmndi:BPMNPlane id="BPMNPlane_bgd_election_bec" bpmnElement="Collaboration_bgd_election_bec" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
