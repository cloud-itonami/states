<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bgd_city_dhaka"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bgd_city_dhaka">
    <bpmn:participant id="Pool_bgd_city_dhaka" name="Dhaka (city:dha)" processRef="Process_bgd_city_dhaka" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bgd_city_dhaka" name="Dhaka — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bgd_city_dhaka" name="Policy trigger
received"><bpmn:outgoing>F_bgd_city_dhaka_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bgd_city_dhaka_open" name="Parallel checks">
      <bpmn:incoming>F_bgd_city_dhaka_01</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_02</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_city_dhaka_03</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_city_dhaka_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bgd_city_dhaka_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.city:dhaka.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_city_dhaka_02</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_city_dhaka_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.city:dhaka.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_city_dhaka_03</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_city_dhaka_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.city:dhaka.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_city_dhaka_04</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bgd_city_dhaka_join" name="Checks complete">
      <bpmn:incoming>F_bgd_city_dhaka_05</bpmn:incoming>
      <bpmn:incoming>F_bgd_city_dhaka_06</bpmn:incoming>
      <bpmn:incoming>F_bgd_city_dhaka_07</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bgd_city_dhaka_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_city_dhaka_08</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bgd_city_dhaka_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bgd_city_dhaka_09</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_city_dhaka_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bgd_city_dhaka_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.city:dhaka.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_city_dhaka_10a</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_city_dhaka_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.city:dhaka.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_city_dhaka_10b</bpmn:incoming>
      <bpmn:outgoing>F_bgd_city_dhaka_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bgd_city_dhaka" name="Process complete">
      <bpmn:incoming>F_bgd_city_dhaka_11</bpmn:incoming>
      <bpmn:incoming>F_bgd_city_dhaka_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_01" sourceRef="Start_bgd_city_dhaka" targetRef="GW_bgd_city_dhaka_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_02" sourceRef="GW_bgd_city_dhaka_open" targetRef="T_bgd_city_dhaka_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_03" sourceRef="GW_bgd_city_dhaka_open" targetRef="T_bgd_city_dhaka_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_04" sourceRef="GW_bgd_city_dhaka_open" targetRef="T_bgd_city_dhaka_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_05" sourceRef="T_bgd_city_dhaka_policy" targetRef="GW_bgd_city_dhaka_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_06" sourceRef="T_bgd_city_dhaka_budget" targetRef="GW_bgd_city_dhaka_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_07" sourceRef="T_bgd_city_dhaka_coord" targetRef="GW_bgd_city_dhaka_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_08" sourceRef="GW_bgd_city_dhaka_join" targetRef="T_bgd_city_dhaka_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_09" sourceRef="T_bgd_city_dhaka_review" targetRef="GW_bgd_city_dhaka_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_10a" sourceRef="GW_bgd_city_dhaka_risk" targetRef="T_bgd_city_dhaka_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_10b" sourceRef="GW_bgd_city_dhaka_risk" targetRef="T_bgd_city_dhaka_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_11" sourceRef="T_bgd_city_dhaka_publish" targetRef="End_bgd_city_dhaka">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_city_dhaka_11b" sourceRef="T_bgd_city_dhaka_revise" targetRef="End_bgd_city_dhaka">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bgd_city_dhaka">
    <bpmndi:BPMNPlane id="BPMNPlane_bgd_city_dhaka" bpmnElement="Collaboration_bgd_city_dhaka" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
