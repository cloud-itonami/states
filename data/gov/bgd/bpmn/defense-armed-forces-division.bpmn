<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bgd_defense_armed_forces_division"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bgd_defense_armed_forces_division">
    <bpmn:participant id="Pool_bgd_defense_armed_forces_division" name="Defense Armed Forces Division (b1g2j3s4)" processRef="Process_bgd_defense_armed_forces_division" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bgd_defense_armed_forces_division" name="Defense Armed Forces Division — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_bgd_defense_armed_forces_division" name="Readiness
assessment triggered"><bpmn:outgoing>F_bgd_defense_armed_forces_division_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_bgd_defense_armed_forces_division_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.defense-armed-forces-division.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_defense_armed_forces_division_01</bpmn:incoming>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_bgd_defense_armed_forces_division_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_bgd_defense_armed_forces_division_02</bpmn:incoming>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_03a</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_03b</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bgd_defense_armed_forces_division_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.defense-armed-forces-division.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_defense_armed_forces_division_03a</bpmn:incoming>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_defense_armed_forces_division_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.defense-armed-forces-division.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_defense_armed_forces_division_03b</bpmn:incoming>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_defense_armed_forces_division_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.defense-armed-forces-division.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_defense_armed_forces_division_03c</bpmn:incoming>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_defense_armed_forces_division_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.defense-armed-forces-division.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_defense_armed_forces_division_04</bpmn:incoming>
      <bpmn:outgoing>F_bgd_defense_armed_forces_division_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bgd_defense_armed_forces_division" name="Assessment complete">
      <bpmn:incoming>F_bgd_defense_armed_forces_division_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_01" sourceRef="Start_bgd_defense_armed_forces_division" targetRef="T_bgd_defense_armed_forces_division_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_02" sourceRef="T_bgd_defense_armed_forces_division_assess" targetRef="GW_bgd_defense_armed_forces_division_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_03a" sourceRef="GW_bgd_defense_armed_forces_division_ready" targetRef="T_bgd_defense_armed_forces_division_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_03b" sourceRef="GW_bgd_defense_armed_forces_division_ready" targetRef="T_bgd_defense_armed_forces_division_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_03c" sourceRef="GW_bgd_defense_armed_forces_division_ready" targetRef="T_bgd_defense_armed_forces_division_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_04" sourceRef="T_bgd_defense_armed_forces_division_ops" targetRef="T_bgd_defense_armed_forces_division_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_04b" sourceRef="T_bgd_defense_armed_forces_division_proc" targetRef="T_bgd_defense_armed_forces_division_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_04c" sourceRef="T_bgd_defense_armed_forces_division_alert" targetRef="T_bgd_defense_armed_forces_division_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_defense_armed_forces_division_05" sourceRef="T_bgd_defense_armed_forces_division_report" targetRef="End_bgd_defense_armed_forces_division">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bgd_defense_armed_forces_division">
    <bpmndi:BPMNPlane id="BPMNPlane_bgd_defense_armed_forces_division" bpmnElement="Collaboration_bgd_defense_armed_forces_division" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
