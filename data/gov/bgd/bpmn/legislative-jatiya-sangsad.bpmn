    id="Definitions_bgd_legislative_jatiya_sangsad"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bgd_legislative_jatiya_sangsad">
    <bpmn:participant id="Pool_bgd_legislative_jatiya_sangsad" name="Legislative Jatiya Sangsad (b4g8j1s9)" processRef="Process_bgd_legislative_jatiya_sangsad" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bgd_legislative_jatiya_sangsad" name="Legislative Jatiya Sangsad — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bgd_legislative_jatiya_sangsad" name="Policy trigger
received"><bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bgd_legislative_jatiya_sangsad_open" name="Parallel checks">
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_01</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_02</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_03</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bgd_legislative_jatiya_sangsad_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.legislative-jatiya-sangsad.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_02</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_legislative_jatiya_sangsad_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.legislative-jatiya-sangsad.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_03</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_legislative_jatiya_sangsad_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.legislative-jatiya-sangsad.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_04</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bgd_legislative_jatiya_sangsad_join" name="Checks complete">
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_05</bpmn:incoming>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_06</bpmn:incoming>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_07</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bgd_legislative_jatiya_sangsad_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_08</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bgd_legislative_jatiya_sangsad_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_09</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bgd_legislative_jatiya_sangsad_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.legislative-jatiya-sangsad.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_10a</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bgd_legislative_jatiya_sangsad_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bgd.legislative-jatiya-sangsad.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_10b</bpmn:incoming>
      <bpmn:outgoing>F_bgd_legislative_jatiya_sangsad_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bgd_legislative_jatiya_sangsad" name="Process complete">
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_11</bpmn:incoming>
      <bpmn:incoming>F_bgd_legislative_jatiya_sangsad_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_01" sourceRef="Start_bgd_legislative_jatiya_sangsad" targetRef="GW_bgd_legislative_jatiya_sangsad_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_02" sourceRef="GW_bgd_legislative_jatiya_sangsad_open" targetRef="T_bgd_legislative_jatiya_sangsad_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_03" sourceRef="GW_bgd_legislative_jatiya_sangsad_open" targetRef="T_bgd_legislative_jatiya_sangsad_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_04" sourceRef="GW_bgd_legislative_jatiya_sangsad_open" targetRef="T_bgd_legislative_jatiya_sangsad_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_05" sourceRef="T_bgd_legislative_jatiya_sangsad_policy" targetRef="GW_bgd_legislative_jatiya_sangsad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_06" sourceRef="T_bgd_legislative_jatiya_sangsad_budget" targetRef="GW_bgd_legislative_jatiya_sangsad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_07" sourceRef="T_bgd_legislative_jatiya_sangsad_coord" targetRef="GW_bgd_legislative_jatiya_sangsad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_08" sourceRef="GW_bgd_legislative_jatiya_sangsad_join" targetRef="T_bgd_legislative_jatiya_sangsad_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_09" sourceRef="T_bgd_legislative_jatiya_sangsad_review" targetRef="GW_bgd_legislative_jatiya_sangsad_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_10a" sourceRef="GW_bgd_legislative_jatiya_sangsad_risk" targetRef="T_bgd_legislative_jatiya_sangsad_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_10b" sourceRef="GW_bgd_legislative_jatiya_sangsad_risk" targetRef="T_bgd_legislative_jatiya_sangsad_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_11" sourceRef="T_bgd_legislative_jatiya_sangsad_publish" targetRef="End_bgd_legislative_jatiya_sangsad">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bgd_legislative_jatiya_sangsad_11b" sourceRef="T_bgd_legislative_jatiya_sangsad_revise" targetRef="End_bgd_legislative_jatiya_sangsad">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bgd_legislative_jatiya_sangsad">
    <bpmndi:BPMNPlane id="BPMNPlane_bgd_legislative_jatiya_sangsad" bpmnElement="Collaboration_bgd_legislative_jatiya_sangsad" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
