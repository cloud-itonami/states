<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_sdn_city_omdurman"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_sdn_city_omdurman">
    <bpmn:participant id="Pool_sdn_city_omdurman" name="Omdurman (city:omd)" processRef="Process_sdn_city_omdurman" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sdn_city_omdurman" name="Omdurman — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_sdn_city_omdurman" name="Policy trigger
received"><bpmn:outgoing>F_sdn_city_omdurman_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_sdn_city_omdurman_open" name="Parallel checks">
      <bpmn:incoming>F_sdn_city_omdurman_01</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_02</bpmn:outgoing>
      <bpmn:outgoing>F_sdn_city_omdurman_03</bpmn:outgoing>
      <bpmn:outgoing>F_sdn_city_omdurman_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_sdn_city_omdurman_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sdn.city:omdurman.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sdn_city_omdurman_02</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sdn_city_omdurman_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sdn.city:omdurman.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sdn_city_omdurman_03</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sdn_city_omdurman_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sdn.city:omdurman.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sdn_city_omdurman_04</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_sdn_city_omdurman_join" name="Checks complete">
      <bpmn:incoming>F_sdn_city_omdurman_05</bpmn:incoming>
      <bpmn:incoming>F_sdn_city_omdurman_06</bpmn:incoming>
      <bpmn:incoming>F_sdn_city_omdurman_07</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_sdn_city_omdurman_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_sdn_city_omdurman_08</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_sdn_city_omdurman_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_sdn_city_omdurman_09</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_10a</bpmn:outgoing>
      <bpmn:outgoing>F_sdn_city_omdurman_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_sdn_city_omdurman_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sdn.city:omdurman.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sdn_city_omdurman_10a</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sdn_city_omdurman_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sdn.city:omdurman.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sdn_city_omdurman_10b</bpmn:incoming>
      <bpmn:outgoing>F_sdn_city_omdurman_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sdn_city_omdurman" name="Process complete">
      <bpmn:incoming>F_sdn_city_omdurman_11</bpmn:incoming>
      <bpmn:incoming>F_sdn_city_omdurman_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_01" sourceRef="Start_sdn_city_omdurman" targetRef="GW_sdn_city_omdurman_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_02" sourceRef="GW_sdn_city_omdurman_open" targetRef="T_sdn_city_omdurman_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_03" sourceRef="GW_sdn_city_omdurman_open" targetRef="T_sdn_city_omdurman_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_04" sourceRef="GW_sdn_city_omdurman_open" targetRef="T_sdn_city_omdurman_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_05" sourceRef="T_sdn_city_omdurman_policy" targetRef="GW_sdn_city_omdurman_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_06" sourceRef="T_sdn_city_omdurman_budget" targetRef="GW_sdn_city_omdurman_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_07" sourceRef="T_sdn_city_omdurman_coord" targetRef="GW_sdn_city_omdurman_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_08" sourceRef="GW_sdn_city_omdurman_join" targetRef="T_sdn_city_omdurman_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_09" sourceRef="T_sdn_city_omdurman_review" targetRef="GW_sdn_city_omdurman_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_10a" sourceRef="GW_sdn_city_omdurman_risk" targetRef="T_sdn_city_omdurman_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_10b" sourceRef="GW_sdn_city_omdurman_risk" targetRef="T_sdn_city_omdurman_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_11" sourceRef="T_sdn_city_omdurman_publish" targetRef="End_sdn_city_omdurman">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sdn_city_omdurman_11b" sourceRef="T_sdn_city_omdurman_revise" targetRef="End_sdn_city_omdurman">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sdn_city_omdurman">
    <bpmndi:BPMNPlane id="BPMNPlane_sdn_city_omdurman" bpmnElement="Collaboration_sdn_city_omdurman" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
