<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_slb_city_honiara"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_slb_city_honiara">
    <bpmn:participant id="Pool_slb_city_honiara" name="Honiara (city:hon)" processRef="Process_slb_city_honiara" />
  </bpmn:collaboration>
  <bpmn:process id="Process_slb_city_honiara" name="Honiara — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_slb_city_honiara" name="Policy trigger
received"><bpmn:outgoing>F_slb_city_honiara_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_slb_city_honiara_open" name="Parallel checks">
      <bpmn:incoming>F_slb_city_honiara_01</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_02</bpmn:outgoing>
      <bpmn:outgoing>F_slb_city_honiara_03</bpmn:outgoing>
      <bpmn:outgoing>F_slb_city_honiara_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_slb_city_honiara_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.slb.city:honiara.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_slb_city_honiara_02</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_slb_city_honiara_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.slb.city:honiara.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_slb_city_honiara_03</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_slb_city_honiara_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.slb.city:honiara.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_slb_city_honiara_04</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_slb_city_honiara_join" name="Checks complete">
      <bpmn:incoming>F_slb_city_honiara_05</bpmn:incoming>
      <bpmn:incoming>F_slb_city_honiara_06</bpmn:incoming>
      <bpmn:incoming>F_slb_city_honiara_07</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_slb_city_honiara_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_slb_city_honiara_08</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_slb_city_honiara_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_slb_city_honiara_09</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_10a</bpmn:outgoing>
      <bpmn:outgoing>F_slb_city_honiara_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_slb_city_honiara_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.slb.city:honiara.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_slb_city_honiara_10a</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_slb_city_honiara_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.slb.city:honiara.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_slb_city_honiara_10b</bpmn:incoming>
      <bpmn:outgoing>F_slb_city_honiara_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_slb_city_honiara" name="Process complete">
      <bpmn:incoming>F_slb_city_honiara_11</bpmn:incoming>
      <bpmn:incoming>F_slb_city_honiara_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_slb_city_honiara_01" sourceRef="Start_slb_city_honiara" targetRef="GW_slb_city_honiara_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_02" sourceRef="GW_slb_city_honiara_open" targetRef="T_slb_city_honiara_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_03" sourceRef="GW_slb_city_honiara_open" targetRef="T_slb_city_honiara_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_04" sourceRef="GW_slb_city_honiara_open" targetRef="T_slb_city_honiara_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_05" sourceRef="T_slb_city_honiara_policy" targetRef="GW_slb_city_honiara_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_06" sourceRef="T_slb_city_honiara_budget" targetRef="GW_slb_city_honiara_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_07" sourceRef="T_slb_city_honiara_coord" targetRef="GW_slb_city_honiara_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_08" sourceRef="GW_slb_city_honiara_join" targetRef="T_slb_city_honiara_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_09" sourceRef="T_slb_city_honiara_review" targetRef="GW_slb_city_honiara_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_10a" sourceRef="GW_slb_city_honiara_risk" targetRef="T_slb_city_honiara_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_10b" sourceRef="GW_slb_city_honiara_risk" targetRef="T_slb_city_honiara_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_11" sourceRef="T_slb_city_honiara_publish" targetRef="End_slb_city_honiara">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_slb_city_honiara_11b" sourceRef="T_slb_city_honiara_revise" targetRef="End_slb_city_honiara">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_slb_city_honiara">
    <bpmndi:BPMNPlane id="BPMNPlane_slb_city_honiara" bpmnElement="Collaboration_slb_city_honiara" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
