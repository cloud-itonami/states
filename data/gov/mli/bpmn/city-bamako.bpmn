<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mli_city_bamako"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mli_city_bamako">
    <bpmn:participant id="Pool_mli_city_bamako" name="Bamako (city:bam)" processRef="Process_mli_city_bamako" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mli_city_bamako" name="Bamako — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mli_city_bamako" name="Policy trigger
received"><bpmn:outgoing>F_mli_city_bamako_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mli_city_bamako_open" name="Parallel checks">
      <bpmn:incoming>F_mli_city_bamako_01</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_02</bpmn:outgoing>
      <bpmn:outgoing>F_mli_city_bamako_03</bpmn:outgoing>
      <bpmn:outgoing>F_mli_city_bamako_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mli_city_bamako_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mli.city:bamako.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mli_city_bamako_02</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mli_city_bamako_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mli.city:bamako.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mli_city_bamako_03</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mli_city_bamako_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mli.city:bamako.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mli_city_bamako_04</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mli_city_bamako_join" name="Checks complete">
      <bpmn:incoming>F_mli_city_bamako_05</bpmn:incoming>
      <bpmn:incoming>F_mli_city_bamako_06</bpmn:incoming>
      <bpmn:incoming>F_mli_city_bamako_07</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mli_city_bamako_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mli_city_bamako_08</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mli_city_bamako_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mli_city_bamako_09</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mli_city_bamako_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mli_city_bamako_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mli.city:bamako.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mli_city_bamako_10a</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mli_city_bamako_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mli.city:bamako.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mli_city_bamako_10b</bpmn:incoming>
      <bpmn:outgoing>F_mli_city_bamako_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mli_city_bamako" name="Process complete">
      <bpmn:incoming>F_mli_city_bamako_11</bpmn:incoming>
      <bpmn:incoming>F_mli_city_bamako_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mli_city_bamako_01" sourceRef="Start_mli_city_bamako" targetRef="GW_mli_city_bamako_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_02" sourceRef="GW_mli_city_bamako_open" targetRef="T_mli_city_bamako_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_03" sourceRef="GW_mli_city_bamako_open" targetRef="T_mli_city_bamako_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_04" sourceRef="GW_mli_city_bamako_open" targetRef="T_mli_city_bamako_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_05" sourceRef="T_mli_city_bamako_policy" targetRef="GW_mli_city_bamako_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_06" sourceRef="T_mli_city_bamako_budget" targetRef="GW_mli_city_bamako_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_07" sourceRef="T_mli_city_bamako_coord" targetRef="GW_mli_city_bamako_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_08" sourceRef="GW_mli_city_bamako_join" targetRef="T_mli_city_bamako_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_09" sourceRef="T_mli_city_bamako_review" targetRef="GW_mli_city_bamako_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_10a" sourceRef="GW_mli_city_bamako_risk" targetRef="T_mli_city_bamako_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_10b" sourceRef="GW_mli_city_bamako_risk" targetRef="T_mli_city_bamako_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_11" sourceRef="T_mli_city_bamako_publish" targetRef="End_mli_city_bamako">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mli_city_bamako_11b" sourceRef="T_mli_city_bamako_revise" targetRef="End_mli_city_bamako">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mli_city_bamako">
    <bpmndi:BPMNPlane id="BPMNPlane_mli_city_bamako" bpmnElement="Collaboration_mli_city_bamako" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
