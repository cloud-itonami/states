<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_col_environment"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_col_environment">
    <bpmn:participant id="Pool_col_environment" name="Environment (c1l2e3v4)" processRef="Process_col_environment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_col_environment" name="Environment — Environmental Protection" isExecutable="true">
    <bpmn:startEvent id="Start_col_environment" name="Environmental
monitor triggered"><bpmn:outgoing>F_col_environment_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_col_environment_monitor" name="Environmental
Monitoring & Data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.col.environment.monitor" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_rate" />
          <zeebe:header key="cofog" value="05" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_col_environment_01</bpmn:incoming>
      <bpmn:outgoing>F_col_environment_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_col_environment_thresh" name="Threshold
exceeded?" isMarkerVisible="true">
      <bpmn:incoming>F_col_environment_02</bpmn:incoming>
      <bpmn:outgoing>F_col_environment_03a</bpmn:outgoing>
      <bpmn:outgoing>F_col_environment_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_col_environment_enforce" name="Issue Enforcement
Notice / Fine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.col.environment.enforce" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="enforce" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_col_environment_03a</bpmn:incoming>
      <bpmn:outgoing>F_col_environment_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_col_environment_log" name="Log Readings
& Archive">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.col.environment.log" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_col_environment_03b</bpmn:incoming>
      <bpmn:outgoing>F_col_environment_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_col_environment_report" name="Publish Environmental
Status Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.col.environment.publish_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_col_environment_04</bpmn:incoming>
      <bpmn:outgoing>F_col_environment_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_col_environment" name="Cycle complete">
      <bpmn:incoming>F_col_environment_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_col_environment_01" sourceRef="Start_col_environment" targetRef="T_col_environment_monitor">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_col_environment_02" sourceRef="T_col_environment_monitor" targetRef="GW_col_environment_thresh">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_col_environment_03a" sourceRef="GW_col_environment_thresh" targetRef="T_col_environment_enforce" name="Yes">
      <bpmn:conditionExpression>=exceeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_col_environment_03b" sourceRef="GW_col_environment_thresh" targetRef="T_col_environment_log" name="No">
      <bpmn:conditionExpression>=exceeded = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_col_environment_04" sourceRef="T_col_environment_enforce" targetRef="T_col_environment_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_col_environment_04b" sourceRef="T_col_environment_log" targetRef="T_col_environment_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_col_environment_05" sourceRef="T_col_environment_report" targetRef="End_col_environment">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_col_environment">
    <bpmndi:BPMNPlane id="BPMNPlane_col_environment" bpmnElement="Collaboration_col_environment" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
