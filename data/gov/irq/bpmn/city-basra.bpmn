<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_irq_city_basra"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_irq_city_basra">
    <bpmn:participant id="Pool_irq_city_basra" name="Basra (city:bas)" processRef="Process_irq_city_basra" />
  </bpmn:collaboration>
  <bpmn:process id="Process_irq_city_basra" name="Basra — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_irq_city_basra" name="Policy trigger
received"><bpmn:outgoing>F_irq_city_basra_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_irq_city_basra_open" name="Parallel checks">
      <bpmn:incoming>F_irq_city_basra_01</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_02</bpmn:outgoing>
      <bpmn:outgoing>F_irq_city_basra_03</bpmn:outgoing>
      <bpmn:outgoing>F_irq_city_basra_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_irq_city_basra_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irq.city:basra.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irq_city_basra_02</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irq_city_basra_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irq.city:basra.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irq_city_basra_03</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irq_city_basra_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irq.city:basra.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irq_city_basra_04</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_irq_city_basra_join" name="Checks complete">
      <bpmn:incoming>F_irq_city_basra_05</bpmn:incoming>
      <bpmn:incoming>F_irq_city_basra_06</bpmn:incoming>
      <bpmn:incoming>F_irq_city_basra_07</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_irq_city_basra_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_irq_city_basra_08</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_irq_city_basra_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_irq_city_basra_09</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_10a</bpmn:outgoing>
      <bpmn:outgoing>F_irq_city_basra_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_irq_city_basra_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irq.city:basra.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irq_city_basra_10a</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irq_city_basra_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irq.city:basra.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irq_city_basra_10b</bpmn:incoming>
      <bpmn:outgoing>F_irq_city_basra_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_irq_city_basra" name="Process complete">
      <bpmn:incoming>F_irq_city_basra_11</bpmn:incoming>
      <bpmn:incoming>F_irq_city_basra_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_irq_city_basra_01" sourceRef="Start_irq_city_basra" targetRef="GW_irq_city_basra_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_02" sourceRef="GW_irq_city_basra_open" targetRef="T_irq_city_basra_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_03" sourceRef="GW_irq_city_basra_open" targetRef="T_irq_city_basra_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_04" sourceRef="GW_irq_city_basra_open" targetRef="T_irq_city_basra_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_05" sourceRef="T_irq_city_basra_policy" targetRef="GW_irq_city_basra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_06" sourceRef="T_irq_city_basra_budget" targetRef="GW_irq_city_basra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_07" sourceRef="T_irq_city_basra_coord" targetRef="GW_irq_city_basra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_08" sourceRef="GW_irq_city_basra_join" targetRef="T_irq_city_basra_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_09" sourceRef="T_irq_city_basra_review" targetRef="GW_irq_city_basra_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_10a" sourceRef="GW_irq_city_basra_risk" targetRef="T_irq_city_basra_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_10b" sourceRef="GW_irq_city_basra_risk" targetRef="T_irq_city_basra_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_11" sourceRef="T_irq_city_basra_publish" targetRef="End_irq_city_basra">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irq_city_basra_11b" sourceRef="T_irq_city_basra_revise" targetRef="End_irq_city_basra">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_irq_city_basra">
    <bpmndi:BPMNPlane id="BPMNPlane_irq_city_basra" bpmnElement="Collaboration_irq_city_basra" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
