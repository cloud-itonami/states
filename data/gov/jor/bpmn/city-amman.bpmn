<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jor_city_amman"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jor_city_amman">
    <bpmn:participant id="Pool_jor_city_amman" name="Amman (city:amm)" processRef="Process_jor_city_amman" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jor_city_amman" name="Amman — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jor_city_amman" name="Policy trigger
received"><bpmn:outgoing>F_jor_city_amman_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jor_city_amman_open" name="Parallel checks">
      <bpmn:incoming>F_jor_city_amman_01</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_02</bpmn:outgoing>
      <bpmn:outgoing>F_jor_city_amman_03</bpmn:outgoing>
      <bpmn:outgoing>F_jor_city_amman_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jor_city_amman_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jor.city:amman.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jor_city_amman_02</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jor_city_amman_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jor.city:amman.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jor_city_amman_03</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jor_city_amman_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jor.city:amman.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jor_city_amman_04</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jor_city_amman_join" name="Checks complete">
      <bpmn:incoming>F_jor_city_amman_05</bpmn:incoming>
      <bpmn:incoming>F_jor_city_amman_06</bpmn:incoming>
      <bpmn:incoming>F_jor_city_amman_07</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jor_city_amman_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jor_city_amman_08</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jor_city_amman_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jor_city_amman_09</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jor_city_amman_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jor_city_amman_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jor.city:amman.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jor_city_amman_10a</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jor_city_amman_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jor.city:amman.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jor_city_amman_10b</bpmn:incoming>
      <bpmn:outgoing>F_jor_city_amman_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jor_city_amman" name="Process complete">
      <bpmn:incoming>F_jor_city_amman_11</bpmn:incoming>
      <bpmn:incoming>F_jor_city_amman_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jor_city_amman_01" sourceRef="Start_jor_city_amman" targetRef="GW_jor_city_amman_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_02" sourceRef="GW_jor_city_amman_open" targetRef="T_jor_city_amman_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_03" sourceRef="GW_jor_city_amman_open" targetRef="T_jor_city_amman_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_04" sourceRef="GW_jor_city_amman_open" targetRef="T_jor_city_amman_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_05" sourceRef="T_jor_city_amman_policy" targetRef="GW_jor_city_amman_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_06" sourceRef="T_jor_city_amman_budget" targetRef="GW_jor_city_amman_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_07" sourceRef="T_jor_city_amman_coord" targetRef="GW_jor_city_amman_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_08" sourceRef="GW_jor_city_amman_join" targetRef="T_jor_city_amman_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_09" sourceRef="T_jor_city_amman_review" targetRef="GW_jor_city_amman_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_10a" sourceRef="GW_jor_city_amman_risk" targetRef="T_jor_city_amman_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_10b" sourceRef="GW_jor_city_amman_risk" targetRef="T_jor_city_amman_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_11" sourceRef="T_jor_city_amman_publish" targetRef="End_jor_city_amman">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jor_city_amman_11b" sourceRef="T_jor_city_amman_revise" targetRef="End_jor_city_amman">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jor_city_amman">
    <bpmndi:BPMNPlane id="BPMNPlane_jor_city_amman" bpmnElement="Collaboration_jor_city_amman" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
