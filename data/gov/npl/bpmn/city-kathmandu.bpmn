<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_npl_city_kathmandu"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_npl_city_kathmandu">
    <bpmn:participant id="Pool_npl_city_kathmandu" name="Kathmandu (city:kat)" processRef="Process_npl_city_kathmandu" />
  </bpmn:collaboration>
  <bpmn:process id="Process_npl_city_kathmandu" name="Kathmandu — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_npl_city_kathmandu" name="Policy trigger
received"><bpmn:outgoing>F_npl_city_kathmandu_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_npl_city_kathmandu_open" name="Parallel checks">
      <bpmn:incoming>F_npl_city_kathmandu_01</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_02</bpmn:outgoing>
      <bpmn:outgoing>F_npl_city_kathmandu_03</bpmn:outgoing>
      <bpmn:outgoing>F_npl_city_kathmandu_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_npl_city_kathmandu_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.npl.city:kathmandu.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_npl_city_kathmandu_02</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_npl_city_kathmandu_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.npl.city:kathmandu.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_npl_city_kathmandu_03</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_npl_city_kathmandu_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.npl.city:kathmandu.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_npl_city_kathmandu_04</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_npl_city_kathmandu_join" name="Checks complete">
      <bpmn:incoming>F_npl_city_kathmandu_05</bpmn:incoming>
      <bpmn:incoming>F_npl_city_kathmandu_06</bpmn:incoming>
      <bpmn:incoming>F_npl_city_kathmandu_07</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_npl_city_kathmandu_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_npl_city_kathmandu_08</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_npl_city_kathmandu_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_npl_city_kathmandu_09</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_10a</bpmn:outgoing>
      <bpmn:outgoing>F_npl_city_kathmandu_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_npl_city_kathmandu_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.npl.city:kathmandu.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_npl_city_kathmandu_10a</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_npl_city_kathmandu_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.npl.city:kathmandu.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_npl_city_kathmandu_10b</bpmn:incoming>
      <bpmn:outgoing>F_npl_city_kathmandu_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_npl_city_kathmandu" name="Process complete">
      <bpmn:incoming>F_npl_city_kathmandu_11</bpmn:incoming>
      <bpmn:incoming>F_npl_city_kathmandu_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_01" sourceRef="Start_npl_city_kathmandu" targetRef="GW_npl_city_kathmandu_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_02" sourceRef="GW_npl_city_kathmandu_open" targetRef="T_npl_city_kathmandu_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_03" sourceRef="GW_npl_city_kathmandu_open" targetRef="T_npl_city_kathmandu_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_04" sourceRef="GW_npl_city_kathmandu_open" targetRef="T_npl_city_kathmandu_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_05" sourceRef="T_npl_city_kathmandu_policy" targetRef="GW_npl_city_kathmandu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_06" sourceRef="T_npl_city_kathmandu_budget" targetRef="GW_npl_city_kathmandu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_07" sourceRef="T_npl_city_kathmandu_coord" targetRef="GW_npl_city_kathmandu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_08" sourceRef="GW_npl_city_kathmandu_join" targetRef="T_npl_city_kathmandu_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_09" sourceRef="T_npl_city_kathmandu_review" targetRef="GW_npl_city_kathmandu_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_10a" sourceRef="GW_npl_city_kathmandu_risk" targetRef="T_npl_city_kathmandu_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_10b" sourceRef="GW_npl_city_kathmandu_risk" targetRef="T_npl_city_kathmandu_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_11" sourceRef="T_npl_city_kathmandu_publish" targetRef="End_npl_city_kathmandu">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_npl_city_kathmandu_11b" sourceRef="T_npl_city_kathmandu_revise" targetRef="End_npl_city_kathmandu">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_npl_city_kathmandu">
    <bpmndi:BPMNPlane id="BPMNPlane_npl_city_kathmandu" bpmnElement="Collaboration_npl_city_kathmandu" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
