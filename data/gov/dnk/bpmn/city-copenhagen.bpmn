<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_dnk_city_copenhagen"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_dnk_city_copenhagen">
    <bpmn:participant id="Pool_dnk_city_copenhagen" name="Copenhagen (city:cop)" processRef="Process_dnk_city_copenhagen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_dnk_city_copenhagen" name="Copenhagen — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_dnk_city_copenhagen" name="Policy trigger
received"><bpmn:outgoing>F_dnk_city_copenhagen_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_dnk_city_copenhagen_open" name="Parallel checks">
      <bpmn:incoming>F_dnk_city_copenhagen_01</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_02</bpmn:outgoing>
      <bpmn:outgoing>F_dnk_city_copenhagen_03</bpmn:outgoing>
      <bpmn:outgoing>F_dnk_city_copenhagen_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_dnk_city_copenhagen_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dnk.city:copenhagen.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dnk_city_copenhagen_02</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dnk_city_copenhagen_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dnk.city:copenhagen.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dnk_city_copenhagen_03</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dnk_city_copenhagen_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dnk.city:copenhagen.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dnk_city_copenhagen_04</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_dnk_city_copenhagen_join" name="Checks complete">
      <bpmn:incoming>F_dnk_city_copenhagen_05</bpmn:incoming>
      <bpmn:incoming>F_dnk_city_copenhagen_06</bpmn:incoming>
      <bpmn:incoming>F_dnk_city_copenhagen_07</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_dnk_city_copenhagen_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_dnk_city_copenhagen_08</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_dnk_city_copenhagen_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_dnk_city_copenhagen_09</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_10a</bpmn:outgoing>
      <bpmn:outgoing>F_dnk_city_copenhagen_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_dnk_city_copenhagen_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dnk.city:copenhagen.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dnk_city_copenhagen_10a</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_dnk_city_copenhagen_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.dnk.city:copenhagen.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_dnk_city_copenhagen_10b</bpmn:incoming>
      <bpmn:outgoing>F_dnk_city_copenhagen_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_dnk_city_copenhagen" name="Process complete">
      <bpmn:incoming>F_dnk_city_copenhagen_11</bpmn:incoming>
      <bpmn:incoming>F_dnk_city_copenhagen_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_01" sourceRef="Start_dnk_city_copenhagen" targetRef="GW_dnk_city_copenhagen_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_02" sourceRef="GW_dnk_city_copenhagen_open" targetRef="T_dnk_city_copenhagen_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_03" sourceRef="GW_dnk_city_copenhagen_open" targetRef="T_dnk_city_copenhagen_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_04" sourceRef="GW_dnk_city_copenhagen_open" targetRef="T_dnk_city_copenhagen_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_05" sourceRef="T_dnk_city_copenhagen_policy" targetRef="GW_dnk_city_copenhagen_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_06" sourceRef="T_dnk_city_copenhagen_budget" targetRef="GW_dnk_city_copenhagen_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_07" sourceRef="T_dnk_city_copenhagen_coord" targetRef="GW_dnk_city_copenhagen_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_08" sourceRef="GW_dnk_city_copenhagen_join" targetRef="T_dnk_city_copenhagen_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_09" sourceRef="T_dnk_city_copenhagen_review" targetRef="GW_dnk_city_copenhagen_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_10a" sourceRef="GW_dnk_city_copenhagen_risk" targetRef="T_dnk_city_copenhagen_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_10b" sourceRef="GW_dnk_city_copenhagen_risk" targetRef="T_dnk_city_copenhagen_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_11" sourceRef="T_dnk_city_copenhagen_publish" targetRef="End_dnk_city_copenhagen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_dnk_city_copenhagen_11b" sourceRef="T_dnk_city_copenhagen_revise" targetRef="End_dnk_city_copenhagen">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_dnk_city_copenhagen">
    <bpmndi:BPMNPlane id="BPMNPlane_dnk_city_copenhagen" bpmnElement="Collaboration_dnk_city_copenhagen" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
