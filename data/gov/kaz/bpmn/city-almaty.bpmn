<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_kaz_city_almaty"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_kaz_city_almaty">
    <bpmn:participant id="Pool_kaz_city_almaty" name="Almaty (city:alm)" processRef="Process_kaz_city_almaty" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kaz_city_almaty" name="Almaty — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_kaz_city_almaty" name="Policy trigger
received"><bpmn:outgoing>F_kaz_city_almaty_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_kaz_city_almaty_open" name="Parallel checks">
      <bpmn:incoming>F_kaz_city_almaty_01</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_02</bpmn:outgoing>
      <bpmn:outgoing>F_kaz_city_almaty_03</bpmn:outgoing>
      <bpmn:outgoing>F_kaz_city_almaty_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_kaz_city_almaty_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kaz.city:almaty.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kaz_city_almaty_02</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kaz_city_almaty_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kaz.city:almaty.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kaz_city_almaty_03</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kaz_city_almaty_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kaz.city:almaty.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kaz_city_almaty_04</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_kaz_city_almaty_join" name="Checks complete">
      <bpmn:incoming>F_kaz_city_almaty_05</bpmn:incoming>
      <bpmn:incoming>F_kaz_city_almaty_06</bpmn:incoming>
      <bpmn:incoming>F_kaz_city_almaty_07</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_kaz_city_almaty_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_kaz_city_almaty_08</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_kaz_city_almaty_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_kaz_city_almaty_09</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_10a</bpmn:outgoing>
      <bpmn:outgoing>F_kaz_city_almaty_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_kaz_city_almaty_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kaz.city:almaty.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kaz_city_almaty_10a</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_kaz_city_almaty_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.kaz.city:almaty.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_kaz_city_almaty_10b</bpmn:incoming>
      <bpmn:outgoing>F_kaz_city_almaty_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_kaz_city_almaty" name="Process complete">
      <bpmn:incoming>F_kaz_city_almaty_11</bpmn:incoming>
      <bpmn:incoming>F_kaz_city_almaty_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_01" sourceRef="Start_kaz_city_almaty" targetRef="GW_kaz_city_almaty_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_02" sourceRef="GW_kaz_city_almaty_open" targetRef="T_kaz_city_almaty_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_03" sourceRef="GW_kaz_city_almaty_open" targetRef="T_kaz_city_almaty_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_04" sourceRef="GW_kaz_city_almaty_open" targetRef="T_kaz_city_almaty_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_05" sourceRef="T_kaz_city_almaty_policy" targetRef="GW_kaz_city_almaty_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_06" sourceRef="T_kaz_city_almaty_budget" targetRef="GW_kaz_city_almaty_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_07" sourceRef="T_kaz_city_almaty_coord" targetRef="GW_kaz_city_almaty_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_08" sourceRef="GW_kaz_city_almaty_join" targetRef="T_kaz_city_almaty_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_09" sourceRef="T_kaz_city_almaty_review" targetRef="GW_kaz_city_almaty_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_10a" sourceRef="GW_kaz_city_almaty_risk" targetRef="T_kaz_city_almaty_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_10b" sourceRef="GW_kaz_city_almaty_risk" targetRef="T_kaz_city_almaty_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_11" sourceRef="T_kaz_city_almaty_publish" targetRef="End_kaz_city_almaty">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_kaz_city_almaty_11b" sourceRef="T_kaz_city_almaty_revise" targetRef="End_kaz_city_almaty">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_kaz_city_almaty">
    <bpmndi:BPMNPlane id="BPMNPlane_kaz_city_almaty" bpmnElement="Collaboration_kaz_city_almaty" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
