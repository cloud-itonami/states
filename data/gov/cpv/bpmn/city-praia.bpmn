<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_cpv_city_praia"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_cpv_city_praia">
    <bpmn:participant id="Pool_cpv_city_praia" name="Praia (city:pra)" processRef="Process_cpv_city_praia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cpv_city_praia" name="Praia — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_cpv_city_praia" name="Policy trigger
received"><bpmn:outgoing>F_cpv_city_praia_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_cpv_city_praia_open" name="Parallel checks">
      <bpmn:incoming>F_cpv_city_praia_01</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_02</bpmn:outgoing>
      <bpmn:outgoing>F_cpv_city_praia_03</bpmn:outgoing>
      <bpmn:outgoing>F_cpv_city_praia_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_cpv_city_praia_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cpv.city:praia.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cpv_city_praia_02</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cpv_city_praia_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cpv.city:praia.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cpv_city_praia_03</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cpv_city_praia_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cpv.city:praia.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cpv_city_praia_04</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_cpv_city_praia_join" name="Checks complete">
      <bpmn:incoming>F_cpv_city_praia_05</bpmn:incoming>
      <bpmn:incoming>F_cpv_city_praia_06</bpmn:incoming>
      <bpmn:incoming>F_cpv_city_praia_07</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_cpv_city_praia_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_cpv_city_praia_08</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_cpv_city_praia_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_cpv_city_praia_09</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_10a</bpmn:outgoing>
      <bpmn:outgoing>F_cpv_city_praia_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_cpv_city_praia_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cpv.city:praia.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cpv_city_praia_10a</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cpv_city_praia_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cpv.city:praia.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cpv_city_praia_10b</bpmn:incoming>
      <bpmn:outgoing>F_cpv_city_praia_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_cpv_city_praia" name="Process complete">
      <bpmn:incoming>F_cpv_city_praia_11</bpmn:incoming>
      <bpmn:incoming>F_cpv_city_praia_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_cpv_city_praia_01" sourceRef="Start_cpv_city_praia" targetRef="GW_cpv_city_praia_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_02" sourceRef="GW_cpv_city_praia_open" targetRef="T_cpv_city_praia_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_03" sourceRef="GW_cpv_city_praia_open" targetRef="T_cpv_city_praia_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_04" sourceRef="GW_cpv_city_praia_open" targetRef="T_cpv_city_praia_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_05" sourceRef="T_cpv_city_praia_policy" targetRef="GW_cpv_city_praia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_06" sourceRef="T_cpv_city_praia_budget" targetRef="GW_cpv_city_praia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_07" sourceRef="T_cpv_city_praia_coord" targetRef="GW_cpv_city_praia_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_08" sourceRef="GW_cpv_city_praia_join" targetRef="T_cpv_city_praia_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_09" sourceRef="T_cpv_city_praia_review" targetRef="GW_cpv_city_praia_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_10a" sourceRef="GW_cpv_city_praia_risk" targetRef="T_cpv_city_praia_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_10b" sourceRef="GW_cpv_city_praia_risk" targetRef="T_cpv_city_praia_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_11" sourceRef="T_cpv_city_praia_publish" targetRef="End_cpv_city_praia">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cpv_city_praia_11b" sourceRef="T_cpv_city_praia_revise" targetRef="End_cpv_city_praia">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cpv_city_praia">
    <bpmndi:BPMNPlane id="BPMNPlane_cpv_city_praia" bpmnElement="Collaboration_cpv_city_praia" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
