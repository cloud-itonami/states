<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_fin_city_helsinki"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_fin_city_helsinki">
    <bpmn:participant id="Pool_fin_city_helsinki" name="Helsinki (city:hel)" processRef="Process_fin_city_helsinki" />
  </bpmn:collaboration>
  <bpmn:process id="Process_fin_city_helsinki" name="Helsinki — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_fin_city_helsinki" name="Policy trigger
received"><bpmn:outgoing>F_fin_city_helsinki_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_fin_city_helsinki_open" name="Parallel checks">
      <bpmn:incoming>F_fin_city_helsinki_01</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_02</bpmn:outgoing>
      <bpmn:outgoing>F_fin_city_helsinki_03</bpmn:outgoing>
      <bpmn:outgoing>F_fin_city_helsinki_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_fin_city_helsinki_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fin.city:helsinki.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fin_city_helsinki_02</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fin_city_helsinki_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fin.city:helsinki.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fin_city_helsinki_03</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fin_city_helsinki_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fin.city:helsinki.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fin_city_helsinki_04</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_fin_city_helsinki_join" name="Checks complete">
      <bpmn:incoming>F_fin_city_helsinki_05</bpmn:incoming>
      <bpmn:incoming>F_fin_city_helsinki_06</bpmn:incoming>
      <bpmn:incoming>F_fin_city_helsinki_07</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_fin_city_helsinki_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_fin_city_helsinki_08</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_fin_city_helsinki_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_fin_city_helsinki_09</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_10a</bpmn:outgoing>
      <bpmn:outgoing>F_fin_city_helsinki_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_fin_city_helsinki_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fin.city:helsinki.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fin_city_helsinki_10a</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fin_city_helsinki_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.fin.city:helsinki.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_fin_city_helsinki_10b</bpmn:incoming>
      <bpmn:outgoing>F_fin_city_helsinki_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_fin_city_helsinki" name="Process complete">
      <bpmn:incoming>F_fin_city_helsinki_11</bpmn:incoming>
      <bpmn:incoming>F_fin_city_helsinki_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_01" sourceRef="Start_fin_city_helsinki" targetRef="GW_fin_city_helsinki_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_02" sourceRef="GW_fin_city_helsinki_open" targetRef="T_fin_city_helsinki_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_03" sourceRef="GW_fin_city_helsinki_open" targetRef="T_fin_city_helsinki_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_04" sourceRef="GW_fin_city_helsinki_open" targetRef="T_fin_city_helsinki_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_05" sourceRef="T_fin_city_helsinki_policy" targetRef="GW_fin_city_helsinki_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_06" sourceRef="T_fin_city_helsinki_budget" targetRef="GW_fin_city_helsinki_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_07" sourceRef="T_fin_city_helsinki_coord" targetRef="GW_fin_city_helsinki_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_08" sourceRef="GW_fin_city_helsinki_join" targetRef="T_fin_city_helsinki_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_09" sourceRef="T_fin_city_helsinki_review" targetRef="GW_fin_city_helsinki_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_10a" sourceRef="GW_fin_city_helsinki_risk" targetRef="T_fin_city_helsinki_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_10b" sourceRef="GW_fin_city_helsinki_risk" targetRef="T_fin_city_helsinki_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_11" sourceRef="T_fin_city_helsinki_publish" targetRef="End_fin_city_helsinki">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_fin_city_helsinki_11b" sourceRef="T_fin_city_helsinki_revise" targetRef="End_fin_city_helsinki">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_fin_city_helsinki">
    <bpmndi:BPMNPlane id="BPMNPlane_fin_city_helsinki" bpmnElement="Collaboration_fin_city_helsinki" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
