<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_zwe_city_harare"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_zwe_city_harare">
    <bpmn:participant id="Pool_zwe_city_harare" name="Harare (city:har)" processRef="Process_zwe_city_harare" />
  </bpmn:collaboration>
  <bpmn:process id="Process_zwe_city_harare" name="Harare — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_zwe_city_harare" name="Policy trigger
received"><bpmn:outgoing>F_zwe_city_harare_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_zwe_city_harare_open" name="Parallel checks">
      <bpmn:incoming>F_zwe_city_harare_01</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_02</bpmn:outgoing>
      <bpmn:outgoing>F_zwe_city_harare_03</bpmn:outgoing>
      <bpmn:outgoing>F_zwe_city_harare_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_zwe_city_harare_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zwe.city:harare.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zwe_city_harare_02</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zwe_city_harare_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zwe.city:harare.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zwe_city_harare_03</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zwe_city_harare_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zwe.city:harare.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zwe_city_harare_04</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_zwe_city_harare_join" name="Checks complete">
      <bpmn:incoming>F_zwe_city_harare_05</bpmn:incoming>
      <bpmn:incoming>F_zwe_city_harare_06</bpmn:incoming>
      <bpmn:incoming>F_zwe_city_harare_07</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_zwe_city_harare_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_zwe_city_harare_08</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_zwe_city_harare_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_zwe_city_harare_09</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_10a</bpmn:outgoing>
      <bpmn:outgoing>F_zwe_city_harare_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_zwe_city_harare_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zwe.city:harare.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zwe_city_harare_10a</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zwe_city_harare_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zwe.city:harare.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zwe_city_harare_10b</bpmn:incoming>
      <bpmn:outgoing>F_zwe_city_harare_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_zwe_city_harare" name="Process complete">
      <bpmn:incoming>F_zwe_city_harare_11</bpmn:incoming>
      <bpmn:incoming>F_zwe_city_harare_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_zwe_city_harare_01" sourceRef="Start_zwe_city_harare" targetRef="GW_zwe_city_harare_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_02" sourceRef="GW_zwe_city_harare_open" targetRef="T_zwe_city_harare_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_03" sourceRef="GW_zwe_city_harare_open" targetRef="T_zwe_city_harare_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_04" sourceRef="GW_zwe_city_harare_open" targetRef="T_zwe_city_harare_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_05" sourceRef="T_zwe_city_harare_policy" targetRef="GW_zwe_city_harare_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_06" sourceRef="T_zwe_city_harare_budget" targetRef="GW_zwe_city_harare_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_07" sourceRef="T_zwe_city_harare_coord" targetRef="GW_zwe_city_harare_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_08" sourceRef="GW_zwe_city_harare_join" targetRef="T_zwe_city_harare_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_09" sourceRef="T_zwe_city_harare_review" targetRef="GW_zwe_city_harare_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_10a" sourceRef="GW_zwe_city_harare_risk" targetRef="T_zwe_city_harare_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_10b" sourceRef="GW_zwe_city_harare_risk" targetRef="T_zwe_city_harare_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_11" sourceRef="T_zwe_city_harare_publish" targetRef="End_zwe_city_harare">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zwe_city_harare_11b" sourceRef="T_zwe_city_harare_revise" targetRef="End_zwe_city_harare">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_zwe_city_harare">
    <bpmndi:BPMNPlane id="BPMNPlane_zwe_city_harare" bpmnElement="Collaboration_zwe_city_harare" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
