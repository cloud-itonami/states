<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_eth_central_bank"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_eth_central_bank">
    <bpmn:participant id="Pool_eth_central_bank" name="Central Bank (e1t2c3b4)" processRef="Process_eth_central_bank" />
  </bpmn:collaboration>
  <bpmn:process id="Process_eth_central_bank" name="Central Bank — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_eth_central_bank" name="License / Permit
application received"><bpmn:outgoing>F_eth_central_bank_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_eth_central_bank_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.central-bank.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_01</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_eth_central_bank_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_eth_central_bank_02</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_03a</bpmn:outgoing>
      <bpmn:outgoing>F_eth_central_bank_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_eth_central_bank_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.central-bank.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_03b</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_eth_central_bank_checks" name="Parallel review">
      <bpmn:incoming>F_eth_central_bank_03a</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_04a</bpmn:outgoing>
      <bpmn:outgoing>F_eth_central_bank_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_eth_central_bank_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.central-bank.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_04a</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_central_bank_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.central-bank.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_04b</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_eth_central_bank_join" name="Reviews complete">
      <bpmn:incoming>F_eth_central_bank_05</bpmn:incoming>
      <bpmn:incoming>F_eth_central_bank_05b</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_eth_central_bank_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_06</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_eth_central_bank_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_eth_central_bank_07</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_08a</bpmn:outgoing>
      <bpmn:outgoing>F_eth_central_bank_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_eth_central_bank_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.central-bank.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_08a</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_central_bank_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.central-bank.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_central_bank_08b</bpmn:incoming>
      <bpmn:outgoing>F_eth_central_bank_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_eth_central_bank" name="Application
processed">
      <bpmn:incoming>F_eth_central_bank_end1</bpmn:incoming>
      <bpmn:incoming>F_eth_central_bank_end1b</bpmn:incoming>
      <bpmn:incoming>F_eth_central_bank_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_eth_central_bank_01" sourceRef="Start_eth_central_bank" targetRef="T_eth_central_bank_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_02" sourceRef="T_eth_central_bank_screen" targetRef="GW_eth_central_bank_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_03a" sourceRef="GW_eth_central_bank_complete" targetRef="GW_eth_central_bank_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_03b" sourceRef="GW_eth_central_bank_complete" targetRef="T_eth_central_bank_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_04a" sourceRef="GW_eth_central_bank_checks" targetRef="T_eth_central_bank_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_04b" sourceRef="GW_eth_central_bank_checks" targetRef="T_eth_central_bank_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_05" sourceRef="T_eth_central_bank_legal" targetRef="GW_eth_central_bank_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_05b" sourceRef="T_eth_central_bank_technical" targetRef="GW_eth_central_bank_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_06" sourceRef="GW_eth_central_bank_join" targetRef="T_eth_central_bank_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_07" sourceRef="T_eth_central_bank_decision" targetRef="GW_eth_central_bank_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_08a" sourceRef="GW_eth_central_bank_approve" targetRef="T_eth_central_bank_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_08b" sourceRef="GW_eth_central_bank_approve" targetRef="T_eth_central_bank_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_end1" sourceRef="T_eth_central_bank_issue" targetRef="End_eth_central_bank">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_end1b" sourceRef="T_eth_central_bank_deny" targetRef="End_eth_central_bank">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_central_bank_end1c" sourceRef="T_eth_central_bank_return" targetRef="End_eth_central_bank">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_eth_central_bank">
    <bpmndi:BPMNPlane id="BPMNPlane_eth_central_bank" bpmnElement="Collaboration_eth_central_bank" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
