<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_eth_city_dire_dawa"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_eth_city_dire_dawa">
    <bpmn:participant id="Pool_eth_city_dire_dawa" name="Dire Dawa (city:dir)" processRef="Process_eth_city_dire_dawa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_eth_city_dire_dawa" name="Dire Dawa — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_eth_city_dire_dawa" name="Policy trigger
received"><bpmn:outgoing>F_eth_city_dire_dawa_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_eth_city_dire_dawa_open" name="Parallel checks">
      <bpmn:incoming>F_eth_city_dire_dawa_01</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_02</bpmn:outgoing>
      <bpmn:outgoing>F_eth_city_dire_dawa_03</bpmn:outgoing>
      <bpmn:outgoing>F_eth_city_dire_dawa_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_eth_city_dire_dawa_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.city:dire-dawa.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_city_dire_dawa_02</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_city_dire_dawa_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.city:dire-dawa.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_city_dire_dawa_03</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_city_dire_dawa_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.city:dire-dawa.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_city_dire_dawa_04</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_eth_city_dire_dawa_join" name="Checks complete">
      <bpmn:incoming>F_eth_city_dire_dawa_05</bpmn:incoming>
      <bpmn:incoming>F_eth_city_dire_dawa_06</bpmn:incoming>
      <bpmn:incoming>F_eth_city_dire_dawa_07</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_eth_city_dire_dawa_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_city_dire_dawa_08</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_eth_city_dire_dawa_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_eth_city_dire_dawa_09</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_10a</bpmn:outgoing>
      <bpmn:outgoing>F_eth_city_dire_dawa_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_eth_city_dire_dawa_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.city:dire-dawa.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_city_dire_dawa_10a</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_city_dire_dawa_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.city:dire-dawa.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_city_dire_dawa_10b</bpmn:incoming>
      <bpmn:outgoing>F_eth_city_dire_dawa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_eth_city_dire_dawa" name="Process complete">
      <bpmn:incoming>F_eth_city_dire_dawa_11</bpmn:incoming>
      <bpmn:incoming>F_eth_city_dire_dawa_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_01" sourceRef="Start_eth_city_dire_dawa" targetRef="GW_eth_city_dire_dawa_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_02" sourceRef="GW_eth_city_dire_dawa_open" targetRef="T_eth_city_dire_dawa_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_03" sourceRef="GW_eth_city_dire_dawa_open" targetRef="T_eth_city_dire_dawa_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_04" sourceRef="GW_eth_city_dire_dawa_open" targetRef="T_eth_city_dire_dawa_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_05" sourceRef="T_eth_city_dire_dawa_policy" targetRef="GW_eth_city_dire_dawa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_06" sourceRef="T_eth_city_dire_dawa_budget" targetRef="GW_eth_city_dire_dawa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_07" sourceRef="T_eth_city_dire_dawa_coord" targetRef="GW_eth_city_dire_dawa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_08" sourceRef="GW_eth_city_dire_dawa_join" targetRef="T_eth_city_dire_dawa_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_09" sourceRef="T_eth_city_dire_dawa_review" targetRef="GW_eth_city_dire_dawa_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_10a" sourceRef="GW_eth_city_dire_dawa_risk" targetRef="T_eth_city_dire_dawa_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_10b" sourceRef="GW_eth_city_dire_dawa_risk" targetRef="T_eth_city_dire_dawa_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_11" sourceRef="T_eth_city_dire_dawa_publish" targetRef="End_eth_city_dire_dawa">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_city_dire_dawa_11b" sourceRef="T_eth_city_dire_dawa_revise" targetRef="End_eth_city_dire_dawa">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_eth_city_dire_dawa">
    <bpmndi:BPMNPlane id="BPMNPlane_eth_city_dire_dawa" bpmnElement="Collaboration_eth_city_dire_dawa" />
  </bpmndi:BPMNDiagram>
