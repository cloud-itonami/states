<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_eth_leg_lower"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_eth_leg_lower">
    <bpmn:participant id="Pool_eth_leg_lower" name="Leg Lower (e1t2l3l4)" processRef="Process_eth_leg_lower" />
  </bpmn:collaboration>
  <bpmn:process id="Process_eth_leg_lower" name="Leg Lower — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_eth_leg_lower" name="Policy trigger
received"><bpmn:outgoing>F_eth_leg_lower_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_eth_leg_lower_open" name="Parallel checks">
      <bpmn:incoming>F_eth_leg_lower_01</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_02</bpmn:outgoing>
      <bpmn:outgoing>F_eth_leg_lower_03</bpmn:outgoing>
      <bpmn:outgoing>F_eth_leg_lower_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_eth_leg_lower_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.leg-lower.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_leg_lower_02</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_leg_lower_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.leg-lower.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_leg_lower_03</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_leg_lower_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.leg-lower.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_leg_lower_04</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_eth_leg_lower_join" name="Checks complete">
      <bpmn:incoming>F_eth_leg_lower_05</bpmn:incoming>
      <bpmn:incoming>F_eth_leg_lower_06</bpmn:incoming>
      <bpmn:incoming>F_eth_leg_lower_07</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_eth_leg_lower_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_leg_lower_08</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_eth_leg_lower_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_eth_leg_lower_09</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_10a</bpmn:outgoing>
      <bpmn:outgoing>F_eth_leg_lower_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_eth_leg_lower_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.leg-lower.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_leg_lower_10a</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_eth_leg_lower_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.eth.leg-lower.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_eth_leg_lower_10b</bpmn:incoming>
      <bpmn:outgoing>F_eth_leg_lower_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_eth_leg_lower" name="Process complete">
      <bpmn:incoming>F_eth_leg_lower_11</bpmn:incoming>
      <bpmn:incoming>F_eth_leg_lower_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_eth_leg_lower_01" sourceRef="Start_eth_leg_lower" targetRef="GW_eth_leg_lower_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_02" sourceRef="GW_eth_leg_lower_open" targetRef="T_eth_leg_lower_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_03" sourceRef="GW_eth_leg_lower_open" targetRef="T_eth_leg_lower_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_04" sourceRef="GW_eth_leg_lower_open" targetRef="T_eth_leg_lower_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_05" sourceRef="T_eth_leg_lower_policy" targetRef="GW_eth_leg_lower_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_06" sourceRef="T_eth_leg_lower_budget" targetRef="GW_eth_leg_lower_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_07" sourceRef="T_eth_leg_lower_coord" targetRef="GW_eth_leg_lower_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_08" sourceRef="GW_eth_leg_lower_join" targetRef="T_eth_leg_lower_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_09" sourceRef="T_eth_leg_lower_review" targetRef="GW_eth_leg_lower_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_10a" sourceRef="GW_eth_leg_lower_risk" targetRef="T_eth_leg_lower_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_10b" sourceRef="GW_eth_leg_lower_risk" targetRef="T_eth_leg_lower_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_11" sourceRef="T_eth_leg_lower_publish" targetRef="End_eth_leg_lower">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_eth_leg_lower_11b" sourceRef="T_eth_leg_lower_revise" targetRef="End_eth_leg_lower">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_eth_leg_lower">
    <bpmndi:BPMNPlane id="BPMNPlane_eth_leg_lower" bpmnElement="Collaboration_eth_leg_lower" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
