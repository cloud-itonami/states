<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mwi_city_lilongwe"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mwi_city_lilongwe">
    <bpmn:participant id="Pool_mwi_city_lilongwe" name="Lilongwe (city:lil)" processRef="Process_mwi_city_lilongwe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mwi_city_lilongwe" name="Lilongwe — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mwi_city_lilongwe" name="Policy trigger
received"><bpmn:outgoing>F_mwi_city_lilongwe_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mwi_city_lilongwe_open" name="Parallel checks">
      <bpmn:incoming>F_mwi_city_lilongwe_01</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_02</bpmn:outgoing>
      <bpmn:outgoing>F_mwi_city_lilongwe_03</bpmn:outgoing>
      <bpmn:outgoing>F_mwi_city_lilongwe_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mwi_city_lilongwe_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mwi.city:lilongwe.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mwi_city_lilongwe_02</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mwi_city_lilongwe_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mwi.city:lilongwe.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mwi_city_lilongwe_03</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mwi_city_lilongwe_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mwi.city:lilongwe.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mwi_city_lilongwe_04</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mwi_city_lilongwe_join" name="Checks complete">
      <bpmn:incoming>F_mwi_city_lilongwe_05</bpmn:incoming>
      <bpmn:incoming>F_mwi_city_lilongwe_06</bpmn:incoming>
      <bpmn:incoming>F_mwi_city_lilongwe_07</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mwi_city_lilongwe_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mwi_city_lilongwe_08</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mwi_city_lilongwe_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mwi_city_lilongwe_09</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mwi_city_lilongwe_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mwi_city_lilongwe_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mwi.city:lilongwe.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mwi_city_lilongwe_10a</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mwi_city_lilongwe_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mwi.city:lilongwe.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mwi_city_lilongwe_10b</bpmn:incoming>
      <bpmn:outgoing>F_mwi_city_lilongwe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mwi_city_lilongwe" name="Process complete">
      <bpmn:incoming>F_mwi_city_lilongwe_11</bpmn:incoming>
      <bpmn:incoming>F_mwi_city_lilongwe_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_01" sourceRef="Start_mwi_city_lilongwe" targetRef="GW_mwi_city_lilongwe_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_02" sourceRef="GW_mwi_city_lilongwe_open" targetRef="T_mwi_city_lilongwe_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_03" sourceRef="GW_mwi_city_lilongwe_open" targetRef="T_mwi_city_lilongwe_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_04" sourceRef="GW_mwi_city_lilongwe_open" targetRef="T_mwi_city_lilongwe_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_05" sourceRef="T_mwi_city_lilongwe_policy" targetRef="GW_mwi_city_lilongwe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_06" sourceRef="T_mwi_city_lilongwe_budget" targetRef="GW_mwi_city_lilongwe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_07" sourceRef="T_mwi_city_lilongwe_coord" targetRef="GW_mwi_city_lilongwe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_08" sourceRef="GW_mwi_city_lilongwe_join" targetRef="T_mwi_city_lilongwe_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_09" sourceRef="T_mwi_city_lilongwe_review" targetRef="GW_mwi_city_lilongwe_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_10a" sourceRef="GW_mwi_city_lilongwe_risk" targetRef="T_mwi_city_lilongwe_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_10b" sourceRef="GW_mwi_city_lilongwe_risk" targetRef="T_mwi_city_lilongwe_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_11" sourceRef="T_mwi_city_lilongwe_publish" targetRef="End_mwi_city_lilongwe">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mwi_city_lilongwe_11b" sourceRef="T_mwi_city_lilongwe_revise" targetRef="End_mwi_city_lilongwe">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mwi_city_lilongwe">
    <bpmndi:BPMNPlane id="BPMNPlane_mwi_city_lilongwe" bpmnElement="Collaboration_mwi_city_lilongwe" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
