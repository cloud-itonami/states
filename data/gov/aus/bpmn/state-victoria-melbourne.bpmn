<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_aus_state_victoria_melbourne"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_aus_state_victoria_melbourne">
    <bpmn:participant id="Pool_aus_state_victoria_melbourne" name="Melbourne (state:vi)" processRef="Process_aus_state_victoria_melbourne" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aus_state_victoria_melbourne" name="Melbourne — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_aus_state_victoria_melbourne" name="Policy trigger
received"><bpmn:outgoing>F_aus_state_victoria_melbourne_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_aus_state_victoria_melbourne_open" name="Parallel checks">
      <bpmn:incoming>F_aus_state_victoria_melbourne_01</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_02</bpmn:outgoing>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_03</bpmn:outgoing>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_aus_state_victoria_melbourne_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:victoria:melbourne.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_victoria_melbourne_02</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_state_victoria_melbourne_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:victoria:melbourne.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_victoria_melbourne_03</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_state_victoria_melbourne_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:victoria:melbourne.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_victoria_melbourne_04</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_aus_state_victoria_melbourne_join" name="Checks complete">
      <bpmn:incoming>F_aus_state_victoria_melbourne_05</bpmn:incoming>
      <bpmn:incoming>F_aus_state_victoria_melbourne_06</bpmn:incoming>
      <bpmn:incoming>F_aus_state_victoria_melbourne_07</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_aus_state_victoria_melbourne_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_victoria_melbourne_08</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_aus_state_victoria_melbourne_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_aus_state_victoria_melbourne_09</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_10a</bpmn:outgoing>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_aus_state_victoria_melbourne_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:victoria:melbourne.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_victoria_melbourne_10a</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_state_victoria_melbourne_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:victoria:melbourne.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_victoria_melbourne_10b</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_victoria_melbourne_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_aus_state_victoria_melbourne" name="Process complete">
      <bpmn:incoming>F_aus_state_victoria_melbourne_11</bpmn:incoming>
      <bpmn:incoming>F_aus_state_victoria_melbourne_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_01" sourceRef="Start_aus_state_victoria_melbourne" targetRef="GW_aus_state_victoria_melbourne_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_02" sourceRef="GW_aus_state_victoria_melbourne_open" targetRef="T_aus_state_victoria_melbourne_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_03" sourceRef="GW_aus_state_victoria_melbourne_open" targetRef="T_aus_state_victoria_melbourne_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_04" sourceRef="GW_aus_state_victoria_melbourne_open" targetRef="T_aus_state_victoria_melbourne_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_05" sourceRef="T_aus_state_victoria_melbourne_policy" targetRef="GW_aus_state_victoria_melbourne_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_06" sourceRef="T_aus_state_victoria_melbourne_budget" targetRef="GW_aus_state_victoria_melbourne_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_07" sourceRef="T_aus_state_victoria_melbourne_coord" targetRef="GW_aus_state_victoria_melbourne_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_08" sourceRef="GW_aus_state_victoria_melbourne_join" targetRef="T_aus_state_victoria_melbourne_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_09" sourceRef="T_aus_state_victoria_melbourne_review" targetRef="GW_aus_state_victoria_melbourne_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_10a" sourceRef="GW_aus_state_victoria_melbourne_risk" targetRef="T_aus_state_victoria_melbourne_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_10b" sourceRef="GW_aus_state_victoria_melbourne_risk" targetRef="T_aus_state_victoria_melbourne_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_11" sourceRef="T_aus_state_victoria_melbourne_publish" targetRef="End_aus_state_victoria_melbourne">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_victoria_melbourne_11b" sourceRef="T_aus_state_victoria_melbourne_revise" targetRef="End_aus_state_victoria_melbourne">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_aus_state_victoria_melbourne">
    <bpmndi:BPMNPlane id="BPMNPlane_aus_state_victoria_melbourne" bpmnElement="Collaboration_aus_state_victoria_melbourne" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
