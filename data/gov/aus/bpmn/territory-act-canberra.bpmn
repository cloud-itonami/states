<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_aus_territory_act_canberra"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_aus_territory_act_canberra">
    <bpmn:participant id="Pool_aus_territory_act_canberra" name="Canberra (territor)" processRef="Process_aus_territory_act_canberra" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aus_territory_act_canberra" name="Canberra — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_aus_territory_act_canberra" name="Policy trigger
received"><bpmn:outgoing>F_aus_territory_act_canberra_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_aus_territory_act_canberra_open" name="Parallel checks">
      <bpmn:incoming>F_aus_territory_act_canberra_01</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_02</bpmn:outgoing>
      <bpmn:outgoing>F_aus_territory_act_canberra_03</bpmn:outgoing>
      <bpmn:outgoing>F_aus_territory_act_canberra_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_aus_territory_act_canberra_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.territory:act:canberra.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_territory_act_canberra_02</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_territory_act_canberra_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.territory:act:canberra.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_territory_act_canberra_03</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_territory_act_canberra_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.territory:act:canberra.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_territory_act_canberra_04</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_aus_territory_act_canberra_join" name="Checks complete">
      <bpmn:incoming>F_aus_territory_act_canberra_05</bpmn:incoming>
      <bpmn:incoming>F_aus_territory_act_canberra_06</bpmn:incoming>
      <bpmn:incoming>F_aus_territory_act_canberra_07</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_aus_territory_act_canberra_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_territory_act_canberra_08</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_aus_territory_act_canberra_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_aus_territory_act_canberra_09</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_10a</bpmn:outgoing>
      <bpmn:outgoing>F_aus_territory_act_canberra_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_aus_territory_act_canberra_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.territory:act:canberra.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_territory_act_canberra_10a</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_territory_act_canberra_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.territory:act:canberra.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_territory_act_canberra_10b</bpmn:incoming>
      <bpmn:outgoing>F_aus_territory_act_canberra_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_aus_territory_act_canberra" name="Process complete">
      <bpmn:incoming>F_aus_territory_act_canberra_11</bpmn:incoming>
      <bpmn:incoming>F_aus_territory_act_canberra_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_01" sourceRef="Start_aus_territory_act_canberra" targetRef="GW_aus_territory_act_canberra_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_02" sourceRef="GW_aus_territory_act_canberra_open" targetRef="T_aus_territory_act_canberra_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_03" sourceRef="GW_aus_territory_act_canberra_open" targetRef="T_aus_territory_act_canberra_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_04" sourceRef="GW_aus_territory_act_canberra_open" targetRef="T_aus_territory_act_canberra_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_05" sourceRef="T_aus_territory_act_canberra_policy" targetRef="GW_aus_territory_act_canberra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_06" sourceRef="T_aus_territory_act_canberra_budget" targetRef="GW_aus_territory_act_canberra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_07" sourceRef="T_aus_territory_act_canberra_coord" targetRef="GW_aus_territory_act_canberra_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_08" sourceRef="GW_aus_territory_act_canberra_join" targetRef="T_aus_territory_act_canberra_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_09" sourceRef="T_aus_territory_act_canberra_review" targetRef="GW_aus_territory_act_canberra_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_10a" sourceRef="GW_aus_territory_act_canberra_risk" targetRef="T_aus_territory_act_canberra_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_10b" sourceRef="GW_aus_territory_act_canberra_risk" targetRef="T_aus_territory_act_canberra_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_11" sourceRef="T_aus_territory_act_canberra_publish" targetRef="End_aus_territory_act_canberra">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_act_canberra_11b" sourceRef="T_aus_territory_act_canberra_revise" targetRef="End_aus_territory_act_canberra">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_aus_territory_act_canberra">
    <bpmndi:BPMNPlane id="BPMNPlane_aus_territory_act_canberra" bpmnElement="Collaboration_aus_territory_act_canberra" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
