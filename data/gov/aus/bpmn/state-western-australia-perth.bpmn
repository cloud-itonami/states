        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_western_australia_perth_08</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_aus_state_western_australia_perth_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_aus_state_western_australia_perth_09</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_10a</bpmn:outgoing>
      <bpmn:outgoing>F_aus_state_western_australia_perth_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_aus_state_western_australia_perth_publish" name="Publish Policy
&amp; Notify Citizens">
