      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:western-australia:perth.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_western_australia_perth_10b</bpmn:incoming>
