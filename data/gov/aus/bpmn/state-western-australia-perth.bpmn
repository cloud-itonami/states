      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:western-australia:perth.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_western_australia_perth_04</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_aus_state_western_australia_perth_join" name="Checks complete">
      <bpmn:incoming>F_aus_state_western_australia_perth_05</bpmn:incoming>
      <bpmn:incoming>F_aus_state_western_australia_perth_06</bpmn:incoming>
      <bpmn:incoming>F_aus_state_western_australia_perth_07</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_08</bpmn:outgoing>
