      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_10b" sourceRef="GW_aus_state_western_australia_perth_risk" targetRef="T_aus_state_western_australia_perth_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_11" sourceRef="T_aus_state_western_australia_perth_publish" targetRef="End_aus_state_western_australia_perth">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_11b" sourceRef="T_aus_state_western_australia_perth_revise" targetRef="End_aus_state_western_australia_perth">
