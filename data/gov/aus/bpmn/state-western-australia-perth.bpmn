      <bpmn:outgoing>F_aus_state_western_australia_perth_02</bpmn:outgoing>
      <bpmn:outgoing>F_aus_state_western_australia_perth_03</bpmn:outgoing>
      <bpmn:outgoing>F_aus_state_western_australia_perth_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_aus_state_western_australia_perth_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:western-australia:perth.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_western_australia_perth_02</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_state_western_australia_perth_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aus.state:western-australia:perth.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_western_australia_perth_03</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_state_western_australia_perth_coord" name="Inter-Agency
