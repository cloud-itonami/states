        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aus_state_western_australia_perth_10a</bpmn:incoming>
      <bpmn:outgoing>F_aus_state_western_australia_perth_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aus_state_western_australia_perth_revise" name="Return for
