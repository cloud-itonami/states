    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_aus_state_western_australia_perth">
    <bpmn:participant id="Pool_aus_state_western_australia_perth" name="Perth (state:we)" processRef="Process_aus_state_western_australia_perth" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aus_state_western_australia_perth" name="Perth — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_aus_state_western_australia_perth" name="Policy trigger
received"><bpmn:outgoing>F_aus_state_western_australia_perth_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_aus_state_western_australia_perth_open" name="Parallel checks">
