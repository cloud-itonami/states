      <bpmn:incoming>F_aus_state_western_australia_perth_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_01" sourceRef="Start_aus_state_western_australia_perth" targetRef="GW_aus_state_western_australia_perth_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_02" sourceRef="GW_aus_state_western_australia_perth_open" targetRef="T_aus_state_western_australia_perth_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_03" sourceRef="GW_aus_state_western_australia_perth_open" targetRef="T_aus_state_western_australia_perth_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_04" sourceRef="GW_aus_state_western_australia_perth_open" targetRef="T_aus_state_western_australia_perth_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_05" sourceRef="T_aus_state_western_australia_perth_policy" targetRef="GW_aus_state_western_australia_perth_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_06" sourceRef="T_aus_state_western_australia_perth_budget" targetRef="GW_aus_state_western_australia_perth_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_07" sourceRef="T_aus_state_western_australia_perth_coord" targetRef="GW_aus_state_western_australia_perth_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_08" sourceRef="GW_aus_state_western_australia_perth_join" targetRef="T_aus_state_western_australia_perth_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_state_western_australia_perth_09" sourceRef="T_aus_state_western_australia_perth_review" targetRef="GW_aus_state_western_australia_perth_risk">
    </bpmn:sequenceFlow>
