    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aus_territory_northern_territory_darwin_07" sourceRef="T_aus_territory_northern_territory_darwin_coord" targetRef="GW_aus_territory_northern_territory_darwin_join">
