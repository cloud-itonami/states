<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_twn_city_new_taipei"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_twn_city_new_taipei">
    <bpmn:participant id="Pool_twn_city_new_taipei" name="New Taipei City (city:new)" processRef="Process_twn_city_new_taipei" />
  </bpmn:collaboration>
  <bpmn:process id="Process_twn_city_new_taipei" name="New Taipei City — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_twn_city_new_taipei" name="Policy trigger
received"><bpmn:outgoing>F_twn_city_new_taipei_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_twn_city_new_taipei_open" name="Parallel checks">
      <bpmn:incoming>F_twn_city_new_taipei_01</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_02</bpmn:outgoing>
      <bpmn:outgoing>F_twn_city_new_taipei_03</bpmn:outgoing>
      <bpmn:outgoing>F_twn_city_new_taipei_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_twn_city_new_taipei_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.twn.city:new-taipei.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_twn_city_new_taipei_02</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_twn_city_new_taipei_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.twn.city:new-taipei.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_twn_city_new_taipei_03</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_twn_city_new_taipei_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.twn.city:new-taipei.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_twn_city_new_taipei_04</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_twn_city_new_taipei_join" name="Checks complete">
      <bpmn:incoming>F_twn_city_new_taipei_05</bpmn:incoming>
      <bpmn:incoming>F_twn_city_new_taipei_06</bpmn:incoming>
      <bpmn:incoming>F_twn_city_new_taipei_07</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_twn_city_new_taipei_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_twn_city_new_taipei_08</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_twn_city_new_taipei_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_twn_city_new_taipei_09</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_10a</bpmn:outgoing>
      <bpmn:outgoing>F_twn_city_new_taipei_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_twn_city_new_taipei_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.twn.city:new-taipei.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_twn_city_new_taipei_10a</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_twn_city_new_taipei_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.twn.city:new-taipei.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_twn_city_new_taipei_10b</bpmn:incoming>
      <bpmn:outgoing>F_twn_city_new_taipei_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_twn_city_new_taipei" name="Process complete">
      <bpmn:incoming>F_twn_city_new_taipei_11</bpmn:incoming>
      <bpmn:incoming>F_twn_city_new_taipei_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_01" sourceRef="Start_twn_city_new_taipei" targetRef="GW_twn_city_new_taipei_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_02" sourceRef="GW_twn_city_new_taipei_open" targetRef="T_twn_city_new_taipei_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_03" sourceRef="GW_twn_city_new_taipei_open" targetRef="T_twn_city_new_taipei_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_04" sourceRef="GW_twn_city_new_taipei_open" targetRef="T_twn_city_new_taipei_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_05" sourceRef="T_twn_city_new_taipei_policy" targetRef="GW_twn_city_new_taipei_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_06" sourceRef="T_twn_city_new_taipei_budget" targetRef="GW_twn_city_new_taipei_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_07" sourceRef="T_twn_city_new_taipei_coord" targetRef="GW_twn_city_new_taipei_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_08" sourceRef="GW_twn_city_new_taipei_join" targetRef="T_twn_city_new_taipei_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_09" sourceRef="T_twn_city_new_taipei_review" targetRef="GW_twn_city_new_taipei_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_10a" sourceRef="GW_twn_city_new_taipei_risk" targetRef="T_twn_city_new_taipei_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_10b" sourceRef="GW_twn_city_new_taipei_risk" targetRef="T_twn_city_new_taipei_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_11" sourceRef="T_twn_city_new_taipei_publish" targetRef="End_twn_city_new_taipei">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_twn_city_new_taipei_11b" sourceRef="T_twn_city_new_taipei_revise" targetRef="End_twn_city_new_taipei">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_twn_city_new_taipei">
    <bpmndi:BPMNPlane id="BPMNPlane_twn_city_new_taipei" bpmnElement="Collaboration_twn_city_new_taipei" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
