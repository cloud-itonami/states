<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pol_city_krakow"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pol_city_krakow">
    <bpmn:participant id="Pool_pol_city_krakow" name="Krakow (city:kra)" processRef="Process_pol_city_krakow" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pol_city_krakow" name="Krakow — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_pol_city_krakow" name="Policy trigger
received"><bpmn:outgoing>F_pol_city_krakow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_pol_city_krakow_open" name="Parallel checks">
      <bpmn:incoming>F_pol_city_krakow_01</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_02</bpmn:outgoing>
      <bpmn:outgoing>F_pol_city_krakow_03</bpmn:outgoing>
      <bpmn:outgoing>F_pol_city_krakow_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_pol_city_krakow_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pol.city:krakow.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pol_city_krakow_02</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pol_city_krakow_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pol.city:krakow.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pol_city_krakow_03</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pol_city_krakow_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pol.city:krakow.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pol_city_krakow_04</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pol_city_krakow_join" name="Checks complete">
      <bpmn:incoming>F_pol_city_krakow_05</bpmn:incoming>
      <bpmn:incoming>F_pol_city_krakow_06</bpmn:incoming>
      <bpmn:incoming>F_pol_city_krakow_07</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_pol_city_krakow_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pol_city_krakow_08</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_pol_city_krakow_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_pol_city_krakow_09</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_10a</bpmn:outgoing>
      <bpmn:outgoing>F_pol_city_krakow_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pol_city_krakow_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pol.city:krakow.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pol_city_krakow_10a</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pol_city_krakow_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pol.city:krakow.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pol_city_krakow_10b</bpmn:incoming>
      <bpmn:outgoing>F_pol_city_krakow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pol_city_krakow" name="Process complete">
      <bpmn:incoming>F_pol_city_krakow_11</bpmn:incoming>
      <bpmn:incoming>F_pol_city_krakow_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pol_city_krakow_01" sourceRef="Start_pol_city_krakow" targetRef="GW_pol_city_krakow_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_02" sourceRef="GW_pol_city_krakow_open" targetRef="T_pol_city_krakow_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_03" sourceRef="GW_pol_city_krakow_open" targetRef="T_pol_city_krakow_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_04" sourceRef="GW_pol_city_krakow_open" targetRef="T_pol_city_krakow_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_05" sourceRef="T_pol_city_krakow_policy" targetRef="GW_pol_city_krakow_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_06" sourceRef="T_pol_city_krakow_budget" targetRef="GW_pol_city_krakow_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_07" sourceRef="T_pol_city_krakow_coord" targetRef="GW_pol_city_krakow_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_08" sourceRef="GW_pol_city_krakow_join" targetRef="T_pol_city_krakow_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_09" sourceRef="T_pol_city_krakow_review" targetRef="GW_pol_city_krakow_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_10a" sourceRef="GW_pol_city_krakow_risk" targetRef="T_pol_city_krakow_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_10b" sourceRef="GW_pol_city_krakow_risk" targetRef="T_pol_city_krakow_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_11" sourceRef="T_pol_city_krakow_publish" targetRef="End_pol_city_krakow">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pol_city_krakow_11b" sourceRef="T_pol_city_krakow_revise" targetRef="End_pol_city_krakow">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pol_city_krakow">
    <bpmndi:BPMNPlane id="BPMNPlane_pol_city_krakow" bpmnElement="Collaboration_pol_city_krakow" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
