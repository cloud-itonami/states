<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_syc_city_victoria"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_syc_city_victoria">
    <bpmn:participant id="Pool_syc_city_victoria" name="Victoria (city:vic)" processRef="Process_syc_city_victoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_syc_city_victoria" name="Victoria — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_syc_city_victoria" name="Policy trigger
received"><bpmn:outgoing>F_syc_city_victoria_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_syc_city_victoria_open" name="Parallel checks">
      <bpmn:incoming>F_syc_city_victoria_01</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_02</bpmn:outgoing>
      <bpmn:outgoing>F_syc_city_victoria_03</bpmn:outgoing>
      <bpmn:outgoing>F_syc_city_victoria_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_syc_city_victoria_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syc.city:victoria.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syc_city_victoria_02</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_syc_city_victoria_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syc.city:victoria.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syc_city_victoria_03</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_syc_city_victoria_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syc.city:victoria.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syc_city_victoria_04</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_syc_city_victoria_join" name="Checks complete">
      <bpmn:incoming>F_syc_city_victoria_05</bpmn:incoming>
      <bpmn:incoming>F_syc_city_victoria_06</bpmn:incoming>
      <bpmn:incoming>F_syc_city_victoria_07</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_syc_city_victoria_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_syc_city_victoria_08</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_syc_city_victoria_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_syc_city_victoria_09</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_10a</bpmn:outgoing>
      <bpmn:outgoing>F_syc_city_victoria_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_syc_city_victoria_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syc.city:victoria.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syc_city_victoria_10a</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_syc_city_victoria_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syc.city:victoria.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syc_city_victoria_10b</bpmn:incoming>
      <bpmn:outgoing>F_syc_city_victoria_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_syc_city_victoria" name="Process complete">
      <bpmn:incoming>F_syc_city_victoria_11</bpmn:incoming>
      <bpmn:incoming>F_syc_city_victoria_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_syc_city_victoria_01" sourceRef="Start_syc_city_victoria" targetRef="GW_syc_city_victoria_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_02" sourceRef="GW_syc_city_victoria_open" targetRef="T_syc_city_victoria_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_03" sourceRef="GW_syc_city_victoria_open" targetRef="T_syc_city_victoria_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_04" sourceRef="GW_syc_city_victoria_open" targetRef="T_syc_city_victoria_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_05" sourceRef="T_syc_city_victoria_policy" targetRef="GW_syc_city_victoria_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_06" sourceRef="T_syc_city_victoria_budget" targetRef="GW_syc_city_victoria_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_07" sourceRef="T_syc_city_victoria_coord" targetRef="GW_syc_city_victoria_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_08" sourceRef="GW_syc_city_victoria_join" targetRef="T_syc_city_victoria_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_09" sourceRef="T_syc_city_victoria_review" targetRef="GW_syc_city_victoria_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_10a" sourceRef="GW_syc_city_victoria_risk" targetRef="T_syc_city_victoria_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_10b" sourceRef="GW_syc_city_victoria_risk" targetRef="T_syc_city_victoria_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_11" sourceRef="T_syc_city_victoria_publish" targetRef="End_syc_city_victoria">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syc_city_victoria_11b" sourceRef="T_syc_city_victoria_revise" targetRef="End_syc_city_victoria">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_syc_city_victoria">
    <bpmndi:BPMNPlane id="BPMNPlane_syc_city_victoria" bpmnElement="Collaboration_syc_city_victoria" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
