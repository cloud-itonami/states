<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_aze_city_baku"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_aze_city_baku">
    <bpmn:participant id="Pool_aze_city_baku" name="Baku (city:bak)" processRef="Process_aze_city_baku" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aze_city_baku" name="Baku — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_aze_city_baku" name="Policy trigger
received"><bpmn:outgoing>F_aze_city_baku_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_aze_city_baku_open" name="Parallel checks">
      <bpmn:incoming>F_aze_city_baku_01</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_02</bpmn:outgoing>
      <bpmn:outgoing>F_aze_city_baku_03</bpmn:outgoing>
      <bpmn:outgoing>F_aze_city_baku_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_aze_city_baku_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aze.city:baku.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aze_city_baku_02</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aze_city_baku_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aze.city:baku.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aze_city_baku_03</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aze_city_baku_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aze.city:baku.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aze_city_baku_04</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_aze_city_baku_join" name="Checks complete">
      <bpmn:incoming>F_aze_city_baku_05</bpmn:incoming>
      <bpmn:incoming>F_aze_city_baku_06</bpmn:incoming>
      <bpmn:incoming>F_aze_city_baku_07</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_aze_city_baku_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_aze_city_baku_08</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_aze_city_baku_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_aze_city_baku_09</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_10a</bpmn:outgoing>
      <bpmn:outgoing>F_aze_city_baku_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_aze_city_baku_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aze.city:baku.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aze_city_baku_10a</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aze_city_baku_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aze.city:baku.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aze_city_baku_10b</bpmn:incoming>
      <bpmn:outgoing>F_aze_city_baku_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_aze_city_baku" name="Process complete">
      <bpmn:incoming>F_aze_city_baku_11</bpmn:incoming>
      <bpmn:incoming>F_aze_city_baku_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_aze_city_baku_01" sourceRef="Start_aze_city_baku" targetRef="GW_aze_city_baku_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_02" sourceRef="GW_aze_city_baku_open" targetRef="T_aze_city_baku_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_03" sourceRef="GW_aze_city_baku_open" targetRef="T_aze_city_baku_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_04" sourceRef="GW_aze_city_baku_open" targetRef="T_aze_city_baku_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_05" sourceRef="T_aze_city_baku_policy" targetRef="GW_aze_city_baku_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_06" sourceRef="T_aze_city_baku_budget" targetRef="GW_aze_city_baku_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_07" sourceRef="T_aze_city_baku_coord" targetRef="GW_aze_city_baku_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_08" sourceRef="GW_aze_city_baku_join" targetRef="T_aze_city_baku_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_09" sourceRef="T_aze_city_baku_review" targetRef="GW_aze_city_baku_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_10a" sourceRef="GW_aze_city_baku_risk" targetRef="T_aze_city_baku_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_10b" sourceRef="GW_aze_city_baku_risk" targetRef="T_aze_city_baku_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_11" sourceRef="T_aze_city_baku_publish" targetRef="End_aze_city_baku">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aze_city_baku_11b" sourceRef="T_aze_city_baku_revise" targetRef="End_aze_city_baku">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_aze_city_baku">
    <bpmndi:BPMNPlane id="BPMNPlane_aze_city_baku" bpmnElement="Collaboration_aze_city_baku" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
