<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_intl_wto"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_intl_wto">
    <bpmn:participant id="Pool_intl_wto" name="Wto (wto)" processRef="Process_intl_wto" />
  </bpmn:collaboration>
  <bpmn:process id="Process_intl_wto" name="Wto — International Coordination" isExecutable="true">
    <bpmn:startEvent id="Start_intl_wto" name="Multilateral
agenda item raised"><bpmn:outgoing>F_intl_wto_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_intl_wto_consult" name="Member State
Consultation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.intl.wto.consult_members" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="member_participation_rate" />
          <zeebe:header key="cofog" value="intl" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_intl_wto_01</bpmn:incoming>
      <bpmn:outgoing>F_intl_wto_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_intl_wto_draft" name="Draft Resolution
/ Treaty Text">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.intl.wto.draft_resolution" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_intl_wto_02</bpmn:incoming>
      <bpmn:outgoing>F_intl_wto_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_intl_wto_negotiate" name="Negotiation
& Amendments">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="member-state-delegates" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_intl_wto_03</bpmn:incoming>
      <bpmn:outgoing>F_intl_wto_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_intl_wto_consensus" name="Consensus
reached?" isMarkerVisible="true">
      <bpmn:incoming>F_intl_wto_04</bpmn:incoming>
      <bpmn:outgoing>F_intl_wto_05a</bpmn:outgoing>
      <bpmn:outgoing>F_intl_wto_05b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_intl_wto_adopt" name="Adopt Resolution
& Notify Members">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.intl.wto.adopt_resolution" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="adopt" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_intl_wto_05a</bpmn:incoming>
      <bpmn:outgoing>F_intl_wto_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_intl_wto_refer" name="Refer to
Committee">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.intl.wto.refer_committee" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="refer" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_intl_wto_05b</bpmn:incoming>
      <bpmn:outgoing>F_intl_wto_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_intl_wto" name="Agenda item
resolved">
      <bpmn:incoming>F_intl_wto_06</bpmn:incoming>
      <bpmn:incoming>F_intl_wto_06b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_intl_wto_01" sourceRef="Start_intl_wto" targetRef="T_intl_wto_consult">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_02" sourceRef="T_intl_wto_consult" targetRef="T_intl_wto_draft">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_03" sourceRef="T_intl_wto_draft" targetRef="T_intl_wto_negotiate">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_04" sourceRef="T_intl_wto_negotiate" targetRef="GW_intl_wto_consensus">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_05a" sourceRef="GW_intl_wto_consensus" targetRef="T_intl_wto_adopt" name="Yes">
      <bpmn:conditionExpression>=consensus = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_05b" sourceRef="GW_intl_wto_consensus" targetRef="T_intl_wto_refer" name="No">
      <bpmn:conditionExpression>=consensus = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_06" sourceRef="T_intl_wto_adopt" targetRef="End_intl_wto">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_intl_wto_06b" sourceRef="T_intl_wto_refer" targetRef="End_intl_wto">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_intl_wto">
    <bpmndi:BPMNPlane id="BPMNPlane_intl_wto" bpmnElement="Collaboration_intl_wto" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
