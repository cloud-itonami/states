<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_hkg_legislative"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_hkg_legislative">
    <bpmn:participant id="Pool_hkg_legislative" name="Legislative (legislat)" processRef="Process_hkg_legislative" />
  </bpmn:collaboration>
  <bpmn:process id="Process_hkg_legislative" name="Legislative — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_hkg_legislative" name="Policy trigger
received"><bpmn:outgoing>F_hkg_legislative_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_hkg_legislative_open" name="Parallel checks">
      <bpmn:incoming>F_hkg_legislative_01</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_02</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_legislative_03</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_legislative_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_hkg_legislative_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.legislative.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_legislative_02</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_legislative_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.legislative.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_legislative_03</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_legislative_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.legislative.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_legislative_04</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_hkg_legislative_join" name="Checks complete">
      <bpmn:incoming>F_hkg_legislative_05</bpmn:incoming>
      <bpmn:incoming>F_hkg_legislative_06</bpmn:incoming>
      <bpmn:incoming>F_hkg_legislative_07</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_hkg_legislative_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_legislative_08</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_hkg_legislative_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_hkg_legislative_09</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_10a</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_legislative_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_hkg_legislative_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.legislative.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_legislative_10a</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_legislative_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.legislative.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_legislative_10b</bpmn:incoming>
      <bpmn:outgoing>F_hkg_legislative_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hkg_legislative" name="Process complete">
      <bpmn:incoming>F_hkg_legislative_11</bpmn:incoming>
      <bpmn:incoming>F_hkg_legislative_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hkg_legislative_01" sourceRef="Start_hkg_legislative" targetRef="GW_hkg_legislative_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_02" sourceRef="GW_hkg_legislative_open" targetRef="T_hkg_legislative_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_03" sourceRef="GW_hkg_legislative_open" targetRef="T_hkg_legislative_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_04" sourceRef="GW_hkg_legislative_open" targetRef="T_hkg_legislative_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_05" sourceRef="T_hkg_legislative_policy" targetRef="GW_hkg_legislative_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_06" sourceRef="T_hkg_legislative_budget" targetRef="GW_hkg_legislative_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_07" sourceRef="T_hkg_legislative_coord" targetRef="GW_hkg_legislative_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_08" sourceRef="GW_hkg_legislative_join" targetRef="T_hkg_legislative_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_09" sourceRef="T_hkg_legislative_review" targetRef="GW_hkg_legislative_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_10a" sourceRef="GW_hkg_legislative_risk" targetRef="T_hkg_legislative_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_10b" sourceRef="GW_hkg_legislative_risk" targetRef="T_hkg_legislative_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_11" sourceRef="T_hkg_legislative_publish" targetRef="End_hkg_legislative">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_legislative_11b" sourceRef="T_hkg_legislative_revise" targetRef="End_hkg_legislative">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hkg_legislative">
    <bpmndi:BPMNPlane id="BPMNPlane_hkg_legislative" bpmnElement="Collaboration_hkg_legislative" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
