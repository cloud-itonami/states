<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_hkg_law_enforcement_hong_kong_police_for"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_hkg_law_enforcement_hong_kong_police_for">
    <bpmn:participant id="Pool_hkg_law_enforcement_hong_kong_police_for" name="Law Enforcement Hong Kong Police For (law-enfo)" processRef="Process_hkg_law_enforcement_hong_kong_police_for" />
  </bpmn:collaboration>
  <bpmn:process id="Process_hkg_law_enforcement_hong_kong_police_for" name="Law Enforcement Hong Kong Police For — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_hkg_law_enforcement_hong_kong_police_for" name="Incident
reported"><bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_hkg_law_enforcement_hong_kong_police_for_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.law-enforcement-hong-kong-police-for.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_01</bpmn:incoming>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_hkg_law_enforcement_hong_kong_police_for_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_02</bpmn:incoming>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_03a</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_03b</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_hkg_law_enforcement_hong_kong_police_for_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.law-enforcement-hong-kong-police-for.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_03a</bpmn:incoming>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_law_enforcement_hong_kong_police_for_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.law-enforcement-hong-kong-police-for.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_03b</bpmn:incoming>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_law_enforcement_hong_kong_police_for_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.law-enforcement-hong-kong-police-for.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_03c</bpmn:incoming>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_law_enforcement_hong_kong_police_for_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.law-enforcement-hong-kong-police-for.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_06</bpmn:incoming>
      <bpmn:outgoing>F_hkg_law_enforcement_hong_kong_police_for_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hkg_law_enforcement_hong_kong_police_for" name="Incident resolved">
      <bpmn:incoming>F_hkg_law_enforcement_hong_kong_police_for_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_01" sourceRef="Start_hkg_law_enforcement_hong_kong_police_for" targetRef="T_hkg_law_enforcement_hong_kong_police_for_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_02" sourceRef="T_hkg_law_enforcement_hong_kong_police_for_triage" targetRef="GW_hkg_law_enforcement_hong_kong_police_for_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_03a" sourceRef="GW_hkg_law_enforcement_hong_kong_police_for_sev" targetRef="T_hkg_law_enforcement_hong_kong_police_for_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_03b" sourceRef="GW_hkg_law_enforcement_hong_kong_police_for_sev" targetRef="T_hkg_law_enforcement_hong_kong_police_for_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_03c" sourceRef="GW_hkg_law_enforcement_hong_kong_police_for_sev" targetRef="T_hkg_law_enforcement_hong_kong_police_for_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_06" sourceRef="T_hkg_law_enforcement_hong_kong_police_for_emergency" targetRef="T_hkg_law_enforcement_hong_kong_police_for_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_06b" sourceRef="T_hkg_law_enforcement_hong_kong_police_for_investigate" targetRef="T_hkg_law_enforcement_hong_kong_police_for_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_06c" sourceRef="T_hkg_law_enforcement_hong_kong_police_for_log" targetRef="T_hkg_law_enforcement_hong_kong_police_for_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_law_enforcement_hong_kong_police_for_07" sourceRef="T_hkg_law_enforcement_hong_kong_police_for_report" targetRef="End_hkg_law_enforcement_hong_kong_police_for">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hkg_law_enforcement_hong_kong_police_for">
    <bpmndi:BPMNPlane id="BPMNPlane_hkg_law_enforcement_hong_kong_police_for" bpmnElement="Collaboration_hkg_law_enforcement_hong_kong_police_for" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
