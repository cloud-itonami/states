<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_hkg_military_hong_kong"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_hkg_military_hong_kong">
    <bpmn:participant id="Pool_hkg_military_hong_kong" name="Military Hong Kong (garrison)" processRef="Process_hkg_military_hong_kong" />
  </bpmn:collaboration>
  <bpmn:process id="Process_hkg_military_hong_kong" name="Military Hong Kong — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_hkg_military_hong_kong" name="Readiness
assessment triggered"><bpmn:outgoing>F_hkg_military_hong_kong_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_hkg_military_hong_kong_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.military-hong-kong.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_military_hong_kong_01</bpmn:incoming>
      <bpmn:outgoing>F_hkg_military_hong_kong_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_hkg_military_hong_kong_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_hkg_military_hong_kong_02</bpmn:incoming>
      <bpmn:outgoing>F_hkg_military_hong_kong_03a</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_military_hong_kong_03b</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_military_hong_kong_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_hkg_military_hong_kong_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.military-hong-kong.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_military_hong_kong_03a</bpmn:incoming>
      <bpmn:outgoing>F_hkg_military_hong_kong_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_military_hong_kong_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.military-hong-kong.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_military_hong_kong_03b</bpmn:incoming>
      <bpmn:outgoing>F_hkg_military_hong_kong_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_military_hong_kong_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.military-hong-kong.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_military_hong_kong_03c</bpmn:incoming>
      <bpmn:outgoing>F_hkg_military_hong_kong_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_military_hong_kong_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.military-hong-kong.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_military_hong_kong_04</bpmn:incoming>
      <bpmn:outgoing>F_hkg_military_hong_kong_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hkg_military_hong_kong" name="Assessment complete">
      <bpmn:incoming>F_hkg_military_hong_kong_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_01" sourceRef="Start_hkg_military_hong_kong" targetRef="T_hkg_military_hong_kong_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_02" sourceRef="T_hkg_military_hong_kong_assess" targetRef="GW_hkg_military_hong_kong_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_03a" sourceRef="GW_hkg_military_hong_kong_ready" targetRef="T_hkg_military_hong_kong_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_03b" sourceRef="GW_hkg_military_hong_kong_ready" targetRef="T_hkg_military_hong_kong_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_03c" sourceRef="GW_hkg_military_hong_kong_ready" targetRef="T_hkg_military_hong_kong_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_04" sourceRef="T_hkg_military_hong_kong_ops" targetRef="T_hkg_military_hong_kong_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_04b" sourceRef="T_hkg_military_hong_kong_proc" targetRef="T_hkg_military_hong_kong_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_04c" sourceRef="T_hkg_military_hong_kong_alert" targetRef="T_hkg_military_hong_kong_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_military_hong_kong_05" sourceRef="T_hkg_military_hong_kong_report" targetRef="End_hkg_military_hong_kong">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hkg_military_hong_kong">
    <bpmndi:BPMNPlane id="BPMNPlane_hkg_military_hong_kong" bpmnElement="Collaboration_hkg_military_hong_kong" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
