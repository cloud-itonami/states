<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_hkg_executive_chief_executives"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_hkg_executive_chief_executives">
    <bpmn:participant id="Pool_hkg_executive_chief_executives" name="Executive Chief Executives (executiv)" processRef="Process_hkg_executive_chief_executives" />
  </bpmn:collaboration>
  <bpmn:process id="Process_hkg_executive_chief_executives" name="Executive Chief Executives — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_hkg_executive_chief_executives" name="Policy trigger
received"><bpmn:outgoing>F_hkg_executive_chief_executives_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_hkg_executive_chief_executives_open" name="Parallel checks">
      <bpmn:incoming>F_hkg_executive_chief_executives_01</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_02</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_executive_chief_executives_03</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_executive_chief_executives_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_hkg_executive_chief_executives_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.executive-chief-executives.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_executive_chief_executives_02</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_executive_chief_executives_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.executive-chief-executives.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_executive_chief_executives_03</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_executive_chief_executives_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.executive-chief-executives.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_executive_chief_executives_04</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_hkg_executive_chief_executives_join" name="Checks complete">
      <bpmn:incoming>F_hkg_executive_chief_executives_05</bpmn:incoming>
      <bpmn:incoming>F_hkg_executive_chief_executives_06</bpmn:incoming>
      <bpmn:incoming>F_hkg_executive_chief_executives_07</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_hkg_executive_chief_executives_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_executive_chief_executives_08</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_hkg_executive_chief_executives_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_hkg_executive_chief_executives_09</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_10a</bpmn:outgoing>
      <bpmn:outgoing>F_hkg_executive_chief_executives_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_hkg_executive_chief_executives_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.executive-chief-executives.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_executive_chief_executives_10a</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_hkg_executive_chief_executives_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hkg.executive-chief-executives.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hkg_executive_chief_executives_10b</bpmn:incoming>
      <bpmn:outgoing>F_hkg_executive_chief_executives_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hkg_executive_chief_executives" name="Process complete">
      <bpmn:incoming>F_hkg_executive_chief_executives_11</bpmn:incoming>
      <bpmn:incoming>F_hkg_executive_chief_executives_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_01" sourceRef="Start_hkg_executive_chief_executives" targetRef="GW_hkg_executive_chief_executives_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_02" sourceRef="GW_hkg_executive_chief_executives_open" targetRef="T_hkg_executive_chief_executives_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_03" sourceRef="GW_hkg_executive_chief_executives_open" targetRef="T_hkg_executive_chief_executives_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_04" sourceRef="GW_hkg_executive_chief_executives_open" targetRef="T_hkg_executive_chief_executives_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_05" sourceRef="T_hkg_executive_chief_executives_policy" targetRef="GW_hkg_executive_chief_executives_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_06" sourceRef="T_hkg_executive_chief_executives_budget" targetRef="GW_hkg_executive_chief_executives_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_07" sourceRef="T_hkg_executive_chief_executives_coord" targetRef="GW_hkg_executive_chief_executives_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_08" sourceRef="GW_hkg_executive_chief_executives_join" targetRef="T_hkg_executive_chief_executives_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_09" sourceRef="T_hkg_executive_chief_executives_review" targetRef="GW_hkg_executive_chief_executives_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_10a" sourceRef="GW_hkg_executive_chief_executives_risk" targetRef="T_hkg_executive_chief_executives_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_10b" sourceRef="GW_hkg_executive_chief_executives_risk" targetRef="T_hkg_executive_chief_executives_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_11" sourceRef="T_hkg_executive_chief_executives_publish" targetRef="End_hkg_executive_chief_executives">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hkg_executive_chief_executives_11b" sourceRef="T_hkg_executive_chief_executives_revise" targetRef="End_hkg_executive_chief_executives">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hkg_executive_chief_executives">
    <bpmndi:BPMNPlane id="BPMNPlane_hkg_executive_chief_executives" bpmnElement="Collaboration_hkg_executive_chief_executives" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
