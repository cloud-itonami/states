<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mdv_city_male"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mdv_city_male">
    <bpmn:participant id="Pool_mdv_city_male" name="Male (city:mal)" processRef="Process_mdv_city_male" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mdv_city_male" name="Male — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mdv_city_male" name="Policy trigger
received"><bpmn:outgoing>F_mdv_city_male_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mdv_city_male_open" name="Parallel checks">
      <bpmn:incoming>F_mdv_city_male_01</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_02</bpmn:outgoing>
      <bpmn:outgoing>F_mdv_city_male_03</bpmn:outgoing>
      <bpmn:outgoing>F_mdv_city_male_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mdv_city_male_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mdv.city:male.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mdv_city_male_02</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mdv_city_male_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mdv.city:male.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mdv_city_male_03</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mdv_city_male_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mdv.city:male.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mdv_city_male_04</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mdv_city_male_join" name="Checks complete">
      <bpmn:incoming>F_mdv_city_male_05</bpmn:incoming>
      <bpmn:incoming>F_mdv_city_male_06</bpmn:incoming>
      <bpmn:incoming>F_mdv_city_male_07</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mdv_city_male_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mdv_city_male_08</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mdv_city_male_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mdv_city_male_09</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mdv_city_male_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mdv_city_male_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mdv.city:male.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mdv_city_male_10a</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mdv_city_male_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mdv.city:male.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mdv_city_male_10b</bpmn:incoming>
      <bpmn:outgoing>F_mdv_city_male_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mdv_city_male" name="Process complete">
      <bpmn:incoming>F_mdv_city_male_11</bpmn:incoming>
      <bpmn:incoming>F_mdv_city_male_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mdv_city_male_01" sourceRef="Start_mdv_city_male" targetRef="GW_mdv_city_male_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_02" sourceRef="GW_mdv_city_male_open" targetRef="T_mdv_city_male_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_03" sourceRef="GW_mdv_city_male_open" targetRef="T_mdv_city_male_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_04" sourceRef="GW_mdv_city_male_open" targetRef="T_mdv_city_male_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_05" sourceRef="T_mdv_city_male_policy" targetRef="GW_mdv_city_male_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_06" sourceRef="T_mdv_city_male_budget" targetRef="GW_mdv_city_male_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_07" sourceRef="T_mdv_city_male_coord" targetRef="GW_mdv_city_male_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_08" sourceRef="GW_mdv_city_male_join" targetRef="T_mdv_city_male_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_09" sourceRef="T_mdv_city_male_review" targetRef="GW_mdv_city_male_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_10a" sourceRef="GW_mdv_city_male_risk" targetRef="T_mdv_city_male_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_10b" sourceRef="GW_mdv_city_male_risk" targetRef="T_mdv_city_male_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_11" sourceRef="T_mdv_city_male_publish" targetRef="End_mdv_city_male">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mdv_city_male_11b" sourceRef="T_mdv_city_male_revise" targetRef="End_mdv_city_male">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mdv_city_male">
    <bpmndi:BPMNPlane id="BPMNPlane_mdv_city_male" bpmnElement="Collaboration_mdv_city_male" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
