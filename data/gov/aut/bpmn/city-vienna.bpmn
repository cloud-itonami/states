<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_aut_city_vienna"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_aut_city_vienna">
    <bpmn:participant id="Pool_aut_city_vienna" name="Vienna (city:vie)" processRef="Process_aut_city_vienna" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aut_city_vienna" name="Vienna — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_aut_city_vienna" name="Policy trigger
received"><bpmn:outgoing>F_aut_city_vienna_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_aut_city_vienna_open" name="Parallel checks">
      <bpmn:incoming>F_aut_city_vienna_01</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_02</bpmn:outgoing>
      <bpmn:outgoing>F_aut_city_vienna_03</bpmn:outgoing>
      <bpmn:outgoing>F_aut_city_vienna_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_aut_city_vienna_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aut.city:vienna.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aut_city_vienna_02</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aut_city_vienna_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aut.city:vienna.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aut_city_vienna_03</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aut_city_vienna_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aut.city:vienna.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aut_city_vienna_04</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_aut_city_vienna_join" name="Checks complete">
      <bpmn:incoming>F_aut_city_vienna_05</bpmn:incoming>
      <bpmn:incoming>F_aut_city_vienna_06</bpmn:incoming>
      <bpmn:incoming>F_aut_city_vienna_07</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_aut_city_vienna_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_aut_city_vienna_08</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_aut_city_vienna_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_aut_city_vienna_09</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_10a</bpmn:outgoing>
      <bpmn:outgoing>F_aut_city_vienna_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_aut_city_vienna_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aut.city:vienna.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aut_city_vienna_10a</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_aut_city_vienna_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.aut.city:vienna.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_aut_city_vienna_10b</bpmn:incoming>
      <bpmn:outgoing>F_aut_city_vienna_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_aut_city_vienna" name="Process complete">
      <bpmn:incoming>F_aut_city_vienna_11</bpmn:incoming>
      <bpmn:incoming>F_aut_city_vienna_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_aut_city_vienna_01" sourceRef="Start_aut_city_vienna" targetRef="GW_aut_city_vienna_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_02" sourceRef="GW_aut_city_vienna_open" targetRef="T_aut_city_vienna_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_03" sourceRef="GW_aut_city_vienna_open" targetRef="T_aut_city_vienna_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_04" sourceRef="GW_aut_city_vienna_open" targetRef="T_aut_city_vienna_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_05" sourceRef="T_aut_city_vienna_policy" targetRef="GW_aut_city_vienna_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_06" sourceRef="T_aut_city_vienna_budget" targetRef="GW_aut_city_vienna_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_07" sourceRef="T_aut_city_vienna_coord" targetRef="GW_aut_city_vienna_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_08" sourceRef="GW_aut_city_vienna_join" targetRef="T_aut_city_vienna_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_09" sourceRef="T_aut_city_vienna_review" targetRef="GW_aut_city_vienna_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_10a" sourceRef="GW_aut_city_vienna_risk" targetRef="T_aut_city_vienna_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_10b" sourceRef="GW_aut_city_vienna_risk" targetRef="T_aut_city_vienna_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_11" sourceRef="T_aut_city_vienna_publish" targetRef="End_aut_city_vienna">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_aut_city_vienna_11b" sourceRef="T_aut_city_vienna_revise" targetRef="End_aut_city_vienna">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_aut_city_vienna">
    <bpmndi:BPMNPlane id="BPMNPlane_aut_city_vienna" bpmnElement="Collaboration_aut_city_vienna" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
