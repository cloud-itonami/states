    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_01" sourceRef="Start_bra_estado_paraiba_joao_pessoa" targetRef="GW_bra_estado_paraiba_joao_pessoa_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_02" sourceRef="GW_bra_estado_paraiba_joao_pessoa_open" targetRef="T_bra_estado_paraiba_joao_pessoa_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_03" sourceRef="GW_bra_estado_paraiba_joao_pessoa_open" targetRef="T_bra_estado_paraiba_joao_pessoa_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_04" sourceRef="GW_bra_estado_paraiba_joao_pessoa_open" targetRef="T_bra_estado_paraiba_joao_pessoa_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_05" sourceRef="T_bra_estado_paraiba_joao_pessoa_policy" targetRef="GW_bra_estado_paraiba_joao_pessoa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_06" sourceRef="T_bra_estado_paraiba_joao_pessoa_budget" targetRef="GW_bra_estado_paraiba_joao_pessoa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_07" sourceRef="T_bra_estado_paraiba_joao_pessoa_coord" targetRef="GW_bra_estado_paraiba_joao_pessoa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_08" sourceRef="GW_bra_estado_paraiba_joao_pessoa_join" targetRef="T_bra_estado_paraiba_joao_pessoa_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_09" sourceRef="T_bra_estado_paraiba_joao_pessoa_review" targetRef="GW_bra_estado_paraiba_joao_pessoa_risk">
