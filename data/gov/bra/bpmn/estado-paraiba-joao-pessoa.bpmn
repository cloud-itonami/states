    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_estado_paraiba_joao_pessoa">
    <bpmn:participant id="Pool_bra_estado_paraiba_joao_pessoa" name="Joao Pessoa (estado:p)" processRef="Process_bra_estado_paraiba_joao_pessoa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_estado_paraiba_joao_pessoa" name="Joao Pessoa — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_estado_paraiba_joao_pessoa" name="Policy trigger
received"><bpmn:outgoing>F_bra_estado_paraiba_joao_pessoa_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_estado_paraiba_joao_pessoa_open" name="Parallel checks">
