      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_10b" sourceRef="GW_bra_estado_paraiba_joao_pessoa_risk" targetRef="T_bra_estado_paraiba_joao_pessoa_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_11" sourceRef="T_bra_estado_paraiba_joao_pessoa_publish" targetRef="End_bra_estado_paraiba_joao_pessoa">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_paraiba_joao_pessoa_11b" sourceRef="T_bra_estado_paraiba_joao_pessoa_revise" targetRef="End_bra_estado_paraiba_joao_pessoa">
