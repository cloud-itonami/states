    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_paraiba_joao_pessoa_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:paraiba:joao-pessoa.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_paraiba_joao_pessoa_03</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_paraiba_joao_pessoa_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_paraiba_joao_pessoa_coord" name="Inter-Agency
