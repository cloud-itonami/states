      <bpmn:outgoing>F_bra_estado_paraiba_joao_pessoa_03</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_paraiba_joao_pessoa_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_estado_paraiba_joao_pessoa_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:paraiba:joao-pessoa.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_paraiba_joao_pessoa_02</bpmn:incoming>
