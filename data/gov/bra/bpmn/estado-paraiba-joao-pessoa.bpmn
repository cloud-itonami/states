      <bpmn:outgoing>F_bra_estado_paraiba_joao_pessoa_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_estado_paraiba_joao_pessoa_join" name="Checks complete">
      <bpmn:incoming>F_bra_estado_paraiba_joao_pessoa_05</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_paraiba_joao_pessoa_06</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_paraiba_joao_pessoa_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_paraiba_joao_pessoa_08</bpmn:outgoing>
