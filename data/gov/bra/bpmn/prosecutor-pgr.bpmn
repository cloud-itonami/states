<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bra_prosecutor_pgr"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_prosecutor_pgr">
    <bpmn:participant id="Pool_bra_prosecutor_pgr" name="Prosecutor Pgr (b1r2p3g4)" processRef="Process_bra_prosecutor_pgr" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_prosecutor_pgr" name="Prosecutor Pgr — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_bra_prosecutor_pgr" name="Incident
reported"><bpmn:outgoing>F_bra_prosecutor_pgr_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_bra_prosecutor_pgr_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.prosecutor-pgr.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_prosecutor_pgr_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_prosecutor_pgr_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_bra_prosecutor_pgr_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_bra_prosecutor_pgr_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_prosecutor_pgr_03a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_prosecutor_pgr_03b</bpmn:outgoing>
      <bpmn:outgoing>F_bra_prosecutor_pgr_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_prosecutor_pgr_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.prosecutor-pgr.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_prosecutor_pgr_03a</bpmn:incoming>
      <bpmn:outgoing>F_bra_prosecutor_pgr_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_prosecutor_pgr_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.prosecutor-pgr.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_prosecutor_pgr_03b</bpmn:incoming>
      <bpmn:outgoing>F_bra_prosecutor_pgr_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_prosecutor_pgr_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.prosecutor-pgr.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_prosecutor_pgr_03c</bpmn:incoming>
      <bpmn:outgoing>F_bra_prosecutor_pgr_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_prosecutor_pgr_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.prosecutor-pgr.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_prosecutor_pgr_06</bpmn:incoming>
      <bpmn:outgoing>F_bra_prosecutor_pgr_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bra_prosecutor_pgr" name="Incident resolved">
      <bpmn:incoming>F_bra_prosecutor_pgr_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_01" sourceRef="Start_bra_prosecutor_pgr" targetRef="T_bra_prosecutor_pgr_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_02" sourceRef="T_bra_prosecutor_pgr_triage" targetRef="GW_bra_prosecutor_pgr_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_03a" sourceRef="GW_bra_prosecutor_pgr_sev" targetRef="T_bra_prosecutor_pgr_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_03b" sourceRef="GW_bra_prosecutor_pgr_sev" targetRef="T_bra_prosecutor_pgr_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_03c" sourceRef="GW_bra_prosecutor_pgr_sev" targetRef="T_bra_prosecutor_pgr_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_06" sourceRef="T_bra_prosecutor_pgr_emergency" targetRef="T_bra_prosecutor_pgr_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_06b" sourceRef="T_bra_prosecutor_pgr_investigate" targetRef="T_bra_prosecutor_pgr_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_06c" sourceRef="T_bra_prosecutor_pgr_log" targetRef="T_bra_prosecutor_pgr_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_prosecutor_pgr_07" sourceRef="T_bra_prosecutor_pgr_report" targetRef="End_bra_prosecutor_pgr">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bra_prosecutor_pgr">
    <bpmndi:BPMNPlane id="BPMNPlane_bra_prosecutor_pgr" bpmnElement="Collaboration_bra_prosecutor_pgr" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
