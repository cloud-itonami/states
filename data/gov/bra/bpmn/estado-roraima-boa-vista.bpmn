    id="Definitions_bra_estado_roraima_boa_vista"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_estado_roraima_boa_vista">
    <bpmn:participant id="Pool_bra_estado_roraima_boa_vista" name="Boa Vista (estado:r)" processRef="Process_bra_estado_roraima_boa_vista" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_estado_roraima_boa_vista" name="Boa Vista — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_estado_roraima_boa_vista" name="Policy trigger
received"><bpmn:outgoing>F_bra_estado_roraima_boa_vista_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_estado_roraima_boa_vista_open" name="Parallel checks">
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_02</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_03</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_estado_roraima_boa_vista_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:roraima:boa-vista.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_roraima_boa_vista_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:roraima:boa-vista.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_03</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_roraima_boa_vista_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:roraima:boa-vista.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_04</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_estado_roraima_boa_vista_join" name="Checks complete">
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_05</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_06</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bra_estado_roraima_boa_vista_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_08</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bra_estado_roraima_boa_vista_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_09</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_estado_roraima_boa_vista_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:roraima:boa-vista.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_10a</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_roraima_boa_vista_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:roraima:boa-vista.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_10b</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_roraima_boa_vista_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bra_estado_roraima_boa_vista" name="Process complete">
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_11</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_roraima_boa_vista_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_01" sourceRef="Start_bra_estado_roraima_boa_vista" targetRef="GW_bra_estado_roraima_boa_vista_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_02" sourceRef="GW_bra_estado_roraima_boa_vista_open" targetRef="T_bra_estado_roraima_boa_vista_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_03" sourceRef="GW_bra_estado_roraima_boa_vista_open" targetRef="T_bra_estado_roraima_boa_vista_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_04" sourceRef="GW_bra_estado_roraima_boa_vista_open" targetRef="T_bra_estado_roraima_boa_vista_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_05" sourceRef="T_bra_estado_roraima_boa_vista_policy" targetRef="GW_bra_estado_roraima_boa_vista_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_06" sourceRef="T_bra_estado_roraima_boa_vista_budget" targetRef="GW_bra_estado_roraima_boa_vista_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_07" sourceRef="T_bra_estado_roraima_boa_vista_coord" targetRef="GW_bra_estado_roraima_boa_vista_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_08" sourceRef="GW_bra_estado_roraima_boa_vista_join" targetRef="T_bra_estado_roraima_boa_vista_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_09" sourceRef="T_bra_estado_roraima_boa_vista_review" targetRef="GW_bra_estado_roraima_boa_vista_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_10a" sourceRef="GW_bra_estado_roraima_boa_vista_risk" targetRef="T_bra_estado_roraima_boa_vista_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_10b" sourceRef="GW_bra_estado_roraima_boa_vista_risk" targetRef="T_bra_estado_roraima_boa_vista_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_11" sourceRef="T_bra_estado_roraima_boa_vista_publish" targetRef="End_bra_estado_roraima_boa_vista">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_roraima_boa_vista_11b" sourceRef="T_bra_estado_roraima_boa_vista_revise" targetRef="End_bra_estado_roraima_boa_vista">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bra_estado_roraima_boa_vista">
    <bpmndi:BPMNPlane id="BPMNPlane_bra_estado_roraima_boa_vista" bpmnElement="Collaboration_bra_estado_roraima_boa_vista" />
  </bpmndi:BPMNDiagram>
