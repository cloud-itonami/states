      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.legislative-senado-federal.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_legislative_senado_federal_10b</bpmn:incoming>
