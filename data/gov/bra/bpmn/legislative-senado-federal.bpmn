      <bpmn:outgoing>F_bra_legislative_senado_federal_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_legislative_senado_federal_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_legislative_senado_federal_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.legislative-senado-federal.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_legislative_senado_federal_10a</bpmn:incoming>
