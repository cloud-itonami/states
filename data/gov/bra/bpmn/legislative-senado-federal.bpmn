    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bra_legislative_senado_federal" name="Process complete">
      <bpmn:incoming>F_bra_legislative_senado_federal_11</bpmn:incoming>
      <bpmn:incoming>F_bra_legislative_senado_federal_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_01" sourceRef="Start_bra_legislative_senado_federal" targetRef="GW_bra_legislative_senado_federal_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_02" sourceRef="GW_bra_legislative_senado_federal_open" targetRef="T_bra_legislative_senado_federal_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_03" sourceRef="GW_bra_legislative_senado_federal_open" targetRef="T_bra_legislative_senado_federal_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_04" sourceRef="GW_bra_legislative_senado_federal_open" targetRef="T_bra_legislative_senado_federal_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_05" sourceRef="T_bra_legislative_senado_federal_policy" targetRef="GW_bra_legislative_senado_federal_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_06" sourceRef="T_bra_legislative_senado_federal_budget" targetRef="GW_bra_legislative_senado_federal_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_07" sourceRef="T_bra_legislative_senado_federal_coord" targetRef="GW_bra_legislative_senado_federal_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_08" sourceRef="GW_bra_legislative_senado_federal_join" targetRef="T_bra_legislative_senado_federal_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_09" sourceRef="T_bra_legislative_senado_federal_review" targetRef="GW_bra_legislative_senado_federal_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_10a" sourceRef="GW_bra_legislative_senado_federal_risk" targetRef="T_bra_legislative_senado_federal_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_10b" sourceRef="GW_bra_legislative_senado_federal_risk" targetRef="T_bra_legislative_senado_federal_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_11" sourceRef="T_bra_legislative_senado_federal_publish" targetRef="End_bra_legislative_senado_federal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_legislative_senado_federal_11b" sourceRef="T_bra_legislative_senado_federal_revise" targetRef="End_bra_legislative_senado_federal">
    </bpmn:sequenceFlow>
  </bpmn:process>
