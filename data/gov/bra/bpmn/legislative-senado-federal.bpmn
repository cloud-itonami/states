  <bpmn:collaboration id="Collaboration_bra_legislative_senado_federal">
    <bpmn:participant id="Pool_bra_legislative_senado_federal" name="Legislative Senado Federal (b4r8s1n2)" processRef="Process_bra_legislative_senado_federal" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_legislative_senado_federal" name="Legislative Senado Federal — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_legislative_senado_federal" name="Policy trigger
received"><bpmn:outgoing>F_bra_legislative_senado_federal_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_legislative_senado_federal_open" name="Parallel checks">
      <bpmn:incoming>F_bra_legislative_senado_federal_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_legislative_senado_federal_02</bpmn:outgoing>
      <bpmn:outgoing>F_bra_legislative_senado_federal_03</bpmn:outgoing>
      <bpmn:outgoing>F_bra_legislative_senado_federal_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_legislative_senado_federal_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.legislative-senado-federal.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_legislative_senado_federal_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_legislative_senado_federal_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_legislative_senado_federal_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.legislative-senado-federal.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_legislative_senado_federal_03</bpmn:incoming>
      <bpmn:outgoing>F_bra_legislative_senado_federal_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_legislative_senado_federal_coord" name="Inter-Agency
