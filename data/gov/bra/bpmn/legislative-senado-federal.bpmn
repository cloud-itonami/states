      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.legislative-senado-federal.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_legislative_senado_federal_04</bpmn:incoming>
      <bpmn:outgoing>F_bra_legislative_senado_federal_07</bpmn:outgoing>
