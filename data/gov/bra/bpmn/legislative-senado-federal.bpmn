    <bpmn:parallelGateway id="GW_bra_legislative_senado_federal_join" name="Checks complete">
      <bpmn:incoming>F_bra_legislative_senado_federal_05</bpmn:incoming>
      <bpmn:incoming>F_bra_legislative_senado_federal_06</bpmn:incoming>
      <bpmn:incoming>F_bra_legislative_senado_federal_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_legislative_senado_federal_08</bpmn:outgoing>
