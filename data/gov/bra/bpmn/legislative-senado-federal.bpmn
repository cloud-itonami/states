    <bpmn:userTask id="T_bra_legislative_senado_federal_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_legislative_senado_federal_08</bpmn:incoming>
      <bpmn:outgoing>F_bra_legislative_senado_federal_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bra_legislative_senado_federal_risk" name="Approved?" isMarkerVisible="true">
