      <bpmn:outgoing>F_bra_estado_espirito_santo_vitoria_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_estado_espirito_santo_vitoria_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:espirito-santo:vitoria.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_espirito_santo_vitoria_02</bpmn:incoming>
