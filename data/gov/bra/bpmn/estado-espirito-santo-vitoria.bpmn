  <bpmn:collaboration id="Collaboration_bra_estado_espirito_santo_vitoria">
    <bpmn:participant id="Pool_bra_estado_espirito_santo_vitoria" name="Vitoria (estado:e)" processRef="Process_bra_estado_espirito_santo_vitoria" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_estado_espirito_santo_vitoria" name="Vitoria — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_estado_espirito_santo_vitoria" name="Policy trigger
received"><bpmn:outgoing>F_bra_estado_espirito_santo_vitoria_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_estado_espirito_santo_vitoria_open" name="Parallel checks">
      <bpmn:incoming>F_bra_estado_espirito_santo_vitoria_01</bpmn:incoming>
