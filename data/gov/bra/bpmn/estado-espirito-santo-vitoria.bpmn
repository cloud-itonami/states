      <bpmn:outgoing>F_bra_estado_espirito_santo_vitoria_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_estado_espirito_santo_vitoria_join" name="Checks complete">
      <bpmn:incoming>F_bra_estado_espirito_santo_vitoria_05</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_espirito_santo_vitoria_06</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_espirito_santo_vitoria_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_espirito_santo_vitoria_08</bpmn:outgoing>
