    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_10b" sourceRef="GW_bra_estado_espirito_santo_vitoria_risk" targetRef="T_bra_estado_espirito_santo_vitoria_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_11" sourceRef="T_bra_estado_espirito_santo_vitoria_publish" targetRef="End_bra_estado_espirito_santo_vitoria">
