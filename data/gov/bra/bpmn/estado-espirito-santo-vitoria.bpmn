    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_10a" sourceRef="GW_bra_estado_espirito_santo_vitoria_risk" targetRef="T_bra_estado_espirito_santo_vitoria_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
