    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_espirito_santo_vitoria_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:espirito-santo:vitoria.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_espirito_santo_vitoria_03</bpmn:incoming>
