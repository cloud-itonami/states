    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_01" sourceRef="Start_bra_estado_espirito_santo_vitoria" targetRef="GW_bra_estado_espirito_santo_vitoria_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_02" sourceRef="GW_bra_estado_espirito_santo_vitoria_open" targetRef="T_bra_estado_espirito_santo_vitoria_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_03" sourceRef="GW_bra_estado_espirito_santo_vitoria_open" targetRef="T_bra_estado_espirito_santo_vitoria_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_04" sourceRef="GW_bra_estado_espirito_santo_vitoria_open" targetRef="T_bra_estado_espirito_santo_vitoria_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_05" sourceRef="T_bra_estado_espirito_santo_vitoria_policy" targetRef="GW_bra_estado_espirito_santo_vitoria_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_06" sourceRef="T_bra_estado_espirito_santo_vitoria_budget" targetRef="GW_bra_estado_espirito_santo_vitoria_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_07" sourceRef="T_bra_estado_espirito_santo_vitoria_coord" targetRef="GW_bra_estado_espirito_santo_vitoria_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_espirito_santo_vitoria_08" sourceRef="GW_bra_estado_espirito_santo_vitoria_join" targetRef="T_bra_estado_espirito_santo_vitoria_review">
