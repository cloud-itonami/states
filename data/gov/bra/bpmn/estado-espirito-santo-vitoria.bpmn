      <bpmn:outgoing>F_bra_estado_espirito_santo_vitoria_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bra_estado_espirito_santo_vitoria_risk" name="Approved?" isMarkerVisible="true">
