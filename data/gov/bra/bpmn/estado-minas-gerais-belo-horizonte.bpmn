  </bpmn:collaboration>
  <bpmn:process id="Process_bra_estado_minas_gerais_belo_horizonte" name="Belo Horizonte — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_estado_minas_gerais_belo_horizonte" name="Policy trigger
received"><bpmn:outgoing>F_bra_estado_minas_gerais_belo_horizonte_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_estado_minas_gerais_belo_horizonte_open" name="Parallel checks">
