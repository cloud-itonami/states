    <bpmn:sequenceFlow id="F_bra_estado_minas_gerais_belo_horizonte_01" sourceRef="Start_bra_estado_minas_gerais_belo_horizonte" targetRef="GW_bra_estado_minas_gerais_belo_horizonte_open">
