    <bpmn:sequenceFlow id="F_bra_estado_minas_gerais_belo_horizonte_05" sourceRef="T_bra_estado_minas_gerais_belo_horizonte_policy" targetRef="GW_bra_estado_minas_gerais_belo_horizonte_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_minas_gerais_belo_horizonte_06" sourceRef="T_bra_estado_minas_gerais_belo_horizonte_budget" targetRef="GW_bra_estado_minas_gerais_belo_horizonte_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_minas_gerais_belo_horizonte_07" sourceRef="T_bra_estado_minas_gerais_belo_horizonte_coord" targetRef="GW_bra_estado_minas_gerais_belo_horizonte_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_minas_gerais_belo_horizonte_08" sourceRef="GW_bra_estado_minas_gerais_belo_horizonte_join" targetRef="T_bra_estado_minas_gerais_belo_horizonte_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_minas_gerais_belo_horizonte_09" sourceRef="T_bra_estado_minas_gerais_belo_horizonte_review" targetRef="GW_bra_estado_minas_gerais_belo_horizonte_risk">
    </bpmn:sequenceFlow>
