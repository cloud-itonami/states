      <bpmn:outgoing>F_bra_estado_minas_gerais_belo_horizonte_03</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_minas_gerais_belo_horizonte_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_estado_minas_gerais_belo_horizonte_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:minas-gerais:belo-horizonte.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
