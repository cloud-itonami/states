<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bra_defense_ministerio_da_defesa"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_defense_ministerio_da_defesa">
    <bpmn:participant id="Pool_bra_defense_ministerio_da_defesa" name="Defense Ministerio Da Defesa (b1r2d3m4)" processRef="Process_bra_defense_ministerio_da_defesa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_defense_ministerio_da_defesa" name="Defense Ministerio Da Defesa — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_bra_defense_ministerio_da_defesa" name="Readiness
assessment triggered"><bpmn:outgoing>F_bra_defense_ministerio_da_defesa_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_bra_defense_ministerio_da_defesa_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.defense-ministerio-da-defesa.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_bra_defense_ministerio_da_defesa_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_03a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_03b</bpmn:outgoing>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_defense_ministerio_da_defesa_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.defense-ministerio-da-defesa.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_03a</bpmn:incoming>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_defense_ministerio_da_defesa_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.defense-ministerio-da-defesa.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_03b</bpmn:incoming>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_defense_ministerio_da_defesa_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.defense-ministerio-da-defesa.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_03c</bpmn:incoming>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_defense_ministerio_da_defesa_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.defense-ministerio-da-defesa.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_04</bpmn:incoming>
      <bpmn:outgoing>F_bra_defense_ministerio_da_defesa_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bra_defense_ministerio_da_defesa" name="Assessment complete">
      <bpmn:incoming>F_bra_defense_ministerio_da_defesa_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_01" sourceRef="Start_bra_defense_ministerio_da_defesa" targetRef="T_bra_defense_ministerio_da_defesa_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_02" sourceRef="T_bra_defense_ministerio_da_defesa_assess" targetRef="GW_bra_defense_ministerio_da_defesa_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_03a" sourceRef="GW_bra_defense_ministerio_da_defesa_ready" targetRef="T_bra_defense_ministerio_da_defesa_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_03b" sourceRef="GW_bra_defense_ministerio_da_defesa_ready" targetRef="T_bra_defense_ministerio_da_defesa_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_03c" sourceRef="GW_bra_defense_ministerio_da_defesa_ready" targetRef="T_bra_defense_ministerio_da_defesa_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_04" sourceRef="T_bra_defense_ministerio_da_defesa_ops" targetRef="T_bra_defense_ministerio_da_defesa_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_04b" sourceRef="T_bra_defense_ministerio_da_defesa_proc" targetRef="T_bra_defense_ministerio_da_defesa_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_04c" sourceRef="T_bra_defense_ministerio_da_defesa_alert" targetRef="T_bra_defense_ministerio_da_defesa_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_defense_ministerio_da_defesa_05" sourceRef="T_bra_defense_ministerio_da_defesa_report" targetRef="End_bra_defense_ministerio_da_defesa">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bra_defense_ministerio_da_defesa">
    <bpmndi:BPMNPlane id="BPMNPlane_bra_defense_ministerio_da_defesa" bpmnElement="Collaboration_bra_defense_ministerio_da_defesa" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
