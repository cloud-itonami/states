<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bra_competition"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_competition">
    <bpmn:participant id="Pool_bra_competition" name="Competition (b1r2c3o4)" processRef="Process_bra_competition" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_competition" name="Competition — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_bra_competition" name="License / Permit
application received"><bpmn:outgoing>F_bra_competition_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_bra_competition_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.competition.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_bra_competition_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_bra_competition_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_03a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_competition_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_competition_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.competition.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_03b</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_competition_checks" name="Parallel review">
      <bpmn:incoming>F_bra_competition_03a</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_04a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_competition_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_competition_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.competition.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_04a</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_competition_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.competition.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_04b</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_competition_join" name="Reviews complete">
      <bpmn:incoming>F_bra_competition_05</bpmn:incoming>
      <bpmn:incoming>F_bra_competition_05b</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bra_competition_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_06</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bra_competition_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_bra_competition_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_08a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_competition_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_competition_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.competition.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_08a</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_competition_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.competition.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_competition_08b</bpmn:incoming>
      <bpmn:outgoing>F_bra_competition_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bra_competition" name="Application
processed">
      <bpmn:incoming>F_bra_competition_end1</bpmn:incoming>
      <bpmn:incoming>F_bra_competition_end1b</bpmn:incoming>
      <bpmn:incoming>F_bra_competition_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_competition_01" sourceRef="Start_bra_competition" targetRef="T_bra_competition_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_02" sourceRef="T_bra_competition_screen" targetRef="GW_bra_competition_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_03a" sourceRef="GW_bra_competition_complete" targetRef="GW_bra_competition_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_03b" sourceRef="GW_bra_competition_complete" targetRef="T_bra_competition_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_04a" sourceRef="GW_bra_competition_checks" targetRef="T_bra_competition_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_04b" sourceRef="GW_bra_competition_checks" targetRef="T_bra_competition_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_05" sourceRef="T_bra_competition_legal" targetRef="GW_bra_competition_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_05b" sourceRef="T_bra_competition_technical" targetRef="GW_bra_competition_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_06" sourceRef="GW_bra_competition_join" targetRef="T_bra_competition_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_07" sourceRef="T_bra_competition_decision" targetRef="GW_bra_competition_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_08a" sourceRef="GW_bra_competition_approve" targetRef="T_bra_competition_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_08b" sourceRef="GW_bra_competition_approve" targetRef="T_bra_competition_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_end1" sourceRef="T_bra_competition_issue" targetRef="End_bra_competition">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_end1b" sourceRef="T_bra_competition_deny" targetRef="End_bra_competition">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_competition_end1c" sourceRef="T_bra_competition_return" targetRef="End_bra_competition">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bra_competition">
    <bpmndi:BPMNPlane id="BPMNPlane_bra_competition" bpmnElement="Collaboration_bra_competition" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
