<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bra_estado_bahia_salvador"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_estado_bahia_salvador">
    <bpmn:participant id="Pool_bra_estado_bahia_salvador" name="Salvador (estado:b)" processRef="Process_bra_estado_bahia_salvador" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_estado_bahia_salvador" name="Salvador — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_estado_bahia_salvador" name="Policy trigger
received"><bpmn:outgoing>F_bra_estado_bahia_salvador_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_estado_bahia_salvador_open" name="Parallel checks">
      <bpmn:incoming>F_bra_estado_bahia_salvador_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_02</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_03</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_estado_bahia_salvador_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:bahia:salvador.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_bahia_salvador_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_bahia_salvador_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:bahia:salvador.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_bahia_salvador_03</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_bahia_salvador_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:bahia:salvador.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_bahia_salvador_04</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_estado_bahia_salvador_join" name="Checks complete">
      <bpmn:incoming>F_bra_estado_bahia_salvador_05</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_bahia_salvador_06</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_bahia_salvador_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bra_estado_bahia_salvador_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_bahia_salvador_08</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bra_estado_bahia_salvador_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bra_estado_bahia_salvador_09</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bra_estado_bahia_salvador_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:bahia:salvador.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_bahia_salvador_10a</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_bahia_salvador_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:bahia:salvador.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_bahia_salvador_10b</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_bahia_salvador_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bra_estado_bahia_salvador" name="Process complete">
      <bpmn:incoming>F_bra_estado_bahia_salvador_11</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_bahia_salvador_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_01" sourceRef="Start_bra_estado_bahia_salvador" targetRef="GW_bra_estado_bahia_salvador_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_02" sourceRef="GW_bra_estado_bahia_salvador_open" targetRef="T_bra_estado_bahia_salvador_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_03" sourceRef="GW_bra_estado_bahia_salvador_open" targetRef="T_bra_estado_bahia_salvador_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_04" sourceRef="GW_bra_estado_bahia_salvador_open" targetRef="T_bra_estado_bahia_salvador_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_05" sourceRef="T_bra_estado_bahia_salvador_policy" targetRef="GW_bra_estado_bahia_salvador_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_06" sourceRef="T_bra_estado_bahia_salvador_budget" targetRef="GW_bra_estado_bahia_salvador_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_07" sourceRef="T_bra_estado_bahia_salvador_coord" targetRef="GW_bra_estado_bahia_salvador_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_08" sourceRef="GW_bra_estado_bahia_salvador_join" targetRef="T_bra_estado_bahia_salvador_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_09" sourceRef="T_bra_estado_bahia_salvador_review" targetRef="GW_bra_estado_bahia_salvador_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_10a" sourceRef="GW_bra_estado_bahia_salvador_risk" targetRef="T_bra_estado_bahia_salvador_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_10b" sourceRef="GW_bra_estado_bahia_salvador_risk" targetRef="T_bra_estado_bahia_salvador_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_11" sourceRef="T_bra_estado_bahia_salvador_publish" targetRef="End_bra_estado_bahia_salvador">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_bahia_salvador_11b" sourceRef="T_bra_estado_bahia_salvador_revise" targetRef="End_bra_estado_bahia_salvador">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bra_estado_bahia_salvador">
    <bpmndi:BPMNPlane id="BPMNPlane_bra_estado_bahia_salvador" bpmnElement="Collaboration_bra_estado_bahia_salvador" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
