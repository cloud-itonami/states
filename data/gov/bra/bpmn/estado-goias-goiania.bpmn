      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:goias:goiania.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_goias_goiania_04</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_goias_goiania_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bra_estado_goias_goiania_join" name="Checks complete">
      <bpmn:incoming>F_bra_estado_goias_goiania_05</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_goias_goiania_06</bpmn:incoming>
      <bpmn:incoming>F_bra_estado_goias_goiania_07</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_goias_goiania_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bra_estado_goias_goiania_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_goias_goiania_08</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_goias_goiania_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bra_estado_goias_goiania_risk" name="Approved?" isMarkerVisible="true">
