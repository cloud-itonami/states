      <bpmn:incoming>F_bra_estado_goias_goiania_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_01" sourceRef="Start_bra_estado_goias_goiania" targetRef="GW_bra_estado_goias_goiania_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_02" sourceRef="GW_bra_estado_goias_goiania_open" targetRef="T_bra_estado_goias_goiania_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_03" sourceRef="GW_bra_estado_goias_goiania_open" targetRef="T_bra_estado_goias_goiania_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_04" sourceRef="GW_bra_estado_goias_goiania_open" targetRef="T_bra_estado_goias_goiania_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_05" sourceRef="T_bra_estado_goias_goiania_policy" targetRef="GW_bra_estado_goias_goiania_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_06" sourceRef="T_bra_estado_goias_goiania_budget" targetRef="GW_bra_estado_goias_goiania_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_07" sourceRef="T_bra_estado_goias_goiania_coord" targetRef="GW_bra_estado_goias_goiania_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_08" sourceRef="GW_bra_estado_goias_goiania_join" targetRef="T_bra_estado_goias_goiania_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_09" sourceRef="T_bra_estado_goias_goiania_review" targetRef="GW_bra_estado_goias_goiania_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_10a" sourceRef="GW_bra_estado_goias_goiania_risk" targetRef="T_bra_estado_goias_goiania_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_10b" sourceRef="GW_bra_estado_goias_goiania_risk" targetRef="T_bra_estado_goias_goiania_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_11" sourceRef="T_bra_estado_goias_goiania_publish" targetRef="End_bra_estado_goias_goiania">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bra_estado_goias_goiania_11b" sourceRef="T_bra_estado_goias_goiania_revise" targetRef="End_bra_estado_goias_goiania">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bra_estado_goias_goiania">
    <bpmndi:BPMNPlane id="BPMNPlane_bra_estado_goias_goiania" bpmnElement="Collaboration_bra_estado_goias_goiania" />
