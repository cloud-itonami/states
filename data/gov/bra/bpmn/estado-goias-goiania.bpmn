    id="Definitions_bra_estado_goias_goiania"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bra_estado_goias_goiania">
    <bpmn:participant id="Pool_bra_estado_goias_goiania" name="Goiania (estado:g)" processRef="Process_bra_estado_goias_goiania" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bra_estado_goias_goiania" name="Goiania — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bra_estado_goias_goiania" name="Policy trigger
received"><bpmn:outgoing>F_bra_estado_goias_goiania_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bra_estado_goias_goiania_open" name="Parallel checks">
      <bpmn:incoming>F_bra_estado_goias_goiania_01</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_goias_goiania_02</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_goias_goiania_03</bpmn:outgoing>
      <bpmn:outgoing>F_bra_estado_goias_goiania_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bra_estado_goias_goiania_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:goias:goiania.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_goias_goiania_02</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_goias_goiania_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_goias_goiania_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bra.estado:goias:goiania.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bra_estado_goias_goiania_03</bpmn:incoming>
      <bpmn:outgoing>F_bra_estado_goias_goiania_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bra_estado_goias_goiania_coord" name="Inter-Agency
