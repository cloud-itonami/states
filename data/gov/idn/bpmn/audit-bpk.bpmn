<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_idn_audit_bpk"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_idn_audit_bpk">
    <bpmn:participant id="Pool_idn_audit_bpk" name="Audit Bpk (i1d2a3d4)" processRef="Process_idn_audit_bpk" />
  </bpmn:collaboration>
  <bpmn:process id="Process_idn_audit_bpk" name="Audit Bpk — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_idn_audit_bpk" name="Policy trigger
received"><bpmn:outgoing>F_idn_audit_bpk_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_idn_audit_bpk_open" name="Parallel checks">
      <bpmn:incoming>F_idn_audit_bpk_01</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_02</bpmn:outgoing>
      <bpmn:outgoing>F_idn_audit_bpk_03</bpmn:outgoing>
      <bpmn:outgoing>F_idn_audit_bpk_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_idn_audit_bpk_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.audit-bpk.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_audit_bpk_02</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_audit_bpk_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.audit-bpk.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_audit_bpk_03</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_audit_bpk_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.audit-bpk.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_audit_bpk_04</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_idn_audit_bpk_join" name="Checks complete">
      <bpmn:incoming>F_idn_audit_bpk_05</bpmn:incoming>
      <bpmn:incoming>F_idn_audit_bpk_06</bpmn:incoming>
      <bpmn:incoming>F_idn_audit_bpk_07</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_idn_audit_bpk_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_audit_bpk_08</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_idn_audit_bpk_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_idn_audit_bpk_09</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_10a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_audit_bpk_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_idn_audit_bpk_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.audit-bpk.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_audit_bpk_10a</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_audit_bpk_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.audit-bpk.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_audit_bpk_10b</bpmn:incoming>
      <bpmn:outgoing>F_idn_audit_bpk_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_idn_audit_bpk" name="Process complete">
      <bpmn:incoming>F_idn_audit_bpk_11</bpmn:incoming>
      <bpmn:incoming>F_idn_audit_bpk_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_01" sourceRef="Start_idn_audit_bpk" targetRef="GW_idn_audit_bpk_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_02" sourceRef="GW_idn_audit_bpk_open" targetRef="T_idn_audit_bpk_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_03" sourceRef="GW_idn_audit_bpk_open" targetRef="T_idn_audit_bpk_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_04" sourceRef="GW_idn_audit_bpk_open" targetRef="T_idn_audit_bpk_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_05" sourceRef="T_idn_audit_bpk_policy" targetRef="GW_idn_audit_bpk_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_06" sourceRef="T_idn_audit_bpk_budget" targetRef="GW_idn_audit_bpk_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_07" sourceRef="T_idn_audit_bpk_coord" targetRef="GW_idn_audit_bpk_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_08" sourceRef="GW_idn_audit_bpk_join" targetRef="T_idn_audit_bpk_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_09" sourceRef="T_idn_audit_bpk_review" targetRef="GW_idn_audit_bpk_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_10a" sourceRef="GW_idn_audit_bpk_risk" targetRef="T_idn_audit_bpk_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_10b" sourceRef="GW_idn_audit_bpk_risk" targetRef="T_idn_audit_bpk_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_11" sourceRef="T_idn_audit_bpk_publish" targetRef="End_idn_audit_bpk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_audit_bpk_11b" sourceRef="T_idn_audit_bpk_revise" targetRef="End_idn_audit_bpk">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_idn_audit_bpk">
    <bpmndi:BPMNPlane id="BPMNPlane_idn_audit_bpk" bpmnElement="Collaboration_idn_audit_bpk" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
