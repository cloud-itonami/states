<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_idn_defense_kemhan"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_idn_defense_kemhan">
    <bpmn:participant id="Pool_idn_defense_kemhan" name="Defense Kemhan (i1d2d3m4)" processRef="Process_idn_defense_kemhan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_idn_defense_kemhan" name="Defense Kemhan — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_idn_defense_kemhan" name="Readiness
assessment triggered"><bpmn:outgoing>F_idn_defense_kemhan_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_idn_defense_kemhan_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.defense-kemhan.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_defense_kemhan_01</bpmn:incoming>
      <bpmn:outgoing>F_idn_defense_kemhan_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_idn_defense_kemhan_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_idn_defense_kemhan_02</bpmn:incoming>
      <bpmn:outgoing>F_idn_defense_kemhan_03a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_defense_kemhan_03b</bpmn:outgoing>
      <bpmn:outgoing>F_idn_defense_kemhan_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_idn_defense_kemhan_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.defense-kemhan.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_defense_kemhan_03a</bpmn:incoming>
      <bpmn:outgoing>F_idn_defense_kemhan_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_defense_kemhan_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.defense-kemhan.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_defense_kemhan_03b</bpmn:incoming>
      <bpmn:outgoing>F_idn_defense_kemhan_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_defense_kemhan_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.defense-kemhan.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_defense_kemhan_03c</bpmn:incoming>
      <bpmn:outgoing>F_idn_defense_kemhan_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_defense_kemhan_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.defense-kemhan.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_defense_kemhan_04</bpmn:incoming>
      <bpmn:outgoing>F_idn_defense_kemhan_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_idn_defense_kemhan" name="Assessment complete">
      <bpmn:incoming>F_idn_defense_kemhan_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_01" sourceRef="Start_idn_defense_kemhan" targetRef="T_idn_defense_kemhan_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_02" sourceRef="T_idn_defense_kemhan_assess" targetRef="GW_idn_defense_kemhan_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_03a" sourceRef="GW_idn_defense_kemhan_ready" targetRef="T_idn_defense_kemhan_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_03b" sourceRef="GW_idn_defense_kemhan_ready" targetRef="T_idn_defense_kemhan_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_03c" sourceRef="GW_idn_defense_kemhan_ready" targetRef="T_idn_defense_kemhan_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_04" sourceRef="T_idn_defense_kemhan_ops" targetRef="T_idn_defense_kemhan_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_04b" sourceRef="T_idn_defense_kemhan_proc" targetRef="T_idn_defense_kemhan_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_04c" sourceRef="T_idn_defense_kemhan_alert" targetRef="T_idn_defense_kemhan_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_defense_kemhan_05" sourceRef="T_idn_defense_kemhan_report" targetRef="End_idn_defense_kemhan">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_idn_defense_kemhan">
    <bpmndi:BPMNPlane id="BPMNPlane_idn_defense_kemhan" bpmnElement="Collaboration_idn_defense_kemhan" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
