<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_idn_foreign_kemlu"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_idn_foreign_kemlu">
    <bpmn:participant id="Pool_idn_foreign_kemlu" name="Foreign Kemlu (i6d2w5a8)" processRef="Process_idn_foreign_kemlu" />
  </bpmn:collaboration>
  <bpmn:process id="Process_idn_foreign_kemlu" name="Foreign Kemlu — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_idn_foreign_kemlu" name="Policy trigger
received"><bpmn:outgoing>F_idn_foreign_kemlu_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_idn_foreign_kemlu_open" name="Parallel checks">
      <bpmn:incoming>F_idn_foreign_kemlu_01</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_02</bpmn:outgoing>
      <bpmn:outgoing>F_idn_foreign_kemlu_03</bpmn:outgoing>
      <bpmn:outgoing>F_idn_foreign_kemlu_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_idn_foreign_kemlu_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.foreign-kemlu.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_foreign_kemlu_02</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_foreign_kemlu_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.foreign-kemlu.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_foreign_kemlu_03</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_foreign_kemlu_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.foreign-kemlu.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_foreign_kemlu_04</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_idn_foreign_kemlu_join" name="Checks complete">
      <bpmn:incoming>F_idn_foreign_kemlu_05</bpmn:incoming>
      <bpmn:incoming>F_idn_foreign_kemlu_06</bpmn:incoming>
      <bpmn:incoming>F_idn_foreign_kemlu_07</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_idn_foreign_kemlu_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_foreign_kemlu_08</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_idn_foreign_kemlu_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_idn_foreign_kemlu_09</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_10a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_foreign_kemlu_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_idn_foreign_kemlu_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.foreign-kemlu.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_foreign_kemlu_10a</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_foreign_kemlu_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.foreign-kemlu.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_foreign_kemlu_10b</bpmn:incoming>
      <bpmn:outgoing>F_idn_foreign_kemlu_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_idn_foreign_kemlu" name="Process complete">
      <bpmn:incoming>F_idn_foreign_kemlu_11</bpmn:incoming>
      <bpmn:incoming>F_idn_foreign_kemlu_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_01" sourceRef="Start_idn_foreign_kemlu" targetRef="GW_idn_foreign_kemlu_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_02" sourceRef="GW_idn_foreign_kemlu_open" targetRef="T_idn_foreign_kemlu_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_03" sourceRef="GW_idn_foreign_kemlu_open" targetRef="T_idn_foreign_kemlu_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_04" sourceRef="GW_idn_foreign_kemlu_open" targetRef="T_idn_foreign_kemlu_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_05" sourceRef="T_idn_foreign_kemlu_policy" targetRef="GW_idn_foreign_kemlu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_06" sourceRef="T_idn_foreign_kemlu_budget" targetRef="GW_idn_foreign_kemlu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_07" sourceRef="T_idn_foreign_kemlu_coord" targetRef="GW_idn_foreign_kemlu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_08" sourceRef="GW_idn_foreign_kemlu_join" targetRef="T_idn_foreign_kemlu_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_09" sourceRef="T_idn_foreign_kemlu_review" targetRef="GW_idn_foreign_kemlu_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_10a" sourceRef="GW_idn_foreign_kemlu_risk" targetRef="T_idn_foreign_kemlu_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_10b" sourceRef="GW_idn_foreign_kemlu_risk" targetRef="T_idn_foreign_kemlu_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_11" sourceRef="T_idn_foreign_kemlu_publish" targetRef="End_idn_foreign_kemlu">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_foreign_kemlu_11b" sourceRef="T_idn_foreign_kemlu_revise" targetRef="End_idn_foreign_kemlu">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_idn_foreign_kemlu">
    <bpmndi:BPMNPlane id="BPMNPlane_idn_foreign_kemlu" bpmnElement="Collaboration_idn_foreign_kemlu" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
