<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_idn_finance_kemenkeu"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_idn_finance_kemenkeu">
    <bpmn:participant id="Pool_idn_finance_kemenkeu" name="Finance Kemenkeu (i4d8f1k9)" processRef="Process_idn_finance_kemenkeu" />
  </bpmn:collaboration>
  <bpmn:process id="Process_idn_finance_kemenkeu" name="Finance Kemenkeu — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_idn_finance_kemenkeu" name="License / Permit
application received"><bpmn:outgoing>F_idn_finance_kemenkeu_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_idn_finance_kemenkeu_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.finance-kemenkeu.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_01</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_idn_finance_kemenkeu_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_idn_finance_kemenkeu_02</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_03a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_finance_kemenkeu_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_idn_finance_kemenkeu_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.finance-kemenkeu.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_03b</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_idn_finance_kemenkeu_checks" name="Parallel review">
      <bpmn:incoming>F_idn_finance_kemenkeu_03a</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_04a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_finance_kemenkeu_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_idn_finance_kemenkeu_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.finance-kemenkeu.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_04a</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_finance_kemenkeu_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.finance-kemenkeu.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_04b</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_idn_finance_kemenkeu_join" name="Reviews complete">
      <bpmn:incoming>F_idn_finance_kemenkeu_05</bpmn:incoming>
      <bpmn:incoming>F_idn_finance_kemenkeu_05b</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_idn_finance_kemenkeu_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_06</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_idn_finance_kemenkeu_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_idn_finance_kemenkeu_07</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_08a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_finance_kemenkeu_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_idn_finance_kemenkeu_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.finance-kemenkeu.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_08a</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_finance_kemenkeu_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.finance-kemenkeu.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_finance_kemenkeu_08b</bpmn:incoming>
      <bpmn:outgoing>F_idn_finance_kemenkeu_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_idn_finance_kemenkeu" name="Application
processed">
      <bpmn:incoming>F_idn_finance_kemenkeu_end1</bpmn:incoming>
      <bpmn:incoming>F_idn_finance_kemenkeu_end1b</bpmn:incoming>
      <bpmn:incoming>F_idn_finance_kemenkeu_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_01" sourceRef="Start_idn_finance_kemenkeu" targetRef="T_idn_finance_kemenkeu_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_02" sourceRef="T_idn_finance_kemenkeu_screen" targetRef="GW_idn_finance_kemenkeu_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_03a" sourceRef="GW_idn_finance_kemenkeu_complete" targetRef="GW_idn_finance_kemenkeu_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_03b" sourceRef="GW_idn_finance_kemenkeu_complete" targetRef="T_idn_finance_kemenkeu_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_04a" sourceRef="GW_idn_finance_kemenkeu_checks" targetRef="T_idn_finance_kemenkeu_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_04b" sourceRef="GW_idn_finance_kemenkeu_checks" targetRef="T_idn_finance_kemenkeu_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_05" sourceRef="T_idn_finance_kemenkeu_legal" targetRef="GW_idn_finance_kemenkeu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_05b" sourceRef="T_idn_finance_kemenkeu_technical" targetRef="GW_idn_finance_kemenkeu_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_06" sourceRef="GW_idn_finance_kemenkeu_join" targetRef="T_idn_finance_kemenkeu_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_07" sourceRef="T_idn_finance_kemenkeu_decision" targetRef="GW_idn_finance_kemenkeu_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_08a" sourceRef="GW_idn_finance_kemenkeu_approve" targetRef="T_idn_finance_kemenkeu_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_08b" sourceRef="GW_idn_finance_kemenkeu_approve" targetRef="T_idn_finance_kemenkeu_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_end1" sourceRef="T_idn_finance_kemenkeu_issue" targetRef="End_idn_finance_kemenkeu">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_end1b" sourceRef="T_idn_finance_kemenkeu_deny" targetRef="End_idn_finance_kemenkeu">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_finance_kemenkeu_end1c" sourceRef="T_idn_finance_kemenkeu_return" targetRef="End_idn_finance_kemenkeu">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_idn_finance_kemenkeu">
    <bpmndi:BPMNPlane id="BPMNPlane_idn_finance_kemenkeu" bpmnElement="Collaboration_idn_finance_kemenkeu" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
