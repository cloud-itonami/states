<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_idn_special_region_jakarta_jakarta"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_idn_special_region_jakarta_jakarta">
    <bpmn:participant id="Pool_idn_special_region_jakarta_jakarta" name="Jakarta (special-)" processRef="Process_idn_special_region_jakarta_jakarta" />
  </bpmn:collaboration>
  <bpmn:process id="Process_idn_special_region_jakarta_jakarta" name="Jakarta — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_idn_special_region_jakarta_jakarta" name="Policy trigger
received"><bpmn:outgoing>F_idn_special_region_jakarta_jakarta_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_idn_special_region_jakarta_jakarta_open" name="Parallel checks">
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_01</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_02</bpmn:outgoing>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_03</bpmn:outgoing>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_idn_special_region_jakarta_jakarta_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.special-region:jakarta:jakarta.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_02</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_special_region_jakarta_jakarta_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.special-region:jakarta:jakarta.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_03</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_special_region_jakarta_jakarta_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.special-region:jakarta:jakarta.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_04</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_idn_special_region_jakarta_jakarta_join" name="Checks complete">
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_05</bpmn:incoming>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_06</bpmn:incoming>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_07</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_idn_special_region_jakarta_jakarta_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_08</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_idn_special_region_jakarta_jakarta_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_09</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_10a</bpmn:outgoing>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_idn_special_region_jakarta_jakarta_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.special-region:jakarta:jakarta.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_10a</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_idn_special_region_jakarta_jakarta_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.idn.special-region:jakarta:jakarta.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_10b</bpmn:incoming>
      <bpmn:outgoing>F_idn_special_region_jakarta_jakarta_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_idn_special_region_jakarta_jakarta" name="Process complete">
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_11</bpmn:incoming>
      <bpmn:incoming>F_idn_special_region_jakarta_jakarta_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_01" sourceRef="Start_idn_special_region_jakarta_jakarta" targetRef="GW_idn_special_region_jakarta_jakarta_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_02" sourceRef="GW_idn_special_region_jakarta_jakarta_open" targetRef="T_idn_special_region_jakarta_jakarta_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_03" sourceRef="GW_idn_special_region_jakarta_jakarta_open" targetRef="T_idn_special_region_jakarta_jakarta_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_04" sourceRef="GW_idn_special_region_jakarta_jakarta_open" targetRef="T_idn_special_region_jakarta_jakarta_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_05" sourceRef="T_idn_special_region_jakarta_jakarta_policy" targetRef="GW_idn_special_region_jakarta_jakarta_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_06" sourceRef="T_idn_special_region_jakarta_jakarta_budget" targetRef="GW_idn_special_region_jakarta_jakarta_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_07" sourceRef="T_idn_special_region_jakarta_jakarta_coord" targetRef="GW_idn_special_region_jakarta_jakarta_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_08" sourceRef="GW_idn_special_region_jakarta_jakarta_join" targetRef="T_idn_special_region_jakarta_jakarta_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_09" sourceRef="T_idn_special_region_jakarta_jakarta_review" targetRef="GW_idn_special_region_jakarta_jakarta_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_10a" sourceRef="GW_idn_special_region_jakarta_jakarta_risk" targetRef="T_idn_special_region_jakarta_jakarta_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_10b" sourceRef="GW_idn_special_region_jakarta_jakarta_risk" targetRef="T_idn_special_region_jakarta_jakarta_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_11" sourceRef="T_idn_special_region_jakarta_jakarta_publish" targetRef="End_idn_special_region_jakarta_jakarta">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_idn_special_region_jakarta_jakarta_11b" sourceRef="T_idn_special_region_jakarta_jakarta_revise" targetRef="End_idn_special_region_jakarta_jakarta">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_idn_special_region_jakarta_jakarta">
    <bpmndi:BPMNPlane id="BPMNPlane_idn_special_region_jakarta_jakarta" bpmnElement="Collaboration_idn_special_region_jakarta_jakarta" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
