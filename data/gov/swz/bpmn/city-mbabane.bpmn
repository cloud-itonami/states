<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_swz_city_mbabane"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_swz_city_mbabane">
    <bpmn:participant id="Pool_swz_city_mbabane" name="Mbabane (city:mba)" processRef="Process_swz_city_mbabane" />
  </bpmn:collaboration>
  <bpmn:process id="Process_swz_city_mbabane" name="Mbabane — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_swz_city_mbabane" name="Policy trigger
received"><bpmn:outgoing>F_swz_city_mbabane_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_swz_city_mbabane_open" name="Parallel checks">
      <bpmn:incoming>F_swz_city_mbabane_01</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_02</bpmn:outgoing>
      <bpmn:outgoing>F_swz_city_mbabane_03</bpmn:outgoing>
      <bpmn:outgoing>F_swz_city_mbabane_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_swz_city_mbabane_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swz.city:mbabane.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swz_city_mbabane_02</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_swz_city_mbabane_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swz.city:mbabane.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swz_city_mbabane_03</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_swz_city_mbabane_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swz.city:mbabane.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swz_city_mbabane_04</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_swz_city_mbabane_join" name="Checks complete">
      <bpmn:incoming>F_swz_city_mbabane_05</bpmn:incoming>
      <bpmn:incoming>F_swz_city_mbabane_06</bpmn:incoming>
      <bpmn:incoming>F_swz_city_mbabane_07</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_swz_city_mbabane_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_swz_city_mbabane_08</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_swz_city_mbabane_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_swz_city_mbabane_09</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_10a</bpmn:outgoing>
      <bpmn:outgoing>F_swz_city_mbabane_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_swz_city_mbabane_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swz.city:mbabane.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swz_city_mbabane_10a</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_swz_city_mbabane_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.swz.city:mbabane.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_swz_city_mbabane_10b</bpmn:incoming>
      <bpmn:outgoing>F_swz_city_mbabane_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_swz_city_mbabane" name="Process complete">
      <bpmn:incoming>F_swz_city_mbabane_11</bpmn:incoming>
      <bpmn:incoming>F_swz_city_mbabane_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_01" sourceRef="Start_swz_city_mbabane" targetRef="GW_swz_city_mbabane_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_02" sourceRef="GW_swz_city_mbabane_open" targetRef="T_swz_city_mbabane_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_03" sourceRef="GW_swz_city_mbabane_open" targetRef="T_swz_city_mbabane_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_04" sourceRef="GW_swz_city_mbabane_open" targetRef="T_swz_city_mbabane_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_05" sourceRef="T_swz_city_mbabane_policy" targetRef="GW_swz_city_mbabane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_06" sourceRef="T_swz_city_mbabane_budget" targetRef="GW_swz_city_mbabane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_07" sourceRef="T_swz_city_mbabane_coord" targetRef="GW_swz_city_mbabane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_08" sourceRef="GW_swz_city_mbabane_join" targetRef="T_swz_city_mbabane_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_09" sourceRef="T_swz_city_mbabane_review" targetRef="GW_swz_city_mbabane_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_10a" sourceRef="GW_swz_city_mbabane_risk" targetRef="T_swz_city_mbabane_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_10b" sourceRef="GW_swz_city_mbabane_risk" targetRef="T_swz_city_mbabane_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_11" sourceRef="T_swz_city_mbabane_publish" targetRef="End_swz_city_mbabane">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_swz_city_mbabane_11b" sourceRef="T_swz_city_mbabane_revise" targetRef="End_swz_city_mbabane">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_swz_city_mbabane">
    <bpmndi:BPMNPlane id="BPMNPlane_swz_city_mbabane" bpmnElement="Collaboration_swz_city_mbabane" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
