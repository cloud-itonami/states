    <bpmn:userTask id="T_tkm_city_ashgabat_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_tkm_city_ashgabat_08</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_tkm_city_ashgabat_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_tkm_city_ashgabat_09</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_10a</bpmn:outgoing>
      <bpmn:outgoing>F_tkm_city_ashgabat_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_tkm_city_ashgabat_publish" name="Publish Policy
