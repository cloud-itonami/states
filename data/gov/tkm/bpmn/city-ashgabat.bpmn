    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_03" sourceRef="GW_tkm_city_ashgabat_open" targetRef="T_tkm_city_ashgabat_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_04" sourceRef="GW_tkm_city_ashgabat_open" targetRef="T_tkm_city_ashgabat_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_05" sourceRef="T_tkm_city_ashgabat_policy" targetRef="GW_tkm_city_ashgabat_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_06" sourceRef="T_tkm_city_ashgabat_budget" targetRef="GW_tkm_city_ashgabat_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_07" sourceRef="T_tkm_city_ashgabat_coord" targetRef="GW_tkm_city_ashgabat_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_08" sourceRef="GW_tkm_city_ashgabat_join" targetRef="T_tkm_city_ashgabat_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_09" sourceRef="T_tkm_city_ashgabat_review" targetRef="GW_tkm_city_ashgabat_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_10a" sourceRef="GW_tkm_city_ashgabat_risk" targetRef="T_tkm_city_ashgabat_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_10b" sourceRef="GW_tkm_city_ashgabat_risk" targetRef="T_tkm_city_ashgabat_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_11" sourceRef="T_tkm_city_ashgabat_publish" targetRef="End_tkm_city_ashgabat">
