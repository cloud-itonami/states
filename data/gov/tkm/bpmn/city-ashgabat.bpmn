      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tkm.city:ashgabat.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tkm_city_ashgabat_04</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_07</bpmn:outgoing>
