    <bpmn:parallelGateway id="GW_tkm_city_ashgabat_join" name="Checks complete">
      <bpmn:incoming>F_tkm_city_ashgabat_05</bpmn:incoming>
      <bpmn:incoming>F_tkm_city_ashgabat_06</bpmn:incoming>
      <bpmn:incoming>F_tkm_city_ashgabat_07</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_08</bpmn:outgoing>
