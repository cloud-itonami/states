  <bpmn:collaboration id="Collaboration_tkm_city_ashgabat">
    <bpmn:participant id="Pool_tkm_city_ashgabat" name="Ashgabat (city:ash)" processRef="Process_tkm_city_ashgabat" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tkm_city_ashgabat" name="Ashgabat — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_tkm_city_ashgabat" name="Policy trigger
received"><bpmn:outgoing>F_tkm_city_ashgabat_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_tkm_city_ashgabat_open" name="Parallel checks">
      <bpmn:incoming>F_tkm_city_ashgabat_01</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_02</bpmn:outgoing>
      <bpmn:outgoing>F_tkm_city_ashgabat_03</bpmn:outgoing>
      <bpmn:outgoing>F_tkm_city_ashgabat_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_tkm_city_ashgabat_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tkm.city:ashgabat.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tkm_city_ashgabat_02</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tkm_city_ashgabat_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.tkm.city:ashgabat.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_tkm_city_ashgabat_03</bpmn:incoming>
      <bpmn:outgoing>F_tkm_city_ashgabat_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_tkm_city_ashgabat_coord" name="Inter-Agency
