    <bpmn:endEvent id="End_tkm_city_ashgabat" name="Process complete">
      <bpmn:incoming>F_tkm_city_ashgabat_11</bpmn:incoming>
      <bpmn:incoming>F_tkm_city_ashgabat_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_01" sourceRef="Start_tkm_city_ashgabat" targetRef="GW_tkm_city_ashgabat_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_tkm_city_ashgabat_02" sourceRef="GW_tkm_city_ashgabat_open" targetRef="T_tkm_city_ashgabat_policy">
