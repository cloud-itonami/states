<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_nga_justice_ministry_of_justice"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_nga_justice_ministry_of_justice">
    <bpmn:participant id="Pool_nga_justice_ministry_of_justice" name="Justice Ministry Of Justice (n7g3j1a2)" processRef="Process_nga_justice_ministry_of_justice" />
  </bpmn:collaboration>
  <bpmn:process id="Process_nga_justice_ministry_of_justice" name="Justice Ministry Of Justice — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_nga_justice_ministry_of_justice" name="Incident
reported"><bpmn:outgoing>F_nga_justice_ministry_of_justice_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_nga_justice_ministry_of_justice_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nga.justice-ministry-of-justice.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nga_justice_ministry_of_justice_01</bpmn:incoming>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_nga_justice_ministry_of_justice_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_nga_justice_ministry_of_justice_02</bpmn:incoming>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_03a</bpmn:outgoing>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_03b</bpmn:outgoing>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_nga_justice_ministry_of_justice_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nga.justice-ministry-of-justice.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nga_justice_ministry_of_justice_03a</bpmn:incoming>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nga_justice_ministry_of_justice_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nga.justice-ministry-of-justice.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nga_justice_ministry_of_justice_03b</bpmn:incoming>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nga_justice_ministry_of_justice_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nga.justice-ministry-of-justice.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nga_justice_ministry_of_justice_03c</bpmn:incoming>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nga_justice_ministry_of_justice_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nga.justice-ministry-of-justice.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_nga_justice_ministry_of_justice_06</bpmn:incoming>
      <bpmn:outgoing>F_nga_justice_ministry_of_justice_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_nga_justice_ministry_of_justice" name="Incident resolved">
      <bpmn:incoming>F_nga_justice_ministry_of_justice_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_01" sourceRef="Start_nga_justice_ministry_of_justice" targetRef="T_nga_justice_ministry_of_justice_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_02" sourceRef="T_nga_justice_ministry_of_justice_triage" targetRef="GW_nga_justice_ministry_of_justice_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_03a" sourceRef="GW_nga_justice_ministry_of_justice_sev" targetRef="T_nga_justice_ministry_of_justice_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_03b" sourceRef="GW_nga_justice_ministry_of_justice_sev" targetRef="T_nga_justice_ministry_of_justice_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_03c" sourceRef="GW_nga_justice_ministry_of_justice_sev" targetRef="T_nga_justice_ministry_of_justice_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_06" sourceRef="T_nga_justice_ministry_of_justice_emergency" targetRef="T_nga_justice_ministry_of_justice_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_06b" sourceRef="T_nga_justice_ministry_of_justice_investigate" targetRef="T_nga_justice_ministry_of_justice_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_06c" sourceRef="T_nga_justice_ministry_of_justice_log" targetRef="T_nga_justice_ministry_of_justice_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nga_justice_ministry_of_justice_07" sourceRef="T_nga_justice_ministry_of_justice_report" targetRef="End_nga_justice_ministry_of_justice">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_nga_justice_ministry_of_justice">
    <bpmndi:BPMNPlane id="BPMNPlane_nga_justice_ministry_of_justice" bpmnElement="Collaboration_nga_justice_ministry_of_justice" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
