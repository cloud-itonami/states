<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ner_city_niamey"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ner_city_niamey">
    <bpmn:participant id="Pool_ner_city_niamey" name="Niamey (city:nia)" processRef="Process_ner_city_niamey" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ner_city_niamey" name="Niamey — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ner_city_niamey" name="Policy trigger
received"><bpmn:outgoing>F_ner_city_niamey_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ner_city_niamey_open" name="Parallel checks">
      <bpmn:incoming>F_ner_city_niamey_01</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_02</bpmn:outgoing>
      <bpmn:outgoing>F_ner_city_niamey_03</bpmn:outgoing>
      <bpmn:outgoing>F_ner_city_niamey_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ner_city_niamey_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ner.city:niamey.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ner_city_niamey_02</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ner_city_niamey_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ner.city:niamey.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ner_city_niamey_03</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ner_city_niamey_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ner.city:niamey.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ner_city_niamey_04</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ner_city_niamey_join" name="Checks complete">
      <bpmn:incoming>F_ner_city_niamey_05</bpmn:incoming>
      <bpmn:incoming>F_ner_city_niamey_06</bpmn:incoming>
      <bpmn:incoming>F_ner_city_niamey_07</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ner_city_niamey_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ner_city_niamey_08</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ner_city_niamey_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ner_city_niamey_09</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ner_city_niamey_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ner_city_niamey_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ner.city:niamey.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ner_city_niamey_10a</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ner_city_niamey_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ner.city:niamey.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ner_city_niamey_10b</bpmn:incoming>
      <bpmn:outgoing>F_ner_city_niamey_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ner_city_niamey" name="Process complete">
      <bpmn:incoming>F_ner_city_niamey_11</bpmn:incoming>
      <bpmn:incoming>F_ner_city_niamey_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ner_city_niamey_01" sourceRef="Start_ner_city_niamey" targetRef="GW_ner_city_niamey_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_02" sourceRef="GW_ner_city_niamey_open" targetRef="T_ner_city_niamey_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_03" sourceRef="GW_ner_city_niamey_open" targetRef="T_ner_city_niamey_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_04" sourceRef="GW_ner_city_niamey_open" targetRef="T_ner_city_niamey_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_05" sourceRef="T_ner_city_niamey_policy" targetRef="GW_ner_city_niamey_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_06" sourceRef="T_ner_city_niamey_budget" targetRef="GW_ner_city_niamey_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_07" sourceRef="T_ner_city_niamey_coord" targetRef="GW_ner_city_niamey_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_08" sourceRef="GW_ner_city_niamey_join" targetRef="T_ner_city_niamey_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_09" sourceRef="T_ner_city_niamey_review" targetRef="GW_ner_city_niamey_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_10a" sourceRef="GW_ner_city_niamey_risk" targetRef="T_ner_city_niamey_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_10b" sourceRef="GW_ner_city_niamey_risk" targetRef="T_ner_city_niamey_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_11" sourceRef="T_ner_city_niamey_publish" targetRef="End_ner_city_niamey">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ner_city_niamey_11b" sourceRef="T_ner_city_niamey_revise" targetRef="End_ner_city_niamey">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ner_city_niamey">
    <bpmndi:BPMNPlane id="BPMNPlane_ner_city_niamey" bpmnElement="Collaboration_ner_city_niamey" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
