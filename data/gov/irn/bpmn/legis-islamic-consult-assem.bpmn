<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_irn_legis_islamic_consult_assem"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_irn_legis_islamic_consult_assem">
    <bpmn:participant id="Pool_irn_legis_islamic_consult_assem" name="Legis Islamic Consult Assem (2jtnetvu)" processRef="Process_irn_legis_islamic_consult_assem" />
  </bpmn:collaboration>
  <bpmn:process id="Process_irn_legis_islamic_consult_assem" name="Legis Islamic Consult Assem — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_irn_legis_islamic_consult_assem" name="Policy trigger
received"><bpmn:outgoing>F_irn_legis_islamic_consult_assem_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_irn_legis_islamic_consult_assem_open" name="Parallel checks">
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_01</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_02</bpmn:outgoing>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_03</bpmn:outgoing>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_irn_legis_islamic_consult_assem_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.legis-islamic-consult-assem.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_02</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_legis_islamic_consult_assem_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.legis-islamic-consult-assem.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_03</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_legis_islamic_consult_assem_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.legis-islamic-consult-assem.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_04</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_irn_legis_islamic_consult_assem_join" name="Checks complete">
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_05</bpmn:incoming>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_06</bpmn:incoming>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_07</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_irn_legis_islamic_consult_assem_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_08</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_irn_legis_islamic_consult_assem_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_09</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_10a</bpmn:outgoing>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_irn_legis_islamic_consult_assem_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.legis-islamic-consult-assem.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_10a</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_legis_islamic_consult_assem_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.legis-islamic-consult-assem.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_10b</bpmn:incoming>
      <bpmn:outgoing>F_irn_legis_islamic_consult_assem_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_irn_legis_islamic_consult_assem" name="Process complete">
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_11</bpmn:incoming>
      <bpmn:incoming>F_irn_legis_islamic_consult_assem_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_01" sourceRef="Start_irn_legis_islamic_consult_assem" targetRef="GW_irn_legis_islamic_consult_assem_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_02" sourceRef="GW_irn_legis_islamic_consult_assem_open" targetRef="T_irn_legis_islamic_consult_assem_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_03" sourceRef="GW_irn_legis_islamic_consult_assem_open" targetRef="T_irn_legis_islamic_consult_assem_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_04" sourceRef="GW_irn_legis_islamic_consult_assem_open" targetRef="T_irn_legis_islamic_consult_assem_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_05" sourceRef="T_irn_legis_islamic_consult_assem_policy" targetRef="GW_irn_legis_islamic_consult_assem_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_06" sourceRef="T_irn_legis_islamic_consult_assem_budget" targetRef="GW_irn_legis_islamic_consult_assem_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_07" sourceRef="T_irn_legis_islamic_consult_assem_coord" targetRef="GW_irn_legis_islamic_consult_assem_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_08" sourceRef="GW_irn_legis_islamic_consult_assem_join" targetRef="T_irn_legis_islamic_consult_assem_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_09" sourceRef="T_irn_legis_islamic_consult_assem_review" targetRef="GW_irn_legis_islamic_consult_assem_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_10a" sourceRef="GW_irn_legis_islamic_consult_assem_risk" targetRef="T_irn_legis_islamic_consult_assem_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_10b" sourceRef="GW_irn_legis_islamic_consult_assem_risk" targetRef="T_irn_legis_islamic_consult_assem_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_11" sourceRef="T_irn_legis_islamic_consult_assem_publish" targetRef="End_irn_legis_islamic_consult_assem">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_legis_islamic_consult_assem_11b" sourceRef="T_irn_legis_islamic_consult_assem_revise" targetRef="End_irn_legis_islamic_consult_assem">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_irn_legis_islamic_consult_assem">
    <bpmndi:BPMNPlane id="BPMNPlane_irn_legis_islamic_consult_assem" bpmnElement="Collaboration_irn_legis_islamic_consult_assem" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
