<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_irn_city_mashhad"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_irn_city_mashhad">
    <bpmn:participant id="Pool_irn_city_mashhad" name="Mashhad (city:mas)" processRef="Process_irn_city_mashhad" />
  </bpmn:collaboration>
  <bpmn:process id="Process_irn_city_mashhad" name="Mashhad — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_irn_city_mashhad" name="Policy trigger
received"><bpmn:outgoing>F_irn_city_mashhad_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_irn_city_mashhad_open" name="Parallel checks">
      <bpmn:incoming>F_irn_city_mashhad_01</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_02</bpmn:outgoing>
      <bpmn:outgoing>F_irn_city_mashhad_03</bpmn:outgoing>
      <bpmn:outgoing>F_irn_city_mashhad_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_irn_city_mashhad_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.city:mashhad.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_city_mashhad_02</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_city_mashhad_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.city:mashhad.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_city_mashhad_03</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_city_mashhad_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.city:mashhad.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_city_mashhad_04</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_irn_city_mashhad_join" name="Checks complete">
      <bpmn:incoming>F_irn_city_mashhad_05</bpmn:incoming>
      <bpmn:incoming>F_irn_city_mashhad_06</bpmn:incoming>
      <bpmn:incoming>F_irn_city_mashhad_07</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_irn_city_mashhad_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_city_mashhad_08</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_irn_city_mashhad_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_irn_city_mashhad_09</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_10a</bpmn:outgoing>
      <bpmn:outgoing>F_irn_city_mashhad_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_irn_city_mashhad_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.city:mashhad.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_city_mashhad_10a</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_city_mashhad_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.city:mashhad.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_city_mashhad_10b</bpmn:incoming>
      <bpmn:outgoing>F_irn_city_mashhad_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_irn_city_mashhad" name="Process complete">
      <bpmn:incoming>F_irn_city_mashhad_11</bpmn:incoming>
      <bpmn:incoming>F_irn_city_mashhad_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_01" sourceRef="Start_irn_city_mashhad" targetRef="GW_irn_city_mashhad_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_02" sourceRef="GW_irn_city_mashhad_open" targetRef="T_irn_city_mashhad_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_03" sourceRef="GW_irn_city_mashhad_open" targetRef="T_irn_city_mashhad_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_04" sourceRef="GW_irn_city_mashhad_open" targetRef="T_irn_city_mashhad_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_05" sourceRef="T_irn_city_mashhad_policy" targetRef="GW_irn_city_mashhad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_06" sourceRef="T_irn_city_mashhad_budget" targetRef="GW_irn_city_mashhad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_07" sourceRef="T_irn_city_mashhad_coord" targetRef="GW_irn_city_mashhad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_08" sourceRef="GW_irn_city_mashhad_join" targetRef="T_irn_city_mashhad_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_09" sourceRef="T_irn_city_mashhad_review" targetRef="GW_irn_city_mashhad_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_10a" sourceRef="GW_irn_city_mashhad_risk" targetRef="T_irn_city_mashhad_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_10b" sourceRef="GW_irn_city_mashhad_risk" targetRef="T_irn_city_mashhad_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_11" sourceRef="T_irn_city_mashhad_publish" targetRef="End_irn_city_mashhad">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_city_mashhad_11b" sourceRef="T_irn_city_mashhad_revise" targetRef="End_irn_city_mashhad">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_irn_city_mashhad">
    <bpmndi:BPMNPlane id="BPMNPlane_irn_city_mashhad" bpmnElement="Collaboration_irn_city_mashhad" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
