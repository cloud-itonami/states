<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_irn_law_enforcement_force"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_irn_law_enforcement_force">
    <bpmn:participant id="Pool_irn_law_enforcement_force" name="Law Enforcement Force (law-enfo)" processRef="Process_irn_law_enforcement_force" />
  </bpmn:collaboration>
  <bpmn:process id="Process_irn_law_enforcement_force" name="Law Enforcement Force — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_irn_law_enforcement_force" name="Incident
reported"><bpmn:outgoing>F_irn_law_enforcement_force_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_irn_law_enforcement_force_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.law-enforcement-force.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_law_enforcement_force_01</bpmn:incoming>
      <bpmn:outgoing>F_irn_law_enforcement_force_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_irn_law_enforcement_force_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_irn_law_enforcement_force_02</bpmn:incoming>
      <bpmn:outgoing>F_irn_law_enforcement_force_03a</bpmn:outgoing>
      <bpmn:outgoing>F_irn_law_enforcement_force_03b</bpmn:outgoing>
      <bpmn:outgoing>F_irn_law_enforcement_force_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_irn_law_enforcement_force_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.law-enforcement-force.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_law_enforcement_force_03a</bpmn:incoming>
      <bpmn:outgoing>F_irn_law_enforcement_force_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_law_enforcement_force_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.law-enforcement-force.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_law_enforcement_force_03b</bpmn:incoming>
      <bpmn:outgoing>F_irn_law_enforcement_force_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_law_enforcement_force_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.law-enforcement-force.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_law_enforcement_force_03c</bpmn:incoming>
      <bpmn:outgoing>F_irn_law_enforcement_force_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_irn_law_enforcement_force_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.irn.law-enforcement-force.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_irn_law_enforcement_force_06</bpmn:incoming>
      <bpmn:outgoing>F_irn_law_enforcement_force_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_irn_law_enforcement_force" name="Incident resolved">
      <bpmn:incoming>F_irn_law_enforcement_force_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_01" sourceRef="Start_irn_law_enforcement_force" targetRef="T_irn_law_enforcement_force_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_02" sourceRef="T_irn_law_enforcement_force_triage" targetRef="GW_irn_law_enforcement_force_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_03a" sourceRef="GW_irn_law_enforcement_force_sev" targetRef="T_irn_law_enforcement_force_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_03b" sourceRef="GW_irn_law_enforcement_force_sev" targetRef="T_irn_law_enforcement_force_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_03c" sourceRef="GW_irn_law_enforcement_force_sev" targetRef="T_irn_law_enforcement_force_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_06" sourceRef="T_irn_law_enforcement_force_emergency" targetRef="T_irn_law_enforcement_force_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_06b" sourceRef="T_irn_law_enforcement_force_investigate" targetRef="T_irn_law_enforcement_force_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_06c" sourceRef="T_irn_law_enforcement_force_log" targetRef="T_irn_law_enforcement_force_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_irn_law_enforcement_force_07" sourceRef="T_irn_law_enforcement_force_report" targetRef="End_irn_law_enforcement_force">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_irn_law_enforcement_force">
    <bpmndi:BPMNPlane id="BPMNPlane_irn_law_enforcement_force" bpmnElement="Collaboration_irn_law_enforcement_force" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
