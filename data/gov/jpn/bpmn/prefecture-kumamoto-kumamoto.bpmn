<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jpn_prefecture_kumamoto_kumamoto"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jpn_prefecture_kumamoto_kumamoto">
    <bpmn:participant id="Pool_jpn_prefecture_kumamoto_kumamoto" name="Kumamoto (prefectu)" processRef="Process_jpn_prefecture_kumamoto_kumamoto" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jpn_prefecture_kumamoto_kumamoto" name="Kumamoto — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jpn_prefecture_kumamoto_kumamoto" name="Policy trigger
received"><bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jpn_prefecture_kumamoto_kumamoto_open" name="Parallel checks">
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_01</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_02</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_03</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_kumamoto_kumamoto_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:kumamoto:kumamoto.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_02</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_kumamoto_kumamoto_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:kumamoto:kumamoto.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_03</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_kumamoto_kumamoto_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:kumamoto:kumamoto.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_04</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jpn_prefecture_kumamoto_kumamoto_join" name="Checks complete">
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_05</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_06</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_07</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jpn_prefecture_kumamoto_kumamoto_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_08</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jpn_prefecture_kumamoto_kumamoto_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_09</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_kumamoto_kumamoto_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:kumamoto:kumamoto.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_10a</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_kumamoto_kumamoto_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:kumamoto:kumamoto.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_10b</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_kumamoto_kumamoto_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jpn_prefecture_kumamoto_kumamoto" name="Process complete">
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_11</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_kumamoto_kumamoto_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_01" sourceRef="Start_jpn_prefecture_kumamoto_kumamoto" targetRef="GW_jpn_prefecture_kumamoto_kumamoto_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_02" sourceRef="GW_jpn_prefecture_kumamoto_kumamoto_open" targetRef="T_jpn_prefecture_kumamoto_kumamoto_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_03" sourceRef="GW_jpn_prefecture_kumamoto_kumamoto_open" targetRef="T_jpn_prefecture_kumamoto_kumamoto_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_04" sourceRef="GW_jpn_prefecture_kumamoto_kumamoto_open" targetRef="T_jpn_prefecture_kumamoto_kumamoto_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_05" sourceRef="T_jpn_prefecture_kumamoto_kumamoto_policy" targetRef="GW_jpn_prefecture_kumamoto_kumamoto_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_06" sourceRef="T_jpn_prefecture_kumamoto_kumamoto_budget" targetRef="GW_jpn_prefecture_kumamoto_kumamoto_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_07" sourceRef="T_jpn_prefecture_kumamoto_kumamoto_coord" targetRef="GW_jpn_prefecture_kumamoto_kumamoto_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_08" sourceRef="GW_jpn_prefecture_kumamoto_kumamoto_join" targetRef="T_jpn_prefecture_kumamoto_kumamoto_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_09" sourceRef="T_jpn_prefecture_kumamoto_kumamoto_review" targetRef="GW_jpn_prefecture_kumamoto_kumamoto_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_10a" sourceRef="GW_jpn_prefecture_kumamoto_kumamoto_risk" targetRef="T_jpn_prefecture_kumamoto_kumamoto_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_10b" sourceRef="GW_jpn_prefecture_kumamoto_kumamoto_risk" targetRef="T_jpn_prefecture_kumamoto_kumamoto_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_11" sourceRef="T_jpn_prefecture_kumamoto_kumamoto_publish" targetRef="End_jpn_prefecture_kumamoto_kumamoto">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_kumamoto_kumamoto_11b" sourceRef="T_jpn_prefecture_kumamoto_kumamoto_revise" targetRef="End_jpn_prefecture_kumamoto_kumamoto">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jpn_prefecture_kumamoto_kumamoto">
    <bpmndi:BPMNPlane id="BPMNPlane_jpn_prefecture_kumamoto_kumamoto" bpmnElement="Collaboration_jpn_prefecture_kumamoto_kumamoto" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
