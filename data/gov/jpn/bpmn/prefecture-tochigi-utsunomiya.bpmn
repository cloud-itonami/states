    id="Definitions_jpn_prefecture_tochigi_utsunomiya"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jpn_prefecture_tochigi_utsunomiya">
    <bpmn:participant id="Pool_jpn_prefecture_tochigi_utsunomiya" name="Utsunomiya (prefectu)" processRef="Process_jpn_prefecture_tochigi_utsunomiya" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jpn_prefecture_tochigi_utsunomiya" name="Utsunomiya — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jpn_prefecture_tochigi_utsunomiya" name="Policy trigger
received"><bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jpn_prefecture_tochigi_utsunomiya_open" name="Parallel checks">
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_01</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_02</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_03</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_tochigi_utsunomiya_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tochigi:utsunomiya.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_02</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tochigi_utsunomiya_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tochigi:utsunomiya.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_03</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tochigi_utsunomiya_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tochigi:utsunomiya.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_04</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jpn_prefecture_tochigi_utsunomiya_join" name="Checks complete">
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_05</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_06</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_07</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jpn_prefecture_tochigi_utsunomiya_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_08</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jpn_prefecture_tochigi_utsunomiya_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_09</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_tochigi_utsunomiya_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tochigi:utsunomiya.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_10a</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tochigi_utsunomiya_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tochigi:utsunomiya.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_10b</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tochigi_utsunomiya_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jpn_prefecture_tochigi_utsunomiya" name="Process complete">
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_11</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tochigi_utsunomiya_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_01" sourceRef="Start_jpn_prefecture_tochigi_utsunomiya" targetRef="GW_jpn_prefecture_tochigi_utsunomiya_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_02" sourceRef="GW_jpn_prefecture_tochigi_utsunomiya_open" targetRef="T_jpn_prefecture_tochigi_utsunomiya_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_03" sourceRef="GW_jpn_prefecture_tochigi_utsunomiya_open" targetRef="T_jpn_prefecture_tochigi_utsunomiya_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_04" sourceRef="GW_jpn_prefecture_tochigi_utsunomiya_open" targetRef="T_jpn_prefecture_tochigi_utsunomiya_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_05" sourceRef="T_jpn_prefecture_tochigi_utsunomiya_policy" targetRef="GW_jpn_prefecture_tochigi_utsunomiya_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_06" sourceRef="T_jpn_prefecture_tochigi_utsunomiya_budget" targetRef="GW_jpn_prefecture_tochigi_utsunomiya_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_07" sourceRef="T_jpn_prefecture_tochigi_utsunomiya_coord" targetRef="GW_jpn_prefecture_tochigi_utsunomiya_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_08" sourceRef="GW_jpn_prefecture_tochigi_utsunomiya_join" targetRef="T_jpn_prefecture_tochigi_utsunomiya_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_09" sourceRef="T_jpn_prefecture_tochigi_utsunomiya_review" targetRef="GW_jpn_prefecture_tochigi_utsunomiya_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_10a" sourceRef="GW_jpn_prefecture_tochigi_utsunomiya_risk" targetRef="T_jpn_prefecture_tochigi_utsunomiya_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_10b" sourceRef="GW_jpn_prefecture_tochigi_utsunomiya_risk" targetRef="T_jpn_prefecture_tochigi_utsunomiya_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_11" sourceRef="T_jpn_prefecture_tochigi_utsunomiya_publish" targetRef="End_jpn_prefecture_tochigi_utsunomiya">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tochigi_utsunomiya_11b" sourceRef="T_jpn_prefecture_tochigi_utsunomiya_revise" targetRef="End_jpn_prefecture_tochigi_utsunomiya">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jpn_prefecture_tochigi_utsunomiya">
    <bpmndi:BPMNPlane id="BPMNPlane_jpn_prefecture_tochigi_utsunomiya" bpmnElement="Collaboration_jpn_prefecture_tochigi_utsunomiya" />
  </bpmndi:BPMNDiagram>
