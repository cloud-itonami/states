<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jpn_prefecture_wakayama"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jpn_prefecture_wakayama">
    <bpmn:participant id="Pool_jpn_prefecture_wakayama" name="Wakayama (prefectu)" processRef="Process_jpn_prefecture_wakayama" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jpn_prefecture_wakayama" name="Wakayama — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jpn_prefecture_wakayama" name="Policy trigger
received"><bpmn:outgoing>F_jpn_prefecture_wakayama_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jpn_prefecture_wakayama_open" name="Parallel checks">
      <bpmn:incoming>F_jpn_prefecture_wakayama_01</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_02</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_03</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_wakayama_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:wakayama.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_wakayama_02</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_wakayama_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:wakayama.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_wakayama_03</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_wakayama_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:wakayama.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_wakayama_04</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jpn_prefecture_wakayama_join" name="Checks complete">
      <bpmn:incoming>F_jpn_prefecture_wakayama_05</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_wakayama_06</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_wakayama_07</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jpn_prefecture_wakayama_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_wakayama_08</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jpn_prefecture_wakayama_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jpn_prefecture_wakayama_09</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_wakayama_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:wakayama.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_wakayama_10a</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_wakayama_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:wakayama.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_wakayama_10b</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_wakayama_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jpn_prefecture_wakayama" name="Process complete">
      <bpmn:incoming>F_jpn_prefecture_wakayama_11</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_wakayama_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_01" sourceRef="Start_jpn_prefecture_wakayama" targetRef="GW_jpn_prefecture_wakayama_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_02" sourceRef="GW_jpn_prefecture_wakayama_open" targetRef="T_jpn_prefecture_wakayama_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_03" sourceRef="GW_jpn_prefecture_wakayama_open" targetRef="T_jpn_prefecture_wakayama_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_04" sourceRef="GW_jpn_prefecture_wakayama_open" targetRef="T_jpn_prefecture_wakayama_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_05" sourceRef="T_jpn_prefecture_wakayama_policy" targetRef="GW_jpn_prefecture_wakayama_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_06" sourceRef="T_jpn_prefecture_wakayama_budget" targetRef="GW_jpn_prefecture_wakayama_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_07" sourceRef="T_jpn_prefecture_wakayama_coord" targetRef="GW_jpn_prefecture_wakayama_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_08" sourceRef="GW_jpn_prefecture_wakayama_join" targetRef="T_jpn_prefecture_wakayama_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_09" sourceRef="T_jpn_prefecture_wakayama_review" targetRef="GW_jpn_prefecture_wakayama_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_10a" sourceRef="GW_jpn_prefecture_wakayama_risk" targetRef="T_jpn_prefecture_wakayama_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_10b" sourceRef="GW_jpn_prefecture_wakayama_risk" targetRef="T_jpn_prefecture_wakayama_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_11" sourceRef="T_jpn_prefecture_wakayama_publish" targetRef="End_jpn_prefecture_wakayama">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_wakayama_11b" sourceRef="T_jpn_prefecture_wakayama_revise" targetRef="End_jpn_prefecture_wakayama">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jpn_prefecture_wakayama">
    <bpmndi:BPMNPlane id="BPMNPlane_jpn_prefecture_wakayama" bpmnElement="Collaboration_jpn_prefecture_wakayama" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
