<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jpn_prefecture_tokyo_shinagawa"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jpn_prefecture_tokyo_shinagawa">
    <bpmn:participant id="Pool_jpn_prefecture_tokyo_shinagawa" name="Shinagawa (prefectu)" processRef="Process_jpn_prefecture_tokyo_shinagawa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jpn_prefecture_tokyo_shinagawa" name="Shinagawa — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jpn_prefecture_tokyo_shinagawa" name="Policy trigger
received"><bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jpn_prefecture_tokyo_shinagawa_open" name="Parallel checks">
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_01</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_02</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_03</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_shinagawa_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:shinagawa.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_02</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_shinagawa_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:shinagawa.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_03</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_shinagawa_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:shinagawa.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_04</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jpn_prefecture_tokyo_shinagawa_join" name="Checks complete">
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_05</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_06</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_07</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jpn_prefecture_tokyo_shinagawa_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_08</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jpn_prefecture_tokyo_shinagawa_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_09</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_shinagawa_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:shinagawa.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_10a</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_shinagawa_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:shinagawa.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_10b</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_shinagawa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jpn_prefecture_tokyo_shinagawa" name="Process complete">
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_11</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tokyo_shinagawa_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_01" sourceRef="Start_jpn_prefecture_tokyo_shinagawa" targetRef="GW_jpn_prefecture_tokyo_shinagawa_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_02" sourceRef="GW_jpn_prefecture_tokyo_shinagawa_open" targetRef="T_jpn_prefecture_tokyo_shinagawa_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_03" sourceRef="GW_jpn_prefecture_tokyo_shinagawa_open" targetRef="T_jpn_prefecture_tokyo_shinagawa_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_04" sourceRef="GW_jpn_prefecture_tokyo_shinagawa_open" targetRef="T_jpn_prefecture_tokyo_shinagawa_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_05" sourceRef="T_jpn_prefecture_tokyo_shinagawa_policy" targetRef="GW_jpn_prefecture_tokyo_shinagawa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_06" sourceRef="T_jpn_prefecture_tokyo_shinagawa_budget" targetRef="GW_jpn_prefecture_tokyo_shinagawa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_07" sourceRef="T_jpn_prefecture_tokyo_shinagawa_coord" targetRef="GW_jpn_prefecture_tokyo_shinagawa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_08" sourceRef="GW_jpn_prefecture_tokyo_shinagawa_join" targetRef="T_jpn_prefecture_tokyo_shinagawa_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_09" sourceRef="T_jpn_prefecture_tokyo_shinagawa_review" targetRef="GW_jpn_prefecture_tokyo_shinagawa_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_10a" sourceRef="GW_jpn_prefecture_tokyo_shinagawa_risk" targetRef="T_jpn_prefecture_tokyo_shinagawa_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_10b" sourceRef="GW_jpn_prefecture_tokyo_shinagawa_risk" targetRef="T_jpn_prefecture_tokyo_shinagawa_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_11" sourceRef="T_jpn_prefecture_tokyo_shinagawa_publish" targetRef="End_jpn_prefecture_tokyo_shinagawa">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_shinagawa_11b" sourceRef="T_jpn_prefecture_tokyo_shinagawa_revise" targetRef="End_jpn_prefecture_tokyo_shinagawa">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jpn_prefecture_tokyo_shinagawa">
    <bpmndi:BPMNPlane id="BPMNPlane_jpn_prefecture_tokyo_shinagawa" bpmnElement="Collaboration_jpn_prefecture_tokyo_shinagawa" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
