<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jpn_prefecture_shimane"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jpn_prefecture_shimane">
    <bpmn:participant id="Pool_jpn_prefecture_shimane" name="Shimane (prefectu)" processRef="Process_jpn_prefecture_shimane" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jpn_prefecture_shimane" name="Shimane — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jpn_prefecture_shimane" name="Policy trigger
received"><bpmn:outgoing>F_jpn_prefecture_shimane_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jpn_prefecture_shimane_open" name="Parallel checks">
      <bpmn:incoming>F_jpn_prefecture_shimane_01</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_02</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_shimane_03</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_shimane_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_shimane_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:shimane.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_shimane_02</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_shimane_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:shimane.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_shimane_03</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_shimane_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:shimane.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_shimane_04</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jpn_prefecture_shimane_join" name="Checks complete">
      <bpmn:incoming>F_jpn_prefecture_shimane_05</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_shimane_06</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_shimane_07</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jpn_prefecture_shimane_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_shimane_08</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jpn_prefecture_shimane_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jpn_prefecture_shimane_09</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_shimane_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_shimane_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:shimane.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_shimane_10a</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_shimane_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:shimane.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_shimane_10b</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_shimane_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jpn_prefecture_shimane" name="Process complete">
      <bpmn:incoming>F_jpn_prefecture_shimane_11</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_shimane_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_01" sourceRef="Start_jpn_prefecture_shimane" targetRef="GW_jpn_prefecture_shimane_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_02" sourceRef="GW_jpn_prefecture_shimane_open" targetRef="T_jpn_prefecture_shimane_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_03" sourceRef="GW_jpn_prefecture_shimane_open" targetRef="T_jpn_prefecture_shimane_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_04" sourceRef="GW_jpn_prefecture_shimane_open" targetRef="T_jpn_prefecture_shimane_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_05" sourceRef="T_jpn_prefecture_shimane_policy" targetRef="GW_jpn_prefecture_shimane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_06" sourceRef="T_jpn_prefecture_shimane_budget" targetRef="GW_jpn_prefecture_shimane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_07" sourceRef="T_jpn_prefecture_shimane_coord" targetRef="GW_jpn_prefecture_shimane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_08" sourceRef="GW_jpn_prefecture_shimane_join" targetRef="T_jpn_prefecture_shimane_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_09" sourceRef="T_jpn_prefecture_shimane_review" targetRef="GW_jpn_prefecture_shimane_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_10a" sourceRef="GW_jpn_prefecture_shimane_risk" targetRef="T_jpn_prefecture_shimane_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_10b" sourceRef="GW_jpn_prefecture_shimane_risk" targetRef="T_jpn_prefecture_shimane_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_11" sourceRef="T_jpn_prefecture_shimane_publish" targetRef="End_jpn_prefecture_shimane">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_shimane_11b" sourceRef="T_jpn_prefecture_shimane_revise" targetRef="End_jpn_prefecture_shimane">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jpn_prefecture_shimane">
    <bpmndi:BPMNPlane id="BPMNPlane_jpn_prefecture_shimane" bpmnElement="Collaboration_jpn_prefecture_shimane" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
