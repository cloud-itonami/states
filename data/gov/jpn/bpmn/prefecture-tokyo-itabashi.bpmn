<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jpn_prefecture_tokyo_itabashi"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jpn_prefecture_tokyo_itabashi">
    <bpmn:participant id="Pool_jpn_prefecture_tokyo_itabashi" name="Itabashi (prefectu)" processRef="Process_jpn_prefecture_tokyo_itabashi" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jpn_prefecture_tokyo_itabashi" name="Itabashi — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jpn_prefecture_tokyo_itabashi" name="Policy trigger
received"><bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jpn_prefecture_tokyo_itabashi_open" name="Parallel checks">
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_01</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_02</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_03</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_itabashi_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:itabashi.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_02</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_itabashi_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:itabashi.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_03</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_itabashi_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:itabashi.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_04</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jpn_prefecture_tokyo_itabashi_join" name="Checks complete">
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_05</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_06</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_07</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jpn_prefecture_tokyo_itabashi_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_08</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jpn_prefecture_tokyo_itabashi_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_09</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_itabashi_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:itabashi.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_10a</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jpn_prefecture_tokyo_itabashi_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jpn.prefecture:tokyo:itabashi.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_10b</bpmn:incoming>
      <bpmn:outgoing>F_jpn_prefecture_tokyo_itabashi_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jpn_prefecture_tokyo_itabashi" name="Process complete">
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_11</bpmn:incoming>
      <bpmn:incoming>F_jpn_prefecture_tokyo_itabashi_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_01" sourceRef="Start_jpn_prefecture_tokyo_itabashi" targetRef="GW_jpn_prefecture_tokyo_itabashi_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_02" sourceRef="GW_jpn_prefecture_tokyo_itabashi_open" targetRef="T_jpn_prefecture_tokyo_itabashi_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_03" sourceRef="GW_jpn_prefecture_tokyo_itabashi_open" targetRef="T_jpn_prefecture_tokyo_itabashi_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_04" sourceRef="GW_jpn_prefecture_tokyo_itabashi_open" targetRef="T_jpn_prefecture_tokyo_itabashi_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_05" sourceRef="T_jpn_prefecture_tokyo_itabashi_policy" targetRef="GW_jpn_prefecture_tokyo_itabashi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_06" sourceRef="T_jpn_prefecture_tokyo_itabashi_budget" targetRef="GW_jpn_prefecture_tokyo_itabashi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_07" sourceRef="T_jpn_prefecture_tokyo_itabashi_coord" targetRef="GW_jpn_prefecture_tokyo_itabashi_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_08" sourceRef="GW_jpn_prefecture_tokyo_itabashi_join" targetRef="T_jpn_prefecture_tokyo_itabashi_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_09" sourceRef="T_jpn_prefecture_tokyo_itabashi_review" targetRef="GW_jpn_prefecture_tokyo_itabashi_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_10a" sourceRef="GW_jpn_prefecture_tokyo_itabashi_risk" targetRef="T_jpn_prefecture_tokyo_itabashi_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_10b" sourceRef="GW_jpn_prefecture_tokyo_itabashi_risk" targetRef="T_jpn_prefecture_tokyo_itabashi_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_11" sourceRef="T_jpn_prefecture_tokyo_itabashi_publish" targetRef="End_jpn_prefecture_tokyo_itabashi">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jpn_prefecture_tokyo_itabashi_11b" sourceRef="T_jpn_prefecture_tokyo_itabashi_revise" targetRef="End_jpn_prefecture_tokyo_itabashi">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jpn_prefecture_tokyo_itabashi">
    <bpmndi:BPMNPlane id="BPMNPlane_jpn_prefecture_tokyo_itabashi" bpmnElement="Collaboration_jpn_prefecture_tokyo_itabashi" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
