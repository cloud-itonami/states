<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_uga_city_kampala"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_uga_city_kampala">
    <bpmn:participant id="Pool_uga_city_kampala" name="Kampala (city:kam)" processRef="Process_uga_city_kampala" />
  </bpmn:collaboration>
  <bpmn:process id="Process_uga_city_kampala" name="Kampala — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_uga_city_kampala" name="Policy trigger
received"><bpmn:outgoing>F_uga_city_kampala_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_uga_city_kampala_open" name="Parallel checks">
      <bpmn:incoming>F_uga_city_kampala_01</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_02</bpmn:outgoing>
      <bpmn:outgoing>F_uga_city_kampala_03</bpmn:outgoing>
      <bpmn:outgoing>F_uga_city_kampala_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_uga_city_kampala_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.uga.city:kampala.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_uga_city_kampala_02</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_uga_city_kampala_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.uga.city:kampala.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_uga_city_kampala_03</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_uga_city_kampala_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.uga.city:kampala.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_uga_city_kampala_04</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_uga_city_kampala_join" name="Checks complete">
      <bpmn:incoming>F_uga_city_kampala_05</bpmn:incoming>
      <bpmn:incoming>F_uga_city_kampala_06</bpmn:incoming>
      <bpmn:incoming>F_uga_city_kampala_07</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_uga_city_kampala_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_uga_city_kampala_08</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_uga_city_kampala_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_uga_city_kampala_09</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_10a</bpmn:outgoing>
      <bpmn:outgoing>F_uga_city_kampala_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_uga_city_kampala_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.uga.city:kampala.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_uga_city_kampala_10a</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_uga_city_kampala_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.uga.city:kampala.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_uga_city_kampala_10b</bpmn:incoming>
      <bpmn:outgoing>F_uga_city_kampala_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_uga_city_kampala" name="Process complete">
      <bpmn:incoming>F_uga_city_kampala_11</bpmn:incoming>
      <bpmn:incoming>F_uga_city_kampala_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_uga_city_kampala_01" sourceRef="Start_uga_city_kampala" targetRef="GW_uga_city_kampala_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_02" sourceRef="GW_uga_city_kampala_open" targetRef="T_uga_city_kampala_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_03" sourceRef="GW_uga_city_kampala_open" targetRef="T_uga_city_kampala_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_04" sourceRef="GW_uga_city_kampala_open" targetRef="T_uga_city_kampala_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_05" sourceRef="T_uga_city_kampala_policy" targetRef="GW_uga_city_kampala_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_06" sourceRef="T_uga_city_kampala_budget" targetRef="GW_uga_city_kampala_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_07" sourceRef="T_uga_city_kampala_coord" targetRef="GW_uga_city_kampala_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_08" sourceRef="GW_uga_city_kampala_join" targetRef="T_uga_city_kampala_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_09" sourceRef="T_uga_city_kampala_review" targetRef="GW_uga_city_kampala_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_10a" sourceRef="GW_uga_city_kampala_risk" targetRef="T_uga_city_kampala_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_10b" sourceRef="GW_uga_city_kampala_risk" targetRef="T_uga_city_kampala_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_11" sourceRef="T_uga_city_kampala_publish" targetRef="End_uga_city_kampala">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_uga_city_kampala_11b" sourceRef="T_uga_city_kampala_revise" targetRef="End_uga_city_kampala">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_uga_city_kampala">
    <bpmndi:BPMNPlane id="BPMNPlane_uga_city_kampala" bpmnElement="Collaboration_uga_city_kampala" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
