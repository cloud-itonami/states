<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_syr_city_aleppo"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_syr_city_aleppo">
    <bpmn:participant id="Pool_syr_city_aleppo" name="Aleppo (city:ale)" processRef="Process_syr_city_aleppo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_syr_city_aleppo" name="Aleppo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_syr_city_aleppo" name="Policy trigger
received"><bpmn:outgoing>F_syr_city_aleppo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_syr_city_aleppo_open" name="Parallel checks">
      <bpmn:incoming>F_syr_city_aleppo_01</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_02</bpmn:outgoing>
      <bpmn:outgoing>F_syr_city_aleppo_03</bpmn:outgoing>
      <bpmn:outgoing>F_syr_city_aleppo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_syr_city_aleppo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syr.city:aleppo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syr_city_aleppo_02</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_syr_city_aleppo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syr.city:aleppo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syr_city_aleppo_03</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_syr_city_aleppo_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syr.city:aleppo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syr_city_aleppo_04</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_syr_city_aleppo_join" name="Checks complete">
      <bpmn:incoming>F_syr_city_aleppo_05</bpmn:incoming>
      <bpmn:incoming>F_syr_city_aleppo_06</bpmn:incoming>
      <bpmn:incoming>F_syr_city_aleppo_07</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_syr_city_aleppo_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_syr_city_aleppo_08</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_syr_city_aleppo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_syr_city_aleppo_09</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_syr_city_aleppo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_syr_city_aleppo_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syr.city:aleppo.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syr_city_aleppo_10a</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_syr_city_aleppo_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.syr.city:aleppo.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_syr_city_aleppo_10b</bpmn:incoming>
      <bpmn:outgoing>F_syr_city_aleppo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_syr_city_aleppo" name="Process complete">
      <bpmn:incoming>F_syr_city_aleppo_11</bpmn:incoming>
      <bpmn:incoming>F_syr_city_aleppo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_01" sourceRef="Start_syr_city_aleppo" targetRef="GW_syr_city_aleppo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_02" sourceRef="GW_syr_city_aleppo_open" targetRef="T_syr_city_aleppo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_03" sourceRef="GW_syr_city_aleppo_open" targetRef="T_syr_city_aleppo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_04" sourceRef="GW_syr_city_aleppo_open" targetRef="T_syr_city_aleppo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_05" sourceRef="T_syr_city_aleppo_policy" targetRef="GW_syr_city_aleppo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_06" sourceRef="T_syr_city_aleppo_budget" targetRef="GW_syr_city_aleppo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_07" sourceRef="T_syr_city_aleppo_coord" targetRef="GW_syr_city_aleppo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_08" sourceRef="GW_syr_city_aleppo_join" targetRef="T_syr_city_aleppo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_09" sourceRef="T_syr_city_aleppo_review" targetRef="GW_syr_city_aleppo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_10a" sourceRef="GW_syr_city_aleppo_risk" targetRef="T_syr_city_aleppo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_10b" sourceRef="GW_syr_city_aleppo_risk" targetRef="T_syr_city_aleppo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_11" sourceRef="T_syr_city_aleppo_publish" targetRef="End_syr_city_aleppo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_syr_city_aleppo_11b" sourceRef="T_syr_city_aleppo_revise" targetRef="End_syr_city_aleppo">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_syr_city_aleppo">
    <bpmndi:BPMNPlane id="BPMNPlane_syr_city_aleppo" bpmnElement="Collaboration_syr_city_aleppo" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
