<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_zmb_city_kitwe"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_zmb_city_kitwe">
    <bpmn:participant id="Pool_zmb_city_kitwe" name="Kitwe (city:kit)" processRef="Process_zmb_city_kitwe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_zmb_city_kitwe" name="Kitwe — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_zmb_city_kitwe" name="Policy trigger
received"><bpmn:outgoing>F_zmb_city_kitwe_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_zmb_city_kitwe_open" name="Parallel checks">
      <bpmn:incoming>F_zmb_city_kitwe_01</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_02</bpmn:outgoing>
      <bpmn:outgoing>F_zmb_city_kitwe_03</bpmn:outgoing>
      <bpmn:outgoing>F_zmb_city_kitwe_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_zmb_city_kitwe_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zmb.city:kitwe.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zmb_city_kitwe_02</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zmb_city_kitwe_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zmb.city:kitwe.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zmb_city_kitwe_03</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zmb_city_kitwe_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zmb.city:kitwe.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zmb_city_kitwe_04</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_zmb_city_kitwe_join" name="Checks complete">
      <bpmn:incoming>F_zmb_city_kitwe_05</bpmn:incoming>
      <bpmn:incoming>F_zmb_city_kitwe_06</bpmn:incoming>
      <bpmn:incoming>F_zmb_city_kitwe_07</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_zmb_city_kitwe_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_zmb_city_kitwe_08</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_zmb_city_kitwe_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_zmb_city_kitwe_09</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_10a</bpmn:outgoing>
      <bpmn:outgoing>F_zmb_city_kitwe_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_zmb_city_kitwe_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zmb.city:kitwe.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zmb_city_kitwe_10a</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zmb_city_kitwe_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.zmb.city:kitwe.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_zmb_city_kitwe_10b</bpmn:incoming>
      <bpmn:outgoing>F_zmb_city_kitwe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_zmb_city_kitwe" name="Process complete">
      <bpmn:incoming>F_zmb_city_kitwe_11</bpmn:incoming>
      <bpmn:incoming>F_zmb_city_kitwe_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_01" sourceRef="Start_zmb_city_kitwe" targetRef="GW_zmb_city_kitwe_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_02" sourceRef="GW_zmb_city_kitwe_open" targetRef="T_zmb_city_kitwe_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_03" sourceRef="GW_zmb_city_kitwe_open" targetRef="T_zmb_city_kitwe_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_04" sourceRef="GW_zmb_city_kitwe_open" targetRef="T_zmb_city_kitwe_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_05" sourceRef="T_zmb_city_kitwe_policy" targetRef="GW_zmb_city_kitwe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_06" sourceRef="T_zmb_city_kitwe_budget" targetRef="GW_zmb_city_kitwe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_07" sourceRef="T_zmb_city_kitwe_coord" targetRef="GW_zmb_city_kitwe_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_08" sourceRef="GW_zmb_city_kitwe_join" targetRef="T_zmb_city_kitwe_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_09" sourceRef="T_zmb_city_kitwe_review" targetRef="GW_zmb_city_kitwe_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_10a" sourceRef="GW_zmb_city_kitwe_risk" targetRef="T_zmb_city_kitwe_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_10b" sourceRef="GW_zmb_city_kitwe_risk" targetRef="T_zmb_city_kitwe_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_11" sourceRef="T_zmb_city_kitwe_publish" targetRef="End_zmb_city_kitwe">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_zmb_city_kitwe_11b" sourceRef="T_zmb_city_kitwe_revise" targetRef="End_zmb_city_kitwe">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_zmb_city_kitwe">
    <bpmndi:BPMNPlane id="BPMNPlane_zmb_city_kitwe" bpmnElement="Collaboration_zmb_city_kitwe" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
