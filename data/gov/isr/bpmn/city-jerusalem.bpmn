<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_isr_city_jerusalem"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_isr_city_jerusalem">
    <bpmn:participant id="Pool_isr_city_jerusalem" name="Jerusalem (city:jer)" processRef="Process_isr_city_jerusalem" />
  </bpmn:collaboration>
  <bpmn:process id="Process_isr_city_jerusalem" name="Jerusalem — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_isr_city_jerusalem" name="Policy trigger
received"><bpmn:outgoing>F_isr_city_jerusalem_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_isr_city_jerusalem_open" name="Parallel checks">
      <bpmn:incoming>F_isr_city_jerusalem_01</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_02</bpmn:outgoing>
      <bpmn:outgoing>F_isr_city_jerusalem_03</bpmn:outgoing>
      <bpmn:outgoing>F_isr_city_jerusalem_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_isr_city_jerusalem_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.isr.city:jerusalem.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_isr_city_jerusalem_02</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_isr_city_jerusalem_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.isr.city:jerusalem.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_isr_city_jerusalem_03</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_isr_city_jerusalem_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.isr.city:jerusalem.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_isr_city_jerusalem_04</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_isr_city_jerusalem_join" name="Checks complete">
      <bpmn:incoming>F_isr_city_jerusalem_05</bpmn:incoming>
      <bpmn:incoming>F_isr_city_jerusalem_06</bpmn:incoming>
      <bpmn:incoming>F_isr_city_jerusalem_07</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_isr_city_jerusalem_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_isr_city_jerusalem_08</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_isr_city_jerusalem_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_isr_city_jerusalem_09</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_10a</bpmn:outgoing>
      <bpmn:outgoing>F_isr_city_jerusalem_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_isr_city_jerusalem_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.isr.city:jerusalem.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_isr_city_jerusalem_10a</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_isr_city_jerusalem_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.isr.city:jerusalem.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_isr_city_jerusalem_10b</bpmn:incoming>
      <bpmn:outgoing>F_isr_city_jerusalem_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_isr_city_jerusalem" name="Process complete">
      <bpmn:incoming>F_isr_city_jerusalem_11</bpmn:incoming>
      <bpmn:incoming>F_isr_city_jerusalem_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_01" sourceRef="Start_isr_city_jerusalem" targetRef="GW_isr_city_jerusalem_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_02" sourceRef="GW_isr_city_jerusalem_open" targetRef="T_isr_city_jerusalem_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_03" sourceRef="GW_isr_city_jerusalem_open" targetRef="T_isr_city_jerusalem_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_04" sourceRef="GW_isr_city_jerusalem_open" targetRef="T_isr_city_jerusalem_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_05" sourceRef="T_isr_city_jerusalem_policy" targetRef="GW_isr_city_jerusalem_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_06" sourceRef="T_isr_city_jerusalem_budget" targetRef="GW_isr_city_jerusalem_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_07" sourceRef="T_isr_city_jerusalem_coord" targetRef="GW_isr_city_jerusalem_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_08" sourceRef="GW_isr_city_jerusalem_join" targetRef="T_isr_city_jerusalem_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_09" sourceRef="T_isr_city_jerusalem_review" targetRef="GW_isr_city_jerusalem_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_10a" sourceRef="GW_isr_city_jerusalem_risk" targetRef="T_isr_city_jerusalem_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_10b" sourceRef="GW_isr_city_jerusalem_risk" targetRef="T_isr_city_jerusalem_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_11" sourceRef="T_isr_city_jerusalem_publish" targetRef="End_isr_city_jerusalem">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_isr_city_jerusalem_11b" sourceRef="T_isr_city_jerusalem_revise" targetRef="End_isr_city_jerusalem">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_isr_city_jerusalem">
    <bpmndi:BPMNPlane id="BPMNPlane_isr_city_jerusalem" bpmnElement="Collaboration_isr_city_jerusalem" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
