<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bfa_city_ouagadougou"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bfa_city_ouagadougou">
    <bpmn:participant id="Pool_bfa_city_ouagadougou" name="Ouagadougou (city:oua)" processRef="Process_bfa_city_ouagadougou" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bfa_city_ouagadougou" name="Ouagadougou — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bfa_city_ouagadougou" name="Policy trigger
received"><bpmn:outgoing>F_bfa_city_ouagadougou_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bfa_city_ouagadougou_open" name="Parallel checks">
      <bpmn:incoming>F_bfa_city_ouagadougou_01</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_02</bpmn:outgoing>
      <bpmn:outgoing>F_bfa_city_ouagadougou_03</bpmn:outgoing>
      <bpmn:outgoing>F_bfa_city_ouagadougou_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bfa_city_ouagadougou_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bfa.city:ouagadougou.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bfa_city_ouagadougou_02</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bfa_city_ouagadougou_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bfa.city:ouagadougou.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bfa_city_ouagadougou_03</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bfa_city_ouagadougou_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bfa.city:ouagadougou.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bfa_city_ouagadougou_04</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bfa_city_ouagadougou_join" name="Checks complete">
      <bpmn:incoming>F_bfa_city_ouagadougou_05</bpmn:incoming>
      <bpmn:incoming>F_bfa_city_ouagadougou_06</bpmn:incoming>
      <bpmn:incoming>F_bfa_city_ouagadougou_07</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bfa_city_ouagadougou_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bfa_city_ouagadougou_08</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bfa_city_ouagadougou_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bfa_city_ouagadougou_09</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bfa_city_ouagadougou_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bfa_city_ouagadougou_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bfa.city:ouagadougou.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bfa_city_ouagadougou_10a</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bfa_city_ouagadougou_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bfa.city:ouagadougou.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bfa_city_ouagadougou_10b</bpmn:incoming>
      <bpmn:outgoing>F_bfa_city_ouagadougou_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bfa_city_ouagadougou" name="Process complete">
      <bpmn:incoming>F_bfa_city_ouagadougou_11</bpmn:incoming>
      <bpmn:incoming>F_bfa_city_ouagadougou_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_01" sourceRef="Start_bfa_city_ouagadougou" targetRef="GW_bfa_city_ouagadougou_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_02" sourceRef="GW_bfa_city_ouagadougou_open" targetRef="T_bfa_city_ouagadougou_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_03" sourceRef="GW_bfa_city_ouagadougou_open" targetRef="T_bfa_city_ouagadougou_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_04" sourceRef="GW_bfa_city_ouagadougou_open" targetRef="T_bfa_city_ouagadougou_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_05" sourceRef="T_bfa_city_ouagadougou_policy" targetRef="GW_bfa_city_ouagadougou_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_06" sourceRef="T_bfa_city_ouagadougou_budget" targetRef="GW_bfa_city_ouagadougou_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_07" sourceRef="T_bfa_city_ouagadougou_coord" targetRef="GW_bfa_city_ouagadougou_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_08" sourceRef="GW_bfa_city_ouagadougou_join" targetRef="T_bfa_city_ouagadougou_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_09" sourceRef="T_bfa_city_ouagadougou_review" targetRef="GW_bfa_city_ouagadougou_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_10a" sourceRef="GW_bfa_city_ouagadougou_risk" targetRef="T_bfa_city_ouagadougou_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_10b" sourceRef="GW_bfa_city_ouagadougou_risk" targetRef="T_bfa_city_ouagadougou_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_11" sourceRef="T_bfa_city_ouagadougou_publish" targetRef="End_bfa_city_ouagadougou">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bfa_city_ouagadougou_11b" sourceRef="T_bfa_city_ouagadougou_revise" targetRef="End_bfa_city_ouagadougou">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bfa_city_ouagadougou">
    <bpmndi:BPMNPlane id="BPMNPlane_bfa_city_ouagadougou" bpmnElement="Collaboration_bfa_city_ouagadougou" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
