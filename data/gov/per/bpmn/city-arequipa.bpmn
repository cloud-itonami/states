<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_per_city_arequipa"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_per_city_arequipa">
    <bpmn:participant id="Pool_per_city_arequipa" name="Arequipa (city:are)" processRef="Process_per_city_arequipa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_per_city_arequipa" name="Arequipa — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_per_city_arequipa" name="Policy trigger
received"><bpmn:outgoing>F_per_city_arequipa_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_per_city_arequipa_open" name="Parallel checks">
      <bpmn:incoming>F_per_city_arequipa_01</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_02</bpmn:outgoing>
      <bpmn:outgoing>F_per_city_arequipa_03</bpmn:outgoing>
      <bpmn:outgoing>F_per_city_arequipa_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_per_city_arequipa_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:arequipa.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_arequipa_02</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_per_city_arequipa_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:arequipa.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_arequipa_03</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_per_city_arequipa_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:arequipa.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_arequipa_04</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_per_city_arequipa_join" name="Checks complete">
      <bpmn:incoming>F_per_city_arequipa_05</bpmn:incoming>
      <bpmn:incoming>F_per_city_arequipa_06</bpmn:incoming>
      <bpmn:incoming>F_per_city_arequipa_07</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_per_city_arequipa_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_arequipa_08</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_per_city_arequipa_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_per_city_arequipa_09</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_10a</bpmn:outgoing>
      <bpmn:outgoing>F_per_city_arequipa_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_per_city_arequipa_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:arequipa.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_arequipa_10a</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_per_city_arequipa_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:arequipa.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_arequipa_10b</bpmn:incoming>
      <bpmn:outgoing>F_per_city_arequipa_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_per_city_arequipa" name="Process complete">
      <bpmn:incoming>F_per_city_arequipa_11</bpmn:incoming>
      <bpmn:incoming>F_per_city_arequipa_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_per_city_arequipa_01" sourceRef="Start_per_city_arequipa" targetRef="GW_per_city_arequipa_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_02" sourceRef="GW_per_city_arequipa_open" targetRef="T_per_city_arequipa_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_03" sourceRef="GW_per_city_arequipa_open" targetRef="T_per_city_arequipa_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_04" sourceRef="GW_per_city_arequipa_open" targetRef="T_per_city_arequipa_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_05" sourceRef="T_per_city_arequipa_policy" targetRef="GW_per_city_arequipa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_06" sourceRef="T_per_city_arequipa_budget" targetRef="GW_per_city_arequipa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_07" sourceRef="T_per_city_arequipa_coord" targetRef="GW_per_city_arequipa_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_08" sourceRef="GW_per_city_arequipa_join" targetRef="T_per_city_arequipa_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_09" sourceRef="T_per_city_arequipa_review" targetRef="GW_per_city_arequipa_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_10a" sourceRef="GW_per_city_arequipa_risk" targetRef="T_per_city_arequipa_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_10b" sourceRef="GW_per_city_arequipa_risk" targetRef="T_per_city_arequipa_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_11" sourceRef="T_per_city_arequipa_publish" targetRef="End_per_city_arequipa">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_arequipa_11b" sourceRef="T_per_city_arequipa_revise" targetRef="End_per_city_arequipa">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_per_city_arequipa">
    <bpmndi:BPMNPlane id="BPMNPlane_per_city_arequipa" bpmnElement="Collaboration_per_city_arequipa" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
