<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_per_city_lima"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_per_city_lima">
    <bpmn:participant id="Pool_per_city_lima" name="Lima (city:lim)" processRef="Process_per_city_lima" />
  </bpmn:collaboration>
  <bpmn:process id="Process_per_city_lima" name="Lima — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_per_city_lima" name="Policy trigger
received"><bpmn:outgoing>F_per_city_lima_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_per_city_lima_open" name="Parallel checks">
      <bpmn:incoming>F_per_city_lima_01</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_02</bpmn:outgoing>
      <bpmn:outgoing>F_per_city_lima_03</bpmn:outgoing>
      <bpmn:outgoing>F_per_city_lima_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_per_city_lima_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:lima.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_lima_02</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_per_city_lima_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:lima.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_lima_03</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_per_city_lima_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:lima.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_lima_04</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_per_city_lima_join" name="Checks complete">
      <bpmn:incoming>F_per_city_lima_05</bpmn:incoming>
      <bpmn:incoming>F_per_city_lima_06</bpmn:incoming>
      <bpmn:incoming>F_per_city_lima_07</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_per_city_lima_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_lima_08</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_per_city_lima_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_per_city_lima_09</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_10a</bpmn:outgoing>
      <bpmn:outgoing>F_per_city_lima_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_per_city_lima_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:lima.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_lima_10a</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_per_city_lima_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.per.city:lima.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_per_city_lima_10b</bpmn:incoming>
      <bpmn:outgoing>F_per_city_lima_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_per_city_lima" name="Process complete">
      <bpmn:incoming>F_per_city_lima_11</bpmn:incoming>
      <bpmn:incoming>F_per_city_lima_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_per_city_lima_01" sourceRef="Start_per_city_lima" targetRef="GW_per_city_lima_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_02" sourceRef="GW_per_city_lima_open" targetRef="T_per_city_lima_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_03" sourceRef="GW_per_city_lima_open" targetRef="T_per_city_lima_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_04" sourceRef="GW_per_city_lima_open" targetRef="T_per_city_lima_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_05" sourceRef="T_per_city_lima_policy" targetRef="GW_per_city_lima_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_06" sourceRef="T_per_city_lima_budget" targetRef="GW_per_city_lima_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_07" sourceRef="T_per_city_lima_coord" targetRef="GW_per_city_lima_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_08" sourceRef="GW_per_city_lima_join" targetRef="T_per_city_lima_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_09" sourceRef="T_per_city_lima_review" targetRef="GW_per_city_lima_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_10a" sourceRef="GW_per_city_lima_risk" targetRef="T_per_city_lima_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_10b" sourceRef="GW_per_city_lima_risk" targetRef="T_per_city_lima_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_11" sourceRef="T_per_city_lima_publish" targetRef="End_per_city_lima">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_per_city_lima_11b" sourceRef="T_per_city_lima_revise" targetRef="End_per_city_lima">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_per_city_lima">
    <bpmndi:BPMNPlane id="BPMNPlane_per_city_lima" bpmnElement="Collaboration_per_city_lima" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
