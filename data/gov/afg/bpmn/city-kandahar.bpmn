<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_afg_city_kandahar"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_afg_city_kandahar">
    <bpmn:participant id="Pool_afg_city_kandahar" name="Kandahar (city:kan)" processRef="Process_afg_city_kandahar" />
  </bpmn:collaboration>
  <bpmn:process id="Process_afg_city_kandahar" name="Kandahar — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_afg_city_kandahar" name="Policy trigger
received"><bpmn:outgoing>F_afg_city_kandahar_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_afg_city_kandahar_open" name="Parallel checks">
      <bpmn:incoming>F_afg_city_kandahar_01</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_02</bpmn:outgoing>
      <bpmn:outgoing>F_afg_city_kandahar_03</bpmn:outgoing>
      <bpmn:outgoing>F_afg_city_kandahar_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_afg_city_kandahar_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kandahar.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kandahar_02</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_afg_city_kandahar_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kandahar.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kandahar_03</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_afg_city_kandahar_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kandahar.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kandahar_04</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_afg_city_kandahar_join" name="Checks complete">
      <bpmn:incoming>F_afg_city_kandahar_05</bpmn:incoming>
      <bpmn:incoming>F_afg_city_kandahar_06</bpmn:incoming>
      <bpmn:incoming>F_afg_city_kandahar_07</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_afg_city_kandahar_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kandahar_08</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_afg_city_kandahar_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_afg_city_kandahar_09</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_10a</bpmn:outgoing>
      <bpmn:outgoing>F_afg_city_kandahar_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_afg_city_kandahar_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kandahar.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kandahar_10a</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_afg_city_kandahar_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kandahar.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kandahar_10b</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kandahar_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_afg_city_kandahar" name="Process complete">
      <bpmn:incoming>F_afg_city_kandahar_11</bpmn:incoming>
      <bpmn:incoming>F_afg_city_kandahar_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_01" sourceRef="Start_afg_city_kandahar" targetRef="GW_afg_city_kandahar_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_02" sourceRef="GW_afg_city_kandahar_open" targetRef="T_afg_city_kandahar_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_03" sourceRef="GW_afg_city_kandahar_open" targetRef="T_afg_city_kandahar_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_04" sourceRef="GW_afg_city_kandahar_open" targetRef="T_afg_city_kandahar_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_05" sourceRef="T_afg_city_kandahar_policy" targetRef="GW_afg_city_kandahar_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_06" sourceRef="T_afg_city_kandahar_budget" targetRef="GW_afg_city_kandahar_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_07" sourceRef="T_afg_city_kandahar_coord" targetRef="GW_afg_city_kandahar_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_08" sourceRef="GW_afg_city_kandahar_join" targetRef="T_afg_city_kandahar_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_09" sourceRef="T_afg_city_kandahar_review" targetRef="GW_afg_city_kandahar_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_10a" sourceRef="GW_afg_city_kandahar_risk" targetRef="T_afg_city_kandahar_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_10b" sourceRef="GW_afg_city_kandahar_risk" targetRef="T_afg_city_kandahar_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_11" sourceRef="T_afg_city_kandahar_publish" targetRef="End_afg_city_kandahar">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kandahar_11b" sourceRef="T_afg_city_kandahar_revise" targetRef="End_afg_city_kandahar">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_afg_city_kandahar">
    <bpmndi:BPMNPlane id="BPMNPlane_afg_city_kandahar" bpmnElement="Collaboration_afg_city_kandahar" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
