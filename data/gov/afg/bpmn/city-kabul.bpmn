<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_afg_city_kabul"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_afg_city_kabul">
    <bpmn:participant id="Pool_afg_city_kabul" name="Kabul (city:kab)" processRef="Process_afg_city_kabul" />
  </bpmn:collaboration>
  <bpmn:process id="Process_afg_city_kabul" name="Kabul — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_afg_city_kabul" name="Policy trigger
received"><bpmn:outgoing>F_afg_city_kabul_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_afg_city_kabul_open" name="Parallel checks">
      <bpmn:incoming>F_afg_city_kabul_01</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_02</bpmn:outgoing>
      <bpmn:outgoing>F_afg_city_kabul_03</bpmn:outgoing>
      <bpmn:outgoing>F_afg_city_kabul_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_afg_city_kabul_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kabul.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kabul_02</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_afg_city_kabul_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kabul.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kabul_03</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_afg_city_kabul_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kabul.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kabul_04</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_afg_city_kabul_join" name="Checks complete">
      <bpmn:incoming>F_afg_city_kabul_05</bpmn:incoming>
      <bpmn:incoming>F_afg_city_kabul_06</bpmn:incoming>
      <bpmn:incoming>F_afg_city_kabul_07</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_afg_city_kabul_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kabul_08</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_afg_city_kabul_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_afg_city_kabul_09</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_10a</bpmn:outgoing>
      <bpmn:outgoing>F_afg_city_kabul_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_afg_city_kabul_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kabul.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kabul_10a</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_afg_city_kabul_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.afg.city:kabul.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_afg_city_kabul_10b</bpmn:incoming>
      <bpmn:outgoing>F_afg_city_kabul_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_afg_city_kabul" name="Process complete">
      <bpmn:incoming>F_afg_city_kabul_11</bpmn:incoming>
      <bpmn:incoming>F_afg_city_kabul_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_afg_city_kabul_01" sourceRef="Start_afg_city_kabul" targetRef="GW_afg_city_kabul_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_02" sourceRef="GW_afg_city_kabul_open" targetRef="T_afg_city_kabul_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_03" sourceRef="GW_afg_city_kabul_open" targetRef="T_afg_city_kabul_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_04" sourceRef="GW_afg_city_kabul_open" targetRef="T_afg_city_kabul_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_05" sourceRef="T_afg_city_kabul_policy" targetRef="GW_afg_city_kabul_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_06" sourceRef="T_afg_city_kabul_budget" targetRef="GW_afg_city_kabul_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_07" sourceRef="T_afg_city_kabul_coord" targetRef="GW_afg_city_kabul_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_08" sourceRef="GW_afg_city_kabul_join" targetRef="T_afg_city_kabul_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_09" sourceRef="T_afg_city_kabul_review" targetRef="GW_afg_city_kabul_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_10a" sourceRef="GW_afg_city_kabul_risk" targetRef="T_afg_city_kabul_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_10b" sourceRef="GW_afg_city_kabul_risk" targetRef="T_afg_city_kabul_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_11" sourceRef="T_afg_city_kabul_publish" targetRef="End_afg_city_kabul">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_afg_city_kabul_11b" sourceRef="T_afg_city_kabul_revise" targetRef="End_afg_city_kabul">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_afg_city_kabul">
    <bpmndi:BPMNPlane id="BPMNPlane_afg_city_kabul" bpmnElement="Collaboration_afg_city_kabul" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
