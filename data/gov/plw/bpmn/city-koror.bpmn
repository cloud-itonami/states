<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_plw_city_koror"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_plw_city_koror">
    <bpmn:participant id="Pool_plw_city_koror" name="Koror (city:kor)" processRef="Process_plw_city_koror" />
  </bpmn:collaboration>
  <bpmn:process id="Process_plw_city_koror" name="Koror — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_plw_city_koror" name="Policy trigger
received"><bpmn:outgoing>F_plw_city_koror_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_plw_city_koror_open" name="Parallel checks">
      <bpmn:incoming>F_plw_city_koror_01</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_02</bpmn:outgoing>
      <bpmn:outgoing>F_plw_city_koror_03</bpmn:outgoing>
      <bpmn:outgoing>F_plw_city_koror_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_plw_city_koror_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.plw.city:koror.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_plw_city_koror_02</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_plw_city_koror_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.plw.city:koror.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_plw_city_koror_03</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_plw_city_koror_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.plw.city:koror.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_plw_city_koror_04</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_plw_city_koror_join" name="Checks complete">
      <bpmn:incoming>F_plw_city_koror_05</bpmn:incoming>
      <bpmn:incoming>F_plw_city_koror_06</bpmn:incoming>
      <bpmn:incoming>F_plw_city_koror_07</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_plw_city_koror_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_plw_city_koror_08</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_plw_city_koror_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_plw_city_koror_09</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_10a</bpmn:outgoing>
      <bpmn:outgoing>F_plw_city_koror_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_plw_city_koror_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.plw.city:koror.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_plw_city_koror_10a</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_plw_city_koror_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.plw.city:koror.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_plw_city_koror_10b</bpmn:incoming>
      <bpmn:outgoing>F_plw_city_koror_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_plw_city_koror" name="Process complete">
      <bpmn:incoming>F_plw_city_koror_11</bpmn:incoming>
      <bpmn:incoming>F_plw_city_koror_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_plw_city_koror_01" sourceRef="Start_plw_city_koror" targetRef="GW_plw_city_koror_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_02" sourceRef="GW_plw_city_koror_open" targetRef="T_plw_city_koror_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_03" sourceRef="GW_plw_city_koror_open" targetRef="T_plw_city_koror_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_04" sourceRef="GW_plw_city_koror_open" targetRef="T_plw_city_koror_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_05" sourceRef="T_plw_city_koror_policy" targetRef="GW_plw_city_koror_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_06" sourceRef="T_plw_city_koror_budget" targetRef="GW_plw_city_koror_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_07" sourceRef="T_plw_city_koror_coord" targetRef="GW_plw_city_koror_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_08" sourceRef="GW_plw_city_koror_join" targetRef="T_plw_city_koror_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_09" sourceRef="T_plw_city_koror_review" targetRef="GW_plw_city_koror_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_10a" sourceRef="GW_plw_city_koror_risk" targetRef="T_plw_city_koror_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_10b" sourceRef="GW_plw_city_koror_risk" targetRef="T_plw_city_koror_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_11" sourceRef="T_plw_city_koror_publish" targetRef="End_plw_city_koror">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_plw_city_koror_11b" sourceRef="T_plw_city_koror_revise" targetRef="End_plw_city_koror">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_plw_city_koror">
    <bpmndi:BPMNPlane id="BPMNPlane_plw_city_koror" bpmnElement="Collaboration_plw_city_koror" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
