<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_jam_city_kingston"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_jam_city_kingston">
    <bpmn:participant id="Pool_jam_city_kingston" name="Kingston (city:kin)" processRef="Process_jam_city_kingston" />
  </bpmn:collaboration>
  <bpmn:process id="Process_jam_city_kingston" name="Kingston — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_jam_city_kingston" name="Policy trigger
received"><bpmn:outgoing>F_jam_city_kingston_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_jam_city_kingston_open" name="Parallel checks">
      <bpmn:incoming>F_jam_city_kingston_01</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_02</bpmn:outgoing>
      <bpmn:outgoing>F_jam_city_kingston_03</bpmn:outgoing>
      <bpmn:outgoing>F_jam_city_kingston_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_jam_city_kingston_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jam.city:kingston.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jam_city_kingston_02</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jam_city_kingston_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jam.city:kingston.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jam_city_kingston_03</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jam_city_kingston_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jam.city:kingston.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jam_city_kingston_04</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_jam_city_kingston_join" name="Checks complete">
      <bpmn:incoming>F_jam_city_kingston_05</bpmn:incoming>
      <bpmn:incoming>F_jam_city_kingston_06</bpmn:incoming>
      <bpmn:incoming>F_jam_city_kingston_07</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_jam_city_kingston_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_jam_city_kingston_08</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_jam_city_kingston_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_jam_city_kingston_09</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_10a</bpmn:outgoing>
      <bpmn:outgoing>F_jam_city_kingston_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_jam_city_kingston_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jam.city:kingston.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jam_city_kingston_10a</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_jam_city_kingston_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.jam.city:kingston.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_jam_city_kingston_10b</bpmn:incoming>
      <bpmn:outgoing>F_jam_city_kingston_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_jam_city_kingston" name="Process complete">
      <bpmn:incoming>F_jam_city_kingston_11</bpmn:incoming>
      <bpmn:incoming>F_jam_city_kingston_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_jam_city_kingston_01" sourceRef="Start_jam_city_kingston" targetRef="GW_jam_city_kingston_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_02" sourceRef="GW_jam_city_kingston_open" targetRef="T_jam_city_kingston_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_03" sourceRef="GW_jam_city_kingston_open" targetRef="T_jam_city_kingston_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_04" sourceRef="GW_jam_city_kingston_open" targetRef="T_jam_city_kingston_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_05" sourceRef="T_jam_city_kingston_policy" targetRef="GW_jam_city_kingston_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_06" sourceRef="T_jam_city_kingston_budget" targetRef="GW_jam_city_kingston_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_07" sourceRef="T_jam_city_kingston_coord" targetRef="GW_jam_city_kingston_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_08" sourceRef="GW_jam_city_kingston_join" targetRef="T_jam_city_kingston_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_09" sourceRef="T_jam_city_kingston_review" targetRef="GW_jam_city_kingston_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_10a" sourceRef="GW_jam_city_kingston_risk" targetRef="T_jam_city_kingston_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_10b" sourceRef="GW_jam_city_kingston_risk" targetRef="T_jam_city_kingston_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_11" sourceRef="T_jam_city_kingston_publish" targetRef="End_jam_city_kingston">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_jam_city_kingston_11b" sourceRef="T_jam_city_kingston_revise" targetRef="End_jam_city_kingston">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_jam_city_kingston">
    <bpmndi:BPMNPlane id="BPMNPlane_jam_city_kingston" bpmnElement="Collaboration_jam_city_kingston" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
