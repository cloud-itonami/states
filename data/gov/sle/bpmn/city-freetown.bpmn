<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_sle_city_freetown"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_sle_city_freetown">
    <bpmn:participant id="Pool_sle_city_freetown" name="Freetown (city:fre)" processRef="Process_sle_city_freetown" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sle_city_freetown" name="Freetown — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_sle_city_freetown" name="Policy trigger
received"><bpmn:outgoing>F_sle_city_freetown_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_sle_city_freetown_open" name="Parallel checks">
      <bpmn:incoming>F_sle_city_freetown_01</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_02</bpmn:outgoing>
      <bpmn:outgoing>F_sle_city_freetown_03</bpmn:outgoing>
      <bpmn:outgoing>F_sle_city_freetown_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_sle_city_freetown_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sle.city:freetown.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sle_city_freetown_02</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sle_city_freetown_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sle.city:freetown.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sle_city_freetown_03</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sle_city_freetown_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sle.city:freetown.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sle_city_freetown_04</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_sle_city_freetown_join" name="Checks complete">
      <bpmn:incoming>F_sle_city_freetown_05</bpmn:incoming>
      <bpmn:incoming>F_sle_city_freetown_06</bpmn:incoming>
      <bpmn:incoming>F_sle_city_freetown_07</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_sle_city_freetown_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_sle_city_freetown_08</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_sle_city_freetown_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_sle_city_freetown_09</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_10a</bpmn:outgoing>
      <bpmn:outgoing>F_sle_city_freetown_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_sle_city_freetown_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sle.city:freetown.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sle_city_freetown_10a</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sle_city_freetown_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sle.city:freetown.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sle_city_freetown_10b</bpmn:incoming>
      <bpmn:outgoing>F_sle_city_freetown_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sle_city_freetown" name="Process complete">
      <bpmn:incoming>F_sle_city_freetown_11</bpmn:incoming>
      <bpmn:incoming>F_sle_city_freetown_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_sle_city_freetown_01" sourceRef="Start_sle_city_freetown" targetRef="GW_sle_city_freetown_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_02" sourceRef="GW_sle_city_freetown_open" targetRef="T_sle_city_freetown_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_03" sourceRef="GW_sle_city_freetown_open" targetRef="T_sle_city_freetown_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_04" sourceRef="GW_sle_city_freetown_open" targetRef="T_sle_city_freetown_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_05" sourceRef="T_sle_city_freetown_policy" targetRef="GW_sle_city_freetown_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_06" sourceRef="T_sle_city_freetown_budget" targetRef="GW_sle_city_freetown_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_07" sourceRef="T_sle_city_freetown_coord" targetRef="GW_sle_city_freetown_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_08" sourceRef="GW_sle_city_freetown_join" targetRef="T_sle_city_freetown_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_09" sourceRef="T_sle_city_freetown_review" targetRef="GW_sle_city_freetown_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_10a" sourceRef="GW_sle_city_freetown_risk" targetRef="T_sle_city_freetown_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_10b" sourceRef="GW_sle_city_freetown_risk" targetRef="T_sle_city_freetown_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_11" sourceRef="T_sle_city_freetown_publish" targetRef="End_sle_city_freetown">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sle_city_freetown_11b" sourceRef="T_sle_city_freetown_revise" targetRef="End_sle_city_freetown">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sle_city_freetown">
    <bpmndi:BPMNPlane id="BPMNPlane_sle_city_freetown" bpmnElement="Collaboration_sle_city_freetown" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
