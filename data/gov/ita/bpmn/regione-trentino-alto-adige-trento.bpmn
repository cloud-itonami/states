    <bpmn:serviceTask id="T_ita_regione_trentino_alto_adige_trento_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:trentino-alto-adige:trento.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_10a</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_trentino_alto_adige_trento_revise" name="Return for
