  <bpmn:collaboration id="Collaboration_ita_regione_trentino_alto_adige_trento">
    <bpmn:participant id="Pool_ita_regione_trentino_alto_adige_trento" name="Trento (regione:)" processRef="Process_ita_regione_trentino_alto_adige_trento" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ita_regione_trentino_alto_adige_trento" name="Trento — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ita_regione_trentino_alto_adige_trento" name="Policy trigger
received"><bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ita_regione_trentino_alto_adige_trento_open" name="Parallel checks">
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_01</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_02</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_03</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ita_regione_trentino_alto_adige_trento_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:trentino-alto-adige:trento.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_02</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_trentino_alto_adige_trento_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:trentino-alto-adige:trento.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_03</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_trentino_alto_adige_trento_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:trentino-alto-adige:trento.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_04</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ita_regione_trentino_alto_adige_trento_join" name="Checks complete">
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_05</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_06</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_07</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ita_regione_trentino_alto_adige_trento_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_08</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ita_regione_trentino_alto_adige_trento_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_09</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_10b</bpmn:outgoing>
