      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:trentino-alto-adige:trento.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
