      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_10b</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_trentino_alto_adige_trento_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ita_regione_trentino_alto_adige_trento" name="Process complete">
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_11</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_trentino_alto_adige_trento_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_01" sourceRef="Start_ita_regione_trentino_alto_adige_trento" targetRef="GW_ita_regione_trentino_alto_adige_trento_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_02" sourceRef="GW_ita_regione_trentino_alto_adige_trento_open" targetRef="T_ita_regione_trentino_alto_adige_trento_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_03" sourceRef="GW_ita_regione_trentino_alto_adige_trento_open" targetRef="T_ita_regione_trentino_alto_adige_trento_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_04" sourceRef="GW_ita_regione_trentino_alto_adige_trento_open" targetRef="T_ita_regione_trentino_alto_adige_trento_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_05" sourceRef="T_ita_regione_trentino_alto_adige_trento_policy" targetRef="GW_ita_regione_trentino_alto_adige_trento_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_06" sourceRef="T_ita_regione_trentino_alto_adige_trento_budget" targetRef="GW_ita_regione_trentino_alto_adige_trento_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_07" sourceRef="T_ita_regione_trentino_alto_adige_trento_coord" targetRef="GW_ita_regione_trentino_alto_adige_trento_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_08" sourceRef="GW_ita_regione_trentino_alto_adige_trento_join" targetRef="T_ita_regione_trentino_alto_adige_trento_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_09" sourceRef="T_ita_regione_trentino_alto_adige_trento_review" targetRef="GW_ita_regione_trentino_alto_adige_trento_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_10a" sourceRef="GW_ita_regione_trentino_alto_adige_trento_risk" targetRef="T_ita_regione_trentino_alto_adige_trento_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_10b" sourceRef="GW_ita_regione_trentino_alto_adige_trento_risk" targetRef="T_ita_regione_trentino_alto_adige_trento_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_11" sourceRef="T_ita_regione_trentino_alto_adige_trento_publish" targetRef="End_ita_regione_trentino_alto_adige_trento">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_trentino_alto_adige_trento_11b" sourceRef="T_ita_regione_trentino_alto_adige_trento_revise" targetRef="End_ita_regione_trentino_alto_adige_trento">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ita_regione_trentino_alto_adige_trento">
    <bpmndi:BPMNPlane id="BPMNPlane_ita_regione_trentino_alto_adige_trento" bpmnElement="Collaboration_ita_regione_trentino_alto_adige_trento" />
  </bpmndi:BPMNDiagram>
