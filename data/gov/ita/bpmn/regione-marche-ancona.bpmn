<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ita_regione_marche_ancona"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ita_regione_marche_ancona">
    <bpmn:participant id="Pool_ita_regione_marche_ancona" name="Ancona (regione:)" processRef="Process_ita_regione_marche_ancona" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ita_regione_marche_ancona" name="Ancona — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ita_regione_marche_ancona" name="Policy trigger
received"><bpmn:outgoing>F_ita_regione_marche_ancona_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ita_regione_marche_ancona_open" name="Parallel checks">
      <bpmn:incoming>F_ita_regione_marche_ancona_01</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_02</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_marche_ancona_03</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_marche_ancona_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ita_regione_marche_ancona_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:marche:ancona.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_marche_ancona_02</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_marche_ancona_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:marche:ancona.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_marche_ancona_03</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_marche_ancona_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:marche:ancona.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_marche_ancona_04</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ita_regione_marche_ancona_join" name="Checks complete">
      <bpmn:incoming>F_ita_regione_marche_ancona_05</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_marche_ancona_06</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_marche_ancona_07</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ita_regione_marche_ancona_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_marche_ancona_08</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ita_regione_marche_ancona_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ita_regione_marche_ancona_09</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_marche_ancona_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ita_regione_marche_ancona_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:marche:ancona.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_marche_ancona_10a</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_marche_ancona_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:marche:ancona.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_marche_ancona_10b</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_marche_ancona_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ita_regione_marche_ancona" name="Process complete">
      <bpmn:incoming>F_ita_regione_marche_ancona_11</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_marche_ancona_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_01" sourceRef="Start_ita_regione_marche_ancona" targetRef="GW_ita_regione_marche_ancona_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_02" sourceRef="GW_ita_regione_marche_ancona_open" targetRef="T_ita_regione_marche_ancona_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_03" sourceRef="GW_ita_regione_marche_ancona_open" targetRef="T_ita_regione_marche_ancona_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_04" sourceRef="GW_ita_regione_marche_ancona_open" targetRef="T_ita_regione_marche_ancona_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_05" sourceRef="T_ita_regione_marche_ancona_policy" targetRef="GW_ita_regione_marche_ancona_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_06" sourceRef="T_ita_regione_marche_ancona_budget" targetRef="GW_ita_regione_marche_ancona_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_07" sourceRef="T_ita_regione_marche_ancona_coord" targetRef="GW_ita_regione_marche_ancona_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_08" sourceRef="GW_ita_regione_marche_ancona_join" targetRef="T_ita_regione_marche_ancona_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_09" sourceRef="T_ita_regione_marche_ancona_review" targetRef="GW_ita_regione_marche_ancona_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_10a" sourceRef="GW_ita_regione_marche_ancona_risk" targetRef="T_ita_regione_marche_ancona_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_10b" sourceRef="GW_ita_regione_marche_ancona_risk" targetRef="T_ita_regione_marche_ancona_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_11" sourceRef="T_ita_regione_marche_ancona_publish" targetRef="End_ita_regione_marche_ancona">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_marche_ancona_11b" sourceRef="T_ita_regione_marche_ancona_revise" targetRef="End_ita_regione_marche_ancona">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ita_regione_marche_ancona">
    <bpmndi:BPMNPlane id="BPMNPlane_ita_regione_marche_ancona" bpmnElement="Collaboration_ita_regione_marche_ancona" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
