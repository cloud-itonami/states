<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ita_regione_calabria_catanzaro"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ita_regione_calabria_catanzaro">
    <bpmn:participant id="Pool_ita_regione_calabria_catanzaro" name="Catanzaro (regione:)" processRef="Process_ita_regione_calabria_catanzaro" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ita_regione_calabria_catanzaro" name="Catanzaro — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ita_regione_calabria_catanzaro" name="Policy trigger
received"><bpmn:outgoing>F_ita_regione_calabria_catanzaro_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ita_regione_calabria_catanzaro_open" name="Parallel checks">
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_01</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_02</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_03</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ita_regione_calabria_catanzaro_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:calabria:catanzaro.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_02</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_calabria_catanzaro_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:calabria:catanzaro.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_03</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_calabria_catanzaro_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:calabria:catanzaro.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_04</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ita_regione_calabria_catanzaro_join" name="Checks complete">
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_05</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_06</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_07</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ita_regione_calabria_catanzaro_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_08</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ita_regione_calabria_catanzaro_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_09</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ita_regione_calabria_catanzaro_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:calabria:catanzaro.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_10a</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ita_regione_calabria_catanzaro_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ita.regione:calabria:catanzaro.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_10b</bpmn:incoming>
      <bpmn:outgoing>F_ita_regione_calabria_catanzaro_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ita_regione_calabria_catanzaro" name="Process complete">
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_11</bpmn:incoming>
      <bpmn:incoming>F_ita_regione_calabria_catanzaro_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_01" sourceRef="Start_ita_regione_calabria_catanzaro" targetRef="GW_ita_regione_calabria_catanzaro_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_02" sourceRef="GW_ita_regione_calabria_catanzaro_open" targetRef="T_ita_regione_calabria_catanzaro_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_03" sourceRef="GW_ita_regione_calabria_catanzaro_open" targetRef="T_ita_regione_calabria_catanzaro_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_04" sourceRef="GW_ita_regione_calabria_catanzaro_open" targetRef="T_ita_regione_calabria_catanzaro_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_05" sourceRef="T_ita_regione_calabria_catanzaro_policy" targetRef="GW_ita_regione_calabria_catanzaro_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_06" sourceRef="T_ita_regione_calabria_catanzaro_budget" targetRef="GW_ita_regione_calabria_catanzaro_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_07" sourceRef="T_ita_regione_calabria_catanzaro_coord" targetRef="GW_ita_regione_calabria_catanzaro_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_08" sourceRef="GW_ita_regione_calabria_catanzaro_join" targetRef="T_ita_regione_calabria_catanzaro_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_09" sourceRef="T_ita_regione_calabria_catanzaro_review" targetRef="GW_ita_regione_calabria_catanzaro_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_10a" sourceRef="GW_ita_regione_calabria_catanzaro_risk" targetRef="T_ita_regione_calabria_catanzaro_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_10b" sourceRef="GW_ita_regione_calabria_catanzaro_risk" targetRef="T_ita_regione_calabria_catanzaro_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_11" sourceRef="T_ita_regione_calabria_catanzaro_publish" targetRef="End_ita_regione_calabria_catanzaro">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ita_regione_calabria_catanzaro_11b" sourceRef="T_ita_regione_calabria_catanzaro_revise" targetRef="End_ita_regione_calabria_catanzaro">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ita_regione_calabria_catanzaro">
    <bpmndi:BPMNPlane id="BPMNPlane_ita_regione_calabria_catanzaro" bpmnElement="Collaboration_ita_regione_calabria_catanzaro" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
