<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_esp_digital"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_esp_digital">
    <bpmn:participant id="Pool_esp_digital" name="Digital (e1s2d3i4)" processRef="Process_esp_digital" />
  </bpmn:collaboration>
  <bpmn:process id="Process_esp_digital" name="Digital — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_esp_digital" name="Policy trigger
received"><bpmn:outgoing>F_esp_digital_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_esp_digital_open" name="Parallel checks">
      <bpmn:incoming>F_esp_digital_01</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_02</bpmn:outgoing>
      <bpmn:outgoing>F_esp_digital_03</bpmn:outgoing>
      <bpmn:outgoing>F_esp_digital_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_esp_digital_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.esp.digital.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_esp_digital_02</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_esp_digital_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.esp.digital.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_esp_digital_03</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_esp_digital_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.esp.digital.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_esp_digital_04</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_esp_digital_join" name="Checks complete">
      <bpmn:incoming>F_esp_digital_05</bpmn:incoming>
      <bpmn:incoming>F_esp_digital_06</bpmn:incoming>
      <bpmn:incoming>F_esp_digital_07</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_esp_digital_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_esp_digital_08</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_esp_digital_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_esp_digital_09</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_10a</bpmn:outgoing>
      <bpmn:outgoing>F_esp_digital_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_esp_digital_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.esp.digital.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_esp_digital_10a</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_esp_digital_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.esp.digital.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_esp_digital_10b</bpmn:incoming>
      <bpmn:outgoing>F_esp_digital_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_esp_digital" name="Process complete">
      <bpmn:incoming>F_esp_digital_11</bpmn:incoming>
      <bpmn:incoming>F_esp_digital_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_esp_digital_01" sourceRef="Start_esp_digital" targetRef="GW_esp_digital_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_02" sourceRef="GW_esp_digital_open" targetRef="T_esp_digital_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_03" sourceRef="GW_esp_digital_open" targetRef="T_esp_digital_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_04" sourceRef="GW_esp_digital_open" targetRef="T_esp_digital_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_05" sourceRef="T_esp_digital_policy" targetRef="GW_esp_digital_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_06" sourceRef="T_esp_digital_budget" targetRef="GW_esp_digital_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_07" sourceRef="T_esp_digital_coord" targetRef="GW_esp_digital_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_08" sourceRef="GW_esp_digital_join" targetRef="T_esp_digital_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_09" sourceRef="T_esp_digital_review" targetRef="GW_esp_digital_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_10a" sourceRef="GW_esp_digital_risk" targetRef="T_esp_digital_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_10b" sourceRef="GW_esp_digital_risk" targetRef="T_esp_digital_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_11" sourceRef="T_esp_digital_publish" targetRef="End_esp_digital">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_esp_digital_11b" sourceRef="T_esp_digital_revise" targetRef="End_esp_digital">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_esp_digital">
    <bpmndi:BPMNPlane id="BPMNPlane_esp_digital" bpmnElement="Collaboration_esp_digital" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
