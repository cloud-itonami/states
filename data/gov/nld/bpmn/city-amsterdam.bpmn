<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_nld_city_amsterdam"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_nld_city_amsterdam">
    <bpmn:participant id="Pool_nld_city_amsterdam" name="Amsterdam (city:ams)" processRef="Process_nld_city_amsterdam" />
  </bpmn:collaboration>
  <bpmn:process id="Process_nld_city_amsterdam" name="Amsterdam — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_nld_city_amsterdam" name="Policy trigger
received"><bpmn:outgoing>F_nld_city_amsterdam_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_nld_city_amsterdam_open" name="Parallel checks">
      <bpmn:incoming>F_nld_city_amsterdam_01</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_02</bpmn:outgoing>
      <bpmn:outgoing>F_nld_city_amsterdam_03</bpmn:outgoing>
      <bpmn:outgoing>F_nld_city_amsterdam_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_nld_city_amsterdam_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.city:amsterdam.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_city_amsterdam_02</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nld_city_amsterdam_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.city:amsterdam.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_city_amsterdam_03</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nld_city_amsterdam_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.city:amsterdam.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_city_amsterdam_04</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_nld_city_amsterdam_join" name="Checks complete">
      <bpmn:incoming>F_nld_city_amsterdam_05</bpmn:incoming>
      <bpmn:incoming>F_nld_city_amsterdam_06</bpmn:incoming>
      <bpmn:incoming>F_nld_city_amsterdam_07</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_nld_city_amsterdam_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_city_amsterdam_08</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_nld_city_amsterdam_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_nld_city_amsterdam_09</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_10a</bpmn:outgoing>
      <bpmn:outgoing>F_nld_city_amsterdam_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_nld_city_amsterdam_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.city:amsterdam.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_city_amsterdam_10a</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nld_city_amsterdam_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.city:amsterdam.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_city_amsterdam_10b</bpmn:incoming>
      <bpmn:outgoing>F_nld_city_amsterdam_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_nld_city_amsterdam" name="Process complete">
      <bpmn:incoming>F_nld_city_amsterdam_11</bpmn:incoming>
      <bpmn:incoming>F_nld_city_amsterdam_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_01" sourceRef="Start_nld_city_amsterdam" targetRef="GW_nld_city_amsterdam_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_02" sourceRef="GW_nld_city_amsterdam_open" targetRef="T_nld_city_amsterdam_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_03" sourceRef="GW_nld_city_amsterdam_open" targetRef="T_nld_city_amsterdam_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_04" sourceRef="GW_nld_city_amsterdam_open" targetRef="T_nld_city_amsterdam_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_05" sourceRef="T_nld_city_amsterdam_policy" targetRef="GW_nld_city_amsterdam_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_06" sourceRef="T_nld_city_amsterdam_budget" targetRef="GW_nld_city_amsterdam_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_07" sourceRef="T_nld_city_amsterdam_coord" targetRef="GW_nld_city_amsterdam_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_08" sourceRef="GW_nld_city_amsterdam_join" targetRef="T_nld_city_amsterdam_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_09" sourceRef="T_nld_city_amsterdam_review" targetRef="GW_nld_city_amsterdam_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_10a" sourceRef="GW_nld_city_amsterdam_risk" targetRef="T_nld_city_amsterdam_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_10b" sourceRef="GW_nld_city_amsterdam_risk" targetRef="T_nld_city_amsterdam_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_11" sourceRef="T_nld_city_amsterdam_publish" targetRef="End_nld_city_amsterdam">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_city_amsterdam_11b" sourceRef="T_nld_city_amsterdam_revise" targetRef="End_nld_city_amsterdam">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_nld_city_amsterdam">
    <bpmndi:BPMNPlane id="BPMNPlane_nld_city_amsterdam" bpmnElement="Collaboration_nld_city_amsterdam" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
