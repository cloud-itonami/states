    <bpmn:endEvent id="End_nld_legislative_tweede_kamer" name="Process complete">
      <bpmn:incoming>F_nld_legislative_tweede_kamer_11</bpmn:incoming>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_01" sourceRef="Start_nld_legislative_tweede_kamer" targetRef="GW_nld_legislative_tweede_kamer_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_02" sourceRef="GW_nld_legislative_tweede_kamer_open" targetRef="T_nld_legislative_tweede_kamer_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_03" sourceRef="GW_nld_legislative_tweede_kamer_open" targetRef="T_nld_legislative_tweede_kamer_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_04" sourceRef="GW_nld_legislative_tweede_kamer_open" targetRef="T_nld_legislative_tweede_kamer_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_05" sourceRef="T_nld_legislative_tweede_kamer_policy" targetRef="GW_nld_legislative_tweede_kamer_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_06" sourceRef="T_nld_legislative_tweede_kamer_budget" targetRef="GW_nld_legislative_tweede_kamer_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_07" sourceRef="T_nld_legislative_tweede_kamer_coord" targetRef="GW_nld_legislative_tweede_kamer_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_08" sourceRef="GW_nld_legislative_tweede_kamer_join" targetRef="T_nld_legislative_tweede_kamer_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_09" sourceRef="T_nld_legislative_tweede_kamer_review" targetRef="GW_nld_legislative_tweede_kamer_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_10a" sourceRef="GW_nld_legislative_tweede_kamer_risk" targetRef="T_nld_legislative_tweede_kamer_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_10b" sourceRef="GW_nld_legislative_tweede_kamer_risk" targetRef="T_nld_legislative_tweede_kamer_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_11" sourceRef="T_nld_legislative_tweede_kamer_publish" targetRef="End_nld_legislative_tweede_kamer">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_nld_legislative_tweede_kamer_11b" sourceRef="T_nld_legislative_tweede_kamer_revise" targetRef="End_nld_legislative_tweede_kamer">
    </bpmn:sequenceFlow>
