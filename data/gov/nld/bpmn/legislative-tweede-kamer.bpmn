      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.legislative-tweede-kamer.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
