      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.legislative-tweede-kamer.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_04</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_nld_legislative_tweede_kamer_join" name="Checks complete">
      <bpmn:incoming>F_nld_legislative_tweede_kamer_05</bpmn:incoming>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_06</bpmn:incoming>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_07</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_nld_legislative_tweede_kamer_review" name="Minister Review
