      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_08</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_nld_legislative_tweede_kamer_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_nld_legislative_tweede_kamer_09</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_10a</bpmn:outgoing>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_nld_legislative_tweede_kamer_publish" name="Publish Policy
