  <bpmn:collaboration id="Collaboration_nld_legislative_tweede_kamer">
    <bpmn:participant id="Pool_nld_legislative_tweede_kamer" name="Legislative Tweede Kamer (6jg6myjb)" processRef="Process_nld_legislative_tweede_kamer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_nld_legislative_tweede_kamer" name="Legislative Tweede Kamer — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_nld_legislative_tweede_kamer" name="Policy trigger
received"><bpmn:outgoing>F_nld_legislative_tweede_kamer_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_nld_legislative_tweede_kamer_open" name="Parallel checks">
      <bpmn:incoming>F_nld_legislative_tweede_kamer_01</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_02</bpmn:outgoing>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_03</bpmn:outgoing>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_nld_legislative_tweede_kamer_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.legislative-tweede-kamer.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_02</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nld_legislative_tweede_kamer_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.nld.legislative-tweede-kamer.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_03</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_nld_legislative_tweede_kamer_coord" name="Inter-Agency
