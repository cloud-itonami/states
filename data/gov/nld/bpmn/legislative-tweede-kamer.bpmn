        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_nld_legislative_tweede_kamer_10a</bpmn:incoming>
      <bpmn:outgoing>F_nld_legislative_tweede_kamer_11</bpmn:outgoing>
