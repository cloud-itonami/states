<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_gbr_nation_scotland_edinburgh"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_gbr_nation_scotland_edinburgh">
    <bpmn:participant id="Pool_gbr_nation_scotland_edinburgh" name="Edinburgh (nation:s)" processRef="Process_gbr_nation_scotland_edinburgh" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gbr_nation_scotland_edinburgh" name="Edinburgh — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_gbr_nation_scotland_edinburgh" name="Policy trigger
received"><bpmn:outgoing>F_gbr_nation_scotland_edinburgh_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_gbr_nation_scotland_edinburgh_open" name="Parallel checks">
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_01</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_02</bpmn:outgoing>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_03</bpmn:outgoing>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_gbr_nation_scotland_edinburgh_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gbr.nation:scotland:edinburgh.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_02</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gbr_nation_scotland_edinburgh_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gbr.nation:scotland:edinburgh.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_03</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gbr_nation_scotland_edinburgh_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gbr.nation:scotland:edinburgh.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_04</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_gbr_nation_scotland_edinburgh_join" name="Checks complete">
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_05</bpmn:incoming>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_06</bpmn:incoming>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_07</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_gbr_nation_scotland_edinburgh_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_08</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_gbr_nation_scotland_edinburgh_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_09</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_10a</bpmn:outgoing>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_gbr_nation_scotland_edinburgh_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gbr.nation:scotland:edinburgh.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_10a</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gbr_nation_scotland_edinburgh_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gbr.nation:scotland:edinburgh.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_10b</bpmn:incoming>
      <bpmn:outgoing>F_gbr_nation_scotland_edinburgh_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_gbr_nation_scotland_edinburgh" name="Process complete">
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_11</bpmn:incoming>
      <bpmn:incoming>F_gbr_nation_scotland_edinburgh_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_01" sourceRef="Start_gbr_nation_scotland_edinburgh" targetRef="GW_gbr_nation_scotland_edinburgh_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_02" sourceRef="GW_gbr_nation_scotland_edinburgh_open" targetRef="T_gbr_nation_scotland_edinburgh_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_03" sourceRef="GW_gbr_nation_scotland_edinburgh_open" targetRef="T_gbr_nation_scotland_edinburgh_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_04" sourceRef="GW_gbr_nation_scotland_edinburgh_open" targetRef="T_gbr_nation_scotland_edinburgh_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_05" sourceRef="T_gbr_nation_scotland_edinburgh_policy" targetRef="GW_gbr_nation_scotland_edinburgh_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_06" sourceRef="T_gbr_nation_scotland_edinburgh_budget" targetRef="GW_gbr_nation_scotland_edinburgh_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_07" sourceRef="T_gbr_nation_scotland_edinburgh_coord" targetRef="GW_gbr_nation_scotland_edinburgh_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_08" sourceRef="GW_gbr_nation_scotland_edinburgh_join" targetRef="T_gbr_nation_scotland_edinburgh_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_09" sourceRef="T_gbr_nation_scotland_edinburgh_review" targetRef="GW_gbr_nation_scotland_edinburgh_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_10a" sourceRef="GW_gbr_nation_scotland_edinburgh_risk" targetRef="T_gbr_nation_scotland_edinburgh_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_10b" sourceRef="GW_gbr_nation_scotland_edinburgh_risk" targetRef="T_gbr_nation_scotland_edinburgh_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_11" sourceRef="T_gbr_nation_scotland_edinburgh_publish" targetRef="End_gbr_nation_scotland_edinburgh">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gbr_nation_scotland_edinburgh_11b" sourceRef="T_gbr_nation_scotland_edinburgh_revise" targetRef="End_gbr_nation_scotland_edinburgh">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_gbr_nation_scotland_edinburgh">
    <bpmndi:BPMNPlane id="BPMNPlane_gbr_nation_scotland_edinburgh" bpmnElement="Collaboration_gbr_nation_scotland_edinburgh" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
