<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_gnb_city_bissau"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_gnb_city_bissau">
    <bpmn:participant id="Pool_gnb_city_bissau" name="Bissau (city:bis)" processRef="Process_gnb_city_bissau" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gnb_city_bissau" name="Bissau — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_gnb_city_bissau" name="Policy trigger
received"><bpmn:outgoing>F_gnb_city_bissau_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_gnb_city_bissau_open" name="Parallel checks">
      <bpmn:incoming>F_gnb_city_bissau_01</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_02</bpmn:outgoing>
      <bpmn:outgoing>F_gnb_city_bissau_03</bpmn:outgoing>
      <bpmn:outgoing>F_gnb_city_bissau_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_gnb_city_bissau_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gnb.city:bissau.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gnb_city_bissau_02</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gnb_city_bissau_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gnb.city:bissau.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gnb_city_bissau_03</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gnb_city_bissau_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gnb.city:bissau.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gnb_city_bissau_04</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_gnb_city_bissau_join" name="Checks complete">
      <bpmn:incoming>F_gnb_city_bissau_05</bpmn:incoming>
      <bpmn:incoming>F_gnb_city_bissau_06</bpmn:incoming>
      <bpmn:incoming>F_gnb_city_bissau_07</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_gnb_city_bissau_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_gnb_city_bissau_08</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_gnb_city_bissau_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_gnb_city_bissau_09</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_10a</bpmn:outgoing>
      <bpmn:outgoing>F_gnb_city_bissau_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_gnb_city_bissau_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gnb.city:bissau.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gnb_city_bissau_10a</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gnb_city_bissau_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gnb.city:bissau.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gnb_city_bissau_10b</bpmn:incoming>
      <bpmn:outgoing>F_gnb_city_bissau_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_gnb_city_bissau" name="Process complete">
      <bpmn:incoming>F_gnb_city_bissau_11</bpmn:incoming>
      <bpmn:incoming>F_gnb_city_bissau_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_01" sourceRef="Start_gnb_city_bissau" targetRef="GW_gnb_city_bissau_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_02" sourceRef="GW_gnb_city_bissau_open" targetRef="T_gnb_city_bissau_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_03" sourceRef="GW_gnb_city_bissau_open" targetRef="T_gnb_city_bissau_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_04" sourceRef="GW_gnb_city_bissau_open" targetRef="T_gnb_city_bissau_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_05" sourceRef="T_gnb_city_bissau_policy" targetRef="GW_gnb_city_bissau_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_06" sourceRef="T_gnb_city_bissau_budget" targetRef="GW_gnb_city_bissau_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_07" sourceRef="T_gnb_city_bissau_coord" targetRef="GW_gnb_city_bissau_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_08" sourceRef="GW_gnb_city_bissau_join" targetRef="T_gnb_city_bissau_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_09" sourceRef="T_gnb_city_bissau_review" targetRef="GW_gnb_city_bissau_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_10a" sourceRef="GW_gnb_city_bissau_risk" targetRef="T_gnb_city_bissau_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_10b" sourceRef="GW_gnb_city_bissau_risk" targetRef="T_gnb_city_bissau_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_11" sourceRef="T_gnb_city_bissau_publish" targetRef="End_gnb_city_bissau">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gnb_city_bissau_11b" sourceRef="T_gnb_city_bissau_revise" targetRef="End_gnb_city_bissau">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_gnb_city_bissau">
    <bpmndi:BPMNPlane id="BPMNPlane_gnb_city_bissau" bpmnElement="Collaboration_gnb_city_bissau" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
