<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bdi_city_bujumbura"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bdi_city_bujumbura">
    <bpmn:participant id="Pool_bdi_city_bujumbura" name="Bujumbura (city:buj)" processRef="Process_bdi_city_bujumbura" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bdi_city_bujumbura" name="Bujumbura — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bdi_city_bujumbura" name="Policy trigger
received"><bpmn:outgoing>F_bdi_city_bujumbura_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bdi_city_bujumbura_open" name="Parallel checks">
      <bpmn:incoming>F_bdi_city_bujumbura_01</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_02</bpmn:outgoing>
      <bpmn:outgoing>F_bdi_city_bujumbura_03</bpmn:outgoing>
      <bpmn:outgoing>F_bdi_city_bujumbura_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bdi_city_bujumbura_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bdi.city:bujumbura.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bdi_city_bujumbura_02</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bdi_city_bujumbura_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bdi.city:bujumbura.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bdi_city_bujumbura_03</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bdi_city_bujumbura_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bdi.city:bujumbura.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bdi_city_bujumbura_04</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bdi_city_bujumbura_join" name="Checks complete">
      <bpmn:incoming>F_bdi_city_bujumbura_05</bpmn:incoming>
      <bpmn:incoming>F_bdi_city_bujumbura_06</bpmn:incoming>
      <bpmn:incoming>F_bdi_city_bujumbura_07</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bdi_city_bujumbura_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bdi_city_bujumbura_08</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bdi_city_bujumbura_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bdi_city_bujumbura_09</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bdi_city_bujumbura_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bdi_city_bujumbura_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bdi.city:bujumbura.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bdi_city_bujumbura_10a</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bdi_city_bujumbura_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bdi.city:bujumbura.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bdi_city_bujumbura_10b</bpmn:incoming>
      <bpmn:outgoing>F_bdi_city_bujumbura_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bdi_city_bujumbura" name="Process complete">
      <bpmn:incoming>F_bdi_city_bujumbura_11</bpmn:incoming>
      <bpmn:incoming>F_bdi_city_bujumbura_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_01" sourceRef="Start_bdi_city_bujumbura" targetRef="GW_bdi_city_bujumbura_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_02" sourceRef="GW_bdi_city_bujumbura_open" targetRef="T_bdi_city_bujumbura_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_03" sourceRef="GW_bdi_city_bujumbura_open" targetRef="T_bdi_city_bujumbura_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_04" sourceRef="GW_bdi_city_bujumbura_open" targetRef="T_bdi_city_bujumbura_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_05" sourceRef="T_bdi_city_bujumbura_policy" targetRef="GW_bdi_city_bujumbura_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_06" sourceRef="T_bdi_city_bujumbura_budget" targetRef="GW_bdi_city_bujumbura_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_07" sourceRef="T_bdi_city_bujumbura_coord" targetRef="GW_bdi_city_bujumbura_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_08" sourceRef="GW_bdi_city_bujumbura_join" targetRef="T_bdi_city_bujumbura_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_09" sourceRef="T_bdi_city_bujumbura_review" targetRef="GW_bdi_city_bujumbura_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_10a" sourceRef="GW_bdi_city_bujumbura_risk" targetRef="T_bdi_city_bujumbura_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_10b" sourceRef="GW_bdi_city_bujumbura_risk" targetRef="T_bdi_city_bujumbura_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_11" sourceRef="T_bdi_city_bujumbura_publish" targetRef="End_bdi_city_bujumbura">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bdi_city_bujumbura_11b" sourceRef="T_bdi_city_bujumbura_revise" targetRef="End_bdi_city_bujumbura">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bdi_city_bujumbura">
    <bpmndi:BPMNPlane id="BPMNPlane_bdi_city_bujumbura" bpmnElement="Collaboration_bdi_city_bujumbura" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
