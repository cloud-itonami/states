<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pry_city_asuncion"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pry_city_asuncion">
    <bpmn:participant id="Pool_pry_city_asuncion" name="Asuncion (city:asu)" processRef="Process_pry_city_asuncion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pry_city_asuncion" name="Asuncion — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_pry_city_asuncion" name="Policy trigger
received"><bpmn:outgoing>F_pry_city_asuncion_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_pry_city_asuncion_open" name="Parallel checks">
      <bpmn:incoming>F_pry_city_asuncion_01</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_02</bpmn:outgoing>
      <bpmn:outgoing>F_pry_city_asuncion_03</bpmn:outgoing>
      <bpmn:outgoing>F_pry_city_asuncion_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_pry_city_asuncion_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pry.city:asuncion.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pry_city_asuncion_02</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pry_city_asuncion_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pry.city:asuncion.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pry_city_asuncion_03</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pry_city_asuncion_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pry.city:asuncion.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pry_city_asuncion_04</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pry_city_asuncion_join" name="Checks complete">
      <bpmn:incoming>F_pry_city_asuncion_05</bpmn:incoming>
      <bpmn:incoming>F_pry_city_asuncion_06</bpmn:incoming>
      <bpmn:incoming>F_pry_city_asuncion_07</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_pry_city_asuncion_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pry_city_asuncion_08</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_pry_city_asuncion_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_pry_city_asuncion_09</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_10a</bpmn:outgoing>
      <bpmn:outgoing>F_pry_city_asuncion_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pry_city_asuncion_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pry.city:asuncion.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pry_city_asuncion_10a</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pry_city_asuncion_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pry.city:asuncion.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pry_city_asuncion_10b</bpmn:incoming>
      <bpmn:outgoing>F_pry_city_asuncion_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pry_city_asuncion" name="Process complete">
      <bpmn:incoming>F_pry_city_asuncion_11</bpmn:incoming>
      <bpmn:incoming>F_pry_city_asuncion_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_01" sourceRef="Start_pry_city_asuncion" targetRef="GW_pry_city_asuncion_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_02" sourceRef="GW_pry_city_asuncion_open" targetRef="T_pry_city_asuncion_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_03" sourceRef="GW_pry_city_asuncion_open" targetRef="T_pry_city_asuncion_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_04" sourceRef="GW_pry_city_asuncion_open" targetRef="T_pry_city_asuncion_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_05" sourceRef="T_pry_city_asuncion_policy" targetRef="GW_pry_city_asuncion_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_06" sourceRef="T_pry_city_asuncion_budget" targetRef="GW_pry_city_asuncion_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_07" sourceRef="T_pry_city_asuncion_coord" targetRef="GW_pry_city_asuncion_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_08" sourceRef="GW_pry_city_asuncion_join" targetRef="T_pry_city_asuncion_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_09" sourceRef="T_pry_city_asuncion_review" targetRef="GW_pry_city_asuncion_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_10a" sourceRef="GW_pry_city_asuncion_risk" targetRef="T_pry_city_asuncion_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_10b" sourceRef="GW_pry_city_asuncion_risk" targetRef="T_pry_city_asuncion_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_11" sourceRef="T_pry_city_asuncion_publish" targetRef="End_pry_city_asuncion">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pry_city_asuncion_11b" sourceRef="T_pry_city_asuncion_revise" targetRef="End_pry_city_asuncion">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pry_city_asuncion">
    <bpmndi:BPMNPlane id="BPMNPlane_pry_city_asuncion" bpmnElement="Collaboration_pry_city_asuncion" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
