      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.hti.city:port-au-prince.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_hti_city_port_au_prince_10b</bpmn:incoming>
      <bpmn:outgoing>F_hti_city_port_au_prince_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_hti_city_port_au_prince" name="Process complete">
      <bpmn:incoming>F_hti_city_port_au_prince_11</bpmn:incoming>
      <bpmn:incoming>F_hti_city_port_au_prince_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_01" sourceRef="Start_hti_city_port_au_prince" targetRef="GW_hti_city_port_au_prince_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_02" sourceRef="GW_hti_city_port_au_prince_open" targetRef="T_hti_city_port_au_prince_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_03" sourceRef="GW_hti_city_port_au_prince_open" targetRef="T_hti_city_port_au_prince_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_04" sourceRef="GW_hti_city_port_au_prince_open" targetRef="T_hti_city_port_au_prince_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_05" sourceRef="T_hti_city_port_au_prince_policy" targetRef="GW_hti_city_port_au_prince_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_06" sourceRef="T_hti_city_port_au_prince_budget" targetRef="GW_hti_city_port_au_prince_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_07" sourceRef="T_hti_city_port_au_prince_coord" targetRef="GW_hti_city_port_au_prince_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_08" sourceRef="GW_hti_city_port_au_prince_join" targetRef="T_hti_city_port_au_prince_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_09" sourceRef="T_hti_city_port_au_prince_review" targetRef="GW_hti_city_port_au_prince_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_10a" sourceRef="GW_hti_city_port_au_prince_risk" targetRef="T_hti_city_port_au_prince_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_10b" sourceRef="GW_hti_city_port_au_prince_risk" targetRef="T_hti_city_port_au_prince_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_11" sourceRef="T_hti_city_port_au_prince_publish" targetRef="End_hti_city_port_au_prince">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_hti_city_port_au_prince_11b" sourceRef="T_hti_city_port_au_prince_revise" targetRef="End_hti_city_port_au_prince">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hti_city_port_au_prince">
    <bpmndi:BPMNPlane id="BPMNPlane_hti_city_port_au_prince" bpmnElement="Collaboration_hti_city_port_au_prince" />
  </bpmndi:BPMNDiagram>
