<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_chn_peoples_liberation_army"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_peoples_liberation_army">
    <bpmn:participant id="Pool_chn_peoples_liberation_army" name="Peoples Liberation Army (peoples-)" processRef="Process_chn_peoples_liberation_army" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_peoples_liberation_army" name="Peoples Liberation Army — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_chn_peoples_liberation_army" name="Readiness
assessment triggered"><bpmn:outgoing>F_chn_peoples_liberation_army_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_chn_peoples_liberation_army_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.peoples-liberation-army.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_peoples_liberation_army_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_peoples_liberation_army_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_chn_peoples_liberation_army_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_peoples_liberation_army_02</bpmn:incoming>
      <bpmn:outgoing>F_chn_peoples_liberation_army_03a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_peoples_liberation_army_03b</bpmn:outgoing>
      <bpmn:outgoing>F_chn_peoples_liberation_army_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_peoples_liberation_army_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.peoples-liberation-army.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_peoples_liberation_army_03a</bpmn:incoming>
      <bpmn:outgoing>F_chn_peoples_liberation_army_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_peoples_liberation_army_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.peoples-liberation-army.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_peoples_liberation_army_03b</bpmn:incoming>
      <bpmn:outgoing>F_chn_peoples_liberation_army_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_peoples_liberation_army_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.peoples-liberation-army.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_peoples_liberation_army_03c</bpmn:incoming>
      <bpmn:outgoing>F_chn_peoples_liberation_army_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_peoples_liberation_army_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.peoples-liberation-army.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_peoples_liberation_army_04</bpmn:incoming>
      <bpmn:outgoing>F_chn_peoples_liberation_army_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_peoples_liberation_army" name="Assessment complete">
      <bpmn:incoming>F_chn_peoples_liberation_army_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_01" sourceRef="Start_chn_peoples_liberation_army" targetRef="T_chn_peoples_liberation_army_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_02" sourceRef="T_chn_peoples_liberation_army_assess" targetRef="GW_chn_peoples_liberation_army_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_03a" sourceRef="GW_chn_peoples_liberation_army_ready" targetRef="T_chn_peoples_liberation_army_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_03b" sourceRef="GW_chn_peoples_liberation_army_ready" targetRef="T_chn_peoples_liberation_army_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_03c" sourceRef="GW_chn_peoples_liberation_army_ready" targetRef="T_chn_peoples_liberation_army_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_04" sourceRef="T_chn_peoples_liberation_army_ops" targetRef="T_chn_peoples_liberation_army_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_04b" sourceRef="T_chn_peoples_liberation_army_proc" targetRef="T_chn_peoples_liberation_army_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_04c" sourceRef="T_chn_peoples_liberation_army_alert" targetRef="T_chn_peoples_liberation_army_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_peoples_liberation_army_05" sourceRef="T_chn_peoples_liberation_army_report" targetRef="End_chn_peoples_liberation_army">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_peoples_liberation_army">
    <bpmndi:BPMNPlane id="BPMNPlane_chn_peoples_liberation_army" bpmnElement="Collaboration_chn_peoples_liberation_army" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
