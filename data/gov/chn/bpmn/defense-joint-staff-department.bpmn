<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_chn_defense_joint_staff_department"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_defense_joint_staff_department">
    <bpmn:participant id="Pool_chn_defense_joint_staff_department" name="Defense Joint Staff Department (c1h2j3s4)" processRef="Process_chn_defense_joint_staff_department" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_defense_joint_staff_department" name="Defense Joint Staff Department — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_chn_defense_joint_staff_department" name="Readiness
assessment triggered"><bpmn:outgoing>F_chn_defense_joint_staff_department_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_chn_defense_joint_staff_department_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.defense-joint-staff-department.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_defense_joint_staff_department_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_chn_defense_joint_staff_department_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_defense_joint_staff_department_02</bpmn:incoming>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_03a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_03b</bpmn:outgoing>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_defense_joint_staff_department_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.defense-joint-staff-department.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_defense_joint_staff_department_03a</bpmn:incoming>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_defense_joint_staff_department_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.defense-joint-staff-department.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_defense_joint_staff_department_03b</bpmn:incoming>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_defense_joint_staff_department_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.defense-joint-staff-department.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_defense_joint_staff_department_03c</bpmn:incoming>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_defense_joint_staff_department_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.defense-joint-staff-department.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_defense_joint_staff_department_04</bpmn:incoming>
      <bpmn:outgoing>F_chn_defense_joint_staff_department_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_defense_joint_staff_department" name="Assessment complete">
      <bpmn:incoming>F_chn_defense_joint_staff_department_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_01" sourceRef="Start_chn_defense_joint_staff_department" targetRef="T_chn_defense_joint_staff_department_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_02" sourceRef="T_chn_defense_joint_staff_department_assess" targetRef="GW_chn_defense_joint_staff_department_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_03a" sourceRef="GW_chn_defense_joint_staff_department_ready" targetRef="T_chn_defense_joint_staff_department_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_03b" sourceRef="GW_chn_defense_joint_staff_department_ready" targetRef="T_chn_defense_joint_staff_department_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_03c" sourceRef="GW_chn_defense_joint_staff_department_ready" targetRef="T_chn_defense_joint_staff_department_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_04" sourceRef="T_chn_defense_joint_staff_department_ops" targetRef="T_chn_defense_joint_staff_department_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_04b" sourceRef="T_chn_defense_joint_staff_department_proc" targetRef="T_chn_defense_joint_staff_department_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_04c" sourceRef="T_chn_defense_joint_staff_department_alert" targetRef="T_chn_defense_joint_staff_department_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_defense_joint_staff_department_05" sourceRef="T_chn_defense_joint_staff_department_report" targetRef="End_chn_defense_joint_staff_department">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_defense_joint_staff_department">
    <bpmndi:BPMNPlane id="BPMNPlane_chn_defense_joint_staff_department" bpmnElement="Collaboration_chn_defense_joint_staff_department" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
