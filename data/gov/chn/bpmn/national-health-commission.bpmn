<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_chn_national_health_commission"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_national_health_commission">
    <bpmn:participant id="Pool_chn_national_health_commission" name="National Health Commission (national)" processRef="Process_chn_national_health_commission" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_national_health_commission" name="National Health Commission — Health Administration" isExecutable="true">
    <bpmn:startEvent id="Start_chn_national_health_commission" name="Health policy
cycle initiated"><bpmn:outgoing>F_chn_national_health_commission_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_chn_national_health_commission_open" name="Parallel health checks">
      <bpmn:incoming>F_chn_national_health_commission_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_national_health_commission_02a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_national_health_commission_02b</bpmn:outgoing>
      <bpmn:outgoing>F_chn_national_health_commission_02c</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_chn_national_health_commission_surveillance" name="Epidemiological
Surveillance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.national-health-commission.surveillance" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="disease_incidence_rate" />
          <zeebe:header key="cofog" value="07" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_national_health_commission_02a</bpmn:incoming>
      <bpmn:outgoing>F_chn_national_health_commission_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_national_health_commission_license" name="Healthcare Provider
Licensing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.national-health-commission.license_provider" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="licensed_facilities" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_national_health_commission_02b</bpmn:incoming>
      <bpmn:outgoing>F_chn_national_health_commission_03b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_national_health_commission_drug" name="Drug & Medical
Device Approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.national-health-commission.drug_approval" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="approval_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_national_health_commission_02c</bpmn:incoming>
      <bpmn:outgoing>F_chn_national_health_commission_03c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_chn_national_health_commission_join" name="Reviews complete">
      <bpmn:incoming>F_chn_national_health_commission_03</bpmn:incoming>
      <bpmn:incoming>F_chn_national_health_commission_03b</bpmn:incoming>
      <bpmn:incoming>F_chn_national_health_commission_03c</bpmn:incoming>
      <bpmn:outgoing>F_chn_national_health_commission_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_chn_national_health_commission_policy" name="Update Health
Policy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.national-health-commission.update_policy" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_national_health_commission_04</bpmn:incoming>
      <bpmn:outgoing>F_chn_national_health_commission_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_national_health_commission" name="Health cycle complete">
      <bpmn:incoming>F_chn_national_health_commission_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_01" sourceRef="Start_chn_national_health_commission" targetRef="GW_chn_national_health_commission_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_02a" sourceRef="GW_chn_national_health_commission_open" targetRef="T_chn_national_health_commission_surveillance">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_02b" sourceRef="GW_chn_national_health_commission_open" targetRef="T_chn_national_health_commission_license">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_02c" sourceRef="GW_chn_national_health_commission_open" targetRef="T_chn_national_health_commission_drug">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_03" sourceRef="T_chn_national_health_commission_surveillance" targetRef="GW_chn_national_health_commission_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_03b" sourceRef="T_chn_national_health_commission_license" targetRef="GW_chn_national_health_commission_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_03c" sourceRef="T_chn_national_health_commission_drug" targetRef="GW_chn_national_health_commission_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_04" sourceRef="GW_chn_national_health_commission_join" targetRef="T_chn_national_health_commission_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_national_health_commission_05" sourceRef="T_chn_national_health_commission_policy" targetRef="End_chn_national_health_commission">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_national_health_commission">
    <bpmndi:BPMNPlane id="BPMNPlane_chn_national_health_commission" bpmnElement="Collaboration_chn_national_health_commission" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
