<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_chn_miit"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_miit">
    <bpmn:participant id="Pool_chn_miit" name="Miit (miit)" processRef="Process_chn_miit" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_miit" name="Miit — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_chn_miit" name="Policy trigger
received"><bpmn:outgoing>F_chn_miit_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_chn_miit_open" name="Parallel checks">
      <bpmn:incoming>F_chn_miit_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_02</bpmn:outgoing>
      <bpmn:outgoing>F_chn_miit_03</bpmn:outgoing>
      <bpmn:outgoing>F_chn_miit_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_chn_miit_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.miit.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_miit_02</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_miit_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.miit.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_miit_03</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_miit_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.miit.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_miit_04</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_chn_miit_join" name="Checks complete">
      <bpmn:incoming>F_chn_miit_05</bpmn:incoming>
      <bpmn:incoming>F_chn_miit_06</bpmn:incoming>
      <bpmn:incoming>F_chn_miit_07</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_chn_miit_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_miit_08</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_chn_miit_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_miit_09</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_10a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_miit_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_miit_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.miit.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_miit_10a</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_miit_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.miit.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_miit_10b</bpmn:incoming>
      <bpmn:outgoing>F_chn_miit_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_miit" name="Process complete">
      <bpmn:incoming>F_chn_miit_11</bpmn:incoming>
      <bpmn:incoming>F_chn_miit_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_miit_01" sourceRef="Start_chn_miit" targetRef="GW_chn_miit_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_02" sourceRef="GW_chn_miit_open" targetRef="T_chn_miit_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_03" sourceRef="GW_chn_miit_open" targetRef="T_chn_miit_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_04" sourceRef="GW_chn_miit_open" targetRef="T_chn_miit_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_05" sourceRef="T_chn_miit_policy" targetRef="GW_chn_miit_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_06" sourceRef="T_chn_miit_budget" targetRef="GW_chn_miit_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_07" sourceRef="T_chn_miit_coord" targetRef="GW_chn_miit_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_08" sourceRef="GW_chn_miit_join" targetRef="T_chn_miit_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_09" sourceRef="T_chn_miit_review" targetRef="GW_chn_miit_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_10a" sourceRef="GW_chn_miit_risk" targetRef="T_chn_miit_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_10b" sourceRef="GW_chn_miit_risk" targetRef="T_chn_miit_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_11" sourceRef="T_chn_miit_publish" targetRef="End_chn_miit">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_miit_11b" sourceRef="T_chn_miit_revise" targetRef="End_chn_miit">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_miit">
    <bpmndi:BPMNPlane id="BPMNPlane_chn_miit" bpmnElement="Collaboration_chn_miit" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
