<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_chn_energy"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_energy">
    <bpmn:participant id="Pool_chn_energy" name="Energy (c1h2e3n4)" processRef="Process_chn_energy" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_energy" name="Energy — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_chn_energy" name="License / Permit
application received"><bpmn:outgoing>F_chn_energy_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_chn_energy_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.energy.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_chn_energy_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_energy_02</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_03a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_energy_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_energy_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.energy.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_03b</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_chn_energy_checks" name="Parallel review">
      <bpmn:incoming>F_chn_energy_03a</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_04a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_energy_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_chn_energy_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.energy.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_04a</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_energy_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.energy.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_04b</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_chn_energy_join" name="Reviews complete">
      <bpmn:incoming>F_chn_energy_05</bpmn:incoming>
      <bpmn:incoming>F_chn_energy_05b</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_chn_energy_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_06</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_chn_energy_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_energy_07</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_08a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_energy_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_energy_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.energy.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_08a</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_energy_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.energy.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_energy_08b</bpmn:incoming>
      <bpmn:outgoing>F_chn_energy_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_energy" name="Application
processed">
      <bpmn:incoming>F_chn_energy_end1</bpmn:incoming>
      <bpmn:incoming>F_chn_energy_end1b</bpmn:incoming>
      <bpmn:incoming>F_chn_energy_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_energy_01" sourceRef="Start_chn_energy" targetRef="T_chn_energy_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_02" sourceRef="T_chn_energy_screen" targetRef="GW_chn_energy_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_03a" sourceRef="GW_chn_energy_complete" targetRef="GW_chn_energy_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_03b" sourceRef="GW_chn_energy_complete" targetRef="T_chn_energy_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_04a" sourceRef="GW_chn_energy_checks" targetRef="T_chn_energy_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_04b" sourceRef="GW_chn_energy_checks" targetRef="T_chn_energy_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_05" sourceRef="T_chn_energy_legal" targetRef="GW_chn_energy_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_05b" sourceRef="T_chn_energy_technical" targetRef="GW_chn_energy_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_06" sourceRef="GW_chn_energy_join" targetRef="T_chn_energy_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_07" sourceRef="T_chn_energy_decision" targetRef="GW_chn_energy_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_08a" sourceRef="GW_chn_energy_approve" targetRef="T_chn_energy_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_08b" sourceRef="GW_chn_energy_approve" targetRef="T_chn_energy_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_end1" sourceRef="T_chn_energy_issue" targetRef="End_chn_energy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_end1b" sourceRef="T_chn_energy_deny" targetRef="End_chn_energy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_energy_end1c" sourceRef="T_chn_energy_return" targetRef="End_chn_energy">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_energy">
    <bpmndi:BPMNPlane id="BPMNPlane_chn_energy" bpmnElement="Collaboration_chn_energy" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
