<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_chn_municipality_shanghai"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_municipality_shanghai">
    <bpmn:participant id="Pool_chn_municipality_shanghai" name="Shanghai (municipa)" processRef="Process_chn_municipality_shanghai" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_municipality_shanghai" name="Shanghai — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_chn_municipality_shanghai" name="Policy trigger
received"><bpmn:outgoing>F_chn_municipality_shanghai_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_chn_municipality_shanghai_open" name="Parallel checks">
      <bpmn:incoming>F_chn_municipality_shanghai_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_02</bpmn:outgoing>
      <bpmn:outgoing>F_chn_municipality_shanghai_03</bpmn:outgoing>
      <bpmn:outgoing>F_chn_municipality_shanghai_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_chn_municipality_shanghai_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.municipality:shanghai.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_municipality_shanghai_02</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_municipality_shanghai_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.municipality:shanghai.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_municipality_shanghai_03</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_municipality_shanghai_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.municipality:shanghai.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_municipality_shanghai_04</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_chn_municipality_shanghai_join" name="Checks complete">
      <bpmn:incoming>F_chn_municipality_shanghai_05</bpmn:incoming>
      <bpmn:incoming>F_chn_municipality_shanghai_06</bpmn:incoming>
      <bpmn:incoming>F_chn_municipality_shanghai_07</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_chn_municipality_shanghai_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_municipality_shanghai_08</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_chn_municipality_shanghai_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_municipality_shanghai_09</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_10a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_municipality_shanghai_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_municipality_shanghai_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.municipality:shanghai.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_municipality_shanghai_10a</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_municipality_shanghai_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.municipality:shanghai.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_municipality_shanghai_10b</bpmn:incoming>
      <bpmn:outgoing>F_chn_municipality_shanghai_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_municipality_shanghai" name="Process complete">
      <bpmn:incoming>F_chn_municipality_shanghai_11</bpmn:incoming>
      <bpmn:incoming>F_chn_municipality_shanghai_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_01" sourceRef="Start_chn_municipality_shanghai" targetRef="GW_chn_municipality_shanghai_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_02" sourceRef="GW_chn_municipality_shanghai_open" targetRef="T_chn_municipality_shanghai_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_03" sourceRef="GW_chn_municipality_shanghai_open" targetRef="T_chn_municipality_shanghai_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_04" sourceRef="GW_chn_municipality_shanghai_open" targetRef="T_chn_municipality_shanghai_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_05" sourceRef="T_chn_municipality_shanghai_policy" targetRef="GW_chn_municipality_shanghai_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_06" sourceRef="T_chn_municipality_shanghai_budget" targetRef="GW_chn_municipality_shanghai_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_07" sourceRef="T_chn_municipality_shanghai_coord" targetRef="GW_chn_municipality_shanghai_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_08" sourceRef="GW_chn_municipality_shanghai_join" targetRef="T_chn_municipality_shanghai_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_09" sourceRef="T_chn_municipality_shanghai_review" targetRef="GW_chn_municipality_shanghai_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_10a" sourceRef="GW_chn_municipality_shanghai_risk" targetRef="T_chn_municipality_shanghai_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_10b" sourceRef="GW_chn_municipality_shanghai_risk" targetRef="T_chn_municipality_shanghai_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_11" sourceRef="T_chn_municipality_shanghai_publish" targetRef="End_chn_municipality_shanghai">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_municipality_shanghai_11b" sourceRef="T_chn_municipality_shanghai_revise" targetRef="End_chn_municipality_shanghai">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_municipality_shanghai">
    <bpmndi:BPMNPlane id="BPMNPlane_chn_municipality_shanghai" bpmnElement="Collaboration_chn_municipality_shanghai" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
