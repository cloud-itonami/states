      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.district:dst-08253010.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_district_dst_08253010_10b</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_chn_district_dst_08253010" name="Process complete">
      <bpmn:incoming>F_chn_district_dst_08253010_11</bpmn:incoming>
      <bpmn:incoming>F_chn_district_dst_08253010_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_01" sourceRef="Start_chn_district_dst_08253010" targetRef="GW_chn_district_dst_08253010_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_02" sourceRef="GW_chn_district_dst_08253010_open" targetRef="T_chn_district_dst_08253010_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_03" sourceRef="GW_chn_district_dst_08253010_open" targetRef="T_chn_district_dst_08253010_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_04" sourceRef="GW_chn_district_dst_08253010_open" targetRef="T_chn_district_dst_08253010_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_05" sourceRef="T_chn_district_dst_08253010_policy" targetRef="GW_chn_district_dst_08253010_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_06" sourceRef="T_chn_district_dst_08253010_budget" targetRef="GW_chn_district_dst_08253010_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_07" sourceRef="T_chn_district_dst_08253010_coord" targetRef="GW_chn_district_dst_08253010_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_08" sourceRef="GW_chn_district_dst_08253010_join" targetRef="T_chn_district_dst_08253010_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_09" sourceRef="T_chn_district_dst_08253010_review" targetRef="GW_chn_district_dst_08253010_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_10a" sourceRef="GW_chn_district_dst_08253010_risk" targetRef="T_chn_district_dst_08253010_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_10b" sourceRef="GW_chn_district_dst_08253010_risk" targetRef="T_chn_district_dst_08253010_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_11" sourceRef="T_chn_district_dst_08253010_publish" targetRef="End_chn_district_dst_08253010">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_chn_district_dst_08253010_11b" sourceRef="T_chn_district_dst_08253010_revise" targetRef="End_chn_district_dst_08253010">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_chn_district_dst_08253010">
