    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_chn_district_dst_08253010">
    <bpmn:participant id="Pool_chn_district_dst_08253010" name="Dst 08253010 (deduxian)" processRef="Process_chn_district_dst_08253010" />
  </bpmn:collaboration>
  <bpmn:process id="Process_chn_district_dst_08253010" name="Dst 08253010 — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_chn_district_dst_08253010" name="Policy trigger
received"><bpmn:outgoing>F_chn_district_dst_08253010_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_chn_district_dst_08253010_open" name="Parallel checks">
      <bpmn:incoming>F_chn_district_dst_08253010_01</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_02</bpmn:outgoing>
      <bpmn:outgoing>F_chn_district_dst_08253010_03</bpmn:outgoing>
      <bpmn:outgoing>F_chn_district_dst_08253010_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_chn_district_dst_08253010_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.district:dst-08253010.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_district_dst_08253010_02</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_district_dst_08253010_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.district:dst-08253010.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_district_dst_08253010_03</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_district_dst_08253010_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.district:dst-08253010.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_district_dst_08253010_04</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_chn_district_dst_08253010_join" name="Checks complete">
      <bpmn:incoming>F_chn_district_dst_08253010_05</bpmn:incoming>
      <bpmn:incoming>F_chn_district_dst_08253010_06</bpmn:incoming>
      <bpmn:incoming>F_chn_district_dst_08253010_07</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_chn_district_dst_08253010_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_district_dst_08253010_08</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_chn_district_dst_08253010_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_chn_district_dst_08253010_09</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_10a</bpmn:outgoing>
      <bpmn:outgoing>F_chn_district_dst_08253010_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_chn_district_dst_08253010_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.chn.district:dst-08253010.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_chn_district_dst_08253010_10a</bpmn:incoming>
      <bpmn:outgoing>F_chn_district_dst_08253010_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_chn_district_dst_08253010_revise" name="Return for
