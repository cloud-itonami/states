<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pri_city_san_juan"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pri_city_san_juan">
    <bpmn:participant id="Pool_pri_city_san_juan" name="San Juan (city:san)" processRef="Process_pri_city_san_juan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pri_city_san_juan" name="San Juan — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_pri_city_san_juan" name="Policy trigger
received"><bpmn:outgoing>F_pri_city_san_juan_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_pri_city_san_juan_open" name="Parallel checks">
      <bpmn:incoming>F_pri_city_san_juan_01</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_02</bpmn:outgoing>
      <bpmn:outgoing>F_pri_city_san_juan_03</bpmn:outgoing>
      <bpmn:outgoing>F_pri_city_san_juan_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_pri_city_san_juan_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pri.city:san-juan.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pri_city_san_juan_02</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pri_city_san_juan_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pri.city:san-juan.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pri_city_san_juan_03</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pri_city_san_juan_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pri.city:san-juan.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pri_city_san_juan_04</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pri_city_san_juan_join" name="Checks complete">
      <bpmn:incoming>F_pri_city_san_juan_05</bpmn:incoming>
      <bpmn:incoming>F_pri_city_san_juan_06</bpmn:incoming>
      <bpmn:incoming>F_pri_city_san_juan_07</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_pri_city_san_juan_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pri_city_san_juan_08</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_pri_city_san_juan_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_pri_city_san_juan_09</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_10a</bpmn:outgoing>
      <bpmn:outgoing>F_pri_city_san_juan_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pri_city_san_juan_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pri.city:san-juan.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pri_city_san_juan_10a</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pri_city_san_juan_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pri.city:san-juan.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pri_city_san_juan_10b</bpmn:incoming>
      <bpmn:outgoing>F_pri_city_san_juan_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pri_city_san_juan" name="Process complete">
      <bpmn:incoming>F_pri_city_san_juan_11</bpmn:incoming>
      <bpmn:incoming>F_pri_city_san_juan_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_01" sourceRef="Start_pri_city_san_juan" targetRef="GW_pri_city_san_juan_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_02" sourceRef="GW_pri_city_san_juan_open" targetRef="T_pri_city_san_juan_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_03" sourceRef="GW_pri_city_san_juan_open" targetRef="T_pri_city_san_juan_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_04" sourceRef="GW_pri_city_san_juan_open" targetRef="T_pri_city_san_juan_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_05" sourceRef="T_pri_city_san_juan_policy" targetRef="GW_pri_city_san_juan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_06" sourceRef="T_pri_city_san_juan_budget" targetRef="GW_pri_city_san_juan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_07" sourceRef="T_pri_city_san_juan_coord" targetRef="GW_pri_city_san_juan_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_08" sourceRef="GW_pri_city_san_juan_join" targetRef="T_pri_city_san_juan_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_09" sourceRef="T_pri_city_san_juan_review" targetRef="GW_pri_city_san_juan_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_10a" sourceRef="GW_pri_city_san_juan_risk" targetRef="T_pri_city_san_juan_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_10b" sourceRef="GW_pri_city_san_juan_risk" targetRef="T_pri_city_san_juan_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_11" sourceRef="T_pri_city_san_juan_publish" targetRef="End_pri_city_san_juan">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pri_city_san_juan_11b" sourceRef="T_pri_city_san_juan_revise" targetRef="End_pri_city_san_juan">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pri_city_san_juan">
    <bpmndi:BPMNPlane id="BPMNPlane_pri_city_san_juan" bpmnElement="Collaboration_pri_city_san_juan" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
