<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_gmb_city_serekunda"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_gmb_city_serekunda">
    <bpmn:participant id="Pool_gmb_city_serekunda" name="Serekunda (city:ser)" processRef="Process_gmb_city_serekunda" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gmb_city_serekunda" name="Serekunda — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_gmb_city_serekunda" name="Policy trigger
received"><bpmn:outgoing>F_gmb_city_serekunda_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_gmb_city_serekunda_open" name="Parallel checks">
      <bpmn:incoming>F_gmb_city_serekunda_01</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_02</bpmn:outgoing>
      <bpmn:outgoing>F_gmb_city_serekunda_03</bpmn:outgoing>
      <bpmn:outgoing>F_gmb_city_serekunda_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_gmb_city_serekunda_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gmb.city:serekunda.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gmb_city_serekunda_02</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gmb_city_serekunda_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gmb.city:serekunda.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gmb_city_serekunda_03</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gmb_city_serekunda_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gmb.city:serekunda.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gmb_city_serekunda_04</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_gmb_city_serekunda_join" name="Checks complete">
      <bpmn:incoming>F_gmb_city_serekunda_05</bpmn:incoming>
      <bpmn:incoming>F_gmb_city_serekunda_06</bpmn:incoming>
      <bpmn:incoming>F_gmb_city_serekunda_07</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_gmb_city_serekunda_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_gmb_city_serekunda_08</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_gmb_city_serekunda_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_gmb_city_serekunda_09</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_10a</bpmn:outgoing>
      <bpmn:outgoing>F_gmb_city_serekunda_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_gmb_city_serekunda_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gmb.city:serekunda.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gmb_city_serekunda_10a</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_gmb_city_serekunda_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.gmb.city:serekunda.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_gmb_city_serekunda_10b</bpmn:incoming>
      <bpmn:outgoing>F_gmb_city_serekunda_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_gmb_city_serekunda" name="Process complete">
      <bpmn:incoming>F_gmb_city_serekunda_11</bpmn:incoming>
      <bpmn:incoming>F_gmb_city_serekunda_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_01" sourceRef="Start_gmb_city_serekunda" targetRef="GW_gmb_city_serekunda_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_02" sourceRef="GW_gmb_city_serekunda_open" targetRef="T_gmb_city_serekunda_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_03" sourceRef="GW_gmb_city_serekunda_open" targetRef="T_gmb_city_serekunda_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_04" sourceRef="GW_gmb_city_serekunda_open" targetRef="T_gmb_city_serekunda_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_05" sourceRef="T_gmb_city_serekunda_policy" targetRef="GW_gmb_city_serekunda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_06" sourceRef="T_gmb_city_serekunda_budget" targetRef="GW_gmb_city_serekunda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_07" sourceRef="T_gmb_city_serekunda_coord" targetRef="GW_gmb_city_serekunda_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_08" sourceRef="GW_gmb_city_serekunda_join" targetRef="T_gmb_city_serekunda_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_09" sourceRef="T_gmb_city_serekunda_review" targetRef="GW_gmb_city_serekunda_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_10a" sourceRef="GW_gmb_city_serekunda_risk" targetRef="T_gmb_city_serekunda_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_10b" sourceRef="GW_gmb_city_serekunda_risk" targetRef="T_gmb_city_serekunda_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_11" sourceRef="T_gmb_city_serekunda_publish" targetRef="End_gmb_city_serekunda">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_gmb_city_serekunda_11b" sourceRef="T_gmb_city_serekunda_revise" targetRef="End_gmb_city_serekunda">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_gmb_city_serekunda">
    <bpmndi:BPMNPlane id="BPMNPlane_gmb_city_serekunda" bpmnElement="Collaboration_gmb_city_serekunda" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
