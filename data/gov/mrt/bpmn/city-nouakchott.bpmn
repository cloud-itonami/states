<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_mrt_city_nouakchott"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_mrt_city_nouakchott">
    <bpmn:participant id="Pool_mrt_city_nouakchott" name="Nouakchott (city:nou)" processRef="Process_mrt_city_nouakchott" />
  </bpmn:collaboration>
  <bpmn:process id="Process_mrt_city_nouakchott" name="Nouakchott — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_mrt_city_nouakchott" name="Policy trigger
received"><bpmn:outgoing>F_mrt_city_nouakchott_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_mrt_city_nouakchott_open" name="Parallel checks">
      <bpmn:incoming>F_mrt_city_nouakchott_01</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_02</bpmn:outgoing>
      <bpmn:outgoing>F_mrt_city_nouakchott_03</bpmn:outgoing>
      <bpmn:outgoing>F_mrt_city_nouakchott_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_mrt_city_nouakchott_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mrt.city:nouakchott.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mrt_city_nouakchott_02</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mrt_city_nouakchott_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mrt.city:nouakchott.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mrt_city_nouakchott_03</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mrt_city_nouakchott_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mrt.city:nouakchott.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mrt_city_nouakchott_04</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_mrt_city_nouakchott_join" name="Checks complete">
      <bpmn:incoming>F_mrt_city_nouakchott_05</bpmn:incoming>
      <bpmn:incoming>F_mrt_city_nouakchott_06</bpmn:incoming>
      <bpmn:incoming>F_mrt_city_nouakchott_07</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_mrt_city_nouakchott_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_mrt_city_nouakchott_08</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_mrt_city_nouakchott_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_mrt_city_nouakchott_09</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_10a</bpmn:outgoing>
      <bpmn:outgoing>F_mrt_city_nouakchott_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_mrt_city_nouakchott_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mrt.city:nouakchott.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mrt_city_nouakchott_10a</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mrt_city_nouakchott_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.mrt.city:nouakchott.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_mrt_city_nouakchott_10b</bpmn:incoming>
      <bpmn:outgoing>F_mrt_city_nouakchott_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_mrt_city_nouakchott" name="Process complete">
      <bpmn:incoming>F_mrt_city_nouakchott_11</bpmn:incoming>
      <bpmn:incoming>F_mrt_city_nouakchott_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_01" sourceRef="Start_mrt_city_nouakchott" targetRef="GW_mrt_city_nouakchott_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_02" sourceRef="GW_mrt_city_nouakchott_open" targetRef="T_mrt_city_nouakchott_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_03" sourceRef="GW_mrt_city_nouakchott_open" targetRef="T_mrt_city_nouakchott_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_04" sourceRef="GW_mrt_city_nouakchott_open" targetRef="T_mrt_city_nouakchott_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_05" sourceRef="T_mrt_city_nouakchott_policy" targetRef="GW_mrt_city_nouakchott_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_06" sourceRef="T_mrt_city_nouakchott_budget" targetRef="GW_mrt_city_nouakchott_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_07" sourceRef="T_mrt_city_nouakchott_coord" targetRef="GW_mrt_city_nouakchott_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_08" sourceRef="GW_mrt_city_nouakchott_join" targetRef="T_mrt_city_nouakchott_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_09" sourceRef="T_mrt_city_nouakchott_review" targetRef="GW_mrt_city_nouakchott_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_10a" sourceRef="GW_mrt_city_nouakchott_risk" targetRef="T_mrt_city_nouakchott_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_10b" sourceRef="GW_mrt_city_nouakchott_risk" targetRef="T_mrt_city_nouakchott_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_11" sourceRef="T_mrt_city_nouakchott_publish" targetRef="End_mrt_city_nouakchott">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_mrt_city_nouakchott_11b" sourceRef="T_mrt_city_nouakchott_revise" targetRef="End_mrt_city_nouakchott">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mrt_city_nouakchott">
    <bpmndi:BPMNPlane id="BPMNPlane_mrt_city_nouakchott" bpmnElement="Collaboration_mrt_city_nouakchott" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
