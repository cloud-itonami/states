<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_ury_city_montevideo"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_ury_city_montevideo">
    <bpmn:participant id="Pool_ury_city_montevideo" name="Montevideo (city:mon)" processRef="Process_ury_city_montevideo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ury_city_montevideo" name="Montevideo — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_ury_city_montevideo" name="Policy trigger
received"><bpmn:outgoing>F_ury_city_montevideo_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ury_city_montevideo_open" name="Parallel checks">
      <bpmn:incoming>F_ury_city_montevideo_01</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_02</bpmn:outgoing>
      <bpmn:outgoing>F_ury_city_montevideo_03</bpmn:outgoing>
      <bpmn:outgoing>F_ury_city_montevideo_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ury_city_montevideo_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ury.city:montevideo.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ury_city_montevideo_02</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ury_city_montevideo_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ury.city:montevideo.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ury_city_montevideo_03</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ury_city_montevideo_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ury.city:montevideo.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ury_city_montevideo_04</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_ury_city_montevideo_join" name="Checks complete">
      <bpmn:incoming>F_ury_city_montevideo_05</bpmn:incoming>
      <bpmn:incoming>F_ury_city_montevideo_06</bpmn:incoming>
      <bpmn:incoming>F_ury_city_montevideo_07</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_ury_city_montevideo_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ury_city_montevideo_08</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ury_city_montevideo_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_ury_city_montevideo_09</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_10a</bpmn:outgoing>
      <bpmn:outgoing>F_ury_city_montevideo_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ury_city_montevideo_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ury.city:montevideo.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ury_city_montevideo_10a</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ury_city_montevideo_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.ury.city:montevideo.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ury_city_montevideo_10b</bpmn:incoming>
      <bpmn:outgoing>F_ury_city_montevideo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ury_city_montevideo" name="Process complete">
      <bpmn:incoming>F_ury_city_montevideo_11</bpmn:incoming>
      <bpmn:incoming>F_ury_city_montevideo_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_01" sourceRef="Start_ury_city_montevideo" targetRef="GW_ury_city_montevideo_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_02" sourceRef="GW_ury_city_montevideo_open" targetRef="T_ury_city_montevideo_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_03" sourceRef="GW_ury_city_montevideo_open" targetRef="T_ury_city_montevideo_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_04" sourceRef="GW_ury_city_montevideo_open" targetRef="T_ury_city_montevideo_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_05" sourceRef="T_ury_city_montevideo_policy" targetRef="GW_ury_city_montevideo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_06" sourceRef="T_ury_city_montevideo_budget" targetRef="GW_ury_city_montevideo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_07" sourceRef="T_ury_city_montevideo_coord" targetRef="GW_ury_city_montevideo_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_08" sourceRef="GW_ury_city_montevideo_join" targetRef="T_ury_city_montevideo_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_09" sourceRef="T_ury_city_montevideo_review" targetRef="GW_ury_city_montevideo_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_10a" sourceRef="GW_ury_city_montevideo_risk" targetRef="T_ury_city_montevideo_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_10b" sourceRef="GW_ury_city_montevideo_risk" targetRef="T_ury_city_montevideo_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_11" sourceRef="T_ury_city_montevideo_publish" targetRef="End_ury_city_montevideo">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ury_city_montevideo_11b" sourceRef="T_ury_city_montevideo_revise" targetRef="End_ury_city_montevideo">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ury_city_montevideo">
    <bpmndi:BPMNPlane id="BPMNPlane_ury_city_montevideo" bpmnElement="Collaboration_ury_city_montevideo" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
