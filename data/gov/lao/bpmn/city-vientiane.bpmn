<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_lao_city_vientiane"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_lao_city_vientiane">
    <bpmn:participant id="Pool_lao_city_vientiane" name="Vientiane (city:vie)" processRef="Process_lao_city_vientiane" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lao_city_vientiane" name="Vientiane — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_lao_city_vientiane" name="Policy trigger
received"><bpmn:outgoing>F_lao_city_vientiane_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_lao_city_vientiane_open" name="Parallel checks">
      <bpmn:incoming>F_lao_city_vientiane_01</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_02</bpmn:outgoing>
      <bpmn:outgoing>F_lao_city_vientiane_03</bpmn:outgoing>
      <bpmn:outgoing>F_lao_city_vientiane_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_lao_city_vientiane_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lao.city:vientiane.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lao_city_vientiane_02</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lao_city_vientiane_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lao.city:vientiane.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lao_city_vientiane_03</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lao_city_vientiane_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lao.city:vientiane.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lao_city_vientiane_04</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_lao_city_vientiane_join" name="Checks complete">
      <bpmn:incoming>F_lao_city_vientiane_05</bpmn:incoming>
      <bpmn:incoming>F_lao_city_vientiane_06</bpmn:incoming>
      <bpmn:incoming>F_lao_city_vientiane_07</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_lao_city_vientiane_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_lao_city_vientiane_08</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_lao_city_vientiane_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_lao_city_vientiane_09</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_10a</bpmn:outgoing>
      <bpmn:outgoing>F_lao_city_vientiane_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_lao_city_vientiane_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lao.city:vientiane.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lao_city_vientiane_10a</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lao_city_vientiane_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lao.city:vientiane.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lao_city_vientiane_10b</bpmn:incoming>
      <bpmn:outgoing>F_lao_city_vientiane_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_lao_city_vientiane" name="Process complete">
      <bpmn:incoming>F_lao_city_vientiane_11</bpmn:incoming>
      <bpmn:incoming>F_lao_city_vientiane_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_01" sourceRef="Start_lao_city_vientiane" targetRef="GW_lao_city_vientiane_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_02" sourceRef="GW_lao_city_vientiane_open" targetRef="T_lao_city_vientiane_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_03" sourceRef="GW_lao_city_vientiane_open" targetRef="T_lao_city_vientiane_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_04" sourceRef="GW_lao_city_vientiane_open" targetRef="T_lao_city_vientiane_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_05" sourceRef="T_lao_city_vientiane_policy" targetRef="GW_lao_city_vientiane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_06" sourceRef="T_lao_city_vientiane_budget" targetRef="GW_lao_city_vientiane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_07" sourceRef="T_lao_city_vientiane_coord" targetRef="GW_lao_city_vientiane_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_08" sourceRef="GW_lao_city_vientiane_join" targetRef="T_lao_city_vientiane_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_09" sourceRef="T_lao_city_vientiane_review" targetRef="GW_lao_city_vientiane_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_10a" sourceRef="GW_lao_city_vientiane_risk" targetRef="T_lao_city_vientiane_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_10b" sourceRef="GW_lao_city_vientiane_risk" targetRef="T_lao_city_vientiane_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_11" sourceRef="T_lao_city_vientiane_publish" targetRef="End_lao_city_vientiane">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lao_city_vientiane_11b" sourceRef="T_lao_city_vientiane_revise" targetRef="End_lao_city_vientiane">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_lao_city_vientiane">
    <bpmndi:BPMNPlane id="BPMNPlane_lao_city_vientiane" bpmnElement="Collaboration_lao_city_vientiane" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
