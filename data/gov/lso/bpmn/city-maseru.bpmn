<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_lso_city_maseru"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_lso_city_maseru">
    <bpmn:participant id="Pool_lso_city_maseru" name="Maseru (city:mas)" processRef="Process_lso_city_maseru" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lso_city_maseru" name="Maseru — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_lso_city_maseru" name="Policy trigger
received"><bpmn:outgoing>F_lso_city_maseru_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_lso_city_maseru_open" name="Parallel checks">
      <bpmn:incoming>F_lso_city_maseru_01</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_02</bpmn:outgoing>
      <bpmn:outgoing>F_lso_city_maseru_03</bpmn:outgoing>
      <bpmn:outgoing>F_lso_city_maseru_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_lso_city_maseru_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lso.city:maseru.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lso_city_maseru_02</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lso_city_maseru_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lso.city:maseru.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lso_city_maseru_03</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lso_city_maseru_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lso.city:maseru.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lso_city_maseru_04</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_lso_city_maseru_join" name="Checks complete">
      <bpmn:incoming>F_lso_city_maseru_05</bpmn:incoming>
      <bpmn:incoming>F_lso_city_maseru_06</bpmn:incoming>
      <bpmn:incoming>F_lso_city_maseru_07</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_lso_city_maseru_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_lso_city_maseru_08</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_lso_city_maseru_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_lso_city_maseru_09</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_10a</bpmn:outgoing>
      <bpmn:outgoing>F_lso_city_maseru_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_lso_city_maseru_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lso.city:maseru.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lso_city_maseru_10a</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lso_city_maseru_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.lso.city:maseru.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_lso_city_maseru_10b</bpmn:incoming>
      <bpmn:outgoing>F_lso_city_maseru_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_lso_city_maseru" name="Process complete">
      <bpmn:incoming>F_lso_city_maseru_11</bpmn:incoming>
      <bpmn:incoming>F_lso_city_maseru_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_lso_city_maseru_01" sourceRef="Start_lso_city_maseru" targetRef="GW_lso_city_maseru_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_02" sourceRef="GW_lso_city_maseru_open" targetRef="T_lso_city_maseru_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_03" sourceRef="GW_lso_city_maseru_open" targetRef="T_lso_city_maseru_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_04" sourceRef="GW_lso_city_maseru_open" targetRef="T_lso_city_maseru_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_05" sourceRef="T_lso_city_maseru_policy" targetRef="GW_lso_city_maseru_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_06" sourceRef="T_lso_city_maseru_budget" targetRef="GW_lso_city_maseru_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_07" sourceRef="T_lso_city_maseru_coord" targetRef="GW_lso_city_maseru_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_08" sourceRef="GW_lso_city_maseru_join" targetRef="T_lso_city_maseru_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_09" sourceRef="T_lso_city_maseru_review" targetRef="GW_lso_city_maseru_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_10a" sourceRef="GW_lso_city_maseru_risk" targetRef="T_lso_city_maseru_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_10b" sourceRef="GW_lso_city_maseru_risk" targetRef="T_lso_city_maseru_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_11" sourceRef="T_lso_city_maseru_publish" targetRef="End_lso_city_maseru">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_lso_city_maseru_11b" sourceRef="T_lso_city_maseru_revise" targetRef="End_lso_city_maseru">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_lso_city_maseru">
    <bpmndi:BPMNPlane id="BPMNPlane_lso_city_maseru" bpmnElement="Collaboration_lso_city_maseru" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
