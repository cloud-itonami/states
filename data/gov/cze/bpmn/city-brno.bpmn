<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_cze_city_brno"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_cze_city_brno">
    <bpmn:participant id="Pool_cze_city_brno" name="Brno (city:brn)" processRef="Process_cze_city_brno" />
  </bpmn:collaboration>
  <bpmn:process id="Process_cze_city_brno" name="Brno — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_cze_city_brno" name="Policy trigger
received"><bpmn:outgoing>F_cze_city_brno_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_cze_city_brno_open" name="Parallel checks">
      <bpmn:incoming>F_cze_city_brno_01</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_02</bpmn:outgoing>
      <bpmn:outgoing>F_cze_city_brno_03</bpmn:outgoing>
      <bpmn:outgoing>F_cze_city_brno_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_cze_city_brno_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cze.city:brno.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cze_city_brno_02</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cze_city_brno_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cze.city:brno.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cze_city_brno_03</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cze_city_brno_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cze.city:brno.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cze_city_brno_04</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_cze_city_brno_join" name="Checks complete">
      <bpmn:incoming>F_cze_city_brno_05</bpmn:incoming>
      <bpmn:incoming>F_cze_city_brno_06</bpmn:incoming>
      <bpmn:incoming>F_cze_city_brno_07</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_cze_city_brno_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_cze_city_brno_08</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_cze_city_brno_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_cze_city_brno_09</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_10a</bpmn:outgoing>
      <bpmn:outgoing>F_cze_city_brno_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_cze_city_brno_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cze.city:brno.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cze_city_brno_10a</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_cze_city_brno_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.cze.city:brno.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_cze_city_brno_10b</bpmn:incoming>
      <bpmn:outgoing>F_cze_city_brno_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_cze_city_brno" name="Process complete">
      <bpmn:incoming>F_cze_city_brno_11</bpmn:incoming>
      <bpmn:incoming>F_cze_city_brno_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_cze_city_brno_01" sourceRef="Start_cze_city_brno" targetRef="GW_cze_city_brno_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_02" sourceRef="GW_cze_city_brno_open" targetRef="T_cze_city_brno_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_03" sourceRef="GW_cze_city_brno_open" targetRef="T_cze_city_brno_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_04" sourceRef="GW_cze_city_brno_open" targetRef="T_cze_city_brno_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_05" sourceRef="T_cze_city_brno_policy" targetRef="GW_cze_city_brno_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_06" sourceRef="T_cze_city_brno_budget" targetRef="GW_cze_city_brno_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_07" sourceRef="T_cze_city_brno_coord" targetRef="GW_cze_city_brno_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_08" sourceRef="GW_cze_city_brno_join" targetRef="T_cze_city_brno_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_09" sourceRef="T_cze_city_brno_review" targetRef="GW_cze_city_brno_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_10a" sourceRef="GW_cze_city_brno_risk" targetRef="T_cze_city_brno_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_10b" sourceRef="GW_cze_city_brno_risk" targetRef="T_cze_city_brno_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_11" sourceRef="T_cze_city_brno_publish" targetRef="End_cze_city_brno">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cze_city_brno_11b" sourceRef="T_cze_city_brno_revise" targetRef="End_cze_city_brno">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cze_city_brno">
    <bpmndi:BPMNPlane id="BPMNPlane_cze_city_brno" bpmnElement="Collaboration_cze_city_brno" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
