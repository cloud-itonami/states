<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_phl_city_manila"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_phl_city_manila">
    <bpmn:participant id="Pool_phl_city_manila" name="Manila (city:man)" processRef="Process_phl_city_manila" />
  </bpmn:collaboration>
  <bpmn:process id="Process_phl_city_manila" name="Manila — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_phl_city_manila" name="Policy trigger
received"><bpmn:outgoing>F_phl_city_manila_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_phl_city_manila_open" name="Parallel checks">
      <bpmn:incoming>F_phl_city_manila_01</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_02</bpmn:outgoing>
      <bpmn:outgoing>F_phl_city_manila_03</bpmn:outgoing>
      <bpmn:outgoing>F_phl_city_manila_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_phl_city_manila_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.phl.city:manila.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_phl_city_manila_02</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_phl_city_manila_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.phl.city:manila.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_phl_city_manila_03</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_phl_city_manila_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.phl.city:manila.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_phl_city_manila_04</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_phl_city_manila_join" name="Checks complete">
      <bpmn:incoming>F_phl_city_manila_05</bpmn:incoming>
      <bpmn:incoming>F_phl_city_manila_06</bpmn:incoming>
      <bpmn:incoming>F_phl_city_manila_07</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_phl_city_manila_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_phl_city_manila_08</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_phl_city_manila_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_phl_city_manila_09</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_10a</bpmn:outgoing>
      <bpmn:outgoing>F_phl_city_manila_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_phl_city_manila_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.phl.city:manila.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_phl_city_manila_10a</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_phl_city_manila_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.phl.city:manila.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_phl_city_manila_10b</bpmn:incoming>
      <bpmn:outgoing>F_phl_city_manila_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_phl_city_manila" name="Process complete">
      <bpmn:incoming>F_phl_city_manila_11</bpmn:incoming>
      <bpmn:incoming>F_phl_city_manila_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_phl_city_manila_01" sourceRef="Start_phl_city_manila" targetRef="GW_phl_city_manila_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_02" sourceRef="GW_phl_city_manila_open" targetRef="T_phl_city_manila_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_03" sourceRef="GW_phl_city_manila_open" targetRef="T_phl_city_manila_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_04" sourceRef="GW_phl_city_manila_open" targetRef="T_phl_city_manila_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_05" sourceRef="T_phl_city_manila_policy" targetRef="GW_phl_city_manila_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_06" sourceRef="T_phl_city_manila_budget" targetRef="GW_phl_city_manila_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_07" sourceRef="T_phl_city_manila_coord" targetRef="GW_phl_city_manila_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_08" sourceRef="GW_phl_city_manila_join" targetRef="T_phl_city_manila_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_09" sourceRef="T_phl_city_manila_review" targetRef="GW_phl_city_manila_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_10a" sourceRef="GW_phl_city_manila_risk" targetRef="T_phl_city_manila_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_10b" sourceRef="GW_phl_city_manila_risk" targetRef="T_phl_city_manila_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_11" sourceRef="T_phl_city_manila_publish" targetRef="End_phl_city_manila">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_phl_city_manila_11b" sourceRef="T_phl_city_manila_revise" targetRef="End_phl_city_manila">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_phl_city_manila">
    <bpmndi:BPMNPlane id="BPMNPlane_phl_city_manila" bpmnElement="Collaboration_phl_city_manila" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
