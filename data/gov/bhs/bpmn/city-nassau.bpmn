<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_bhs_city_nassau"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_bhs_city_nassau">
    <bpmn:participant id="Pool_bhs_city_nassau" name="Nassau (city:nas)" processRef="Process_bhs_city_nassau" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bhs_city_nassau" name="Nassau — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_bhs_city_nassau" name="Policy trigger
received"><bpmn:outgoing>F_bhs_city_nassau_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_bhs_city_nassau_open" name="Parallel checks">
      <bpmn:incoming>F_bhs_city_nassau_01</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_02</bpmn:outgoing>
      <bpmn:outgoing>F_bhs_city_nassau_03</bpmn:outgoing>
      <bpmn:outgoing>F_bhs_city_nassau_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_bhs_city_nassau_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bhs.city:nassau.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bhs_city_nassau_02</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bhs_city_nassau_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bhs.city:nassau.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bhs_city_nassau_03</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bhs_city_nassau_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bhs.city:nassau.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bhs_city_nassau_04</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_bhs_city_nassau_join" name="Checks complete">
      <bpmn:incoming>F_bhs_city_nassau_05</bpmn:incoming>
      <bpmn:incoming>F_bhs_city_nassau_06</bpmn:incoming>
      <bpmn:incoming>F_bhs_city_nassau_07</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_bhs_city_nassau_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_bhs_city_nassau_08</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_bhs_city_nassau_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_bhs_city_nassau_09</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_10a</bpmn:outgoing>
      <bpmn:outgoing>F_bhs_city_nassau_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_bhs_city_nassau_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bhs.city:nassau.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bhs_city_nassau_10a</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_bhs_city_nassau_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.bhs.city:nassau.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_bhs_city_nassau_10b</bpmn:incoming>
      <bpmn:outgoing>F_bhs_city_nassau_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_bhs_city_nassau" name="Process complete">
      <bpmn:incoming>F_bhs_city_nassau_11</bpmn:incoming>
      <bpmn:incoming>F_bhs_city_nassau_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_01" sourceRef="Start_bhs_city_nassau" targetRef="GW_bhs_city_nassau_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_02" sourceRef="GW_bhs_city_nassau_open" targetRef="T_bhs_city_nassau_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_03" sourceRef="GW_bhs_city_nassau_open" targetRef="T_bhs_city_nassau_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_04" sourceRef="GW_bhs_city_nassau_open" targetRef="T_bhs_city_nassau_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_05" sourceRef="T_bhs_city_nassau_policy" targetRef="GW_bhs_city_nassau_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_06" sourceRef="T_bhs_city_nassau_budget" targetRef="GW_bhs_city_nassau_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_07" sourceRef="T_bhs_city_nassau_coord" targetRef="GW_bhs_city_nassau_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_08" sourceRef="GW_bhs_city_nassau_join" targetRef="T_bhs_city_nassau_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_09" sourceRef="T_bhs_city_nassau_review" targetRef="GW_bhs_city_nassau_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_10a" sourceRef="GW_bhs_city_nassau_risk" targetRef="T_bhs_city_nassau_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_10b" sourceRef="GW_bhs_city_nassau_risk" targetRef="T_bhs_city_nassau_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_11" sourceRef="T_bhs_city_nassau_publish" targetRef="End_bhs_city_nassau">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_bhs_city_nassau_11b" sourceRef="T_bhs_city_nassau_revise" targetRef="End_bhs_city_nassau">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_bhs_city_nassau">
    <bpmndi:BPMNPlane id="BPMNPlane_bhs_city_nassau" bpmnElement="Collaboration_bhs_city_nassau" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
