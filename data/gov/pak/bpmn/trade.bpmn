<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pak_trade"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pak_trade">
    <bpmn:participant id="Pool_pak_trade" name="Trade (p1k2t3r4)" processRef="Process_pak_trade" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pak_trade" name="Trade — Economic Affairs / Licensing" isExecutable="true">
    <bpmn:startEvent id="Start_pak_trade" name="License / Permit
application received"><bpmn:outgoing>F_pak_trade_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_pak_trade_screen" name="Screen Application
(completeness check)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.trade.screen_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="processing_days" />
          <zeebe:header key="cofog" value="04" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_01</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_pak_trade_complete" name="Complete?" isMarkerVisible="true">
      <bpmn:incoming>F_pak_trade_02</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_03a</bpmn:outgoing>
      <bpmn:outgoing>F_pak_trade_03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pak_trade_return" name="Return for
Additional Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.trade.return_application" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_03b</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pak_trade_checks" name="Parallel review">
      <bpmn:incoming>F_pak_trade_03a</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_04a</bpmn:outgoing>
      <bpmn:outgoing>F_pak_trade_04b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_pak_trade_legal" name="Legal Compliance
Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.trade.legal_review" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="compliance_pass_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_04a</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_trade_technical" name="Technical
Assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.trade.technical_assessment" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="technical_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_04b</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_05b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pak_trade_join" name="Reviews complete">
      <bpmn:incoming>F_pak_trade_05</bpmn:incoming>
      <bpmn:incoming>F_pak_trade_05b</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_pak_trade_decision" name="Approval Decision
by Authority">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_06</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_pak_trade_approve" name="Decision?" isMarkerVisible="true">
      <bpmn:incoming>F_pak_trade_07</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_08a</bpmn:outgoing>
      <bpmn:outgoing>F_pak_trade_08b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pak_trade_issue" name="Issue License
/ Permit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.trade.issue_license" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="issue" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_08a</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_trade_deny" name="Send Denial
Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.trade.deny_application" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="deny" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_trade_08b</bpmn:incoming>
      <bpmn:outgoing>F_pak_trade_end1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pak_trade" name="Application
processed">
      <bpmn:incoming>F_pak_trade_end1</bpmn:incoming>
      <bpmn:incoming>F_pak_trade_end1b</bpmn:incoming>
      <bpmn:incoming>F_pak_trade_end1c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pak_trade_01" sourceRef="Start_pak_trade" targetRef="T_pak_trade_screen">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_02" sourceRef="T_pak_trade_screen" targetRef="GW_pak_trade_complete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_03a" sourceRef="GW_pak_trade_complete" targetRef="GW_pak_trade_checks" name="Yes">
      <bpmn:conditionExpression>=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_03b" sourceRef="GW_pak_trade_complete" targetRef="T_pak_trade_return" name="No">
      <bpmn:conditionExpression>=complete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_04a" sourceRef="GW_pak_trade_checks" targetRef="T_pak_trade_legal">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_04b" sourceRef="GW_pak_trade_checks" targetRef="T_pak_trade_technical">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_05" sourceRef="T_pak_trade_legal" targetRef="GW_pak_trade_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_05b" sourceRef="T_pak_trade_technical" targetRef="GW_pak_trade_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_06" sourceRef="GW_pak_trade_join" targetRef="T_pak_trade_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_07" sourceRef="T_pak_trade_decision" targetRef="GW_pak_trade_approve">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_08a" sourceRef="GW_pak_trade_approve" targetRef="T_pak_trade_issue" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_08b" sourceRef="GW_pak_trade_approve" targetRef="T_pak_trade_deny" name="Denied">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_end1" sourceRef="T_pak_trade_issue" targetRef="End_pak_trade">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_end1b" sourceRef="T_pak_trade_deny" targetRef="End_pak_trade">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_trade_end1c" sourceRef="T_pak_trade_return" targetRef="End_pak_trade">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pak_trade">
    <bpmndi:BPMNPlane id="BPMNPlane_pak_trade" bpmnElement="Collaboration_pak_trade" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
