<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pak_city_islamabad"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pak_city_islamabad">
    <bpmn:participant id="Pool_pak_city_islamabad" name="Islamabad (city:isl)" processRef="Process_pak_city_islamabad" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pak_city_islamabad" name="Islamabad — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_pak_city_islamabad" name="Policy trigger
received"><bpmn:outgoing>F_pak_city_islamabad_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_pak_city_islamabad_open" name="Parallel checks">
      <bpmn:incoming>F_pak_city_islamabad_01</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_02</bpmn:outgoing>
      <bpmn:outgoing>F_pak_city_islamabad_03</bpmn:outgoing>
      <bpmn:outgoing>F_pak_city_islamabad_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_pak_city_islamabad_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.city:islamabad.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_city_islamabad_02</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_city_islamabad_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.city:islamabad.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_city_islamabad_03</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_city_islamabad_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.city:islamabad.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_city_islamabad_04</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_pak_city_islamabad_join" name="Checks complete">
      <bpmn:incoming>F_pak_city_islamabad_05</bpmn:incoming>
      <bpmn:incoming>F_pak_city_islamabad_06</bpmn:incoming>
      <bpmn:incoming>F_pak_city_islamabad_07</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_pak_city_islamabad_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_city_islamabad_08</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_pak_city_islamabad_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_pak_city_islamabad_09</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_10a</bpmn:outgoing>
      <bpmn:outgoing>F_pak_city_islamabad_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pak_city_islamabad_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.city:islamabad.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_city_islamabad_10a</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_city_islamabad_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.city:islamabad.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_city_islamabad_10b</bpmn:incoming>
      <bpmn:outgoing>F_pak_city_islamabad_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pak_city_islamabad" name="Process complete">
      <bpmn:incoming>F_pak_city_islamabad_11</bpmn:incoming>
      <bpmn:incoming>F_pak_city_islamabad_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_01" sourceRef="Start_pak_city_islamabad" targetRef="GW_pak_city_islamabad_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_02" sourceRef="GW_pak_city_islamabad_open" targetRef="T_pak_city_islamabad_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_03" sourceRef="GW_pak_city_islamabad_open" targetRef="T_pak_city_islamabad_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_04" sourceRef="GW_pak_city_islamabad_open" targetRef="T_pak_city_islamabad_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_05" sourceRef="T_pak_city_islamabad_policy" targetRef="GW_pak_city_islamabad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_06" sourceRef="T_pak_city_islamabad_budget" targetRef="GW_pak_city_islamabad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_07" sourceRef="T_pak_city_islamabad_coord" targetRef="GW_pak_city_islamabad_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_08" sourceRef="GW_pak_city_islamabad_join" targetRef="T_pak_city_islamabad_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_09" sourceRef="T_pak_city_islamabad_review" targetRef="GW_pak_city_islamabad_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_10a" sourceRef="GW_pak_city_islamabad_risk" targetRef="T_pak_city_islamabad_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_10b" sourceRef="GW_pak_city_islamabad_risk" targetRef="T_pak_city_islamabad_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_11" sourceRef="T_pak_city_islamabad_publish" targetRef="End_pak_city_islamabad">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_city_islamabad_11b" sourceRef="T_pak_city_islamabad_revise" targetRef="End_pak_city_islamabad">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pak_city_islamabad">
    <bpmndi:BPMNPlane id="BPMNPlane_pak_city_islamabad" bpmnElement="Collaboration_pak_city_islamabad" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
