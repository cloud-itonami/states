<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_pak_prosecutor_agp"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_pak_prosecutor_agp">
    <bpmn:participant id="Pool_pak_prosecutor_agp" name="Prosecutor Agp (p1k2p3g4)" processRef="Process_pak_prosecutor_agp" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pak_prosecutor_agp" name="Prosecutor Agp — Public Order & Safety" isExecutable="true">
    <bpmn:startEvent id="Start_pak_prosecutor_agp" name="Incident
reported"><bpmn:outgoing>F_pak_prosecutor_agp_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_pak_prosecutor_agp_triage" name="Triage Incident
(severity classification)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.prosecutor-agp.triage" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="response_time_minutes" />
          <zeebe:header key="cofog" value="03" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_prosecutor_agp_01</bpmn:incoming>
      <bpmn:outgoing>F_pak_prosecutor_agp_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_pak_prosecutor_agp_sev" name="Severity?" isMarkerVisible="true">
      <bpmn:incoming>F_pak_prosecutor_agp_02</bpmn:incoming>
      <bpmn:outgoing>F_pak_prosecutor_agp_03a</bpmn:outgoing>
      <bpmn:outgoing>F_pak_prosecutor_agp_03b</bpmn:outgoing>
      <bpmn:outgoing>F_pak_prosecutor_agp_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pak_prosecutor_agp_emergency" name="Deploy Emergency
Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.prosecutor-agp.emergency_response" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="emergency" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_prosecutor_agp_03a</bpmn:incoming>
      <bpmn:outgoing>F_pak_prosecutor_agp_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_prosecutor_agp_investigate" name="Open Investigation
& Assign Officers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.prosecutor-agp.investigate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="investigate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_prosecutor_agp_03b</bpmn:incoming>
      <bpmn:outgoing>F_pak_prosecutor_agp_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_prosecutor_agp_log" name="Log Report
& Close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.prosecutor-agp.log_close" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="log" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_prosecutor_agp_03c</bpmn:incoming>
      <bpmn:outgoing>F_pak_prosecutor_agp_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_pak_prosecutor_agp_report" name="File Incident
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.pak.prosecutor-agp.file_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_pak_prosecutor_agp_06</bpmn:incoming>
      <bpmn:outgoing>F_pak_prosecutor_agp_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_pak_prosecutor_agp" name="Incident resolved">
      <bpmn:incoming>F_pak_prosecutor_agp_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_01" sourceRef="Start_pak_prosecutor_agp" targetRef="T_pak_prosecutor_agp_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_02" sourceRef="T_pak_prosecutor_agp_triage" targetRef="GW_pak_prosecutor_agp_sev">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_03a" sourceRef="GW_pak_prosecutor_agp_sev" targetRef="T_pak_prosecutor_agp_emergency" name="Critical">
      <bpmn:conditionExpression>=severity = 'critical'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_03b" sourceRef="GW_pak_prosecutor_agp_sev" targetRef="T_pak_prosecutor_agp_investigate" name="Standard">
      <bpmn:conditionExpression>=severity = 'standard'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_03c" sourceRef="GW_pak_prosecutor_agp_sev" targetRef="T_pak_prosecutor_agp_log" name="Minor">
      <bpmn:conditionExpression>=severity = 'minor'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_06" sourceRef="T_pak_prosecutor_agp_emergency" targetRef="T_pak_prosecutor_agp_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_06b" sourceRef="T_pak_prosecutor_agp_investigate" targetRef="T_pak_prosecutor_agp_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_06c" sourceRef="T_pak_prosecutor_agp_log" targetRef="T_pak_prosecutor_agp_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pak_prosecutor_agp_07" sourceRef="T_pak_prosecutor_agp_report" targetRef="End_pak_prosecutor_agp">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pak_prosecutor_agp">
    <bpmndi:BPMNPlane id="BPMNPlane_pak_prosecutor_agp" bpmnElement="Collaboration_pak_prosecutor_agp" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
