<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_rwa_city_kigali"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_rwa_city_kigali">
    <bpmn:participant id="Pool_rwa_city_kigali" name="Kigali (city:kig)" processRef="Process_rwa_city_kigali" />
  </bpmn:collaboration>
  <bpmn:process id="Process_rwa_city_kigali" name="Kigali — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_rwa_city_kigali" name="Policy trigger
received"><bpmn:outgoing>F_rwa_city_kigali_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_rwa_city_kigali_open" name="Parallel checks">
      <bpmn:incoming>F_rwa_city_kigali_01</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_02</bpmn:outgoing>
      <bpmn:outgoing>F_rwa_city_kigali_03</bpmn:outgoing>
      <bpmn:outgoing>F_rwa_city_kigali_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_rwa_city_kigali_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rwa.city:kigali.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rwa_city_kigali_02</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rwa_city_kigali_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rwa.city:kigali.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rwa_city_kigali_03</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rwa_city_kigali_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rwa.city:kigali.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rwa_city_kigali_04</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_rwa_city_kigali_join" name="Checks complete">
      <bpmn:incoming>F_rwa_city_kigali_05</bpmn:incoming>
      <bpmn:incoming>F_rwa_city_kigali_06</bpmn:incoming>
      <bpmn:incoming>F_rwa_city_kigali_07</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_rwa_city_kigali_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_rwa_city_kigali_08</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_rwa_city_kigali_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_rwa_city_kigali_09</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_10a</bpmn:outgoing>
      <bpmn:outgoing>F_rwa_city_kigali_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_rwa_city_kigali_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rwa.city:kigali.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rwa_city_kigali_10a</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_rwa_city_kigali_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.rwa.city:kigali.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_rwa_city_kigali_10b</bpmn:incoming>
      <bpmn:outgoing>F_rwa_city_kigali_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_rwa_city_kigali" name="Process complete">
      <bpmn:incoming>F_rwa_city_kigali_11</bpmn:incoming>
      <bpmn:incoming>F_rwa_city_kigali_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_01" sourceRef="Start_rwa_city_kigali" targetRef="GW_rwa_city_kigali_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_02" sourceRef="GW_rwa_city_kigali_open" targetRef="T_rwa_city_kigali_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_03" sourceRef="GW_rwa_city_kigali_open" targetRef="T_rwa_city_kigali_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_04" sourceRef="GW_rwa_city_kigali_open" targetRef="T_rwa_city_kigali_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_05" sourceRef="T_rwa_city_kigali_policy" targetRef="GW_rwa_city_kigali_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_06" sourceRef="T_rwa_city_kigali_budget" targetRef="GW_rwa_city_kigali_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_07" sourceRef="T_rwa_city_kigali_coord" targetRef="GW_rwa_city_kigali_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_08" sourceRef="GW_rwa_city_kigali_join" targetRef="T_rwa_city_kigali_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_09" sourceRef="T_rwa_city_kigali_review" targetRef="GW_rwa_city_kigali_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_10a" sourceRef="GW_rwa_city_kigali_risk" targetRef="T_rwa_city_kigali_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_10b" sourceRef="GW_rwa_city_kigali_risk" targetRef="T_rwa_city_kigali_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_11" sourceRef="T_rwa_city_kigali_publish" targetRef="End_rwa_city_kigali">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_rwa_city_kigali_11b" sourceRef="T_rwa_city_kigali_revise" targetRef="End_rwa_city_kigali">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_rwa_city_kigali">
    <bpmndi:BPMNPlane id="BPMNPlane_rwa_city_kigali" bpmnElement="Collaboration_rwa_city_kigali" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
