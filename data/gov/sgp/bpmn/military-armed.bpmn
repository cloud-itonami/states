<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_sgp_military_armed"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_sgp_military_armed">
    <bpmn:participant id="Pool_sgp_military_armed" name="Military Armed (military)" processRef="Process_sgp_military_armed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sgp_military_armed" name="Military Armed — Defence Operations" isExecutable="true">
    <bpmn:startEvent id="Start_sgp_military_armed" name="Readiness
assessment triggered"><bpmn:outgoing>F_sgp_military_armed_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_sgp_military_armed_assess" name="Assess Operational
Readiness">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.military-armed.assess_readiness" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="readiness_score" />
          <zeebe:header key="cofog" value="02" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_military_armed_01</bpmn:incoming>
      <bpmn:outgoing>F_sgp_military_armed_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_sgp_military_armed_ready" name="Readiness level?" isMarkerVisible="true">
      <bpmn:incoming>F_sgp_military_armed_02</bpmn:incoming>
      <bpmn:outgoing>F_sgp_military_armed_03a</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_military_armed_03b</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_military_armed_03c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_sgp_military_armed_ops" name="Execute Operations
Plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.military-armed.execute_ops" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="execute" />
          <zeebe:header key="kpi" value="mission_success_rate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_military_armed_03a</bpmn:incoming>
      <bpmn:outgoing>F_sgp_military_armed_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_military_armed_proc" name="Initiate Procurement
& Logistics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.military-armed.procurement" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="procure" />
          <zeebe:header key="kpi" value="procurement_cycle_days" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_military_armed_03b</bpmn:incoming>
      <bpmn:outgoing>F_sgp_military_armed_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_military_armed_alert" name="Raise Alert
& Escalate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.military-armed.escalate" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="escalate" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_military_armed_03c</bpmn:incoming>
      <bpmn:outgoing>F_sgp_military_armed_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_military_armed_report" name="Submit Readiness
Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.military-armed.submit_report" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_military_armed_04</bpmn:incoming>
      <bpmn:outgoing>F_sgp_military_armed_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sgp_military_armed" name="Assessment complete">
      <bpmn:incoming>F_sgp_military_armed_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_sgp_military_armed_01" sourceRef="Start_sgp_military_armed" targetRef="T_sgp_military_armed_assess">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_02" sourceRef="T_sgp_military_armed_assess" targetRef="GW_sgp_military_armed_ready">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_03a" sourceRef="GW_sgp_military_armed_ready" targetRef="T_sgp_military_armed_ops" name="High">
      <bpmn:conditionExpression>=readiness = 'high'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_03b" sourceRef="GW_sgp_military_armed_ready" targetRef="T_sgp_military_armed_proc" name="Medium">
      <bpmn:conditionExpression>=readiness = 'medium'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_03c" sourceRef="GW_sgp_military_armed_ready" targetRef="T_sgp_military_armed_alert" name="Low">
      <bpmn:conditionExpression>=readiness = 'low'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_04" sourceRef="T_sgp_military_armed_ops" targetRef="T_sgp_military_armed_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_04b" sourceRef="T_sgp_military_armed_proc" targetRef="T_sgp_military_armed_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_04c" sourceRef="T_sgp_military_armed_alert" targetRef="T_sgp_military_armed_report">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_military_armed_05" sourceRef="T_sgp_military_armed_report" targetRef="End_sgp_military_armed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sgp_military_armed">
    <bpmndi:BPMNPlane id="BPMNPlane_sgp_military_armed" bpmnElement="Collaboration_sgp_military_armed" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
