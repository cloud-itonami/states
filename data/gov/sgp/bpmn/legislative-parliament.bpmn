<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_sgp_legislative_parliament"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_sgp_legislative_parliament">
    <bpmn:participant id="Pool_sgp_legislative_parliament" name="Legislative Parliament (legislat)" processRef="Process_sgp_legislative_parliament" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sgp_legislative_parliament" name="Legislative Parliament — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_sgp_legislative_parliament" name="Policy trigger
received"><bpmn:outgoing>F_sgp_legislative_parliament_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_sgp_legislative_parliament_open" name="Parallel checks">
      <bpmn:incoming>F_sgp_legislative_parliament_01</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_02</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_legislative_parliament_03</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_legislative_parliament_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_sgp_legislative_parliament_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.legislative-parliament.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_legislative_parliament_02</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_legislative_parliament_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.legislative-parliament.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_legislative_parliament_03</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_legislative_parliament_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.legislative-parliament.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_legislative_parliament_04</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_sgp_legislative_parliament_join" name="Checks complete">
      <bpmn:incoming>F_sgp_legislative_parliament_05</bpmn:incoming>
      <bpmn:incoming>F_sgp_legislative_parliament_06</bpmn:incoming>
      <bpmn:incoming>F_sgp_legislative_parliament_07</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_sgp_legislative_parliament_review" name="Minister Review
& Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_legislative_parliament_08</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_sgp_legislative_parliament_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_sgp_legislative_parliament_09</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_10a</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_legislative_parliament_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_sgp_legislative_parliament_publish" name="Publish Policy
& Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.legislative-parliament.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_legislative_parliament_10a</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_legislative_parliament_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.legislative-parliament.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_legislative_parliament_10b</bpmn:incoming>
      <bpmn:outgoing>F_sgp_legislative_parliament_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sgp_legislative_parliament" name="Process complete">
      <bpmn:incoming>F_sgp_legislative_parliament_11</bpmn:incoming>
      <bpmn:incoming>F_sgp_legislative_parliament_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_01" sourceRef="Start_sgp_legislative_parliament" targetRef="GW_sgp_legislative_parliament_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_02" sourceRef="GW_sgp_legislative_parliament_open" targetRef="T_sgp_legislative_parliament_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_03" sourceRef="GW_sgp_legislative_parliament_open" targetRef="T_sgp_legislative_parliament_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_04" sourceRef="GW_sgp_legislative_parliament_open" targetRef="T_sgp_legislative_parliament_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_05" sourceRef="T_sgp_legislative_parliament_policy" targetRef="GW_sgp_legislative_parliament_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_06" sourceRef="T_sgp_legislative_parliament_budget" targetRef="GW_sgp_legislative_parliament_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_07" sourceRef="T_sgp_legislative_parliament_coord" targetRef="GW_sgp_legislative_parliament_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_08" sourceRef="GW_sgp_legislative_parliament_join" targetRef="T_sgp_legislative_parliament_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_09" sourceRef="T_sgp_legislative_parliament_review" targetRef="GW_sgp_legislative_parliament_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_10a" sourceRef="GW_sgp_legislative_parliament_risk" targetRef="T_sgp_legislative_parliament_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_10b" sourceRef="GW_sgp_legislative_parliament_risk" targetRef="T_sgp_legislative_parliament_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_11" sourceRef="T_sgp_legislative_parliament_publish" targetRef="End_sgp_legislative_parliament">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_legislative_parliament_11b" sourceRef="T_sgp_legislative_parliament_revise" targetRef="End_sgp_legislative_parliament">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sgp_legislative_parliament">
    <bpmndi:BPMNPlane id="BPMNPlane_sgp_legislative_parliament" bpmnElement="Collaboration_sgp_legislative_parliament" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
