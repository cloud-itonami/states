<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_sgp_city_singapore"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler" exporterVersion="5.17.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.2.0">
  <bpmn:collaboration id="Collaboration_sgp_city_singapore">
    <bpmn:participant id="Pool_sgp_city_singapore" name="Singapore (city:sin)" processRef="Process_sgp_city_singapore" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sgp_city_singapore" name="Singapore — General Public Services" isExecutable="true">
    <bpmn:startEvent id="Start_sgp_city_singapore" name="Policy trigger
received"><bpmn:outgoing>F_sgp_city_singapore_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="GW_sgp_city_singapore_open" name="Parallel checks">
      <bpmn:incoming>F_sgp_city_singapore_01</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_02</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_city_singapore_03</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_city_singapore_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_sgp_city_singapore_policy" name="Draft Policy
Proposal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.city:singapore.draft_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="policy_output" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_city_singapore_02</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_city_singapore_budget" name="Allocate Budget
(COFOG 01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.city:singapore.allocate_budget" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="budget_execution_rate" />
          <zeebe:header key="cofog" value="01" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_city_singapore_03</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_city_singapore_coord" name="Inter-Agency
Coordination">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.city:singapore.coordinate" />
        <zeebe:taskHeaders>
          <zeebe:header key="kpi" value="coordination_score" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_city_singapore_04</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_sgp_city_singapore_join" name="Checks complete">
      <bpmn:incoming>F_sgp_city_singapore_05</bpmn:incoming>
      <bpmn:incoming>F_sgp_city_singapore_06</bpmn:incoming>
      <bpmn:incoming>F_sgp_city_singapore_07</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T_sgp_city_singapore_review" name="Minister Review
&amp; Sign-off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="gov-official" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_city_singapore_08</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_sgp_city_singapore_risk" name="Approved?" isMarkerVisible="true">
      <bpmn:incoming>F_sgp_city_singapore_09</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_10a</bpmn:outgoing>
      <bpmn:outgoing>F_sgp_city_singapore_10b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_sgp_city_singapore_publish" name="Publish Policy
&amp; Notify Citizens">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.city:singapore.publish_policy" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="publish" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_city_singapore_10a</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_sgp_city_singapore_revise" name="Return for
Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gov.sgp.city:singapore.request_revision" />
        <zeebe:taskHeaders>
          <zeebe:header key="action" value="revise" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_sgp_city_singapore_10b</bpmn:incoming>
      <bpmn:outgoing>F_sgp_city_singapore_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sgp_city_singapore" name="Process complete">
      <bpmn:incoming>F_sgp_city_singapore_11</bpmn:incoming>
      <bpmn:incoming>F_sgp_city_singapore_11b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_01" sourceRef="Start_sgp_city_singapore" targetRef="GW_sgp_city_singapore_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_02" sourceRef="GW_sgp_city_singapore_open" targetRef="T_sgp_city_singapore_policy">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_03" sourceRef="GW_sgp_city_singapore_open" targetRef="T_sgp_city_singapore_budget">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_04" sourceRef="GW_sgp_city_singapore_open" targetRef="T_sgp_city_singapore_coord">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_05" sourceRef="T_sgp_city_singapore_policy" targetRef="GW_sgp_city_singapore_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_06" sourceRef="T_sgp_city_singapore_budget" targetRef="GW_sgp_city_singapore_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_07" sourceRef="T_sgp_city_singapore_coord" targetRef="GW_sgp_city_singapore_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_08" sourceRef="GW_sgp_city_singapore_join" targetRef="T_sgp_city_singapore_review">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_09" sourceRef="T_sgp_city_singapore_review" targetRef="GW_sgp_city_singapore_risk">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_10a" sourceRef="GW_sgp_city_singapore_risk" targetRef="T_sgp_city_singapore_publish" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_10b" sourceRef="GW_sgp_city_singapore_risk" targetRef="T_sgp_city_singapore_revise" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_11" sourceRef="T_sgp_city_singapore_publish" targetRef="End_sgp_city_singapore">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_sgp_city_singapore_11b" sourceRef="T_sgp_city_singapore_revise" targetRef="End_sgp_city_singapore">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sgp_city_singapore">
    <bpmndi:BPMNPlane id="BPMNPlane_sgp_city_singapore" bpmnElement="Collaboration_sgp_city_singapore" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
